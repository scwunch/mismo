struct String
   .bytes Slice[Byte]

impl String
   fn .empty? Bool:
      .bytes.size == 0

   fn .contains(substr: String) Bool:
      .find(substr).some?

   fn .find(substr: String) Option[Nat]:
      for (i, b) in .enumerate:

   fn .enumerate() ()->(Nat, Byte):
      .bytes.enumerate


struct Array[T]
   _buffer: Slice[T]
   _size: UInt

impl[T] Array[T]
   fn .size() Nat: ._size
   fn .cap() Nat: ._buffer.size

   fn .get(index Nat, ?copy(T)->T) Option[T]:
      if index < .size:
         Some(_buffer.deref_let(index).copy)
      else:
         None

   fn .at[R](index Nat, do(T)->R) -> Option[R]:
      if index < .size:
         Some(_buffer.deref_let(index).do)
      else:
         None

   fn .slice[R](start: Nat, end: Nat, do(Slice[T])->R) -> R:
      do(._buffer.slice(start, end))

   fn mut.slice![R](start: Nat, end: Nat, do(mut Slice[T])->R) -> R:
      do(._buffer.slice(start, end))

   fn .iter() Coroutine

struct Generator[T]

impl[T] Generator[T]
   extern fn .next(?clone(T)->T) Option[T]
   extern fn .next(do(T)->R) Option[R]

fn range(to Nat) Generator[Nat]:
   let state = 0
   while state < to:
      yield state += 1

fn iter[T](self Array[T]) {self->T}:
   for i in range(self.size):
      yield ._buffer.deref_let(i)

fn iter[T, R](self Array[T], do(mut Generator[T])->R) R:
   let gen = ||:
      for i in range(self.size):
         yield ._buffer.deref_let(i)
   do(gen)

co iter[T](yield self Array[T]) T:
   ||:
      for i in range(self.size):
         yield ._buffer.deref_let(i)

fn main():
   var arr = [Foo(), Foo(), Foo()]
   let iter = arr.iter
   -- compiler knows that `iter` contains reference to `arr`
   iter.next(|f|:
      -- do something with f: Foo
   )

fn make_and_use_closure[T, A, R](var val T, ?do_something(T)->R):
   let closure = |v: A|:
      v.do_something(val)
   -- closure: {let val, (A)->R}
   move(v)
   -- closure is now invalid



enum Result[T, E]
  Ok(T)
  Err(E)


enum Option[T]
  Some(T)
  None

impl[T] Option[T]
   fn var.map[U](do(var T)->U) Option[U]:
      if self is
         Some(t): Some(do(t))
         None: None

   fn mut.map_mut[U](do(mut T)->U) Option[U]:
      if self is
         Some(t): Some(do(t))
         None: None

   fn mut!.map_mut![U](do(mut! T)->U) Option[U]:
      if self is
         Some(t): Some(do(t))
         None: None

   fn .map_let[U](do(T)->U) Option[U]:
      if self is
         Some(t): Some(do(t))
         None: None


--- Generic implementation of Option[T].map
fn map[T, R, a](a self Option[T], do(a T)->R) Option[R]:
   if self is
      Some(t): Some(do(t))
      None: None

fn map[T, R](yield self Option[T], do(yield[self] T)->R) Option[R]:
   if self is
      Some(t): Some(do(t))
      None: None
