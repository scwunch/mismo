extern fn __zig_print(value: String)
extern fn __zig_panic(value: String) Never

extern fn __zig_eq(left Any, right Any) Bool
extern fn __zig_neq(left Any, right Any) Bool
extern fn __zig_lt(left Any, right Any) Bool
extern fn __zig_gt(left Any, right Any) Bool
extern fn __zig_lte(left Any, right Any) Bool
extern fn __zig_gte(left Any, right Any) Bool

extern fn __zig_add_uint(left Any, right Any) Nat
extern fn __zig_sub_uint(left Any, right Any) Nat
extern fn __zig_mul_uint(left Any, right Any) Nat
extern fn __zig_div_uint(left Any, right Any) Nat

extern fn __zig_neg_int(int Any) Int
extern fn __zig_add_int(left Any, right Any) Int
extern fn __zig_sub_int(left Any, right Any) Int
extern fn __zig_mul_int(left Any, right Any) Int
extern fn __zig_div_int(left Any, right Any) Int

extern fn __zig_neg_float(float Any) Float
extern fn __zig_add_float(left Any, right Any) Float
extern fn __zig_sub_float(left Any, right Any) Float
extern fn __zig_mul_float(left Any, right Any) Float
extern fn __zig_div_float(left Any, right Any) Float

extern fn __zig_nat2int(nat: Nat) Int
extern fn __zig_nat2float(nat: Nat) Float
extern fn __zig_nat2string(nat: Nat) String
extern fn __zig_int2nat(int: Int) Nat
extern fn __zig_int2float(int: Int) Float
extern fn __zig_int2string(int: Int) String
extern fn __zig_float2int(float: Float) Int
extern fn __zig_float2string(float: Float) String
extern fn __zig_string2int(string: String) Int
extern fn __zig_string2float(string: String) Float

