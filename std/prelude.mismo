-- TODO: test
extern fn __zig_print(value: String)
extern fn __zig_panic(value: String) Never

extern fn __zig_eq(left Any, right Any) Bool
extern fn __zig_neq(left Any, right Any) Bool
extern fn __zig_lt(left Any, right Any) Bool
extern fn __zig_gt(left Any, right Any) Bool
extern fn __zig_lte(left Any, right Any) Bool
extern fn __zig_gte(left Any, right Any) Bool

extern fn __zig_add_uint(left Any, right Any) Nat
extern fn __zig_sub_uint(left Any, right Any) Nat
extern fn __zig_mul_uint(left Any, right Any) Nat
extern fn __zig_div_uint(left Any, right Any) Nat

extern fn __zig_neg_int(int Any) Int
extern fn __zig_add_int(left Any, right Any) Int
extern fn __zig_sub_int(left Any, right Any) Int
extern fn __zig_mul_int(left Any, right Any) Int
extern fn __zig_div_int(left Any, right Any) Int

extern fn __zig_neg_float(float Any) Float
extern fn __zig_add_float(left Any, right Any) Float
extern fn __zig_sub_float(left Any, right Any) Float
extern fn __zig_mul_float(left Any, right Any) Float
extern fn __zig_div_float(left Any, right Any) Float

extern fn __zig_nat2int(nat: Nat) Int
extern fn __zig_nat2float(nat: Nat) Float
extern fn __zig_nat2string(nat: Nat) String
extern fn __zig_int2nat(int: Int) Nat
extern fn __zig_int2float(int: Int) Float
extern fn __zig_int2string(int: Int) String
extern fn __zig_float2int(float: Float) Int
extern fn __zig_float2string(float: Float) String
extern fn __zig_string2int(string: String) Int
extern fn __zig_string2float(string: String) Float

extern fn __zig_alloc[T](size: Nat) Slice[T]
extern fn __zig_free(slice: Any)
extern fn __zig_slice_size(slice: Any) Nat
extern fn __zig_slice2ptr[T](slice: Any) Pointer[T]
extern fn __zig_ptr2slice[T](ptr: Any, size: Nat) Slice[T]

fn bool(_ Nil) Bool: false

--- Bool
fn bool(self Bool) Bool: self
fn nat(self Bool) Nat:
   nat(if self: 1
   else: 0)
fn int(self Bool) Int:
   if self: 1
   else: 0
fn float(self Bool) Float:
   if self: 1.0
   else: 0.0
fn string(self Bool) String:
   if self: "true"
   else: "false"

fn ==(self Bool, other Bool) Bool: .__zig_eq(other)
fn ==(self Bool, other Nat) Bool: .__zig_eq(other)
fn ==(self Bool, other Int) Bool: .__zig_eq(other)
fn !=(self Bool, other Bool) Bool: .__zig_neq(other)
fn !=(self Bool, other Nat) Bool: .__zig_neq(other)
fn !=(self Bool, other Int) Bool: .__zig_neq(other)
fn <(self Bool, other Bool) Bool: not self and other
fn <(self Bool, other Nat) Bool: .nat.__zig_lt(other)
fn <(self Bool, other Int) Bool: .int.__zig_lt(other)
fn <=(self Bool, other Bool) Bool: not self or other
fn <=(self Bool, other Nat) Bool: .nat.__zig_lte(other)
fn <=(self Bool, other Int) Bool: .int.__zig_lte(other)
fn >(self Bool, other Bool) Bool: self and not other
fn >(self Bool, other Nat) Bool: .nat.__zig_gt(other)
fn >(self Bool, other Int) Bool: .int.__zig_gt(other)
fn >=(self Bool, other Bool) Bool: self or not other
fn >=(self Bool, other Nat) Bool: .nat.__zig_gte(other)
fn >=(self Bool, other Int) Bool: .int.__zig_gte(other)

fn +(self Bool, other Bool) Nat:
   nat(if
      self and other: 2
      self or other: 1
      else: 0
   )
fn +(self Bool, other Nat) Nat: .nat.__zig_add_uint(other)
fn +(self Bool, other Int) Int: .int.__zig_add_int(other)

fn -(self Bool, other Bool) Int:
   if
      self and other: 0
      self: 1
      other: -1
   else: 0
fn -(self Bool, other Nat) Int: .nat.__zig_sub_int(other)
fn -(self Bool, other Int) Int: .int.__zig_sub_int(other)

fn -(self Bool) Int:
   if self: -1
   else: 0

fn *(self Bool, other Bool) Bool:
   if self and other: true
   else: false
fn *(self Bool, other Nat) Nat:
   if self: other
   else: nat(0)
fn *(self Bool, other Int) Int:
   if self: other
   else: 0
fn *(self Bool, other Float) Float:
   if self: other
   else: 0.0

fn /(self Bool, other Bool) Bool:
   if
      not other:
         panic("divide by zero")
      self and other: true
      else: false
fn /(self Bool, other Nat) Nat: .nat.__zig_div_uint(other)
fn /(self Bool, other Int) Int: .int.__zig_div_int(other)

-- Nat
fn bool(self Nat) Bool: .__zig_neq(0)
fn nat(self Nat) Nat: self
fn int(self Nat) Int: .__zig_nat2int
fn float(self Nat) Float: .__zig_nat2float
fn string(self Nat) String: .__zig_nat2string

fn ==(self Nat, other Bool) Bool: .__zig_eq(other)
fn ==(self Nat, other Nat) Bool: .__zig_eq(other)
fn ==(self Nat, other Int) Bool: .__zig_eq(other)
fn !=(self Nat, other Bool) Bool: .__zig_neq(other)
fn !=(self Nat, other Nat) Bool: .__zig_neq(other)
fn !=(self Nat, other Int) Bool: .__zig_neq(other)
fn <(self Nat, other Bool) Bool: .__zig_lt(other.nat)
fn <(self Nat, other Nat) Bool: .__zig_lt(other)
fn <(self Nat, other Int) Bool: .int.__zig_lt(other)
fn <=(self Nat, other Bool) Bool: .__zig_lte(other.nat)
fn <=(self Nat, other Nat) Bool: .__zig_lte(other)
fn <=(self Nat, other Int) Bool: .int.__zig_lte(other)
fn >(self Nat, other Bool) Bool: .__zig_gt(other.nat)
fn >(self Nat, other Nat) Bool: .__zig_gt(other)
fn >(self Nat, other Int) Bool: .int.__zig_gt(other)
fn >=(self Nat, other Bool) Bool: .__zig_gte(other.nat)
fn >=(self Nat, other Nat) Bool: .__zig_gte(other)
fn >=(self Nat, other Int) Bool: .int.__zig_gte(other)

fn -(self Nat) Int: .__zig_nat2int.__zig_neg_int
fn +(self Nat, other Bool) Nat: .__zig_add_uint(other.nat)
fn +(self Nat, other Nat) Nat: .__zig_add_uint(other)
fn +(self Nat, other Int) Int: .int.__zig_add_int(other)
fn -(self Nat, other Bool) Nat: .__zig_sub_uint(other.nat)
fn -(self Nat, other Nat) Nat: .__zig_sub_uint(other)
fn -(self Nat, other Int) Int: .int.__zig_sub_int(other)
fn *(self Nat, other Bool) Nat: if other: self else: nat(0)
fn *(self Nat, other Nat) Nat: .__zig_mul_uint(other)
fn *(self Nat, other Int) Int: .int.__zig_mul_int(other)
fn /(self Nat, other Bool) Nat: .__zig_div_uint(other.nat)
fn /(self Nat, other Nat) Nat: .__zig_div_uint(other)
fn /(self Nat, other Int) Int: .int.__zig_div_int(other)

-- Int
fn bool Bool: self != 0
fn nat Nat: .__zig_int2nat
fn int Int: self
fn float Float: .__zig_int2float
fn string String: .__zig_int2string

fn ==(self Int, other Bool) Bool: .__zig_eq(other)
fn ==(self Int, other Nat) Bool: .__zig_eq(other)
fn ==(self Int, other Int) Bool: .__zig_eq(other)
fn !=(self Int, other Bool) Bool: .__zig_neq(other)
fn !=(self Int, other Nat) Bool: .__zig_neq(other)
fn !=(self Int, other Int) Bool: .__zig_neq(other)
fn <(self Int, other Bool) Bool: .__zig_lt(other.int)
fn <(self Int, other Nat) Bool: .__zig_lt(other.int)
fn <(self Int, other Int) Bool: .__zig_lt(other)
fn <=(self Int, other Bool) Bool: .__zig_lte(other.int)
fn <=(self Int, other Nat) Bool: .__zig_lte(other.int)
fn <=(self Int, other Int) Bool: .__zig_lte(other)
fn >(self Int, other Bool) Bool: .__zig_gt(other.int)
fn >(self Int, other Nat) Bool: .__zig_gt(other.int)
fn >(self Int, other Int) Bool: .__zig_gt(other)
fn >=(self Int, other Bool) Bool: .__zig_gte(other.int)
fn >=(self Int, other Nat) Bool: .__zig_gte(other.int)
fn >=(self Int, other Int) Bool: .__zig_gte(other)

fn -(self Int) Int: .__zig_neg_int
fn +(self Int, other Bool) Int: .__zig_add_int(other.int)
fn +(self Int, other Nat) Int: .__zig_add_int(other.int)
fn +(self Int, other Int) Int: .__zig_add_int(other)
fn -(self Int, other Bool) Int: .__zig_sub_int(other.int)
fn -(self Int, other Nat) Int: .__zig_sub_int(other.int)
fn -(self Int, other Int) Int: .__zig_sub_int(other)
fn *(self Int, other Bool) Int: .__zig_mul_int(other.int)
fn *(self Int, other Nat) Int: .__zig_mul_int(other.int)
fn *(self Int, other Int) Int: .__zig_mul_int(other)
fn /(self Int, other Bool) Int: .__zig_div_int(other.int)
fn /(self Int, other Nat) Int: .__zig_div_int(other.int)
fn /(self Int, other Int) Int: .__zig_div_int(other)

-- Float
fn int Int: .__zig_float2int
fn float Float: self
fn string String: .__zig_float2string

fn ==(self Float, other Float) Bool: .__zig_eq(other)
fn !=(self Float, other Float) Bool: .__zig_neq(other)
fn <(self Float, other Float) Bool: .__zig_lt(other)
fn <=(self Float, other Float) Bool: .__zig_lte(other)
fn >(self Float, other Float) Bool: .__zig_gt(other)
fn >=(self Float, other Float) Bool: .__zig_gte(other)

fn -(self Float) Float: .__zig_neg_float
fn +(self Float, other Float) Float: .__zig_add_float(other)
fn -(self Float, other Float) Float: .__zig_sub_float(other)
fn *(self Float, other Float) Float: .__zig_mul_float(other)
fn /(self Float, other Float) Float: .__zig_div_float(other)


-- Pointer[T]
-- static alloc Pointer[T]:
--     __zig_alloc[T](1).pointer

fn free[T](self Pointer[T], size: Nat):
   __zig_free(self.slice(size))

fn slice[T](self Pointer[T], size: Nat) Slice[T]:
   __zig_ptr2slice(self, size)


-- Slice[T]
-- static alloc(size: Nat) Slice[T]:
--     __zig_alloc(size)

fn pointer[T](self Slice[T]) Pointer[T]:
   .__zig_slice2ptr

fn free[T](self Slice[T]):
   .__zig_free

fn size[T](self Slice[T]) Nat:
   .__zig_slice_size


-- fn print[T Stringable](val: T):
--    __zig_print(val.string)

fn print(val String):
   __zig_print(val)

fn panic(str: String) -> Never:
   __zig_panic(str)

struct String
   bytes: Array[Byte]

fn ==(self String, other String) Bool:
   .bytes == other.bytes

fn string(self String) String: self

fn drop(self String):
   .bytes.drop[Byte]

struct Array[T]
   buffer: Slice[T]
   size: Nat

-- static new(size: Nat) Array[T]:
--     Array[T](__zig_alloc[T](size), 0)

fn drop[T](self Array[T]):
   .buffer.free
