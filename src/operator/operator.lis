#[equality]
pub enum Operator {
  Neg,
  Add,
  Sub,
  Mul,
  Div,
  Mod,
  Pow,
  Not,
  And,
  Or,
  Eq,
  Neq,
  Lt,
  Gt,
  Lte,
  Gte,
  Is,
  In,
  IsNot,
  NotIn,

  Let,
  Mut,
  MutBang,
  Var,

  Assign,
  AddAssign,
  SubAssign,
  MulAssign,
  DivAssign,
  ModAssign,
  PowAssign,
  AndAssign,
  OrAssign,
}

impl Operator {
  pub fn string(self) -> string {
    self.sigil()
  }

  pub fn is_unary(self) -> bool {
    match self {
      Neg | Not | Let | Mut | MutBang | Var => true,
      _ => false,
    }
  }

  pub fn is_binary(self) -> bool {
    !self.is_unary()
  }

  pub fn sigil(self) -> string {
    match self {
      Add => "+",
      Sub | Neg => "-",
      Mul => "*",
      Div => "/",
      Mod => "%",
      Pow => "^",
      Not => "not",
      And => "and",
      Or => "or",
      Eq => "==",
      Neq => "!=",
      Lt => "<",
      Gt => ">",
      Lte => "<=",
      Gte => ">=",
      Is => "is",
      In => "in",
      IsNot => "is not",
      NotIn => "not in",

      Let => "let",
      Mut => "mut",
      MutBang => "mut!",
      Var => "var",

      Assign => "=",
      AddAssign => "+=",
      SubAssign => "-=",
      MulAssign => "*=",
      DivAssign => "/=",
      ModAssign => "%=",
      PowAssign => "^=",
      AndAssign => "&=",
      OrAssign => "|=",
    }
  }

  pub fn precedence_class(self) -> Prec {
    match self {
      Or => Prec.Or,
      And => Prec.And,
      Is | IsNot | In | NotIn | Eq | Neq | Lt | Gt | Lte | Gte => Prec.Comparison,
      Add | Sub => Prec.Add,
      Mul | Div | Mod => Prec.Mul,
      Pow => Prec.Pow,
      Not | Neg | Let | Mut | MutBang | Var => Prec.Unary,
      // Comma => Prec.Comma,
      // Dot => Prec.Call,
      Assign |
      AddAssign |
      SubAssign |
      MulAssign |
      DivAssign |
      ModAssign |
      AndAssign |
      OrAssign |
      PowAssign => Prec.Assign,
    }
  }

  #[allow(match_same_arms)]
  pub fn relative_precedence(self, other: Operator) -> Bind {
    match (self.precedence_class(), other.precedence_class()) {
      (Call, _) => Bind.Tighter, // Call is highest, and left-associative
      (_, Call) => Bind.Looser,

      (Assign, Assign) => Bind.Looser, // right-associative
      (Unary, Assign) => Bind.Tighter, // comma is the only operator that works in the LHS of an assignment
      (_, Assign) => Bind.None, // everything else require
      (Assign, _) => Bind.Looser, // and tighter on the right
      (Comma, _) => Bind.Looser, // and comma binds looser than everything else
      (_, Comma) => Bind.Tighter,

      (Or, Or) => Bind.Tighter,
      (Or, Comparison) => Bind.Looser,
      (Or, Unary) => Bind.Looser,
      (Or, And) => Bind.None,
      (Or, Add) => Bind.None,
      (Or, Mul) => Bind.None,
      (Or, Pow) => Bind.None,
      (And, And) => Bind.Tighter,
      (And, Comparison) => Bind.Looser,
      (And, Unary) => Bind.Looser,
      (And, Or) => Bind.None,
      (And, Add) => Bind.None,
      (And, Mul) => Bind.None,
      (And, Pow) => Bind.None,
      (Comparison, Or) => Bind.Tighter,
      (Comparison, And) => Bind.Tighter,
      (Comparison, Comparison) => Bind.None,
      (Comparison, Add) => Bind.Looser,
      (Comparison, Mul) => Bind.Looser,
      (Comparison, Pow) => Bind.Looser,
      (Comparison, Unary) => Bind.Looser,
      (Add, Comparison) => Bind.Tighter,
      (Add, Add) => Bind.Tighter,
      (Add, Mul) => Bind.Looser,
      (Add, Pow) => Bind.Looser,
      (Add, Unary) => Bind.Looser,
      (Add, Or) => Bind.None,
      (Add, And) => Bind.None,
      (Mul, Comparison) => Bind.Tighter,
      (Mul, Add) => Bind.Tighter,
      (Mul, Mul) => Bind.Tighter,
      (Mul, Pow) => Bind.Looser,
      (Mul, Unary) => Bind.Looser,
      (Mul, Or) => Bind.None,
      (Mul, And) => Bind.None,
      (Pow, Comparison) => Bind.Tighter,
      (Pow, Add) => Bind.Tighter,
      (Pow, Mul) => Bind.Tighter,
      (Pow, Pow) => Bind.None,
      (Pow, Unary) => Bind.None,
      (Pow, Or) => Bind.None,
      (Pow, And) => Bind.None,
      (Unary, Pow) => Bind.None,
      (Unary, Unary) => Bind.None,
      (Unary, _) => Bind.Tighter,
    }
  }
}

pub enum Prec {
  Assign,
  Comma,
  Or,
  And,
  Comparison,
  Add,
  Mul,
  Pow,
  Unary,
  Call,
}

pub enum Bind {
  None,
  Tighter,
  Looser,
}
