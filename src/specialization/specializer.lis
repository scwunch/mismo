import dx "diagnostics"
import "ty"
import "ir"

pub fn specialize(reg: ir.Registry) -> Result<ConcreteRegistry, dx.SpecializationError> {
  let main = match reg.main {
    [main] => main,
    [] => Err(dx.NoMainFunctionError.new() as dx.SpecializationError)?,
    funs => Err(
      dx.MultipleMainFunctionsError.new(funs.map(|f| f.span)) as dx.SpecializationError,
    )?,
  }

  let mut spec = Specializer.new()
  let _ = spec.add_function(MonoMorphKey { fun: main, type_args: [] })

  spec.run()

  Ok(ConcreteRegistry { type_defs: reg.type_defs, functions: spec.functions })
}

#[display]
struct MonoMorphKey {
  fun: mut Ref<ir.FunctionDef>,
  type_args: Slice<ty.Type>,
}

impl MonoMorphKey {
  fn from_call(call: ir.Call) -> MonoMorphKey {
    MonoMorphKey { fun: call.fun, type_args: call.type_args as Slice<Type> }
  }

  fn equals(self, key: MonoMorphKey) -> bool {
    self.fun == key.fun && self.type_args.equals(key.type_args)
  }
}

type FuncAndTypeArgs = (int, Slice<Type>)

pub struct Specializer {
  queue: Slice<FuncAndTypeArgs>,
  functions: Slice<Function>,
  function_map: Cache,
  errors: Slice<error>,
}

impl Specializer {
  fn new() -> Specializer {
    Specializer {
      queue: [],
      functions: [],
      function_map: Cache.new(),
      errors: [],
    }
  }

  fn run(self: mut Ref<Specializer>) {
    while let Some(func) = self.queue.get(0) {
      // while self.queue.length() > 0 {
      // let func = self.queue[0]
      self.queue = self.queue[1..]
      self.specialize(func)
    }
  }

  fn specialize(self: mut Ref<Specializer>, item: FuncAndTypeArgs) {
    let mut func = self.functions[item.0]
    func.body = self.substitute(func.body, item.1)
    self.functions[item.0] = func
  }

  fn index_of(self: mut Ref<Specializer>, call: ir.FnCall) -> int {
    let call = MonoMorphKey.from_call(call)
    self.function_map.get(call).unwrap_or_else(|| self.add_function(call))
  }

  fn add_function(self: mut Ref<Specializer>, call: MonoMorphKey) -> int {
    let i = self.functions.length()
    let parameters = call.fun.parameters.map(|p| p.substitute(call.type_args))
    let return_type = call.fun.return_type.substitute(call.type_args)
    self.functions = self.functions.append(
      Function {
        span: call.fun.span,
        name: call.fun.name,
        parameters,
        return_type,
        body: call.fun.body,
      },
    )
    self.function_map.insert(call, i)
    let item: FuncAndTypeArgs = (i, call.type_args as Slice<Type>)
    self.queue = self.queue.append(item)
    i
  }

  fn substitute(
    self: mut Ref<Specializer>,
    expr: Expression,
    type_args: Slice<Type>,
  ) -> Expression {
    let kind = match expr.kind {
      Call(call) => {
        let i = self.index_of(call)
        ir.Expr.ConcreteCall(i, call.args.map(|a| self.substitute(a, type_args)))
      },
      ArrayLiteral(exprs, t) => {
        ir.Expr.ArrayLiteral(exprs.map(|e| self.substitute(e, type_args)), t)
      },
      TupleLiteral(exprs) => {
        ir.Expr.TupleLiteral(exprs.map(|e| self.substitute(e, type_args)))
      },
      Closure(closure) => ir.Expr.Closure(
        ir.Closure {
          env: closure.env,
          params: closure.params.map(|p| p.substitute(type_args)),
          ret_type: closure.ret_type.substitute(type_args),
          body: &self.substitute(closure.body.*, type_args),
        },
      ),
      Identifier(id) => ir.Expr.Identifier(id), // HMM: do we need to change the type of `Variable` id?
      Declare(mode, id, value) => ir.Expr.Declare(
        mode,
        id,
        &self.substitute(value.*, type_args),
      ),
      Assign(id, expr) => ir.Expr.Assign(id, &self.substitute(expr.*, type_args)),
      Binding(m, expr) => ir.Expr.Binding(m, &self.substitute(expr.*, type_args)),
      SwitchIf(cases) => {
        ir.Expr.SwitchIf(ir.SwitchIf.new(cases.cases.map(|case| (
          self.substitute(case.0, type_args),
          self.substitute(case.1, type_args),
        ))))
      },
      Match(cases) => ir.Expr.Match(ir.Match.new(
        &self.substitute(cases.subject.*, type_args),
        cases.cases.map(|case| {
          ir.MatchArm.new(
            self.substitute(case.pattern, type_args),
            self.substitute(case.expr, type_args),
          )
        }),
      )),
      Loop(exprs, t) => ir.Expr.Loop(
        exprs.map(|e| self.substitute(e, type_args)),
        t,
      ),
      Block(exprs, t) => ir.Expr.Block(
        exprs.map(|e| self.substitute(e, type_args)),
        t,
      ),
      Return(Some(expr)) => ir.Expr.Return(Some(
        &self.substitute(expr.*, type_args),
      )),
      Break(Some(expr)) => ir.Expr.Return(Some(&self.substitute(expr.*, type_args))),
      FieldAccess(obj, i) => ir.Expr.FieldAccess(
        &self.substitute(obj.*, type_args),
        i,
      ),
      ConcreteCall(_, _) => panic(
        "compiler bug 134: concrete call should not exist yet in specializer",
      ),
      Constructor(typ, args) => ir.Expr.Constructor(
        typ.substitute(type_args),
        args,
      ),
      Nil |
      BoolLiteral(_) |
      IntLiteral(_) |
      FloatLiteral(_) |
      StringLiteral(_) |
      Return(None) |
      Break(None) |
      Continue |
      Extern => expr.kind,
    }
    Expression.new(expr.span, kind)
  }

  fn error(self: mut Ref<Specializer>, e: error) {
    self.errors = self.errors.append(e)
  }
}

pub struct ConcreteRegistry {
  pub type_defs: Map<string, Ref<ty.TypeDef>>,
  pub functions: Slice<Function>,
}
