import "errors"
import "semantic"

type Expr = semantic.Expr

pub fn specialize(reg: semantic.TypeEnv) -> Result<ConcreteRegistry, errors.SpecializationError> {
  let main = match reg.signatures.get("main") {
    Some([main]) => main,
    Some(funs) => Err(
      errors.MultipleMainFunctionsError.new(funs.map(|f| f.span)) as errors.SpecializationError,
    )?,
    None => Err(errors.NoMainFunctionError.new() as errors.SpecializationError)?,
  }

  let mut spec = Specializer.new()
  let _ = spec.add_function(MonoMorphKey { fun: main, type_args: [] })

  spec.run()

  Ok(ConcreteRegistry { type_defs: reg.type_defs, functions: spec.functions })
}

#[display]
struct MonoMorphKey {
  fun: Ref<semantic.FunctionDef>,
  type_args: Slice<semantic.Type>,
}

impl MonoMorphKey {
  fn from_call(call: semantic.FnCall) -> MonoMorphKey {
    MonoMorphKey { fun: call.fun, type_args: call.type_args as Slice<Type> }
  }

  fn equals(self, key: MonoMorphKey) -> bool {
    self.fun == key.fun && self.type_args.equals(key.type_args)
  }
}

type FuncAndTypeArgs = (int, Slice<Type>)

pub struct Specializer {
  queue: Slice<FuncAndTypeArgs>,
  functions: Slice<Function>,
  function_map: Cache,
  errors: Slice<error>,
}

impl Specializer {
  fn new() -> Specializer {
    Specializer { 
      queue: [],
      functions: [],
      function_map: Cache.new(),
      errors: [],
    }
  }

  fn run(self: Ref<Specializer>) {
    while !self.queue.is_empty() {
      let func = self.queue[0]
      self.queue = self.queue[1..]
      self.specialize(func)
    }
  }

  fn specialize(self: Ref<Specializer>, item: FuncAndTypeArgs) {
    let mut func = self.functions[item.0]
    func.body = self.substitute(func.body, item.1)
    self.functions[item.0] = func
  }

  fn index_of(self: Ref<Specializer>, call: semantic.FnCall) -> int {
    let call = MonoMorphKey.from_call(call)
    self.function_map.get(call).unwrap_or_else(|| self.add_function(call))
  }

  fn add_function(self: Ref<Specializer>, call: MonoMorphKey) -> int {
    let i = self.functions.length()
    let parameters = call.fun.parameters.map(|p| p.substitute(call.type_args))
    let return_type = call.fun.return_type.substitute(call.type_args)
    self.functions = self.functions.append(
      Function { 
        span: call.fun.span,
        name: call.fun.name,
        parameters,
        return_type,
        body: call.fun.body,
      },
    )
    self.function_map.insert(call, i)
    let item: FuncAndTypeArgs = (i, call.type_args as Slice<Type>)
    self.queue = self.queue.append(item)
    i
  }

  fn substitute(
    self: Ref<Specializer>,
    expr: Expression,
    type_args: Slice<Type>,
  ) -> Expression {
    let kind = match expr.kind {
      Call(call) => {
        let i = self.index_of(call)
        Expr.ConcreteCall(i, call.args.map(|a| self.substitute(a, type_args)))
      },
      ArrayLiteral(exprs, t) => {
        Expr.ArrayLiteral(exprs.map(|e| self.substitute(e, type_args)), t)
      },
      TupleLiteral(exprs) => {
        Expr.TupleLiteral(exprs.map(|e| self.substitute(e, type_args)))
      },
      Identifier(id) => Expr.Identifier(id), // HMM: do we need to change the type of `Variable` id?
      Assign(id, expr) => Expr.Assign(id, &self.substitute(expr.*, type_args)),
      Binding(m, expr) => Expr.Binding(m, &self.substitute(expr.*, type_args)),
      SwitchIf(cases) => {
        Expr.SwitchIf(semantic.SwitchIf.new(cases.cases.map(|case| (
          self.substitute(case.0, type_args),
          self.substitute(case.1, type_args),
        ))))
      },
      Match(cases) => Expr.Match(semantic.Match.new(
        &self.substitute(cases.subject.*, type_args),
        cases.cases.map(|case| {
          semantic.MatchCase.new(
            self.substitute(case.pattern, type_args),
            self.substitute(case.expr, type_args),
          )
        }),
      )),
      Loop(exprs, t) => Expr.Loop(
        exprs.map(|e| self.substitute(e, type_args)),
        t,
      ),
      Block(exprs, t) => Expr.Block(
        exprs.map(|e| self.substitute(e, type_args)),
        t,
      ),
      Return(Some(expr)) => Expr.Return(Some(
        &self.substitute(expr.*, type_args),
      )),
      Break(Some(expr)) => Expr.Return(Some(&self.substitute(expr.*, type_args))),
      FieldAccess(obj, i) => Expr.FieldAccess(
        &self.substitute(obj.*, type_args),
        i,
      ),
      ConcreteCall(_, _) => panic(
        "compiler bug 134: concrete call should not exist yet in specializer",
      ),
      Constructor(typ, args) => Expr.Constructor(
        typ.substitute(type_args),
        args,
      ),
      Nil |
      BoolLiteral(_) |
      IntLiteral(_) |
      FloatLiteral(_) |
      StringLiteral(_) |
      Return(None) |
      Break(None) |
      Continue |
      Extern => expr.kind,
    }
    Expression.new(expr.span, kind)
  }

  fn error(self: Ref<Specializer>, e: error) {
    self.errors = self.errors.append(e)
  }
}

pub struct ConcreteRegistry {
  pub type_defs: Map<string, Ref<semantic.TypeDef>>,
  pub functions: Slice<Function>,
}
