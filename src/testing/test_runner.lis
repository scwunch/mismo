import "go:fmt"
import "go:os"

pub fn test(
  test_name: string,
  test_fn: fn(Ref<TestRunner>) -> Result<(), string>,
) -> TestRunner {
  let t = TestRunner.new(test_name)
  if let Err(e) = test_fn(&t) { fmt.Println(e) }
  t
}

pub fn test_suite(
  suite_name: string,
  tests: Slice<fn(mut Ref<TestRunner>) -> Result<(), string>>,
) -> bool {
  fmt.Println(f"Test suite: {suite_name}")
  let num_tests = tests.length()
  let mut suite: Slice<TestRunner> = []
  for test_fn in tests {
    let mut t = TestRunner.new("")
    if let Err(e) = test_fn(&t) {
      fmt.Println(f"{t.test_name} failed: {e}")
      t.status = false
    }
    suite = suite.append(t)
  }
  let mut passed = 0
  for t in suite {
    if t.passed() { passed += 1 }
  }
  if passed == num_tests {
    fmt.Println(f"All {num_tests} tests passed!")
    true
  } else {
    fmt.Println(f"{passed} out of {num_tests} tests passed.")
    false
  }
}

pub struct TestFailure { msg: string }

impl TestFailure {
  pub fn Error(self) -> string {
    self.msg
  }
}

pub struct TestRunner {
  pub test_name: string,
  status: bool,
  pub panic_on_fail: bool,
}

impl TestRunner {
  pub fn new(test_name: string) -> TestRunner {
    TestRunner { test_name, status: true, panic_on_fail: false }
  }

  pub fn passed(self) -> bool {
    self.status
  }

  pub fn fail(self: mut Ref<TestRunner>, msg: string) -> Result<(), string> {
    if self.panic_on_fail { panic(f"{self.test_name} failed: msg") }
    self.status = false
    Err(msg)
  }

  pub fn should_eq<A: Equatable<A, B>, B: Equatable<B, A>>(
    self: mut Ref<TestRunner>,
    val: A,
    expected: B,
  ) -> Result<(), string> {
    if val.equals(expected) {
      Ok(())
    } else {
      self.fail(f"\n  Expected: {expected};\n    Actual: {val}")
    }
  }

  pub fn should_eq_repr<A, B>(self: mut Ref<TestRunner>, val: A, expected: B) -> Result<(), string> {
    if f"{val}" == f"{expected}" {
      Ok(())
    } else {
      self.fail(f"Expected \"{expected}\"; got \"{val}\"")
    }
  }

  pub fn should_contain<A: Equatable<A, B>, B>(
    self: mut Ref<TestRunner>,
    collection: Slice<A>,
    expected: B,
  ) -> Result<(), string> {
    for a in collection {
      if a.equals(expected) { return Ok(()) }
    }
    self.fail(f"Expected \"{expected}\" to be in \"{collection}\"")
  }

  pub fn shouldnt_eq<A: Equatable<A, B>, B: Equatable<B, A>>(
    self: mut Ref<TestRunner>,
    val: A,
    expected: B,
  ) -> Result<(), string> {
    if val.equals(expected) {
      self.fail(f"Expected {val} to not be {expected}")
    } else {
      Ok(())
    }
  }

  pub fn should_be_true(self: mut Ref<TestRunner>, cond: bool, error_msg: string) -> Result<(), string> {
    if cond { Ok(()) } else { self.fail(error_msg) }
  }

  pub fn should_be_false(self: mut Ref<TestRunner>, cond: bool, error_msg: string) -> Result<(), string> {
    if !cond { Ok(()) } else { self.fail(error_msg) }
  }
}

pub interface Equatable<T: Equatable<T, Other>, Other: Equatable<Other, T>> {
  fn equals(other: Other) -> bool
}

pub interface Testable<T> {
  fn should_eq(expected: T, t: TestRunner) -> Result<(), string>
}

pub interface Contains<T> {
  fn contains(needle: T) -> bool
}

pub fn debug(msg: string) {
  fmt.Println(msg)
  // Append message to a local file
  if let Ok(f) = os.OpenFile(
    "../../output.log",
    os.O_APPEND | os.O_CREATE | os.O_WRONLY,
    0o644,
  ) {
    match f.WriteString(msg + "\n") {
      Ok(_) => (),
      Err(e) => panic(e),
      Both(_, e) => panic(e),
    }
    f.Close()
  } else {
    panic("could not open `output.log` file")
  }
}
