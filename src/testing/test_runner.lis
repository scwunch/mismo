import "go:fmt"

pub fn test(test_name: string, test_fn: fn(Ref<TestRunner>)) -> TestRunner {
  let t = TestRunner.new(test_name)
  test_fn(&t)
  t
}

pub fn test_suite(suite_name: string, tests: Slice<fn(Ref<TestRunner>)>) -> bool {
  fmt.Println(f"Test suite: {suite_name}")
  let num_tests = tests.length()
  let mut suite: Slice<TestRunner> = []
  for test_fn in tests {
    let t = TestRunner.new("")
    test_fn(&t)
    suite = suite.append(t)
  }
  let mut passed = 0
  for t in suite {
    if t.passed() {
      passed += 1
    }
  }
  if passed == num_tests {
    fmt.Println(f"All {num_tests} tests passed!")
    true
  } else {
    fmt.Println(f"{passed} out of {num_tests} tests passed.")
    false
  }
  false
}

pub struct TestRunner {
  pub test_name: string,
  status: bool,
}
impl TestRunner {
  pub fn new(test_name: string) -> TestRunner { 
    TestRunner{test_name, status: true} 
  }

  pub fn passed(self) -> bool { self.status }

  pub fn fail(self: Ref<TestRunner>, msg: string) {
    self.status = false
    fmt.Println(f"{self.test_name} failed: {msg}")
  }
  
  pub fn should_eq<A: Equatable<A, B>, B: Equatable<B, A>>(
      self: Ref<TestRunner>, val: A, expected: B) {
    if !val.eq(expected) {
      self.fail(f"Expected {expected}, got {val}")
    }
  }

  pub fn should_contain<A: Contains<B>, B>(
      self: Ref<TestRunner>, 
      val:  A,  
      expected: B) {
    if !val.contains(expected) {
      self.fail(f"Expected \"{expected}\" to be in \"{val}\"")
    }
  }

  pub fn shouldnt_eq<A: Equatable<A, B>, B: Equatable<B, A>>(
      self: Ref<TestRunner>, val: A, expected: B) {
    if val.eq(expected) {
      self.fail(f"Expected valueto not be {expected}")
    }
  }

  pub fn should_be_true(self: Ref<TestRunner>, cond: bool, error_msg: string) {
    if !cond  {
      self.fail(error_msg)
    }
  }
  pub fn should_be_false(self: Ref<TestRunner>, cond: bool, error_msg: string) {
    if cond  {
      self.fail(error_msg)
    }
  }
}

pub interface Equatable<Self: Equatable<Self, Other>, Other: Equatable<Other, Self>> {
  fn eq(self, other: Other) -> bool
}

pub interface Testable<Self> {
  fn should_eq(self, expected: Self, t: TestRunner)
}

pub interface Contains<T> {
  fn contains(self, needle: T) -> bool
}