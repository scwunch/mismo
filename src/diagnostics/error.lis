pub struct NoMainFunctionError {}

impl NoMainFunctionError {
  pub fn new() -> NoMainFunctionError {
    NoMainFunctionError {}
  }

  pub fn code(self) -> int {
    4001
  }

  pub fn message(self) -> string {
    "No main function found."
  }

  pub fn span(self) -> Span {
    span.new(0, 0)
  }
}

pub struct MultipleMainFunctionsError { spans: Slice<Span> }

impl MultipleMainFunctionsError {
  pub fn new(spans: Slice<Span>) -> MultipleMainFunctionsError {
    MultipleMainFunctionsError { spans }
  }

  pub fn code(self) -> int {
    4002
  }

  pub fn message(self) -> string {
    f"Multiple main function found: {self.spans}"
  }

  pub fn span(self) -> Span {
    self.spans[0]
  }
}

