pub struct TypeParameterArityError {
  pub _s_: Span,
  pub name: string,
  pub expected: int,
  pub actual: int,
}

impl TypeParameterArityError {
  pub fn new(span: Span, name: string, expected: int, actual: int) -> TypeParameterArityError {
    TypeParameterArityError { _s_: span, name, expected, actual }
  }

  pub fn code(self) -> int {
    2003
  }

  pub fn message(self) -> string {
    f"\"{self.name}\" expects {self.expected} type arguments but {self.actual} were provided"
  }

  pub fn span(self) -> Span {
    self._s_
  }
}

pub struct NoMatchError {
  pub _s_: Span,
  pub errs: Slice<(string, TypeError)>,
}

impl NoMatchError {
  pub fn new(span: Span, errs: Slice<(string, TypeError)>) -> NoMatchError {
    NoMatchError { _s_: span, errs }
  }

  pub fn code(self) -> int {
    2102
  }

  pub fn message(self) -> string {
    let errs = self.errs.map(|fun| f"{fun.0}: {fun.1.message()}").join("\n\t")
    f"No matching overloads found.  Errors:\n\t{errs}"
  }

  pub fn span(self) -> Span {
    self._s_
  }
}

pub struct AmbiguousFunctionCallError {
  pub _s_: Span,
  pub calls: Slice<string>,
}

impl AmbiguousFunctionCallError {
  pub fn new(span: Span, calls: Slice<string>) -> AmbiguousFunctionCallError {
    AmbiguousFunctionCallError { _s_: span, calls }
  }

  pub fn code(self) -> int {
    2103
  }

  fn span(self) -> Span {
    self._s_
  }

  fn message(self) -> string {
    let alts = self.calls.join("\n")
    f"Cannot determine single best overload from alternatives: {alts}"
  }
}

