import "operator"
import "span"

pub type Operator = operator.Operator

pub type Span = span.Span

pub struct Token {
  pub span: Span,
  pub kind: TokenKind,
}

pub enum TokenKind {
  Nil,
  Bool(bool),
  IntLiteral(int),
  FloatLiteral(float64),
  StringLiteral(string),
  Identifier(string),
  LeftParen,
  RightParen,
  LeftBrace,
  RightBrace,
  LeftBracket,
  RightBracket,
  Dot,
  Comma,
  Colon,
  NamespaceSeparator,
  Semicolon,
  Arrow,
  Newline(uint32, rune),
  Let,
  Var,
  Mut,
  MutBang,
  Move,
  If,
  For,
  While,
  Break,
  Continue,
  Return,
  Operator(Operator),
  Tilde,
  Bang,
  At,
  Hashtag,
  Dollarsign,
  Percent,
  Caret,
  Ampersand,
  Star,
  Plus,
  Minus,
  Equals,
  Pipe,
  Backslash,
  LessThan,
  GreaterThan,
  Question,
  Slash,
  EOF,
  Error(string),
}

impl TokenKind {
  pub fn string(self) -> string {
    match self {
      Nil => "nil",
      Bool(b) => f"{b}",
      IntLiteral(i) => f"{i}",
      FloatLiteral(f) => f"{f}",
      StringLiteral(s) => s,
      Identifier(ident) => ident,
      LeftParen => "(",
      RightParen => ")",
      LeftBrace => "{",
      RightBrace => "}",
      LeftBracket => "[",
      RightBracket => "]",
      Dot => ".",
      Comma => ",",
      Colon => ":",
      NamespaceSeparator => "::",
      Semicolon => ";",
      Arrow => "->",
      Newline(indent, c) => f"\\n({indent}{c})",
      Let => "let",
      Var => "var",
      Mut => "mut",
      MutBang => "mut!",
      Move => "move",
      If => "if",
      For => "for",
      While => "while",
      Break => "break",
      Continue => "continue",
      Return => "return",
      Operator(op) => f"{op}",
      Tilde => "~",
      Bang => "!",
      At => "@",
      Hashtag => "#",
      Dollarsign => "$",
      Percent => "%",
      Caret => "^",
      Ampersand => "&",
      Star => "*",
      Plus => "+",
      Minus => "-",
      Equals => "=",
      Pipe => "|",
      Backslash => "\\",
      LessThan => "<",
      GreaterThan => ">",
      Question => "?",
      Slash => "/",
      EOF => "EOF",
      Error(err) => f"Error({err})",
    }
  }
}

impl Token {
  pub fn new(span: Span, kind: TokenKind) -> Token {
    Token { span, kind }
  }

  pub fn string(self) -> string {
    f"Token({self.span} {self.kind})"
  }

  // ===============
  //  constructors
  // ===============
  pub fn nil(start: uint32, end: uint32) -> Token {
    Token.new(Span { start, end }, TokenKind.Nil)
  }

  pub fn bool(start: uint32, end: uint32, val: bool) -> Token {
    Token.new(Span { start, end }, TokenKind.Bool(val))
  }

  pub fn int(start: uint32, end: uint32, val: int) -> Token {
    Token.new(Span { start, end }, TokenKind.IntLiteral(val))
  }

  pub fn float(start: uint32, end: uint32, val: float64) -> Token {
    Token.new(Span { start, end }, TokenKind.FloatLiteral(val))
  }

  pub fn identifier(start: uint32, end: uint32, val: string) -> Token {
    Token.new(Span { start, end }, TokenKind.Identifier(val))
  }

  pub fn left_paren(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.LeftParen)
  }

  pub fn right_paren(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.RightParen)
  }

  pub fn left_brace(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.LeftBrace)
  }

  pub fn right_brace(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.RightBrace)
  }

  pub fn left_bracket(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.LeftBracket)
  }

  pub fn right_bracket(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.RightBracket)
  }

  pub fn dot(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.Dot)
  }

  pub fn comma(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.Comma)
  }

  pub fn semicolon(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.Semicolon)
  }

  pub fn arrow(start: uint32) -> Token {
    Token.new(Span { start, end: start + 2 }, TokenKind.Arrow)
  }

  pub fn operator(start: uint32, end: uint32, operator: Operator) -> Token {
    Token.new(Span { start, end }, TokenKind.Operator(operator))
  }

  pub fn plus(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.Plus)
  }

  pub fn minus(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.Minus)
  }

  pub fn star(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.Star)
  }

  pub fn slash(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.Slash)
  }

  pub fn equals_(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.Equals)
  }

  pub fn eof(start: uint32) -> Token {
    Token.new(Span { start, end: start }, TokenKind.EOF)
  }

  pub fn string_literal(start: uint32, end: uint32, val: string) -> Token {
    Token.new(Span { start, end }, TokenKind.StringLiteral(val))
  }

  pub fn colon(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.Colon)
  }

  pub fn namespace_separator(start: uint32) -> Token {
    Token.new(Span { start, end: start + 2 }, TokenKind.NamespaceSeparator)
  }

  pub fn newline(start: uint32, end: uint32, indent: uint32, next_char: rune) -> Token {
    Token.new(Span { start, end }, TokenKind.Newline(indent, next_char))
  }

  pub fn tilde(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.Tilde)
  }

  pub fn bang(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.Bang)
  }

  pub fn at(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.At)
  }

  pub fn hashtag(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.Hashtag)
  }

  pub fn dollar(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.Dollarsign)
  }

  pub fn percent(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.Percent)
  }

  pub fn caret(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.Caret)
  }

  pub fn ampersand(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.Ampersand)
  }

  pub fn pipe(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.Pipe)
  }

  pub fn backslash(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.Backslash)
  }

  pub fn less_than(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.LessThan)
  }

  pub fn greater_than(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.GreaterThan)
  }

  pub fn question(start: uint32) -> Token {
    Token.new(Span { start, end: start + 1 }, TokenKind.Question)
  }

  pub fn let_(start: uint32, end: uint32) -> Token {
    Token.new(Span { start, end }, TokenKind.Let)
  }

  pub fn var_(start: uint32, end: uint32) -> Token {
    Token.new(Span { start, end }, TokenKind.Var)
  }

  pub fn mut_(start: uint32, end: uint32) -> Token {
    Token.new(Span { start, end }, TokenKind.Mut)
  }

  pub fn mut_bang(start: uint32, end: uint32) -> Token {
    Token.new(Span { start, end }, TokenKind.MutBang)
  }

  pub fn move_(start: uint32, end: uint32) -> Token {
    Token.new(Span { start, end }, TokenKind.Move)
  }

  pub fn if_(start: uint32, end: uint32) -> Token {
    Token.new(Span { start, end }, TokenKind.If)
  }

  pub fn for_(start: uint32, end: uint32) -> Token {
    Token.new(Span { start, end }, TokenKind.For)
  }

  pub fn while_(start: uint32, end: uint32) -> Token {
    Token.new(Span { start, end }, TokenKind.While)
  }

  pub fn break_(start: uint32, end: uint32) -> Token {
    Token.new(Span { start, end }, TokenKind.Break)
  }

  pub fn continue_(start: uint32, end: uint32) -> Token {
    Token.new(Span { start, end }, TokenKind.Continue)
  }

  pub fn return_(start: uint32, end: uint32) -> Token {
    Token.new(Span { start, end }, TokenKind.Return)
  }

  pub fn error(start: uint32, end: uint32, msg: string) -> Token {
    Token.new(Span { start, end }, TokenKind.Error(msg))
  }
}
