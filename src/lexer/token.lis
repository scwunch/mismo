pub enum Token {
  Identifier(string),
  IntLiteral(int),
  FloatLiteral(float64),
  LeftParen,
  RightParen,
  LeftBrace,
  RightBrace,
  Comma,
  Semicolon,
  Plus,
  Minus,
  Star,
  Slash,
  Equals,
  EOF,
}
