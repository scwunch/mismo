import "span"
import "testing"

pub fn test() {
  let _ = testing.test_suite(
    "Lexer",
    [
      test_token_equality,
      test_peek_next_char,
      test_read_word,
      test_read_number,
      test_read_single_line_string,
      test_read_multiline_string,
      test_operators,
      test_keywords_and_operators,
      test_comments,
      test_newlines,
      test_full_program,
    ],
  )
}

impl TokenKind {
  pub fn eq(self, other: TokenKind) -> bool {
    self == other
  }
}

impl Token {
  pub fn eq(self, other: Token) -> bool {
    self == other
  }
}

fn test_token_equality(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Lexer Token Equality"
  let tok1 = TokenKind.LeftParen
  let tok2 = TokenKind.LeftParen
  let tok3 = TokenKind.RightParen
  t.should_eq(tok1, tok2)?
  t.shouldnt_eq(tok1, tok3)?

  t.should_eq(Token.left_brace(0), Token.left_brace(0))?
  t.shouldnt_eq(Token.left_brace(0), Token.right_brace(0))?
  t.shouldnt_eq(Token.left_brace(0), Token.left_brace(99))
}

fn test_peek_next_char(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Lexer Peek/Next Char"
  let lex = Lexer.new("hello")
  t.should_be_true(
    lex.peek_char() == 'h',
    f"expected 'h', got {lex.peek_char()}",
  )?
  let c2 = lex.peek_char_at(1)
  t.should_be_true(c2 == 'e', f"expected 'e', got {c2}")?
  let c3 = lex.peek_char_at(5)
  t.should_be_true(c3 == 0 as rune, f"expected 0, got {c3}")
}

fn test_read_word(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Lexer Read Word"
  let mut lex = Lexer.new("let x = 5")
  let tok = lex.read_word()
  t.should_eq(tok.kind, TokenKind.Let)?
  t.should_eq(tok.span, Span.new(0, 3))?

  t.should_be_true(lex.peek_char() == ' ', "expected space after `let`")?
  lex.index += 1

  let tok2 = lex.read_word()
  t.should_eq(tok2, Token.identifier(4, 5, "x"))?

  t.should_be_true(lex.peek_char() == ' ', "expected space after `x`")?

  lex = Lexer.new("mut! foo")
  t.should_eq(lex.read_word(), Token.mut_bang(0, 4))?
  t.should_be_true(lex.peek_char() == ' ', "expected space after `mut!`")?
  lex.index += 1
  t.should_eq(lex.read_word(), Token.identifier(5, 8, "foo"))?
  Ok(())
}

fn test_read_number(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Lexer Read Number"
  let mut lex = Lexer.new("42")
  let tok = lex.next()
  match tok.kind {
    TokenKind.IntLiteral(n) => {
      if n != 42 { t.fail(f"expected 42, got {n}")? }
    },
    _ => t.fail(f"expected int, got {tok.kind}")?,
  }

  let mut lex2 = Lexer.new("0.0001")
  let tok2 = lex2.next()
  match tok2.kind {
    TokenKind.FloatLiteral(f) => {
      if f != 0.0001 { t.fail(f"expected 0.0001, got {f}")? }
    },
    _ => t.fail(f"expected float, got {tok2.kind}")?,
  }

  let mut lex3 = Lexer.new("42_000")
  let tok3 = lex3.next()
  match tok3.kind {
    TokenKind.IntLiteral(n) => {
      if n != 42000 { t.fail(f"expected 42000, got {n}")? }
    },
    _ => t.fail(f"expected int, got {tok3.kind}")?,
  }

  let mut lex4 = Lexer.new("456.789_012")
  let tok4 = lex4.next()
  match tok4.kind {
    TokenKind.FloatLiteral(f) => {
      if f != 456.789012 { t.fail(f"expected 456.789012, got {f}")? }
    },
    _ => t.fail(f"expected float 456.789_012, got {tok4.kind}")?,
  }
  Ok(())
}

fn test_operators(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Lexer Operators"
  t.should_eq(
    Lexer.new("+").read_operator().kind,
    TokenKind.Operator(Operator.Add),
  )?

  t.should_eq(
    Lexer.new("+=").read_operator().kind,
    TokenKind.Operator(Operator.AddAssign),
  )?

  t.should_eq(
    Lexer.new("*=").read_operator().kind,
    TokenKind.Operator(Operator.MulAssign),
  )?

  t.should_eq(
    Lexer.new("=").read_operator().kind,
    TokenKind.Operator(Operator.Assign),
  )?

  t.should_eq(
    Lexer.new("&").read_operator().kind,
    TokenKind.Operator(Operator.And),
  )
}

fn test_keywords_and_operators(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Lexer Keywords and Word Operators"
  let mut lex = Lexer.new("and or not is in")
  let tok = lex.next()
  match tok.kind {
    TokenKind.Operator(Operator.And) => (),
    _ => t.fail(f"expected 'and' operator, got {tok.kind}")?,
  }
  let tok2 = lex.next()
  match tok2.kind {
    TokenKind.Operator(Operator.Or) => (),
    _ => t.fail(f"expected 'or' operator, got {tok2.kind}")?,
  }
  let tok3 = lex.next()
  match tok3.kind {
    TokenKind.Operator(Operator.Not) => (),
    _ => t.fail(f"expected 'not' operator, got {tok3.kind}")?,
  }
  let tok4 = lex.next()
  match tok4.kind {
    TokenKind.Operator(Operator.Is) => (),
    _ => t.fail(f"expected 'is' operator, got {tok4.kind}")?,
  }
  let tok5 = lex.next()
  match tok5.kind {
    TokenKind.Operator(Operator.In) => (),
    _ => t.fail(f"expected 'in' operator, got {tok5.kind}")?,
  }
  Ok(())
}

fn test_comments(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Lexer Comments"
  let mut lex = Lexer.new("-- this is a comment\nhello")
  let tok = lex.next()
  match tok.kind {
    TokenKind.Newline(0, 'h') => (),
    _ => t.fail(f"expected newline, got {tok.kind}")?,
  }
  let tok2 = lex.next()
  match tok2.kind {
    TokenKind.Identifier("hello") => (),
    _ => t.fail(f"expected identifier 'hello', got {tok2.kind}")?,
  }
  Ok(())
}

fn test_full_program(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Lexer Full Program"
  let mut lex = Lexer.new(
    "function greet(name String):\n  print(\"hello, \" + name)",
  )
  let toks = [
    Token.identifier(0, 8, "function"),
    Token.identifier(9, 14, "greet"),
    Token.left_paren(14),
    Token.identifier(15, 19, "name"),
    Token.identifier(20, 26, "String"),
    Token.right_paren(26),
    Token.colon(27),
    Token.newline(28, 31, 2, 'p'),
    Token.identifier(31, 36, "print"),
    Token.left_paren(36),
    Token.string_literal(37, 46, "hello, "),
    Token.operator(47, 48, Operator.Add),
    Token.identifier(49, 53, "name"),
    Token.right_paren(53),
    // Token.newline(54, 55, 0),
    Token.eof(54),
  ]

  for expected in toks {
    t.should_eq(lex.next(), expected)?
  }
  Ok(())
}

fn test_read_single_line_string(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Lexer String Literals (single-line)"
  // empty strings
  let mut tok = Lexer.new("\"\" + other content").read_string()
  t.should_eq(tok, Token.string_literal(0, 2, ""))?
  tok = Lexer.new("'' + other content").read_string()
  t.should_eq(tok, Token.string_literal(0, 2, ""))?
  tok = Lexer.new("`` + other content").read_string()
  t.should_eq(tok, Token.string_literal(0, 2, ""))?

  // normal strings
  tok = Lexer.new("\"hello\" + other content").read_string()
  t.should_eq(tok, Token.string_literal(0, 7, "hello"))?
  tok = Lexer.new("'hello' + other content").read_string()
  t.should_eq(tok, Token.string_literal(0, 7, "hello"))?
  tok = Lexer.new("`hello` + other content").read_string()
  t.should_eq(tok, Token.string_literal(0, 7, "hello"))?

  // with escapes
  tok = Lexer.new("\"say \\\"hello\\\"\" + other content").read_string()
  t.should_eq(tok, Token.string_literal(0, 15, "say \"hello\""))?
  tok = Lexer.new("'\\n\\t\\\\'").read_string()
  t.should_eq(tok, Token.string_literal(0, 8, "\n\t\\"))?

  // raw strings
  tok = Lexer.new("`\"\\w\"+\\s*\\`").read_string()
  t.should_eq(tok, Token.string_literal(0, 11, "\"\\w\"+\\s*\\"))?
  Ok(())
}

fn test_read_multiline_string(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Lexer String Literals (multiline)"

  // validate open quote
  let mut lex = Lexer.new("'''  \t  \nhello\n'''")
  lex.index = 3
  t.should_be_true(
    lex.validate_open_quote(0).is_ok(),
    "expected whitespace validation to succeed",
  )?
  lex = Lexer.new("'''  multline string on one line '''")
  lex.index = 3
  t.should_eq(
    lex
      .validate_open_quote(0)
      .err()
      .unwrap_or(Token.error(0, 0, "this is not the droid you're looking for")),
    Token.error(
      0,
      5,
      "Multiline string literals start on line after opening quote.",
    ),
  )?
  lex.index = 0
  t.should_eq(
    lex.next(),
    Token.error(
      0,
      5,
      "Multiline string literals start on line after opening quote.",
    ),
  )?

  // get_string_lines
  lex = Lexer.new("'''\n   unterminated''")
  t.should_eq(lex.next(), Token.error(0, 21, "unterminated string literal"))?
  lex = Lexer.new("'''\n  mali'''")
  lex.index = 4
  t.should_eq(
    lex
      .get_string_lines(0, '\'', 3)
      .err()
      .unwrap_or(Token.error(0, 0, "this is not the droid you're looking for")),
    Token.error(
      4,
      13,
      "Only whitespace is allowed before the endquote of a multiline string literal.",
    ),
  )?
  lex = Lexer.new("'''\n   line1\n   line2\n   '''")
  lex.index = 4
  let (lines, indent) = match lex.get_string_lines(0, '\'', 3) {
    Ok((lines, indent)) => (lines.map(|line| line as string), indent),
    Err(_) => (["failed to read lines"], -1),
  }
  t.should_be_true(
    lines[0] == "   line1" && lines[1] == "   line2",
    f"Expected [\"   line1\", \"   line2\"], got {lines}",
  )?
  t.should_be_true(indent == 3, f"Expected indent==3, got indent=={indent}")?

  // test some multiline strings
  let mut tok = Lexer.new("'''\nhello\n'''").read_string()
  t.should_eq(tok, Token.string_literal(0, 13, "hello"))?
  tok = Lexer.new("'''\n   hello\n   '''").read_string()
  t.should_eq(tok, Token.string_literal(0, 19, "hello"))?
  Ok(())
}

fn test_newlines(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Lexer Newline"
  let mut lex = Lexer.new("\n")
  let tok = lex.next()
  match tok.kind {
    TokenKind.Newline(indent, 0) => {
      if indent != 0 { t.fail(f"expected indent 0, got {indent}")? }
    },
    _ => t.fail(f"expected newline, got {tok.kind}")?,
  }

  let mut lex2 = Lexer.new("  \n  x")
  let _ = lex2.next()
  let tok2 = lex2.next()
  match tok2.kind {
    TokenKind.Identifier(name) => {
      if name != "x" { t.fail(f"expected 'x', got '{name}'")? }
    },
    _ => t.fail(f"expected identifier, got {tok2.kind}")?,
  }
  Ok(())
}
