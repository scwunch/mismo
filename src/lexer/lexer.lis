

pub struct Lexer {
  pub source: Slice<rune>,
  pub index: uint32,
  current_token: Token,
}
impl Lexer {
  pub fn new(source: string) -> Lexer {
    let mut lex = Lexer { 
      source: source as Slice<rune>, 
      index: 0,
      current_token: Token.error(0, 0, "Lexer not initialized."),
    }
    let _ = lex.next()  // purge error token and prime the pump
    lex
  }

  pub fn new_no_init(source: string) -> Lexer {
    Lexer { 
      source: source as Slice<rune>, 
      index: 0,
      current_token: Token.error(0, 0, "Lexer not initialized."),
    }
  }

  pub fn peek(self: Ref<Lexer>) -> Token {
    self.current_token
  }

  pub fn next(self: Ref<Lexer>) -> Token {
    let tok = self.current_token
    let pos = self.index
    
    match self.peek_char() {
      0 => self.current_token = Token.eof(pos),
      '\n' => {
        let indent = self.count_indent()
        self.current_token = Token.newline(pos, self.index, indent)
      },
      '-' if self.peek_char_at(1) == '-' => {
        let indent = self.count_indent()
        self.current_token = Token.newline(pos, self.index, indent)
      },
      ' ' | '\t' => {
        self.index += 1
        return self.next()
      },
      ',' => {
        self.index += 1
        self.current_token = Token.comma(pos)
      },
      '.' => {
        self.index += 1
        self.current_token = Token.dot(pos)
      },
      '(' => {
        self.index += 1
        self.current_token = Token.left_paren(pos)
      },
      ')' => {
        self.index += 1
        self.current_token = Token.right_paren(pos)
      },
      '{' => {
        self.index += 1
        self.current_token = Token.left_brace(pos)
      },
      '}' => {
        self.index += 1
        self.current_token = Token.right_brace(pos)
      },
      '[' => {
        self.index += 1
        self.current_token = Token.left_bracket(pos)
      },
      ']' => {
        self.index += 1
        self.current_token = Token.right_bracket(pos)
      },
      ':' => {
        self.index += 1
        self.current_token = Token.colon(pos)
      },
      ';' => {
        self.index += 1
        self.current_token = Token.semicolon(pos)
      },
      '"' | '\'' => {
        self.current_token = self.read_string(self.index)
      },
      c if is_digit(c) => {
        self.current_token = self.read_number(self.index)
      },
      c if is_identifier_start(c) => {
        self.current_token = self.read_word(self.index)
      },
      _ => {
        self.index += 1
        self.current_token = self.token_for_operator(self.index - 1)
      },
    }

    tok
  }

  fn peek_char(self) -> rune {
    self.source.get(self.index as int).unwrap_or(0)
  }

  fn peek_char_at(self, offset: int) -> rune {
    self.source.get(
      self.index as int + offset
    ).unwrap_or(0)
  }

  fn count_indent(self: Ref<Lexer>) -> uint32 {
    // advance to next line
    loop {
      match self.peek_char() {
        '\n' => break,
        0 => return 0,
        _ => self.index += 1,
      }
    }

    let mut indent: uint32 = 0

    loop {
      match self.peek_char() {
        ' ' | '\t' => {
          indent += 1
          self.index += 1
        },
        '-' if self.peek_char_at(1) == '-' => {
          return self.count_indent()
        },
        '\n' => {
          self.index += 1
          indent = 0
        },
        0 => {
          return 0
        },
        _ => {
          return indent
        },
      }
    }
  }

  fn read_word(self: Ref<Lexer>, start: uint32) -> Token {
    while true {
      let c = self.peek_char()
      if is_alphanumeric(c) {
        self.index += 1
      } else {
        break
      }
    }
    let word = self.source[start as int..self.index as int] as string
    
    match parse_keyword(word) {
      Some(kw) => Token.keyword(start, self.index, kw),
      None => Token.identifier(start, self.index, word),
    }
  }

  fn read_number(self: Ref<Lexer>, start: uint32) -> Token {
    let mut int_part: int = 0
    
    loop {
      match self.peek_char() {
        c if is_digit(c) => {
          int_part = int_part * 10 + (c as int - '0' as int)
          self.index += 1
        },
        '_' => self.index += 1,
        '.' if is_digit(self.peek_char_at(1)) => {
          self.index += 1
          break
        },
        _ => return Token.int(start, self.index, int_part),
      }
    }

    // parse float
    let mut float_val = int_part as float64
    let mut decimal_places: float64 = 1.0
    loop {
      match self.peek_char() {
        '_' => self.index += 1,
        c if is_digit(c) => {
          decimal_places *= 10.0
          float_val += (c - '0') as float64 / decimal_places
          self.index += 1
        },
        _ => break,
      }
    }
    Token.float(start, self.index, float_val)
  }

  fn read_string(self: Ref<Lexer>, start: uint32) -> Token {
    let quote = self.source[self.index as int]
    self.index += 1
    let mut quote_width = 1
    
    while self.peek_char() == quote {
      quote_width += 1
      self.index += 1
    }

    if quote_width == 2 {
      return Token.string_literal(start, self.index, "")
    }

    let mut result = ""
    while true {
      let c = self.peek_char()
      match c {
        0 | '\n' => break,
        _ if c == quote => {
          self.index += 1
          break
        },
        '\\' => {
          self.index += 1
          let ec = self.peek_char()
          match ec {
            'n' => { result = result + "\n"; self.index += 1; },
            't' => { result = result + "\t"; self.index += 1; },
            'r' => { result = result + "\r"; self.index += 1; },
            '\\' => { result = result + "\\"; self.index += 1; },
            '"' => { result = result + "\""; self.index += 1; },
            '\'' => { result = result + "'"; self.index += 1; },
            _ => { result = result + [ec] as string; self.index += 1; },
          }
        },
        _ => {
          result = result + [c] as string
          self.index += 1
        },
      }
    }

    Token.string_literal(start, self.index, result)
  }

  fn token_for_operator(self: Ref<Lexer>, start: uint32) -> Token {
    let c = self.source[start as int]
    match c {
      '~' => Token.tilde(start),
      '!' => Token.bang(start),
      '@' => Token.at(start),
      '#' => Token.hashtag(start),
      '$' => Token.dollar(start),
      '%' => Token.percent(start),
      '^' => Token.caret(start),
      '&' => Token.ampersand(start),
      '*' => Token.star(start),
      '+' => Token.plus(start),
      '-' => Token.minus(start),
      '=' => Token.equals(start),
      '|' => Token.pipe(start),
      '\\' => Token.backslash(start),
      '<' => Token.less_than(start),
      '>' => Token.greater_than(start),
      '?' => Token.question(start),
      '/' => Token.slash(start),
      _ => Token.identifier(start, start + 1, [c] as string),
    }
  }
}

fn is_digit(c: rune) -> bool {
  c >= '0' && c <= '9'
}

fn is_alphanumeric(c: rune) -> bool {
  c == '_' || 
    (c >= 'a' && c <= 'z') || 
    (c >= 'A' && c <= 'Z') || 
    (c >= '0' && c <= '9')
}

fn is_identifier_start(c: rune) -> bool {
  c == '_' || 
    (c >= 'a' && c <= 'z') || 
    (c >= 'A' && c <= 'Z')
}
