pub struct Lexer {
  pub source: Slice<rune>,
  pub index: uint32,
  current_token: Token,
}
impl Lexer {
  pub fn new(source: string) -> Lexer {
    let mut lex = Lexer { 
      source: source as Slice<rune>, 
      index: 0,
      current_token: Token.error(0, 0, "Lexer not initialized."),
    }
    let _ = lex.next()  // purge error token and prime the pump
    lex
  }

  pub fn new_no_init(source: string) -> Lexer {
    Lexer { 
      source: source as Slice<rune>, 
      index: 0,
      current_token: Token.error(0, 0, "Lexer not initialized."),
    }
  }

  pub fn peek(self: Ref<Lexer>) -> Token {
    self.current_token
  }

  pub fn next(self: Ref<Lexer>) -> Token {
    let tok = self.current_token
    let pos = self.index
    
    self.current_token = match self.peek_char() {
      ',' => Token.comma(pos),
      '.' => Token.dot(pos),
      ':' => Token.colon(pos),
      ';' => Token.semicolon(pos),
      '(' => Token.left_paren(pos),
      ')' => Token.right_paren(pos),
      '{' => Token.left_brace(pos),
      '}' => Token.right_brace(pos),
      '[' => Token.left_bracket(pos),
      ']' => Token.right_bracket(pos),
      '"' | '\'' | '`' => self.read_string(),
      '\n' => {
        let indent = self.count_indent()
        Token.newline(pos, self.index, indent)
      },
      '-' if self.peek_char_at(1) == '-' => {
        let indent = self.count_indent()
        Token.newline(pos, self.index, indent)
      },
      ' ' | '\t' => {
        self.index += 1
        return self.next()
      },
      0 => Token.eof(pos),
      c if is_digit(c) => self.read_number(),
      c if is_identifier_start(c) => self.read_word(),
      c if is_operator(c) => self.read_operator(),
      c => Token.error(pos, self.index, f"Unhandled character: '{c}'")
    }

    self.index = self.current_token.span.end

    tok
  }

  fn peek_char(self) -> rune {
    self.source.get(self.index as int).unwrap_or(0)
  }

  fn peek_char_at(self, offset: int) -> rune {
    self.source.get(
      self.index as int + offset
    ).unwrap_or(0)
  }

  fn count_indent(self: Ref<Lexer>) -> uint32 {
    // advance to next line
    loop {
      match self.peek_char() {
        '\n' => break,
        0 => return 0,
        _ => self.index += 1,
      }
    }

    let mut indent: uint32 = 0

    loop {
      match self.peek_char() {
        ' ' | '\t' => {
          indent += 1
          self.index += 1
        },
        '-' if self.peek_char_at(1) == '-' => {
          return self.count_indent()
        },
        '\n' => {
          self.index += 1
          indent = 0
        },
        0 => {
          return 0
        },
        _ => {
          return indent
        },
      }
    }
  }

  fn read_word(self: Ref<Lexer>) -> Token {
    let start = self.index
    loop {
      let c = self.peek_char()
      if is_alphanumeric(c) {
        self.index += 1
      } else {
        break
      }
    }
    let word = self.source[start as int..self.index as int] as string
    
    match Keyword.parse(word) {
      Some(Keyword.Mut) if self.peek_char_at(1) == '!' => {
        self.index += 1
        Token.keyword(start, self.index, Keyword.MutBang)
      },
      Some(kw) => Token.keyword(start, self.index, kw),
      None => match word {
        "and" => Token.operator(start, self.index, Operator.And),
        "or"  => Token.operator(start, self.index, Operator.Or),
        "not" => Token.operator(start, self.index, Operator.Not),
        "is"  => Token.operator(start, self.index, Operator.Is),
        "in"  => Token.operator(start, self.index, Operator.In),
        _ => Token.identifier(start, self.index, word)
      },
    }
  }

  fn read_number(self: Ref<Lexer>) -> Token {
    let start = self.index
    let mut int_part: int = 0
    
    loop {
      match self.peek_char() {
        c if is_digit(c) => {
          int_part = int_part * 10 + (c as int - '0' as int)
          self.index += 1
        },
        '.' if is_digit(self.peek_char_at(1)) => {
          self.index += 1
          break
        },
        '_' => self.index += 1,
        _ => return Token.int(start, self.index, int_part),
      }
    }

    // parse float
    let mut float_val = int_part as float64
    let mut decimal_places: float64 = 1.0
    loop {
      match self.peek_char() {
        c if is_digit(c) => {
          decimal_places *= 10.0
          float_val += (c - '0') as float64 / decimal_places
          self.index += 1
        },
        '_' => self.index += 1,
        _ => break,
      }
    }
    Token.float(start, self.index, float_val)
  }

  fn read_string(self: Ref<Lexer>) -> Token {
    let start = self.index
    let quote = self.source[start as int]
    self.index += 1
    let mut quote_width = 1
    
    while self.peek_char() == quote {
      quote_width += 1
      self.index += 1
    }

    if quote_width == 2 {
      return Token.string_literal(start, self.index, "")
    }

    let mut result = ""
    while true {
      let c = self.peek_char()
      match c {
        0 | '\n' => break,
        _ if c == quote => {
          self.index += 1
          break
        },
        '\\' => {
          self.index += 1
          let ec = self.peek_char()
          match ec {
            'n' => { result = result + "\n"; self.index += 1; },
            't' => { result = result + "\t"; self.index += 1; },
            'r' => { result = result + "\r"; self.index += 1; },
            '\\' => { result = result + "\\"; self.index += 1; },
            '"' => { result = result + "\""; self.index += 1; },
            '\'' => { result = result + "'"; self.index += 1; },
            _ => { result = result + [ec] as string; self.index += 1; },
          }
        },
        _ => {
          result = result + [c] as string
          self.index += 1
        },
      }
    }

    Token.string_literal(start, self.index, result)
  }

  fn read_operator(self: Ref<Lexer>) -> Token {
    let start = self.index
    let op = if self.peek_char_at(1) == '=' {
      self.index += 2
      match self.peek_char() {
        '+' => Operator.AddAssign,
        '-' => Operator.SubAssign,
        '*' => Operator.MulAssign,
        '/' => Operator.DivAssign,
        '%' => Operator.ModAssign,
        '^' => Operator.PowAssign,
        '&' => Operator.AndAssign,
        '|' => Operator.OrAssign,
        '=' => Operator.Eq,
        '!' => Operator.Neq,
        '<' => Operator.Lte,
        '>' => Operator.Gte,
        c => return Token.error(start, self.index, "Invalid operator: {c}=")
      }
    } else {
      self.index += 1
      match self.peek_char() {
        '+' => Operator.Add,
        '-' => Operator.Sub,
        '*' => Operator.Mul,
        '/' => Operator.Div,
        '%' => Operator.Mod,
        '^' => Operator.Pow,
        '&' => Operator.And,
        '|' => Operator.Or,
        '!' => Operator.Not,
        '~' => Operator.Not,
        '=' => Operator.Assign,
        c => return Token.error(start, self.index, f"Unrecognized operator: {c}")
      }
    }
    Token.operator(start, self.index, op)
  }
}


fn is_digit(c: rune) -> bool {
  c >= '0' && c <= '9'
}

fn is_alphanumeric(c: rune) -> bool {
  c == '_' || 
    (c >= 'a' && c <= 'z') || 
    (c >= 'A' && c <= 'Z') || 
    (c >= '0' && c <= '9')
}

fn is_identifier_start(c: rune) -> bool {
  c == '_' || 
    (c >= 'a' && c <= 'z') || 
    (c >= 'A' && c <= 'Z')
}

fn is_operator(c: rune) -> bool {
  "+-*/%^<>=&|!~".contains([c] as string)
}