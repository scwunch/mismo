import "go:math"

pub struct Lexer {
  pub source: Slice<rune>,
  pub index: uint32,
}
impl Lexer {
  pub fn new(source: string) -> Lexer {
    Lexer { 
      source: source as Slice<rune>, 
      index: 0,
    }
  }

  /// Returns the next token in the source, advancing the index.
  pub fn next(self: Ref<Lexer>) -> Token {
    let pos = self.index
    
    let tok = match self.peek_char() {
      ',' => Token.comma(pos),
      '.' => Token.dot(pos),
      ':' => Token.colon(pos),
      ';' => Token.semicolon(pos),
      '(' => Token.left_paren(pos),
      ')' => Token.right_paren(pos),
      '{' => Token.left_brace(pos),
      '}' => Token.right_brace(pos),
      '[' => Token.left_bracket(pos),
      ']' => Token.right_bracket(pos),
      '"' | '\'' | '`' => self.read_string(),
      '\n' => self.new_line(),
      '-' if self.peek_char_at(1) == '-' => self.new_line(),
      ' ' | '\t' => {
        self.index += 1
        return self.next()
      },
      0 => Token.eof(pos),
      c if is_digit(c) => self.read_number(),
      c if is_identifier_start(c) => self.read_word(),
      c if is_operator(c) => self.read_operator(),
      c => Token.error(pos, self.index, f"Unhandled character: '{c}'")
    }

    self.index = tok.span.end

    tok
  }

  /// Returns the character at the current index, or 0 if at end.
  fn peek_char(self) -> rune {
    self.source.get(self.index as int).unwrap_or(0)
  }

  /// Returns the character at the current index plus offset, or 0 if at end.
  fn peek_char_at(self, offset: int) -> rune {
    self.source.get(
      self.index as int + offset
    ).unwrap_or(0)
  }

  /// get a bounds-checked sub-slice of self.source
  fn slice(self, start: uint32, end: uint32) -> Slice<rune> {
    if end as int >= self.source.length() {
      self.source[start as int ..]
    } else {
      self.source[start as int .. end as int]
    }
  }

  /// Advances to next significant line (non-whitespace, non-comment) and 
  /// counts the indentation (spaces/tabs) until the first significant 
  /// character.  Returns newline token.
  fn new_line(self: Ref<Lexer>) -> Token {
    self.new_line_recursive(self.index)
  }
  fn new_line_recursive(self: Ref<Lexer>, start: uint32) -> Token {
    // advance to next line
    loop {
      match self.peek_char() {
        '\n' => break,
        0 => return Token.newline(start, self.index, 0),
        _ => self.index += 1,
      }
    }

    let mut indent: uint32 = 0

    loop {
      match self.peek_char() {
        ' ' | '\t' => indent += 1,
        '\n' => indent = 0,
        0 => return Token.newline(start, self.index, 0),
        '-' if self.peek_char_at(1) == '-' => {
          return self.new_line_recursive(start)
        },
        _ => break,
      }
      self.index += 1
    }

    Token.newline(start, self.index, indent)
  }

  /// Reads an identifier, keyword, or word-operator (and, or, not, is, in).
  fn read_word(self: Ref<Lexer>) -> Token {
    let start = self.index
    loop {
      let c = self.peek_char()
      if is_alphanumeric(c) {
        self.index += 1
      } else {
        break
      }
    }
    let word = self.slice(start, self.index) as string
    
    match Keyword.parse(word) {
      Some(Keyword.Mut) if self.peek_char_at(1) == '!' => {
        self.index += 1
        Token.keyword(start, self.index, Keyword.MutBang)
      },
      Some(kw) => Token.keyword(start, self.index, kw),
      None => match word {
        "and" => Token.operator(start, self.index, Operator.And),
        "or"  => Token.operator(start, self.index, Operator.Or),
        "not" => Token.operator(start, self.index, Operator.Not),
        "is"  => Token.operator(start, self.index, Operator.Is),
        "in"  => Token.operator(start, self.index, Operator.In),
        _ => Token.identifier(start, self.index, word)
      },
    }
  }

  /// Reads an integer or float literal (e.g., 42, 3.14, 1_000).
  fn read_number(self: Ref<Lexer>) -> Token {
    let start = self.index
    let (int_part, _) = self.read_int()
    if self.peek_char() == '.' && is_digit(self.peek_char_at(1)) {
      // read float
      self.index += 1
      let (frac_part, num_digits) = self.read_int()
      let divisor = math.Pow10(num_digits)
      let float_val = int_part as float64 + frac_part as float64 / divisor
      Token.float(start, self.index, float_val)
    } else {
      Token.int(start, self.index, int_part as int)
    }
  }

  fn read_int(self: Ref<Lexer>) -> (uint64, int) {
    let mut acc: uint64 = 0
    let mut num_digits = 0
    loop {
      match self.peek_char() {
        c if is_digit(c) => {
          acc = acc * 10 + ((c - '0') as uint64)
          num_digits += 1
        },
        '_' => (),
        _ => return (acc, num_digits)
      }
      self.index += 1
    }
  }

  fn read_string(self: Ref<Lexer>) -> Token {
    let start = self.index
    let quote = self.source[start as int]
    self.index += 1
    let mut quote_width = 1
    
    while self.peek_char() == quote {
      quote_width += 1
      self.index += 1
    }

    match quote_width {
      1 => self.read_single_line_string(start, quote),
      2 => Token.string_literal(start, self.index, ""),
      _ => self.read_multiline_string(start, quote, quote_width),
    }
  }

  fn read_single_line_string(self: Ref<Lexer>, start: uint32, quote: rune) -> Token {
    if quote == '`' {
      loop {
        match self.peek_char() {
          '`' => break,
          0 | '\n' => return Token.error(start, self.index, "unterminated string literal"),
          _ => self.index += 1
        }
      }
      let str = self.slice(start + 1, self.index) as string
      self.index += 1
      Token.string_literal(start, self.index, str)
    } else {
      let mut chars: Slice<rune> = []
      loop {
        match self.peek_char() {
          0 | '\n' => break,
          c if c == quote => {
            self.index += 1
            break
          },
          '\\' => {
            self.index += 1
            chars = match self.peek_char() {
              'n'  => chars.append('\n'),
              't' => chars.append('\t'),
              'r' => chars.append('\r'),
              '\\' => chars.append('\\'),
              '"' => chars.append('"'),
              '\'' => chars.append('\''),
              ec => {
                self.index += 1
                return Token.error(self.index - 2, self.index, f"Invalid escape sequence: \\{ec}")
              },
            }
          },
          c => chars = chars.append(c),
        }
        self.index += 1
      }
      Token.string_literal(start, self.index, chars as string)
    }
  }

  /// call immediately after consuming open quote
  fn read_multiline_string(
    self: Ref<Lexer>, 
    start: uint32, 
    quote: rune, 
    quote_width: int
  ) -> Token {
    let result = try {
      self.validate_open_quote(start)?
      let (lines, indent) = self.get_string_lines(start, quote, quote_width)?
      parse_lines(start, lines, indent)?
    }
    match result {
      Err(tok) => tok,
      Ok(content) => Token.string_literal(start, self.index, content),
    }
  }

  /// verify only whitespace on the line after the open quote
  /// precondition: self.index immediately after open quote
  /// postcondition: self.index immediately after '\n'
  fn validate_open_quote(self: Ref<Lexer>, start: uint32) -> Result<(), Token> {
    while self.peek_char() == ' ' || self.peek_char() == '\t' {
      self.index += 1
    }
    if self.peek_char() == '\n' {
      self.index += 1
      Ok(())
    } else {
      Err(Token.error(
        start,
        self.index,
        "Multiline string literals start on line after opening quote."
      ))
    }
  }

  /// Called when lexer is on the first column of the line after 
  /// consuming the starting quote of a multiline string.
  /// Return the a slice of subslices of the source, not including 
  /// the opening or closing quotes.  Also return the indent of the end
  /// quote.  
  fn get_string_lines(
    self: Ref<Lexer>, 
    start: uint32,
    quote: rune, 
    quote_width: int,
  ) -> Result<(Slice<Slice<rune>>, int), Token> {
    let mut lines = []
    let mut line_start = self.index
    let mut count = 0
    loop {
      match self.peek_char() {
        0 => return Err(Token.error(
          start, 
          self.index,"unterminated string literal"
        )),
        '\n' => {
          let line = self.slice(line_start, self.index)
          lines = lines.append(line)
          line_start = self.index + 1
        },
        q if q == quote => {
          count += 1
          if count == quote_width {
            self.index += 1
            if self.slice(line_start, self.index - count as uint32).any(|c| {
              c != ' ' && c != '\t'
            }) {
              return Err(Token.error(
                line_start,
                self.index,
                "Only whitespace is allowed before the endquote of a multiline string literal."
              ))
            } else {
              let indent = self.index as int - count - line_start as int
              if indent < 0 { panic("compiler bug... negative indent detected") }
              return Ok((lines, indent))
            }
          }
        },
        _ => count = 0
      }
      self.index += 1
    }
  }

  /// Reads an operator (e.g., +, -, ==, !=, +=, <=, etc.).
  fn read_operator(self: Ref<Lexer>) -> Token {
    let start = self.index
    let op_char = self.peek_char()
    let op = if self.peek_char_at(1) == '=' {
      self.index += 2
      match op_char {
        '+' => Operator.AddAssign,
        '-' => Operator.SubAssign,
        '*' => Operator.MulAssign,
        '/' => Operator.DivAssign,
        '%' => Operator.ModAssign,
        '^' => Operator.PowAssign,
        '&' => Operator.AndAssign,
        '|' => Operator.OrAssign,
        '=' => Operator.Eq,
        '!' => Operator.Neq,
        '<' => Operator.Lte,
        '>' => Operator.Gte,
        c => return Token.error(start, self.index, "Invalid operator: {c}=")
      }
    } else {
      self.index += 1
      match op_char {
        '+' => Operator.Add,
        '-' => Operator.Sub,
        '*' => Operator.Mul,
        '/' => Operator.Div,
        '%' => Operator.Mod,
        '^' => Operator.Pow,
        '&' => Operator.And,
        '|' => Operator.Or,
        '!' => Operator.Not,
        '~' => Operator.Not,
        '=' => Operator.Assign,
        c => return Token.error(start, self.index, f"Unrecognized operator: {c}")
      }
    }
    Token.operator(start, self.index, op)
  }
}


fn is_digit(c: rune) -> bool {
  c >= '0' && c <= '9'
}

fn is_alphanumeric(c: rune) -> bool {
  c == '_' || 
    (c >= 'a' && c <= 'z') || 
    (c >= 'A' && c <= 'Z') || 
    (c >= '0' && c <= '9')
}

fn is_identifier_start(c: rune) -> bool {
  c == '_' || 
    (c >= 'a' && c <= 'z') || 
    (c >= 'A' && c <= 'Z')
}

fn is_operator(c: rune) -> bool {
  "+-*/%^<>=&|!~".contains([c] as string)
}

fn parse_lines(start: uint32, lines: Slice<Slice<rune>>, indent: int) -> Result<string, Token> {
  let mut contents: Slice<string> = []
  let mut i = start
  for line in lines {
    if line[..indent].any(|r| {
      i += 1
      r != ' ' && r != '\t'
    }) {
      return Err(Token.error(i, i+1, "content found in indentation space of multiline string"))
    }
    let line = line[indent..]
    contents = contents.append(parse_string(i, line)?)
    i += line.length() as uint32 + 1
  }
  Ok(contents.join("\n"))
}

fn parse_string(start: uint32, runes: Slice<rune>) -> Result<string, Token> {
  let mut parsed: Slice<rune> = []
  let mut i = 0
  loop {
    match runes.get(i) {
      Some('\\') => {
        i += 1
        let c = match runes[i] {
          '0' => '\0',
          'n' => '\n',
          't' => '\t',
          c => {
            let i = start + i as uint32
            return Err(Token.error(i, i + 1, "invalid escape sequence"))
          }
        }
        parsed = parsed.append(c)
      },
      Some(c) => parsed = parsed.append(c),
      None => break
    }
    i += 1
  }
  Ok(parsed as string)
}