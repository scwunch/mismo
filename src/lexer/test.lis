fn test_numbers() {
  let mut lexer = Lexer.new("42 1000 0")
  let tok1 = lexer.next()
  match tok1.kind {
    TokenKind.IntLiteral(n) => {
      if n != 42 { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  let tok2 = lexer.next()
  match tok2.kind {
    TokenKind.IntLiteral(n) => {
      if n != 1000 { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  let tok3 = lexer.next()
  match tok3.kind {
    TokenKind.IntLiteral(n) => {
      if n != 0 { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  fmt.Println("test_numbers passed")
}

fn test_strings() {
  let mut lexer = Lexer.new("\"hello\" 'world' \"\"")
  let tok1 = lexer.next()
  match tok1.kind {
    TokenKind.StringLiteral(s) => {
      if s != "hello" { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  let tok2 = lexer.next()
  match tok2.kind {
    TokenKind.StringLiteral(s) => {
      if s != "world" { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  let tok3 = lexer.next()
  match tok3.kind {
    TokenKind.StringLiteral(s) => {
      if s != "" { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  fmt.Println("test_strings passed")
}

fn test_keywords() {
  let mut lexer = Lexer.new("fn let var mut if for while return struct enum")
  let tok1 = lexer.next()
  if is_keyword(tok1.kind, Keyword.Fn) == false { fmt.Println("FAIL"); return }
  let tok2 = lexer.next()
  if is_keyword(tok2.kind, Keyword.Let) == false { fmt.Println("FAIL"); return }
  let tok3 = lexer.next()
  if is_keyword(tok3.kind, Keyword.Var) == false { fmt.Println("FAIL"); return }
  let tok4 = lexer.next()
  if is_keyword(tok4.kind, Keyword.Mut) == false { fmt.Println("FAIL"); return }
  let tok5 = lexer.next()
  if is_keyword(tok5.kind, Keyword.If) == false { fmt.Println("FAIL"); return }
  let tok6 = lexer.next()
  if is_keyword(tok6.kind, Keyword.For) == false { fmt.Println("FAIL"); return }
  let tok7 = lexer.next()
  if is_keyword(tok7.kind, Keyword.While) == false { fmt.Println("FAIL"); return }
  let tok8 = lexer.next()
  if is_keyword(tok8.kind, Keyword.Return) == false { fmt.Println("FAIL"); return }
  let tok9 = lexer.next()
  if is_keyword(tok9.kind, Keyword.Struct) == false { fmt.Println("FAIL"); return }
  let tok10 = lexer.next()
  if is_keyword(tok10.kind, Keyword.Enum) == false { fmt.Println("FAIL"); return }
  fmt.Println("test_keywords passed")
}

fn is_keyword(kind: TokenKind, kw: Keyword) -> bool {
  match kind {
    TokenKind.Keyword(k) => k == kw,
    _ => false
  }
}

fn test_identifiers() {
  let mut lexer = Lexer.new("foo bar Baz _test abc123")
  let tok1 = lexer.next()
  match tok1.kind {
    TokenKind.Identifier(s) => {
      if s != "foo" { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  let tok2 = lexer.next()
  match tok2.kind {
    TokenKind.Identifier(s) => {
      if s != "bar" { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  let tok3 = lexer.next()
  match tok3.kind {
    TokenKind.Identifier(s) => {
      if s != "Baz" { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  let tok4 = lexer.next()
  match tok4.kind {
    TokenKind.Identifier(s) => {
      if s != "_test" { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  let tok5 = lexer.next()
  match tok5.kind {
    TokenKind.Identifier(s) => {
      if s != "abc123" { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  fmt.Println("test_identifiers passed")
}

fn test_newlines() {
  let mut lexer = Lexer.new("foo\n  bar\nbaz")
  let tok1 = lexer.next()
  match tok1.kind {
    TokenKind.Identifier(s) => {
      if s != "foo" { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  let tok2 = lexer.next()
