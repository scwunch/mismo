import "go:fmt"
import "testing"

pub fn test() {
  let _ = testing.test_suite("Lexer", [
    ("Token Equality", test_token_equality),
    ("Span Merging", test_span_merge),
    ("Lexer Peek/Next Char", test_peek_next_char),
    ("Lexer Read Word", test_read_word),
    ("Lexer Read Number", test_read_number),
    ("Lexer String Literals", test_read_string),
    ("Lexer Newline", test_newlines),
  ])
}

// impl Equatable
impl Span      { pub fn eq(self, other: Span) -> bool { self == other } }
impl TokenKind { pub fn eq(self, other: TokenKind) -> bool { self == other } }
impl Token     { pub fn eq(self, other: Token) -> bool { self == other } }

fn test_token_equality(t: Ref<testing.TestRunner>) {
  let tok1 = TokenKind.LeftParen
  let tok2 = TokenKind.LeftParen
  let tok3 = TokenKind.RightParen
  t.should_eq(tok1, tok2)
  t.shouldnt_eq(tok1, tok3)

  t.should_eq(Token.left_brace(0), Token.left_brace(0))
  t.shouldnt_eq(Token.left_brace(0), Token.right_brace(0))
  t.shouldnt_eq(Token.left_brace(0), Token.left_brace(99))
  // FAIL: t.should_eq(Token.left_brace(0), Token.left_brace(99))
}
