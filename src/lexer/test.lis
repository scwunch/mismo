import "go:fmt"
import "testing"

pub fn test() {
  let _ = testing.test_suite("Lexer", [
    ("Token Equality", test_token_equality),
  ])
  if false {
    test_keywords_print()
    test_punctuators()
    test_operators()
    test_numbers()
    test_strings()
    test_keywords()
    test_identifiers()
    test_newlines()
    test_peek()
  }
}

// impl Equatable
impl Span      { pub fn eq(self, other: Span) -> bool { self == other } }
impl TokenKind { pub fn eq(self, other: TokenKind) -> bool { self == other } }
impl Token     { pub fn eq(self, other: Token) -> bool { self == other } }

fn test_token_equality(t: Ref<testing.TestRunner>) {
  let tok1 = TokenKind.LeftParen
  let tok2 = TokenKind.LeftParen
  let tok3 = TokenKind.RightParen
  t.should_eq(tok1, tok2)
  t.shouldnt_eq(tok1, tok3)

  t.should_eq(Token.left_brace(0), Token.left_brace(0))
  t.shouldnt_eq(Token.left_brace(0), Token.right_brace(0))
  t.shouldnt_eq(Token.left_brace(0), Token.left_brace(99))
  // FAIL: t.should_eq(Token.left_brace(0), Token.left_brace(99))
}

fn test_keywords_print() {
  let mut lexer = Lexer.new("fn let var")
  let tok1 = lexer.next()
  fmt.Println(f"tok1: {tok1.kind}")
  let tok2 = lexer.next()
  fmt.Println(f"tok2: {tok2.kind}")
  let tok3 = lexer.next()
  fmt.Println(f"tok3: {tok3.kind}")
  fmt.Println("test_keywords_print passed")
}


fn test_punctuators() {
  let mut lexer = Lexer.new("(){}[].,:;")
  let tok1 = lexer.next()
  if tok1.kind != TokenKind.LeftParen { fmt.Println("FAIL"); return }
  let tok2 = lexer.next()
  if tok2.kind != TokenKind.RightParen { fmt.Println("FAIL"); return }
  let tok3 = lexer.next()
  if tok3.kind != TokenKind.LeftBrace { fmt.Println("FAIL"); return }
  let tok4 = lexer.next()
  if tok4.kind != TokenKind.RightBrace { fmt.Println("FAIL"); return }
  let tok5 = lexer.next()
  if tok5.kind != TokenKind.LeftBracket { fmt.Println("FAIL"); return }
  let tok6 = lexer.next()
  if tok6.kind != TokenKind.RightBracket { fmt.Println("FAIL"); return }
  let tok7 = lexer.next()
  if tok7.kind != TokenKind.Dot { fmt.Println("FAIL"); return }
  let tok8 = lexer.next()
  if tok8.kind != TokenKind.Comma { fmt.Println("FAIL"); return }
  let tok9 = lexer.next()
  if tok9.kind != TokenKind.Colon { fmt.Println("FAIL"); return }
  let tok10 = lexer.next()
  if tok10.kind != TokenKind.Semicolon { fmt.Println("FAIL"); return }
  fmt.Println("test_punctuators passed")
}

fn test_operators() {
  let mut lexer = Lexer.new("~!@#$%^&*+?-<|>=/\\")
  let tok1 = lexer.next()
  if tok1.kind != TokenKind.Tilde { fmt.Println("FAIL"); return }
  let tok2 = lexer.next()
  if tok2.kind != TokenKind.Bang { fmt.Println("FAIL"); return }
  let tok3 = lexer.next()
  if tok3.kind != TokenKind.At { fmt.Println("FAIL"); return }
  let tok4 = lexer.next()
  if tok4.kind != TokenKind.Hashtag { fmt.Println("FAIL"); return }
  let tok5 = lexer.next()
  if tok5.kind != TokenKind.Dollarsign { fmt.Println("FAIL"); return }
  let tok6 = lexer.next()
  if tok6.kind != TokenKind.Percent { fmt.Println("FAIL"); return }
  let tok7 = lexer.next()
  if tok7.kind != TokenKind.Caret { fmt.Println("FAIL"); return }
  let tok8 = lexer.next()
  if tok8.kind != TokenKind.Ampersand { fmt.Println("FAIL"); return }
  let tok9 = lexer.next()
  if tok9.kind != TokenKind.Star { fmt.Println("FAIL"); return }
  let tok10 = lexer.next()
  if tok10.kind != TokenKind.Plus { fmt.Println("FAIL"); return }
  let tok11 = lexer.next()
  if tok11.kind != TokenKind.Minus { fmt.Println("FAIL"); return }
  let tok12 = lexer.next()
  if tok12.kind != TokenKind.Question { fmt.Println("FAIL"); return }
  let tok13 = lexer.next()
  if tok13.kind != TokenKind.LessThan { fmt.Println("FAIL"); return }
  let tok14 = lexer.next()
  if tok14.kind != TokenKind.GreaterThan { fmt.Println("FAIL"); return }
  let tok15 = lexer.next()
  if tok15.kind != TokenKind.Pipe { fmt.Println("FAIL"); return }
  let tok16 = lexer.next()
  if tok16.kind != TokenKind.Equals { fmt.Println("FAIL"); return }
  let tok17 = lexer.next()
  if tok17.kind != TokenKind.Slash { fmt.Println("FAIL"); return }
  let tok18 = lexer.next()
  if tok18.kind != TokenKind.Backslash { fmt.Println("FAIL"); return }
  fmt.Println("test_operators passed")
}

fn test_numbers() {
  let mut lexer = Lexer.new("42 1000 0")
  let tok1 = lexer.next()
  match tok1.kind {
    TokenKind.IntLiteral(n) => {
      if n != 42 { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  let tok2 = lexer.next()
  match tok2.kind {
    TokenKind.IntLiteral(n) => {
      if n != 1000 { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  let tok3 = lexer.next()
  match tok3.kind {
    TokenKind.IntLiteral(n) => {
      if n != 0 { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  fmt.Println("test_numbers passed")
}

fn test_strings() {
  let mut lexer = Lexer.new("\"hello\" 'world' \"\"")
  let tok1 = lexer.next()
  match tok1.kind {
    TokenKind.StringLiteral(s) => {
      if s != "hello" { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  let tok2 = lexer.next()
  match tok2.kind {
    TokenKind.StringLiteral(s) => {
      if s != "world" { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  let tok3 = lexer.next()
  match tok3.kind {
    TokenKind.StringLiteral(s) => {
      if s != "" { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  fmt.Println("test_strings passed")
}

fn test_keywords() {
  let mut lexer = Lexer.new("fn let var mut if for while return struct enum")
  let tok1 = lexer.next()
  if is_keyword(tok1.kind, Keyword.Fn) == false { fmt.Println("FAIL"); return }
  let tok2 = lexer.next()
  if is_keyword(tok2.kind, Keyword.Let) == false { fmt.Println("FAIL"); return }
  let tok3 = lexer.next()
  if is_keyword(tok3.kind, Keyword.Var) == false { fmt.Println("FAIL"); return }
  let tok4 = lexer.next()
  if is_keyword(tok4.kind, Keyword.Mut) == false { fmt.Println("FAIL"); return }
  let tok5 = lexer.next()
  if is_keyword(tok5.kind, Keyword.If) == false { fmt.Println("FAIL"); return }
  let tok6 = lexer.next()
  if is_keyword(tok6.kind, Keyword.For) == false { fmt.Println("FAIL"); return }
  let tok7 = lexer.next()
  if is_keyword(tok7.kind, Keyword.While) == false { fmt.Println("FAIL"); return }
  let tok8 = lexer.next()
  if is_keyword(tok8.kind, Keyword.Return) == false { fmt.Println("FAIL"); return }
  let tok9 = lexer.next()
  if is_keyword(tok9.kind, Keyword.Struct) == false { fmt.Println("FAIL"); return }
  let tok10 = lexer.next()
  if is_keyword(tok10.kind, Keyword.Enum) == false { fmt.Println("FAIL"); return }
  fmt.Println("test_keywords passed")
}

fn is_keyword(kind: TokenKind, kw: Keyword) -> bool {
  match kind {
    TokenKind.Keyword(k) => k == kw,
    _ => false
  }
}

fn test_identifiers() {
  let mut lexer = Lexer.new("foo bar Baz _test abc123")
  let tok1 = lexer.next()
  match tok1.kind {
    TokenKind.Identifier(s) => {
      if s != "foo" { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  let tok2 = lexer.next()
  match tok2.kind {
    TokenKind.Identifier(s) => {
      if s != "bar" { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  let tok3 = lexer.next()
  match tok3.kind {
    TokenKind.Identifier(s) => {
      if s != "Baz" { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  let tok4 = lexer.next()
  match tok4.kind {
    TokenKind.Identifier(s) => {
      if s != "_test" { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  let tok5 = lexer.next()
  match tok5.kind {
    TokenKind.Identifier(s) => {
      if s != "abc123" { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  fmt.Println("test_identifiers passed")
}

fn test_newlines() {
  let mut lexer = Lexer.new("foo\n  bar\nbaz")
  let tok1 = lexer.next()
  match tok1.kind {
    TokenKind.Identifier(s) => {
      if s != "foo" { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  let tok2 = lexer.next()
  match tok2.kind {
    TokenKind.Newline{indent} => {
      if indent != 2 { fmt.Println(f"FAIL: expected indent 2, got {indent}"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  let tok3 = lexer.next()
  match tok3.kind {
    TokenKind.Identifier(s) => {
      if s != "bar" { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  let tok4 = lexer.next()
  match tok4.kind {
    TokenKind.Newline{indent} => {
      if indent != 0 { fmt.Println(f"FAIL: expected indent 0, got {indent}"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  let tok5 = lexer.next()
  match tok5.kind {
    TokenKind.Identifier(s) => {
      if s != "baz" { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  fmt.Println("test_newlines passed")
}

fn test_peek() {
  let mut lexer = Lexer.new("foo bar")
  let peeked = lexer.peek()
  match peeked.kind {
    TokenKind.Identifier(s) => {
      if s != "foo" { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  let first = lexer.next()
  match first.kind {
    TokenKind.Identifier(s) => {
      if s != "foo" { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  let peeked_again = lexer.peek()
  match peeked_again.kind {
    TokenKind.Identifier(s) => {
      if s != "bar" { fmt.Println("FAIL"); return }
    },
    _ => { fmt.Println("FAIL"); return }
  }
  fmt.Println("test_peek passed")
}