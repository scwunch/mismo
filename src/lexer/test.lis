import "go:fmt"
import "lexer"

pub fn test() {
  fmt.Println("Running lexer tests...")
  test_keywords_print()
  fmt.Println("All lexer tests passed!")
}

fn test_keywords_print() {
  let mut lexer = Lexer.new("fn let var")
  let tok1 = lexer.next()
  fmt.Println(f"tok1: {tok1.kind}")
  let tok2 = lexer.next()
  fmt.Println(f"tok2: {tok2.kind}")
  let tok3 = lexer.next()
  fmt.Println(f"tok3: {tok3.kind}")
  fmt.Println("test_keywords_print passed")
}

