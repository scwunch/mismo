import "mode"
import "span"

impl Parameter {
  pub fn eq(self, other: Parameter) -> bool {
    self.span == other.span && self.mode == other.mode &&
    self.name == other.name &&
    self.typ.eq(other.typ)
  }
}

pub fn param(
  start: uint32,
  end: uint32,
  mode: Option<mode.Mode>,
  name: string,
  typ: Type,
) -> Parameter {
  Parameter.new(span.Span.new(start, end), mode, name, typ)
}
