import "mode"
import "span"
import "ty"

#[display]
#[json]
#[equality]
pub struct Expression {
  pub span: span.Span,
  pub kind: Expr,
}

#[display]
#[json]
#[equality]
pub enum Expr {
  Nil,
  BoolLiteral(bool),
  IntLiteral(int),
  FloatLiteral(float64),
  StringLiteral(string),
  ArrayLiteral(Slice<Expression>),
  TupleLiteral(Slice<Expression>),
  Closure(Closure),
  Declare(mode.Mode, Ref<ty.Variable>, Ref<Expression>),
  Identifier(Ref<ty.Variable>),
  CapturedIdent(Ref<ty.Variable>),
  Assign(Ref<ty.Variable>, Ref<Expression>),
  AssignCapture(Ref<ty.Variable>, Ref<Expression>),
  Binding(mode.Mode, Ref<Expression>),
  Call(Call),
  If(If),
  While(If),
  For(ForLoop),
  Block(Block),
  Return(Option<Ref<Expression>>),
  Break(Option<Ref<Expression>>),
  Continue,
  BareConstructor(string, Slice<Expression>),
  StructConstructor(ty.Type, Slice<Expression>),
  EnumConstructor(Ref<ty.TypeDef>, ty.Variant, Slice<Expression>),
  Extern,
}

#[equality]
pub struct Block {
  pub statements: Slice<Expression>,
  pub typ: ty.Type,
}

impl Block {
  pub fn new(statements: Slice<Expression>) -> Block {
    if statements.is_empty() { panic("Block must have at least one statement") }
    Block { statements, typ: ty.Type.Never }
  }

  pub fn empty() -> Block {
    Block { statements: [], typ: ty.Type.Never }
  }

  pub fn last(self) -> Expression {
    self.statements[self.statements.length() - 1]
  }

  pub fn span(self) -> span.Span {
    self.statements[0].span.merge(self.last().span)
  }

  pub fn kinds(self) -> Slice<Expr> {
    self.statements.map(|s| s.kind)
  }

  pub fn is_extern(self) -> bool {
    match self.statements {
      [Expression { kind: Extern, .. }] => true,
      _ => false,
    }
  }
}

/// all the info required to resolve function overload in type checking phase
#[display]
#[json]
pub struct Call {
  pub local_candidates: Slice<Ref<ty.Variable>>,
  pub global_candidates: Slice<Ref<FunctionDef>>,
  pub type_args: Option<Slice<ty.Type>>,
  pub args: Slice<Expression>,
  pub field: Option<string>,
}

impl Call {
  pub fn new(
    local_candidates: Slice<Ref<ty.Variable>>,
    global_candidates: Slice<Ref<FunctionDef>>,
    type_args: Option<Slice<ty.Type>>,
    args: Slice<Expression>,
    field: Option<string>,
  ) -> Call {
    Call { local_candidates, global_candidates, type_args, args, field }
  }

  pub fn equals(self, other: Call) -> bool {
    match (self.type_args, other.type_args) {
      (None, None) => (),
      (Some(ta1), Some(ta2)) if ta1.equals(ta2) => (),
      _ => return false,
    }
    self.local_candidates.equals(other.local_candidates) &&
    self.global_candidates.equals(other.global_candidates) &&
    self.args.equals(other.args)
  }
}

#[json]
#[equality]
pub struct Closure {
  pub env: Slice<Capture>,
  pub params: Slice<ty.Parameter>,
  pub ret_type: ty.Type,
  pub body: Block,
}

#[json]
pub struct Capture {
  pub mode: mode.Mode,
  pub variable: Ref<ty.Variable>,
}

impl Capture {
  pub fn new(varid: Ref<ty.Variable>) -> Capture {
    Capture { mode: mode.Mode.Let, variable: varid }
  }
}

impl Closure {
  pub fn typ(self) -> ty.Type {
    // let params = self.params.map(|p| ParamType{mode: p.mode, typ: p.typ})
    ty.Type.Fn(self.params.map(ty.Parameter.param_type), &self.ret_type)
  }

  pub fn call_mode(self) -> mode.Mode {
    self.env.fold(mode.Mode.Let, |acc, cap| acc.union(cap.mode))
  }

  pub fn is_movable(self) -> bool {
    self.env.all(|c| c.mode == mode.Mode.Var)
  }
}

#[json]
#[display]
#[equality]
pub struct If {
  pub checks: Slice<Check>,
  pub default: Option<Block>,
}

#[json]
#[display]
#[equality]
pub enum Check {
  Test(Expression, Block),
  Match(Expression, Slice<Arm>),
}

#[json]
#[equality]
pub struct Arm {
  pub pattern: Expression,
  pub then: Then,
}

#[json]
#[equality]
pub enum Then {
  Block(Block),
  If(If),
}

impl If {
  pub fn span(self) -> span.Span {
    self.checks[0].span().merge(self.end_span())
  }

  #[allow(manual_map_or)]
  pub fn end_span(self) -> span.Span {
    match self.default {
      Some(block) => block.last().span,
      None => self.checks[self.checks.length() - 1].end_span(),
    }
  }

  pub fn equals(self, other: If) -> bool {
    self.checks.equals(other.checks) &&
    self.default.map_or_else(
      || other.default.is_none(),
      |b1| other.default.map_or(false, |b2| b1.equals(b2)),
    )
  }
}

impl Check {
  pub fn span(self) -> span.Span {
    match self {
      Test(expr, block) => expr.span.merge(block.last().span),
      Match(expr, arms) => expr.span.merge(arms[arms.length() - 1].end_span()),
    }
  }

  #[allow(manual_map_or)]
  pub fn end_span(self) -> span.Span {
    match self {
      Test(_, block) => block.last().span,
      Match(_, arms) => arms[arms.length() - 1].end_span(),
    }
  }
}

impl Arm {
  pub fn span(self) -> span.Span {
    self.pattern.span.merge(self.end_span())
  }

  pub fn end_span(self) -> span.Span {
    match self.then {
      Block(block) => block.last().span,
      If(cond) => cond.end_span(),
    }
  }
}

#[json]
#[equality]
pub struct ForLoop {
  pub binding: Ref<ty.Variable>,
  pub iter: Ref<Expression>,
  pub body: Block,
}

impl Expression {
  pub fn new(span: span.Span, kind: Expr) -> Expression {
    Expression { span, kind }
  }

  pub fn blank() -> Expression {
    Expression.new(span.new(0, 0), Expr.Nil)
  }

  // pub fn typ(self) -> ty.Type {
  //   self.kind.typ()
  // }
}

impl Expr {
  pub fn is_extern(self) -> bool {
    self.equals(Expr.Extern)
  }
}

