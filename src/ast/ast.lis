pub fn mock_func(
  name: string,
  type_parameters: Slice<ty.TypeParameter>,
  parameters: Slice<ty.Parameter>,
  return_type: Type,
) -> ty.FunctionDef<Expression> {
  ty.FunctionDef { 
    span: span.new(0, 0),
    id: -1,
    name,
    type_parameters,
    parameters,
    return_type,
    body: Expression.new(span.new(0, 0), Expr.Extern),
  }
}
