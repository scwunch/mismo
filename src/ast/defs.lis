import "errors"
import "span"

/// a container for definitions collected from a module
pub struct Definitions {
  pub imports: Slice<Import>,
  pub structs: Slice<StructDef>,
  pub enums: Slice<EnumDef>,
  pub functions: Slice<FunctionDef>,
  pub errors: Slice<errors.SyntaxError>,
}

pub struct Import {
  pub path: string,
  pub alias: Option<string>,
}

impl Import {
  pub fn new(path: string, alias: Option<string>) -> Import {
    Import { path, alias }
  }
}

pub struct StructDef {
  pub span: span.Span,
  pub name: string,
  pub type_parameters: Slice<string>,
  pub fields: Slice<Field>,
}

impl StructDef {
  pub fn new(
    span: span.Span,
    name: string,
    type_parameters: Slice<string>,
    fields: Slice<Field>,
  ) -> StructDef {
    StructDef { span, name, type_parameters, fields }
  }
}

pub struct Field {
  pub span: span.Span,
  pub name: string,
  pub typ: Type,
}

impl Field {
  pub fn new(start: uint32, end: uint32, name: string, typ: Type) -> Field {
    Field { span: span.Span { start, end }, name, typ }
  }
}

pub struct EnumDef {
  pub span: span.Span,
  pub name: string,
  pub type_parameters: Slice<string>,
  pub variants: Slice<Variant>,
}

impl EnumDef {
  pub fn new(
    span: span.Span,
    name: string,
    type_parameters: Slice<string>,
    variants: Slice<Variant>,
  ) -> EnumDef {
    EnumDef { span, name, type_parameters, variants }
  }
}

pub struct Variant {
  pub span: span.Span,
  pub name: string,
  pub payload: Slice<Type>,
}

impl Variant {
  pub fn new(span: span.Span, name: string, payload: Slice<Type>) -> Variant {
    Variant { span, name, payload }
  }
}

pub struct FunctionDef {
  pub sig: Signature,
  pub body: Expression,
}

impl FunctionDef {
  pub fn new(sig: Signature, body: Expression) -> FunctionDef {
    FunctionDef { sig, body }
  }
}

pub struct Signature {
  pub span: span.Span,
  pub name: string,
  pub type_parameters: Slice<string>,
  pub parameters: Slice<Parameter>,
}

impl Signature {
  pub fn new(
    span: span.Span,
    name: string,
    type_parameters: Slice<string>,
    parameters: Slice<Parameter>,
  ) -> Signature {
    Signature { span, name, type_parameters, parameters }
  }
}

pub struct Parameter {
  pub span: span.Span,
  pub mode: Mode,
  pub name: string,
  pub typ: Type,
}

impl Parameter {
  pub fn new(span: span.Span, mode: Mode, name: string, typ: Type) -> Parameter {
    Parameter { span, mode, name, typ }
  }
}

impl Definitions {
  pub fn new() -> Definitions {
    Definitions { 
      imports: [],
      structs: [],
      enums: [],
      functions: [],
      errors: [],
    }
  }

  pub fn add_import(self: Ref<Definitions>, i: Import) {
    self.imports = self.imports.append(i)
  }

  pub fn add_struct(self: Ref<Definitions>, s: StructDef) {
    self.structs = self.structs.append(s)
  }

  pub fn add_enum(self: Ref<Definitions>, e: EnumDef) {
    self.enums = self.enums.append(e)
  }

  pub fn add_function(self: Ref<Definitions>, f: FunctionDef) {
    self.functions = self.functions.append(f)
  }

  pub fn add_error(self: Ref<Definitions>, s: errors.SyntaxError) {
    self.errors = self.errors.append(s)
  }
}
