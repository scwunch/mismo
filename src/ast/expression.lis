import "mode"
import "operator"
import "span"

// type Span = span.Span
pub type Operator = operator.Operator

pub struct Expression {
  pub span: span.Span,
  pub kind: Expr,
}

pub enum Expr {
  Nil,
  Bool(bool),
  IntLiteral(int),
  FloatLiteral(float64),
  StringLiteral(string),
  ArrayLiteral(Slice<Expression>),
  TupleLiteral(Slice<Expression>),
  Identifier(string),
  Binding(mode.Mode, Ref<Expression>),
  Binop { left: Ref<Expression>, op: Operator, right: Ref<Expression> },
  Assign { pattern: Ref<Expression>, value: Option<Ref<Expression>> },
  Call { fn_name: string, type_args: Slice<Type>, args: Slice<Expression> },
  If(Conditional),
  While(Conditional),
  For { binding: Ref<Expression>, iter: Ref<Expression>, body: Ref<Expression> },
  Block(Slice<Expression>),
}

pub enum Conditional {
  Binary { subject: Ref<Expression>, ops: Slice<Comparison> },
  Unary { expr: Ref<Expression>, consequent: Ref<Expression> },
  Multi(Slice<Conditional>),
  Else { consequent: Ref<Expression> },
}

pub struct Comparison {
  pub op: Operator,
  pub objects: Slice<Branch>,
}

pub struct Branch {
  pub object: Ref<Expression>,
  pub then: Consequent,
}

pub enum Consequent {
  And(Conditional),
  Or(Conditional),
  Do(Ref<Expression>),
}

pub fn nil_lit(span: span.Span) -> Expression {
  Expression { span, kind: Expr.Nil }
}

pub fn bool_lit(span: span.Span, value: bool) -> Expression {
  Expression { span, kind: Expr.Bool(value) }
}

pub fn int_lit(span: span.Span, value: int) -> Expression {
  Expression { span, kind: Expr.IntLiteral(value) }
}

pub fn float_lit(span: span.Span, value: float64) -> Expression {
  Expression { span, kind: Expr.FloatLiteral(value) }
}

pub fn string_lit(span: span.Span, value: string) -> Expression {
  Expression { span, kind: Expr.StringLiteral(value) }
}

pub fn array_lit(span: span.Span, values: Slice<Expression>) -> Expression {
  Expression { span, kind: Expr.ArrayLiteral(values) }
}

