import "cst"
import dx "diagnostics"
import spn "span"
import "ty"

#[json]
pub struct Registry {
  pub imports: Map<string, Registry>,
  pub type_defs: Map<string, Ref<ty.TypeDef>>,
  pub function_defs: Slice<Ref<FunctionDef>>,
  pub signatures: Map<string, Slice<Ref<FunctionDef>>>,
  pub errors: Slice<dx.TypeError>,
}

impl Registry {
  pub fn new() -> Registry {
    Registry { .. }
  }

  pub fn with_mock_prelude() -> Ref<Registry> {
    let self = &Registry { .. }
    for fn_name in ["==", "+", "-", "*", "/", "print"] {
      self.add_function(&FunctionDef.mock(fn_name, [], [], ty.nil()))
    }
    let span = spn.new(0, 0)

    self.type_defs["Option"] = &ty.TypeDef.new_enum(
      span,
      "Option",
      [],
      ([
        ("Some", ty.Type.Bool),
        ("None", ty.nil()),
      ])
    )
    self
  }

  pub fn add_function(self: Ref<Registry>, func: Ref<FunctionDef>) {
    let i = self.function_defs.length()
    self.function_defs = self.function_defs.append(func)
    let def = self.function_defs[i]
    match self.signatures.get(def.name) {
      Some(existing) => {
        self.signatures[def.name] = existing.append(def)
      },
      None => self.signatures[def.name] = [def],
    }
  }

  pub fn error(self: Ref<Registry>, err: dx.TypeError) {
    self.errors = self.errors.append(err)
  }

  pub fn get_module(self, span: spn.Span, path: cst.Path) -> Result<Registry, dx.ResolveError> {
    if path.namespace.is_empty() { return Ok(self) }
    self.imports
      .get(path.namespace.join("::"))
      .ok_or_else(|| dx.MissingNameError.new(path.namespace.join("::"), span))
  }

  pub fn get_type_def(self, span: spn.Span, path: cst.Path) -> Result<Ref<ty.TypeDef>, dx.ResolveError> {
    let module = self.get_module(span, path)?
    module.type_defs
      .get(path.name)
      .ok_or_else(|| dx.MissingNameError.new(path.name, span))
  }

  pub fn eval_type(
    self,
    span: spn.Span,
    name: string,
    type_args: Slice<ty.Type>,
  ) -> Result<ty.Type, dx.ResolveError> {
    match self.type_defs.get(name) {
      None => {
        Err(dx.MissingNameError.new(name, span))
      },
      Some(def) => {
        if type_args.length() != def.type_parameters.length() {
          Err(dx.TypeParameterArityError.new(
            span,
            name,
            type_args.length(),
            def.type_parameters.length(),
          ))
        } else {
          Ok(ty.Type.Adt(def, type_args))
        }
      },
    }
  }
}
