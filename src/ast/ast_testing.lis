import "utils/slice"

impl Type {
  pub fn eq(self, other: Type) -> bool {
    self.span == other.span && self.kind.eq(other.kind)
  }
}

impl TypeKind {
  pub fn eq(self, other: TypeKind) -> bool {
    match (self, other) {
      (TypeKind.Nominal(name1, args1), TypeKind.Nominal(name2, args2)) => {
        name1 == name2 && slice.compare(args1, args2, Type.eq)
      },
      (TypeKind.Tuple(args1), TypeKind.Tuple(args2)) => {
        slice.compare(args1, args2, Type.eq)
      },
      (TypeKind.Fn(params1, ret1), TypeKind.Fn(params2, ret2)) => {
        slice.compare(params1, params2, ParamType.eq) && ret1.*.eq(ret2.*)
      },
      _ => false,
    }
  }
}

impl ParamType {
  pub fn eq(self, other: ParamType) -> bool {
    self.mode == other.mode && self.typ.eq(other.typ)
  }
}

impl Field {
  pub fn eq(self, other: Field) -> bool {
    self.span == other.span && self.name == other.name && self.typ.eq(other.typ)
  }
}

impl StructDef {
  pub fn eq(self, other: StructDef) -> bool {
    self.span == other.span && self.name == other.name &&
    slice.compare(self.fields, other.fields, Field.eq)
  }
}

impl Variant {
  pub fn eq(self, other: Variant) -> bool {
    self.span == other.span && self.name == other.name &&
    slice.compare(self.payload, other.payload, Type.eq)
  }
}

impl EnumDef {
  pub fn eq(self, other: EnumDef) -> bool {
    self.span == other.span && self.name == other.name &&
    slice.compare(self.variants, other.variants, Variant.eq)
  }
}
