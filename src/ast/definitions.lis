import "mode"
import "span"
import "utils/slice"

#[json]
pub struct TypeDef {
  pub span: span.Span,
  pub name: string,
  pub type_parameters: Slice<TypeParameter>,
  pub kind: TypeKind,
  pub signatures: Map<string, Slice<int>>,
}

#[json]
pub enum TypeKind {
  Struct(Slice<Field>),
  Enum(Slice<Variant>),
}

#[json]
pub struct TypeParameter {
  pub span: span.Span,
  pub name: string,
}

impl TypeParameter {
  pub fn new(span: span.Span, name: string) -> TypeParameter {
    TypeParameter { span, name }
  }

  pub fn mock(name: string) -> TypeParameter {
    TypeParameter { name, .. }
  }
}

#[json]
pub struct Field {
  pub span: span.Span,
  pub name: string,
  pub typ: Type,
}

impl Field {
  pub fn to_param(self) -> Parameter {
    Parameter.new(self.span, mode.Mode.Var, self.name, self.typ)
  }
}

#[json]
pub struct Variant {
  pub span: span.Span,
  pub name: string,
  pub fields: Slice<Type>,
}

#[json]
pub struct Signature {
  pub type_parameters: Slice<TypeParameter>,
  pub parameters: Slice<Parameter>,
  pub return_type: Type,
}

#[json]
pub struct FunctionDef {
  pub span: span.Span,
  pub id: int,
  pub name: string,
  pub type_parameters: Slice<TypeParameter>,
  pub parameters: Slice<Parameter>,
  pub return_type: Type,
  pub body: Expression,
}

#[json]
pub struct Parameter {
  pub span: span.Span,
  pub mode: mode.Mode,
  pub name: string,
  pub typ: Type,
}

impl Parameter {
  pub fn new(span: span.Span, mode: mode.Mode, name: string, typ: Type) -> Parameter {
    Parameter { span, mode, name, typ }
  }

  pub fn let_(name: string, typ: Type) -> Parameter {
    Parameter { span: span.new(0, 0), mode: mode.Mode.Let, name, typ }
  }

  pub fn mut_(name: string, typ: Type) -> Parameter {
    Parameter { span: span.new(0, 0), mode: mode.Mode.Mut, name, typ }
  }

  pub fn mutbang(name: string, typ: Type) -> Parameter {
    Parameter { span: span.new(0, 0), mode: mode.Mode.MutBang, name, typ }
  }

  pub fn var_(name: string, typ: Type) -> Parameter {
    Parameter { span: span.new(0, 0), mode: mode.Mode.Var, name, typ }
  }

  pub fn param_type(self) -> ParamType {
    ParamType { mode: self.mode, typ: self.typ }
  }

  pub fn substitute(self, type_args: Slice<Type>) -> Parameter {
    Parameter.new(
      self.span,
      self.mode,
      self.name,
      self.typ.substitute(type_args),
    )
  }
}

impl TypeDef {
  pub fn new(
    span: span.Span,
    name: string,
    type_parameters: Slice<TypeParameter>,
    kind: TypeKind,
  ) -> TypeDef {
    TypeDef { span, name, type_parameters, kind, signatures: Map.new() }
  }
}

impl FunctionDef {
  pub fn new(
    span: span.Span,
    id: int,
    name: string,
    type_parameters: Slice<TypeParameter>,
    parameters: Slice<Parameter>,
    return_type: Type,
    body: Expression,
  ) -> FunctionDef {
    FunctionDef { 
      span,
      id,
      name,
      type_parameters,
      parameters,
      return_type,
      body,
    }
  }

  pub fn mock(
    name: string,
    type_parameters: Slice<TypeParameter>,
    parameters: Slice<Parameter>,
    return_type: Type,
  ) -> FunctionDef {
    FunctionDef { 
      span: span.new(0, 0),
      id: -1,
      name,
      type_parameters,
      parameters,
      return_type,
      body: Expression.blank(),
    }
  }

  pub fn signature(self) -> string {
    let type_params = type_params_to_string(self.type_parameters)
    let params = self.parameters
      .map(|p| f"{p.mode} {p.name} {p.typ}")
      .join(", ")
    f"fn {self.name}{type_params}({params}) {self.return_type}"
  }

  pub fn better_than(self, other: FunctionDef) -> bool {
    let pairs = slice.zip(self.parameters, other.parameters)
    pairs.all(|p| p.0.typ.specificity_ge(p.1.typ)) &&
    pairs.any(|p| p.0.typ.specificity_gt(p.1.typ))
  }

  pub fn is_extern(self) -> bool {
    self.body.kind.is_extern()
  }
}

fn type_params_to_string(type_params: Slice<TypeParameter>) -> string {
  if type_params.is_empty() { "" } else { f"{type_params.map(|tp| tp.name)}" }
}
