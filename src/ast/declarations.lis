import "errors"
import "mode"
import "span"

/// a container for declarations collected from a module
pub struct Declarations {
  pub imports: Slice<Import>,
  pub types: Slice<TypeDecl>,
  pub functions: Slice<FunctionDecl>,
  pub errors: Slice<errors.SyntaxError>,
}

pub struct Import {
  pub path: string,
  pub alias: Option<string>,
}

impl Import {
  pub fn new(path: string, alias: Option<string>) -> Import {
    Import { path, alias }
  }
}

pub struct TypeParameter {
  pub span: span.Span,
  pub name: string,
}

impl TypeParameter {
  pub fn new(span: span.Span, name: string) -> TypeParameter {
    TypeParameter { span, name }
  }
}

pub struct TypeDecl {
  pub span: span.Span,
  pub name: string,
  pub type_parameters: Slice<TypeParameter>,
  pub body: TypeBody,
}

impl TypeDecl {
  pub fn new_struct(
    span: span.Span,
    name: string,
    type_parameters: Slice<TypeParameter>,
    fields: Slice<Field>,
  ) -> TypeDecl {
    TypeDecl { span, name, type_parameters, body: TypeBody.Struct(fields) }
  }

  pub fn new_enum(
    span: span.Span,
    name: string,
    type_parameters: Slice<TypeParameter>,
    variants: Slice<Variant>,
  ) -> TypeDecl {
    TypeDecl { span, name, type_parameters, body: TypeBody.Enum(variants) }
  }
}

pub enum TypeBody {
  Struct(Slice<Field>),
  Enum(Slice<Variant>),
}

pub struct Field {
  pub span: span.Span,
  pub name: string,
  pub typ: Type,
}

impl Field {
  pub fn new(start: uint32, end: uint32, name: string, typ: Type) -> Field {
    Field { span: span.Span { start, end }, name, typ }
  }
}

pub struct Variant {
  pub span: span.Span,
  pub name: string,
  pub payload: Slice<Type>,
}

impl Variant {
  pub fn new(span: span.Span, name: string, payload: Slice<Type>) -> Variant {
    Variant { span, name, payload }
  }
}

pub struct FunctionDecl {
  pub span: span.Span,
  pub signature: Signature,
  pub body: Expression,
}

impl FunctionDecl {
  pub fn new(span: span.Span, signature: Signature, body: Expression) -> FunctionDecl {
    FunctionDecl { span, signature, body }
  }
}

pub struct Signature {
  pub span: span.Span,
  pub name: string,
  pub type_parameters: Slice<TypeParameter>,
  pub parameters: Slice<Parameter>,
  pub return_type: Type,
}

impl Signature {
  pub fn new(
    span: span.Span,
    name: string,
    type_parameters: Slice<TypeParameter>,
    parameters: Slice<Parameter>,
    return_type: Type,
  ) -> Signature {
    Signature { span, name, type_parameters, parameters, return_type }
  }
}

pub struct Parameter {
  pub span: span.Span,
  pub mode: Option<mode.Mode>,
  pub name: string,
  pub typ: Type,
}

impl Parameter {
  pub fn new(span: span.Span, mode: Option<mode.Mode>, name: string, typ: Type) -> Parameter {
    Parameter { span, mode, name, typ }
  }
}

impl Declarations {
  pub fn new() -> Declarations {
    Declarations { imports: [], types: [], functions: [], errors: [] }
  }

  pub fn add_import(self: Ref<Declarations>, i: Import) {
    self.imports = self.imports.append(i)
  }

  pub fn add_type(self: Ref<Declarations>, t: TypeDecl) {
    self.types = self.types.append(t)
  }

  pub fn add_function(self: Ref<Declarations>, f: FunctionDecl) {
    self.functions = self.functions.append(f)
  }

  pub fn add_error(self: Ref<Declarations>, s: errors.SyntaxError) {
    self.errors = self.errors.append(s)
  }
}
