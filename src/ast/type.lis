import "span"

pub struct Type {
  pub span: span.Span,
  pub name: string,
  pub type_args: Slice<Type>,
}
impl Type {
  pub fn new(span: span.Span, name: string, type_args: Slice<Type>) -> Type {
    Type { span, name, type_args }
  }
}

pub fn typ(start: uint32, end: uint32, name: string, type_args: Slice<Type>) -> Type {
  Type.new(span.Span{start, end}, name, type_args)
}