import "ast"
import "cst"
import dx "diagnostics"
import md "mode"
import spn "span"
import "ty"
import "utils/slice"

type Type = ty.Type

/// Generic context that bundles a Registry with type parameters
/// for evaluating types
pub struct TypeContext {
  env: Ref<ast.Registry>,
  type_params: Slice<ty.TypeParameter>,
}

impl TypeContext {
  fn new(env: Ref<ast.Registry>, type_params: Slice<ty.TypeParameter>) -> TypeContext {
    TypeContext { env, type_params }
  }

  fn new_blank() -> TypeContext {
    TypeContext.new(&ast.Registry.new(), [])
  }

  fn eval_variant(self, variant: cst.Variant) -> Result<ty.Constructor, dx.ResolveError> {
    let typ = match variant.payload {
      None => ty.nil(),
      Some(typ) => self.eval_type(typ)?
    }
    Ok(ty.Constructor { name: variant.name, typ })
  }

  fn eval_field(self, field: cst.TypeField) -> Result<ty.Field, dx.ResolveError> {
    Ok(ty.Field {
      name: field.name,
      typ: self.eval_type(field.typ)?
    })
  }

  fn eval_type(self, typ: cst.Type) -> Result<Type, dx.ResolveError> {
    match typ.kind {
      Nominal(name, type_args) => {
        self.eval_nominal_type(
          typ.span,
          name,
          slice.map_result(type_args, self.eval_type)?,
        )
      },
      Tuple(types) => Ok(Type.Tuple(slice.map_result(types, self.eval_type)?)),
      Record(fields) => Ok(Type.Record(slice.map_result(fields, self.eval_field)?)),
      Enum(ctors) => Ok(Type.Enum(slice.map_result(ctors, self.eval_variant)?)),
      Fn(params, ret) => {
        let params = slice.map_result(params, self.eval_param_type)?
        let ret = self.eval_type(ret.*)?
        Ok(Type.Fn(params, &ret))
      },
    }
  }

  fn eval_nominal_type(
    self,
    span: spn.Span,
    path: cst.Path,
    type_args: Slice<Type>,
  ) -> Result<Type, dx.ResolveError> {
    if path.namespace.is_empty() {
      // try to match type param
      if let Some(res_t) = self.type_of_type_param(span, path.name, type_args) {
        return res_t
      }
      // try to match built in type
      if let Some(res_t) = self.primitive_type(span, path.name, type_args) {
        return res_t
      }
      self.env.eval_type(span, path.name, type_args)
    } else {
      let module = self.env.get_module(span, path)?
      module.eval_type(span, path.name, type_args)
    }
  }

  fn type_of_type_param(
    self,
    span: spn.Span,
    name: string,
    type_args: Slice<Type>,
  ) -> Option<Result<Type, dx.ResolveError>> {
    for (i, tp) in self.type_params.enumerate() {
      if name == tp.name {
        return if type_args.is_empty() {
          Some(Ok(Type.Var(i)))
        } else {
          let e = dx.TypeParameterArityError.new(
            span,
            f"type parameter {tp.name}",
            0,
            type_args.length(),
          )
          Some(Err(e))
        }
      }
    }
    None
  }

  fn primitive_type(self, span: spn.Span, name: string, type_args: Slice<Type>) -> Option<Result<Type, dx.ResolveError>> {
    let primitive = match name {
      "Any" => Type.Any,
      "Never" => Type.Never,
      "Nil" => ty.nil(),
      "Bool" => Type.Bool,
      "Nat" => Type.Nat,
      "Int" => Type.Int,
      "Float" => Type.Float,
      "String" => Type.String,
      "Array" => {
        return Some(check_arity(span, name, type_args.length(), 1).map(|_| Type.Array(
          &type_args[0],
        )))
      },
      "Slice" => {
        return Some(check_arity(span, name, type_args.length(), 1).map(|_| Type.Slice(
          &type_args[0],
        )))
      },
      "Pointer" => {
        return Some(check_arity(span, name, type_args.length(), 1).map(|_| Type.Pointer(
          &type_args[0],
        )))
      },
      _ => return None,
    }
    Some(check_arity(span, name, type_args.length(), 0).map(|_| primitive))
  }

  fn eval_param(self, param: cst.Parameter) -> Result<ty.Parameter, dx.ResolveError> {
    let typ = self.eval_type(param.typ)?
    Ok(
      ty.Parameter {
        span: param.span,
        mode: param.mode.unwrap_or(md.Mode.Let),
        name: param.name,
        typ,
      },
    )
  }

  fn eval_param_type(self, param: cst.ParamType) -> Result<ty.ParamType, dx.ResolveError> {
    let typ = self.eval_type(param.typ)?
    Ok(ty.ParamType { mode: param.mode.unwrap_or(md.Mode.Let), typ })
  }
}

fn check_arity(span: spn.Span, name: string, type_args: int, type_params: int) -> Result<(), dx.ResolveError> {
  if type_args == type_params {
    Ok(())
  } else {
    Err(dx.TypeParameterArityError.new(span, name, type_args, type_params))
  }
}
