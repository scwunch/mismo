import "ast"
import "cst"
import dx "diagnostics"
import "mode"
import "operator"
import "parser"
import "span"
import "testing"

pub fn test() {
  let _ = testing.test_suite("Resolver", [test_scope])
}

pub fn test_dummy(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Dummy"
  let _res = Resolver.new_blank()
  Ok(())
}

pub fn test_scope(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Scoping rules"
  let res = Resolver.new_blank()
  let cst_node = parse([
    "let foo = 0",
    "let bar = 0",
    "while true:",
    "  var foo = -1",
    "  bar",
    "  foo",
  ])?
  let mut foo1 = ast.var_var("undefined")
  let mut foo2 = ast.var_var("undefined")
  let mut bar1 = ast.var_var("undefined")
  let mut bar2 = ast.var_var("undefined")
  let block = res.block(cst_node).map_err(|e| e.message())?
  match block.statements {
    [stmt1, stmt2, stmt3] => {
      match (stmt1.kind, stmt2.kind) {
        (Declare(mode.Mode.Let, foo, _), Declare(mode.Mode.Let, bar, _)) => {
          foo1 = foo
          bar1 = bar
          t.should_eq(foo.mode, mode.Mode.Let)?
          t.should_eq(bar.mode, mode.Mode.Let)?
          t.should_eq_repr(foo.name, "foo")?
          t.should_eq_repr(bar.name, "bar")?
        },
        _ => t.fail(
          f"expected first two statements to be `let` declarations; got {stmt1.kind}, {stmt2.kind}",
        )?,
      }
      match stmt3.kind {
        While(_cond, body) => {
          match body.statements {
            [_, ident_bar, ident_foo] => {
              match (ident_bar.kind, ident_foo.kind) {
                (Identifier(bar_var), Identifier(foo_var)) => {
                  bar2 = bar_var
                  foo2 = foo_var
                  if bar1 != bar2 {
                    t.fail(
                      f"First bar ({bar1}) should be the same reference as the second ({bar2})",
                    )?
                  }
                  if foo1 == foo2 {
                    t.fail(
                      f"First foo ({foo1}) should not be the same reference as the second ({foo2})",
                    )?
                  }
                },
                r => t.fail(
                  f"expected last two statements in while loop to be identifiers; got {r}",
                )?,
              }
            },
            _ => t.fail(
              f"expected 3 statements in while loop body; got {body.statements.length()}",
            )?,
          }
        },
        k => t.fail(f"expected while loop; got {k}")?,
      }
    },
    _ => t.fail(f"expected 3 statements; got {block.statements.length()}")?,
  }
  // let _foo1 = ast.let_var("foo")
  // let _bar = ast.let_var("bar")
  // let _block = ast.block_expr([
  //   ast.declare_expr(mode.Mode.Let, "foo", &ast.Expression.blank()),
  //   ast.declare_expr(mode.Mode.Let, "bar", &ast.Expression.blank()),
  // ])
  Ok(())
}

pub fn test_closure_capture(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Dummy"
  let _res = Resolver.new_blank()
  Ok(())
}

fn parse(lines: Slice<string>) -> Result<cst.Block, string> {
  parser.Parser
    .new(": \n" + lines.map(|ln| f"  {ln}\n").join(""))
    .parse_colon_and_block()
    .map_err(|e| e.message())
}
