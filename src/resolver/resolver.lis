import "ast"
import "cst"
import dx "diagnostics"
import md "mode"
import spn "span"
import "ty"
import "utils/slice"

type Expr = ast.Expr

#[display]
pub struct Resolver {
  pub ctx: mut TypeContext,
  pub scope: Scope,
}

impl Resolver {
  pub fn variable(self: mut Resolver, id: ty.VarId) -> mut Ref<ty.Variable> {
    self.ctx.env.variable(id)
  }

  pub fn new(env: mut Ref<mut ast.Registry>, func: Ref<ast.FunctionDef>) -> mut Resolver {
    let scope = Scope.from_params(env, func.parameters)
    let mut ctx = TypeContext.new(env, func.type_parameters)
    Resolver { ctx, scope }
  }

  pub fn new_blank() -> mut Resolver {
    let mut reg = ast.Registry.new()
    let mut fun = ast.FunctionDef.mock("dummy", [], [], ty.nil())
    Resolver.new(&reg, &fun)
  }

  pub fn with_mock_prelude() -> mut Resolver {
    let mut reg = ast.Registry.with_mock_prelude()
    let mut fun = ast.FunctionDef.mock("dummy", [], [], ty.nil())
    Resolver.new(reg, &fun)
  }

  pub fn resolve(self: mut Resolver, node: cst.Expression) -> Result<ast.Expression, dx.ResolveError> {
    let mut captures = CaptureStack.new()
    self.resolve_with(&captures, node)
  }

  fn resolve_with(
    self: mut Resolver,
    captures: mut Ref<CaptureStack>,
    node: cst.Expression,
  ) -> Result<ast.Expression, dx.ResolveError> {
    let mut captures = captures
    let expr: Expr = match node.kind {
      Nil => Expr.Nil,
      BoolLiteral(b) => Expr.BoolLiteral(b),
      IntLiteral(i) => Expr.IntLiteral(i),
      FloatLiteral(f) => Expr.FloatLiteral(f),
      StringLiteral(s) => Expr.StringLiteral(s),
      ArrayLiteral(elems) => Expr.ArrayLiteral(
        self.resolve_expressions(captures, elems)?,
      ),
      TupleLiteral(elems) => Expr.TupleLiteral(
        self.resolve_expressions(captures, elems)?,
      ),
      RecordLiteral(fields) => Expr.RecordLiteral(
        self.resolve_fields(captures, fields)?
      ),
      Closure(params, body) => self.closure_with(
        captures,
        slice.map_result(params, self.ctx.eval_param)?,
        body,
      )?,
      Identifier(path) => self.resolve_path(captures, path, node.span)?,
      Binding(m, expr) => {
        let e = self.resolve_with(captures, expr.*)?
        Expr.Binding(m, &e)
      },
      Binop(binop) => self.binop(captures, binop.*, node.span)?,
      Call(call) => {
        let args = self.resolve_expressions(captures, call.args)?
        self.call(captures, call.fn_name, call.type_args, args, node.span)?
      },
      If(cond) => self.if_expr(captures, cond)?,
      While(cond) => self.while_expr(captures, cond)?,
      For(for_loop) => self.for_expr(captures, for_loop.*, node.span)?,
      Block(exprs) => Expr.Block(self.block_with(captures, exprs)?),
      Neg(expr) => {
        let arg = [self.resolve_with(captures, expr.*)?]
        self.bare_call(captures, "-", arg, false, node.span)?
      },
      Not(expr) => {
        let arg = [self.resolve_with(captures, expr.*)?]
        self.bare_call(captures, "not", arg, false, node.span)?
      },
      Return(None) => Expr.Return(None),
      Return(Some(expr)) => {
        let e = self.resolve_with(captures, expr.*)?
        Expr.Return(Some(&e))
      },
      Break(None) => Expr.Break(None),
      Break(Some(expr)) => {
        let e = self.resolve_with(captures, expr.*)?
        Expr.Break(Some(&e))
      },
      Continue => Expr.Continue,
      DotName(expr, name) => self.dot_name(captures, node.span, expr.*, name)?,
      DotCall(expr, call) => self.dot_call(captures, expr, call, node.span)?,
      Type(path, type_args) => self.resolve_constructor(node.span, path, type_args, &ast.nil_expr())?,
      EnumConstructor(typ, variant) => self.resolve_enum_constructor(node.span, typ, variant, &ast.nil_expr())?,
      Extern => Expr.Extern,
    }
    Ok(ast.Expression { span: node.span, kind: expr })
  }

  fn resolve_path(
    self: mut Resolver,
    captures: mut Ref<CaptureStack>,
    path: cst.Path,
    span: spn.Span,
  ) -> Result<Expr, dx.ResolveError> {
    if path.namespace.is_empty() {
      match self.scope.get(self.ctx.env, path.name) {
        Some((idx, varid)) => {
          if self.capture(captures, varid, idx) {
            Ok(Expr.CapturedIdent(varid))
          } else {
            Ok(Expr.Identifier(varid))
          }
        },
        None => Err(dx.MissingNameError.new(path.name, span)),
      }
    } else {
      Err(dx.MissingNameError.new(
        f"{path.namespace.join("::")}::{path.name}",
        span,
      ))
    }
  }

  fn resolve_field(
    self: mut Resolver,
    captures: mut Ref<CaptureStack>,
    field: cst.RecordField,
  ) -> Result<ast.Field, dx.ResolveError> {
    Ok(ast.Field {
      span: field.span,
      name: field.name,
      expr: self.resolve_with(captures, field.expr)?,
    })
  }

  fn resolve_expressions(
    self: mut Resolver,
    captures: mut Ref<CaptureStack>,
    nodes: Slice<cst.Expression>,
  ) -> Result<Slice<ast.Expression>, dx.ResolveError> {
    let mut expressions = [].reserve(nodes.length())
    for node in nodes {
      expressions = expressions.append(self.resolve_with(captures, node)?)
    }
    Ok(expressions)
  }

  fn resolve_fields(
    self: mut Resolver,
    captures: mut Ref<CaptureStack>,
    fields: Slice<cst.RecordField>,
  ) -> Result<Slice<ast.Field>, dx.ResolveError> {
    let mut resolved_fields = [].reserve(fields.length())
    for field in fields {
      resolved_fields = resolved_fields.append(self.resolve_field(captures, field)?)
    }
    Ok(resolved_fields)
  }
  /// add variable to capture set of all closures outside current scope
  /// return `true` if captured, false, otherwise
  fn capture(
    self,
    captures: mut Ref<CaptureStack>,
    varid: ty.VarId,
    index: int,
  ) -> bool {
    let mut is_capture = false
    let mut sets = [].reserve(captures.sets.length())
    for i in 0..captures.sets.length() {
      let mut capset = captures.sets[i]
      if index < capset.index {
        is_capture = true
        capset.captures = capset.captures.append(varid)
      }
      sets = sets.append(capset)
    }
    captures.sets = sets
    is_capture
  }

  pub fn block(self: mut Resolver, block: cst.Block) -> Result<ast.Block, dx.ResolveError> {
    let mut captures = CaptureStack.new()
    self.block_with(&captures, block)
  }

  fn block_with(
    self: mut Resolver,
    captures: mut Ref<CaptureStack>,
    block: cst.Block,
  ) -> Result<ast.Block, dx.ResolveError> {
    let mut current = self
    let mut expressions = [].reserve(block.statements.length())
    for stmt in block.statements {
      let mut expr = current.resolve_with(captures, stmt)?
      if let Expr.Declare(_, varid, _) = expr.kind {
        current.scope = current.scope.bind(varid)
      }
      expressions = expressions.append(expr)
    }
    Ok(ast.Block.new(expressions))
  }

  fn append_params(self: mut Resolver, params: Slice<ty.Parameter>) -> Scope {
    Scope {
      bindings: params.fold(
        self.scope.bindings,
        |vars, param| vars.append(self.ctx.env.add_variable(ty.Variable.from_param(param))),
      ),
    }
  }

  fn push_closure_env(self, captures: mut Ref<CaptureStack>) {
    captures.sets = captures.sets.append(
      CaptureSet { index: self.scope.bindings.length(), .. },
    )
  }

  fn pop_closure_env(self, captures: mut Ref<CaptureStack>) -> Slice<ast.Capture> {
    let mut captures = captures
    let last = captures.sets.length() - 1
    let mut env = []
    for variable in captures.sets[last].captures {
      env = env.append(ast.Capture.new(variable))
    }
    captures.sets = captures.sets[..last]
    env
  }

  fn closure_with(
    self: mut Resolver,
    captures: mut Ref<CaptureStack>,
    params: Slice<ty.Parameter>,
    body: cst.Block,
  ) -> Result<Expr, dx.ResolveError> {
    let ret_type = Type.Never
    self.push_closure_env(captures)
    let mut child = self
    child.scope = child.append_params(params)
    match child.block_with(captures, body) {
      Ok(body) => {
        let env = self.pop_closure_env(captures)
        Ok(Expr.Closure(ast.Closure { env, params, ret_type, body }))
      },
      Err(e) => {
        let _ = self.pop_closure_env(captures)
        Err(e)
      },
    }
  }

  #[allow(verbose_failure_propagation)]
  fn resolve_constructor(self, span: spn.Span, path: cst.Path, type_args: Option<Slice<cst.Type>>, payload: Ref<ast.Expression>) -> Result<Expr, dx.ResolveError> {
    match type_args {
      Some(type_args) => {
        let typ = self.ctx.eval_type(cst.Type.new(span, path, type_args))?
        Ok(Expr.Constructor(ast.Constructor.ResolvedStruct(typ), payload))
      },
      None => {
        let def = match self.ctx.env.get_type_def(span, path) {
          Ok(def) => def,
          Err(e) => return Err(e),
        }
        let cons = if def.type_parameters.is_empty() {
          let typ = self.ctx.eval_type(cst.Type.new(span, path, []))?
          ast.Constructor.ResolvedStruct(typ)
        } else {
          ast.Constructor.GenericStruct(def)
        }
        Ok(Expr.Constructor(cons, payload))
      },
    }
  }

  #[allow(verbose_failure_propagation)]
  fn resolve_enum_constructor(
    self,
    span: spn.Span,
    typ: Option<(cst.Path, Option<Slice<cst.Type>>)>,
    variant: string,
    payload: Ref<ast.Expression>
  ) -> Result<Expr, dx.ResolveError> {
    match typ {
      Some((path, Some(type_args))) => {
        let typ = self.ctx.eval_type(cst.Type.new(span, path, type_args))?
        let variant = match typ.variants().find(|v| v.name == variant) {
          None => return Err(dx.MissingNameError.new(variant, span)),
          Some(v) => v,
        }
        Ok(Expr.Constructor(ast.Constructor.ResolvedVariant(typ, variant), payload))
      },
      Some((path, None)) => {
        let def = match self.ctx.env.get_type_def(span, path) {
          Ok(def) => def,
          Err(e) => return Err(e),
        }
        let cons = if def.type_parameters.is_empty() {
          let typ = self.ctx.eval_type(cst.Type.new(span, path, []))?
          let variant = match typ.variants().find(|v| v.name == variant) {
            None => return Err(dx.MissingNameError.new(variant, span)),
            Some(v) => v,
          }
          ast.Constructor.ResolvedVariant(typ, variant)
        } else {
          ast.Constructor.GenericVariant(def, variant)
        }
        Ok(Expr.Constructor(cons, payload))
      },
      None => Ok(Expr.Constructor(
        ast.Constructor.BareVariant(variant),
        payload,
      )),
    }
  }

  fn binop(
    self: mut Resolver,
    captures: mut Ref<CaptureStack>,
    binop: cst.Binop,
    span: spn.Span,
  ) -> Result<Expr, dx.ResolveError> {
    match binop.op {
      Assign => {
        let value = self.resolve_with(captures, binop.right)?
        self.assign(captures, binop.left, &value)
      },
      Juxtaposition => {
        let payload = self.resolve_with(captures, binop.right)?
        match binop.left.kind {
          Type(path, type_args) => self.resolve_constructor(binop.left.span, path, type_args, &payload),
          EnumConstructor(typ, variant) => self.resolve_enum_constructor(binop.left.span, typ, variant, &payload),
          _ => panic("compiler bug: parser should only allow `Type` and `EnumConstructor` here."),
      }},
      _ => self.call(
        captures,
        cst.Path.name_(binop.op.sigil()),
        None,
        [
          self.resolve_with(captures, binop.left)?,
          self.resolve_with(captures, binop.right)?,
        ],
        span,
      )
    }
  }

  fn assign(
    self: mut Resolver,
    captures: mut Ref<CaptureStack>,
    lhs: cst.Expression,
    value: Ref<ast.Expression>,
  ) -> Result<Expr, dx.ResolveError> {
    match lhs.kind {
      Binding(mode, expr) => match expr.kind {
        Identifier(path) if path.namespace.is_empty() => {
          let mut ctx = self.ctx
          let varid = ctx.env.add_variable(ty.Variable.new(mode, path.name, lhs.span.start))
          return Ok(Expr.Declare(
            mode,
            varid,
            value,
          ))
        },
        _ => (),
      },
      Identifier(path) if path.namespace.is_empty() => {
        let mut ctx = self.ctx
        return match self.scope.get(ctx.env, path.name) {
          Some((i, varid)) => if i < self.last_capset(captures).index {
            Ok(Expr.AssignCapture(varid, value))
          } else {
            Ok(Expr.Assign(varid, value))
          },
          None => Err(dx.MissingNameError.new(path.name, lhs.span)),
        }
      },
      // TODO: destructuring assignment
      // (x, y) = (a, b)
      // Foo{x} = foo
      _ => (),
    }
    Err(dx.InvalidAssignmentTargetError.new(lhs.span, lhs))
  }

  fn if_expr(
    self: mut Resolver,
    captures: mut Ref<CaptureStack>,
    cond: cst.If,
  ) -> Result<Expr, dx.ResolveError> {
    Ok(ast.Expr.If(self.resolve_conditional(captures, cond)?))
  }

  fn resolve_conditional(
    self: mut Resolver,
    captures: mut Ref<CaptureStack>,
    cond: cst.If,
  ) -> Result<ast.If, dx.ResolveError> {
    let mut checks = [].reserve(cond.checks.length())
    for check in cond.checks {
      checks = checks.append(self.resolve_check(captures, check)?)
    }
    let default = match cond.default {
      Some(default) => Some(self.block_with(captures, default)?),
      None => None,
    }
    Ok(ast.If { checks, default })
  }

  fn resolve_check(
    self: mut Resolver,
    captures: mut Ref<CaptureStack>,
    check: cst.Check,
  ) -> Result<ast.Check, dx.ResolveError> {
    match check {
      Test(expr, block) => Ok(ast.Check.Test(
        self.resolve_with(captures, expr)?,
        self.block_with(captures, block)?,
      )),
      Match(subject, arms) => {
        let subject = self.resolve_with(captures, subject)?
        let mut resolved_arms = [].reserve(arms.length())
        for arm in arms {
          resolved_arms = resolved_arms.append(self.resolve_arm(captures, arm)?)
        }
        Ok(ast.Check.Match(subject, resolved_arms))
      },
    }
  }

  fn resolve_arm(
    self: mut Resolver,
    captures: mut Ref<CaptureStack>,
    arm: cst.Arm,
  ) -> Result<ast.Arm, dx.ResolveError> {
    let pattern = self.resolve_pattern(captures, arm.pattern)?
    let mut child = self
    child.scope = pattern.scope
    let then = match arm.then {
      Block(block) => ast.Then.Block(child.block_with(captures, block)?),
      If(cond) => ast.Then.If(child.resolve_conditional(captures, cond)?),
    }
    Ok(ast.Arm { pattern: pattern.expr, then })
  }

  fn resolve_pattern(
    self: mut Resolver,
    captures: mut Ref<CaptureStack>,
    node: cst.Expression,
  ) -> Result<ResolvedPattern, dx.ResolveError> {
    let expr: Expr = match node.kind {
      Identifier(cst.Path { namespace: [], name }) => {
        let mut ctx = self.ctx
        let varid = ctx.env.add_variable(ty.Variable.new(md.Mode.MutBang, name, node.span.start))
        return Ok(ResolvedPattern {
          expr: ast.Expression { span: node.span, kind: ast.Expr.Identifier(varid) },
          scope: self.scope.bind(varid),
        })
      },
      Nil => Expr.Nil,
      BoolLiteral(b) => Expr.BoolLiteral(b),
      IntLiteral(i) => Expr.IntLiteral(i),
      FloatLiteral(f) => Expr.FloatLiteral(f),
      Neg(expr) => match expr.kind {
        IntLiteral(i) => Expr.IntLiteral(-i),
        FloatLiteral(f) => Expr.FloatLiteral(-f),
        _ => return Err(dx.InvalidPatternError.new(node.span, node.kind)),
      },
      StringLiteral(s) => Expr.StringLiteral(s),
      TupleLiteral(elems) => {
        let patterns = self.resolve_patterns(captures, elems)?
        return Ok(ResolvedPattern {
          expr: ast.Expression {
            span: node.span,
            kind: ast.Expr.TupleLiteral(patterns.exprs),
          },
          scope: patterns.scope,
        })
      },
      RecordLiteral(fields) => {
        let patterns = self.resolve_field_patterns(captures, fields)?
        return Ok(ResolvedPattern {
          expr: ast.Expression {
            span: node.span,
            kind: ast.Expr.RecordLiteral(patterns.fields),
          },
          scope: patterns.scope,
        })
      },
      ArrayLiteral(elems) => {
        let patterns = self.resolve_patterns(captures, elems)?
        return Ok(ResolvedPattern {
          expr: ast.Expression {
            span: node.span,
            kind: ast.Expr.ArrayLiteral(patterns.exprs),
          },
          scope: patterns.scope,
        })
      },
      Type(_, _) |
      EnumConstructor(_, _) => return Ok(ResolvedPattern {
        expr: self.resolve_with(captures, node)?,
        scope: self.scope,
      }),
      Binop(binop) => return self.binop_pattern(captures, binop.*, node.span),
      // Not(expr) => Expr.Not(self.resolve_pattern(expr)?),
      Call(_) |
      DotCall(_, _) |
      DotName(_, _) |
      Identifier(_) |
      Not(_) |
      Binding(_, _) |
      Closure(_, _) |
      If(_) |
      While(_) |
      For(_) |
      Block(_) |
      Return(_) |
      Continue |
      Break(_) |
      Extern => return Err(dx.InvalidPatternError.new(node.span, node.kind)),
    }
    Ok(ResolvedPattern {
      expr: ast.Expression { span: node.span, kind: expr },
      scope: self.scope,
    })
  }

  fn resolve_patterns(
    self: mut Resolver,
    captures: mut Ref<CaptureStack>,
    nodes: Slice<cst.Expression>,
  ) -> Result<ResolvedPatterns, dx.ResolveError> {
    let mut current = self
    let mut exprs = [].reserve(nodes.length())
    for node in nodes {
      let pattern = current.resolve_pattern(captures, node)?
      current.scope = pattern.scope
      exprs = exprs.append(pattern.expr)
    }
    Ok(ResolvedPatterns { exprs, scope: current.scope })
  }

  fn resolve_field_patterns(
    self: mut Resolver,
    captures: mut Ref<CaptureStack>,
    fields: Slice<cst.RecordField>,
  ) -> Result<ResolvedFieldPatterns, dx.ResolveError> {
    let mut current = self
    let mut resolved_fields = [].reserve(fields.length())
    for field in fields {
      let pattern = current.resolve_pattern(captures, field.expr)?
      current.scope = pattern.scope
      resolved_fields = resolved_fields.append(ast.Field {
        span: field.span,
        name: field.name,
        expr: pattern.expr,
      })
    }
    Ok(ResolvedFieldPatterns { fields: resolved_fields, scope: current.scope })
  }

  fn binop_pattern(
    self: mut Resolver,
    captures: mut Ref<CaptureStack>,
    binop: cst.Binop,
    span: spn.Span,
  ) -> Result<ResolvedPattern, dx.ResolveError> {
    match binop.op {
      Juxtaposition => {
        let payload = self.resolve_pattern(captures, binop.right)?
        let expr = match binop.left.kind {
          Type(path, type_args) => self.resolve_constructor(binop.left.span, path, type_args, &payload.expr),
          EnumConstructor(typ, variant) => self.resolve_enum_constructor(binop.left.span, typ, variant, &payload.expr),
          _ => panic("compiler bug: parser should only allow `Type` and `EnumConstructor` here."),
        }?
        Ok(ResolvedPattern { expr: ast.Expression { span, kind: expr }, scope: payload.scope })
      },
      _ => Err(dx.InvalidPatternError.new(span, binop)),
    }
  }

