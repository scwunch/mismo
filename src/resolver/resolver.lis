import "ast"
import "cst"
import dx "diagnostics"
import "mode"
import "ty"
import "operator"
import "span"
import "utils/slice"

type Expr = ast.Expr

#[display]
pub struct Resolver {
  pub ctx: TypeContext,
  pub scope: Scope,
  pub capture_set_stack: Ref<Slice<CaptureSet>>,
}

impl Resolver {
  pub fn new(env: Ref<ast.Registry>, func: Ref<ast.FunctionDef>) -> Resolver {
    let scope = Scope.from_params(func.parameters)
    let ctx = TypeContext.new(env, func.type_parameters)
    let capture_set_stack = &Slice.new()
    Resolver { ctx, scope, capture_set_stack }
  }

  pub fn new_blank() -> Resolver {
    Resolver.new(
      &ast.Registry.new(),
      &ast.FunctionDef.mock("dummy", [], [], ty.nil()),
    )
  }

  pub fn with_mock_prelude() -> Resolver {
    Resolver.new(
      ast.Registry.with_mock_prelude(),
      &ast.FunctionDef.mock("dummy", [], [], ty.nil()),
    )
  }

  pub fn resolve(self, node: cst.Expression) -> Result<ast.Expression, dx.ResolveError> {
    let expr: Expr = match node.kind {
      Nil => Expr.Nil,
      BoolLiteral(b) => Expr.BoolLiteral(b),
      IntLiteral(i) => Expr.IntLiteral(i),
      FloatLiteral(f) => Expr.FloatLiteral(f),
      StringLiteral(s) => Expr.StringLiteral(s),
      ArrayLiteral(elems) => Expr.ArrayLiteral(
        slice.map_result(elems, self.resolve)?,
      ),
      TupleLiteral(elems) => Expr.TupleLiteral(
        slice.map_result(elems, self.resolve)?,
      ),
      Closure(params, body) => self.closure(
        slice.map_result(params, self.ctx.eval_param)?,
        body,
      )?,
      Identifier(path) => self.resolve_path(path, node.span)?,
      Binding(m, expr) => {
        let e = self.resolve(expr.*)?
        Expr.Binding(m, &e)
      },
      Binop(binop) => self.binop(binop.*, node.span)?,
      Call(call) => {
        let args = slice.map_result(call.args, self.resolve)?
        self.call(call.fn_name, call.type_args, args, node.span)?
      },
      If(cond) => self.if_expr(cond)?,
      While(cond) => self.while_expr(cond)?,
      For(for_loop) => self.for_expr(for_loop.*, node.span)?,
      Block(exprs) => Expr.Block(self.block(exprs)?),
      Neg(expr) => {
        let arg = [self.resolve(expr.*)?]
        self.bare_call("-", arg, false, node.span)?
      },
      Not(expr) => {
        let arg = [self.resolve(expr.*)?]
        self.bare_call("not", arg, false, node.span)?
      },
      Return(None) => Expr.Return(None),
      Return(Some(expr)) => {
        let e = self.resolve(expr.*)?
        Expr.Return(Some(&e))
      },
      Break(None) => Expr.Break(None),
      Break(Some(expr)) => {
        let e = self.resolve(expr.*)?
        Expr.Break(Some(&e))
      },
      Continue => Expr.Continue,
      DotName(expr, name) => {
        let arg = [self.resolve(expr.*)?]
        self.bare_call(name, arg, true, node.span)?
      },
      DotCall(expr, call) => self.call(
        call.fn_name,
        call.type_args,
        [self.resolve(expr.*)?].append(slice.map_result(call.args, self.resolve)?...),
        node.span,
      )?,
      TypeDotCall(path, type_args, call) => self.type_dot_call(
        path,
        slice.map_result(type_args, self.ctx.eval_type)?,
        call,
        node.span,
      )?,
      Extern => Expr.Extern,
    }
    Ok(ast.Expression { span: node.span, kind: expr })
  }

  fn resolve_path(self, path: cst.Path, span: span.Span) -> Result<Expr, dx.ResolveError> {
    if path.namespace.is_empty() {
      match self.scope.get(path.name) {
        Some((idx, varid)) => {
          if self.capture(varid, idx) {
            Ok(Expr.CapturedIdent(varid))
          } else {
            Ok(Expr.Identifier(varid))
          }
        },
        None => Err(dx.MissingNameError.new(path.name, span)),
      }
    } else {
      Err(dx.MissingNameError.new(
        f"{path.namespace.join("::")}::{path.name}",
        span,
      ))
    }
  }

  /// add variable to capture set of all closures outside current scope
  /// return `true` if captured, false, otherwise
  fn capture(self, varid: Ref<ty.Variable>, index: int) -> bool {
    // let mut self = &self
    let mut is_capture = false
    for i in 0..self.capture_set_stack.length() {
      let capset = &self.capture_set_stack.*[i]
      if index < capset.index {
        is_capture = true
        capset.captures = capset.captures.append(varid)
      }
    }
    is_capture
  }

  pub fn block(self, block: cst.Block) -> Result<ast.Block, dx.ResolveError> {
    let self = &self
    let expressions = slice.map_result(
      block.statements,
      |stmt| {
        let expr = self.resolve(stmt)?
        if let Expr.Declare(_, varid, _) = expr.kind {
          self.scope.bindings = self.scope.bindings.append(varid)
        }
        Ok(expr)
      },
    )?
    Ok(ast.Block.new(expressions))
  }

  fn append_params(self, params: Slice<ty.Parameter>) -> Slice<Ref<ty.Variable>> {
    params.fold(
      self.scope.bindings,
      |vars, param| vars.append(&ty.Variable.from_param(param)),
    )
  }

  fn push_closure_env(self) {
    self.capture_set_stack.* = self.capture_set_stack.*.append(
      CaptureSet { index: self.scope.bindings.length(), .. },
    )
  }

  fn pop_closure_env(self) -> Slice<ast.Capture> {
    let last = self.capture_set_stack.length() - 1
    let env = self.capture_set_stack.*[last].captures.map(ast.Capture.new)
    self.capture_set_stack.* = self.capture_set_stack.*[..last]
    env
  }

  fn closure(self, params: Slice<ty.Parameter>, body: cst.Block) -> Result<Expr, dx.ResolveError> {
    let self = &self
    let ret_type = Type.Never
    self.push_closure_env()
    self.scope.bindings = self.append_params(params)
    let body = self.block(body)?
    let env = self.pop_closure_env()
    Ok(Expr.Closure(ast.Closure { env, params, ret_type, body }))
  }

  fn binop(self, binop: cst.Binop, span: span.Span) -> Result<Expr, dx.ResolveError> {
    if binop.op == operator.Operator.Assign {
      let value = self.resolve(binop.right)?
      self.assign(binop.left, &value)
    } else {
      self.call(
        cst.Path.name_(binop.op.sigil()),
        None,
        [self.resolve(binop.left)?, self.resolve(binop.right)?],
        span,
      )
    }
  }

  fn assign(self, lhs: cst.Expression, value: Ref<ast.Expression>) -> Result<Expr, dx.ResolveError> {
    match lhs.kind {
      Binding(mode, expr) => match expr.kind {
        Identifier(path) if path.namespace.is_empty() => {
          return Ok(Expr.Declare(
            mode,
            &ty.Variable.new(mode, path.name, lhs.span.start),
            value,
          ))
        },
        _ => (),
      },
      Identifier(path) if path.namespace.is_empty() => {
        return match self.scope.get(path.name) {
          Some((i, varid)) => if i < self.last_capset().index {
            Ok(Expr.AssignCapture(varid, value))
          } else {
            Ok(Expr.Assign(varid, value))
          },
          None => Err(dx.MissingNameError.new(path.name, lhs.span)),
        }
      },
      // TODO: destructuring assignment
      // (x, y) = (a, b)
      // Foo{x} = foo
      _ => (),
    }
    Err(dx.InvalidAssignmentTargetError.new(lhs.span, lhs))
  }

  fn if_expr(self, cond: cst.If) -> Result<Expr, dx.ResolveError> {
    Ok(ast.Expr.If(self.resolve_conditional(cond)?))
  }

  fn resolve_conditional(self, cond: cst.If) -> Result<ast.If, dx.ResolveError> {
    let checks = slice.map_result(cond.checks, self.resolve_check)?
    let default = match cond.default {
      Some(default) => Some(self.block(default)?),
      None => None,
    }
    Ok(ast.If { checks, default })
  }

  fn resolve_check(self, check: cst.Check) -> Result<ast.Check, dx.ResolveError> {
    match check {
      Test(expr, block) => Ok(ast.Check.Test(
        self.resolve(expr)?,
        self.block(block)?,
      )),
      Match(subject, arms) => {
        let subject = self.resolve(subject)?
        let arms = slice.map_result(arms, self.resolve_arm)?
        Ok(ast.Check.Match(subject, arms))
      },
    }
  }

  fn resolve_arm(self, arm: cst.Arm) -> Result<ast.Arm, dx.ResolveError> {
    let self = &self
    let pattern = self.resolve_pattern(arm.pattern)?
    let then = match arm.then {
      Block(block) => ast.Then.Block(self.block(block)?),
      If(cond) => ast.Then.If(self.resolve_conditional(cond)?),
    }
    Ok(ast.Arm { pattern, then })
  }

  fn resolve_pattern(self: Ref<Resolver>, node: cst.Expression) -> Result<ast.Expression, dx.ResolveError> {
    let expr: Expr = match node.kind {
      Identifier(cst.Path { namespace: [], name }) => {
        let varid = &ty.Variable.new(mode.Mode.MutBang, name, node.span.start)
        self.scope.bindings = self.scope.bindings.append(varid)
        ast.Expr.Identifier(varid)
      },
      Nil => Expr.Nil,
      BoolLiteral(b) => Expr.BoolLiteral(b),
      IntLiteral(i) => Expr.IntLiteral(i),
      FloatLiteral(f) => Expr.FloatLiteral(f),
      Neg(expr) => match expr.kind {
        IntLiteral(i) => Expr.IntLiteral(-i),
        FloatLiteral(f) => Expr.FloatLiteral(-f),
        _ => return Err(dx.InvalidPatternError.new(node.span, node.kind)),
      },
      StringLiteral(s) => Expr.StringLiteral(s),
      TupleLiteral(elems) => ast.Expr.TupleLiteral(
        slice.map_result(elems, self.resolve_pattern)?,
      ),
      ArrayLiteral(elems) => ast.Expr.ArrayLiteral(
        slice.map_result(elems, self.resolve_pattern)?,
      ),
      DotName(expr, name) => {
        self.resolve_qualified_constructor(expr, name, [])?
      },
      DotCall(expr, call) if call.fn_name.namespace.is_empty() => {
        self.resolve_qualified_constructor(expr, call.fn_name.name, call.args)?
      },
      Call(call) if call.fn_name.namespace.is_empty() => {
        // raise error if fn_name is namespaced
        let variant = call.fn_name.name
        let args = slice.map_result(call.args, self.resolve_pattern)?
        Expr.BareConstructor(variant, args)
      },
      // Not(expr) => Expr.Not(self.resolve_pattern(expr)?),
      Call(_) |
      DotCall(_, _) |
      Identifier(_) |
      Not(_) |
      TypeDotCall(_, _, _) |
      Binding(_, _) |
      Closure(_, _) |
      Binop(_) |
      If(_) |
      While(_) |
      For(_) |
      Block(_) |
      Return(_) |
      Continue |
      Break(_) |
      Extern => return Err(dx.InvalidPatternError.new(node.span, node.kind)),
    }
    Ok(ast.Expression { span: node.span, kind: expr })
  }

  // TODO: the verbose `match` is a workaround for compiler bug
  #[allow(verbose_failure_propagation)]
  fn resolve_qualified_constructor(
    self: Ref<Resolver>,
    expr: Ref<cst.Expression>,
    name: string,
    args: Slice<cst.Expression>,
  ) -> Result<Expr, dx.ResolveError> {
    let cst.Expr.Identifier(path) = expr.kind else {
      return Err(dx.InvalidPatternError.new(expr.span, expr.kind))
    }
    let type_def = match self.get_type_def(path, expr.span) {
      Ok(td) => td,
      Err(e) => return Err(e),
    }
    let ty.TypeKind.Enum(variants) = type_def.kind else {
      return Err(dx.InvalidPatternError.new(expr.span, expr.kind))
    }
    let variant = match variants.filter(|v| v.name == name) {
      [variant] => variant,
      _ => return Err(dx.MissingNameError.new(name, expr.span)),
    }
    let args = slice.map_result(args, self.resolve_pattern)?
    Ok(Expr.EnumConstructor(type_def, variant, args))
  }

  fn while_expr(self, cond: cst.If) -> Result<Expr, dx.ResolveError> {
    let cond = self.resolve_conditional(cond)?
    Ok(ast.Expr.While(cond))
