  fn for_expr(
    self: mut Resolver,
    _captures: mut Ref<CaptureStack>,
    for_loop: cst.ForLoop,
    span: spn.Span,
  ) -> Result<Expr, dx.ResolveError> {
    let _ = for_loop
    let _ = span
    panic("not implemented yet")
  }

  fn dot_name(
    self: mut Resolver,
    captures: mut Ref<CaptureStack>,
    span: spn.Span,
    expr: cst.Expression,
    name: string,
  ) -> Result<Expr, dx.ResolveError> {
    match expr.kind {
      Type(path, type_args) => {
        self.type_dot_call(
          captures,
          path,
          type_args,
          cst.Call{fn_name: cst.Path.name_(name), ..},
          span,
        )
      },
      _ => {
        let arg = [self.resolve_with(captures, expr)?]
        self.bare_call(captures, name, arg, true, span)
      }
    }
  }

  fn dot_call(
    self: mut Resolver,
    captures: mut Ref<CaptureStack>,
    expr: Ref<cst.Expression>,
    call: cst.Call,
    span: spn.Span,
  ) -> Result<Expr, dx.ResolveError> {
    let receiver = match expr.kind {
      Type(path, type_args) => return self.type_dot_call(captures, path, type_args, call, span),
      _ => self.resolve_with(captures, expr.*)?,
    }
    let mut args = [].reserve(call.args.length())
    args = args.append(receiver)
    for arg in call.args {
      args = args.append(self.resolve_with(captures, arg)?)
    }
    self.call(
      captures,
      call.fn_name,
      call.type_args,
      args,
      // [receiver].append(slice.map_result(call.args, self.resolve)?...),
      span,
    )
  }

  fn type_dot_call(
    self: mut Resolver,
    captures: mut Ref<CaptureStack>,
    type_path: cst.Path,
    type_args: Option<Slice<cst.Type>>,
    call: cst.Call,
    span: spn.Span,
  ) -> Result<Expr, dx.ResolveError> {
    let module = match type_path.namespace {
      [] => self.ctx.env.*,
      path => self.ctx.env.get_module(span, type_path)?,
    }
    let type_def = module.type_defs
      .get(type_path.name)
      .ok_or_else(|| dx.MissingNameError.new(type_path.name, span) as dx.ResolveError)?
    let global_candidates = type_def
      .signatures
      .get(call.fn_name.name)
      .ok_or_else(|| dx.MissingNameError.new(call.fn_name.name, span) as dx.ResolveError)?
      .map(|i| module.function_defs[i])
    if global_candidates.is_empty() {
      return Err(
        dx.MissingNameError.new(call.fn_name.name, span) as dx.ResolveError,
      )
    }
    // combine the type args from the type with the type args with the type args from the call
    let type_args = match (type_args, call.type_args) {
      (None, None) => None,
      (Some(ta), None) => {
        Some(slice.map_result(ta, self.ctx.eval_type)?)
      },
      (None, Some(ta)) => {
        Some(slice.map_result(ta, self.ctx.eval_type)?)
      },
      (Some(ta1), Some(ta2)) => {
        Some(slice.map_result(ta1.append(ta2...), self.ctx.eval_type)?)
      },
    }
    let args = self.resolve_expressions(captures, call.args)?
    Ok(ast.Expr.Call(
      ast.Call {
        local_candidates: [],
        global_candidates,
        type_args,
        args,
        field: None,
      },
    ))
  }

  fn call(
    self: mut Resolver,
    captures: mut Ref<CaptureStack>,
    fname: cst.Path,
    type_args: Option<Slice<cst.Type>>,
    args: Slice<ast.Expression>,
    span: spn.Span,
  ) -> Result<Expr, dx.ResolveError> {
    if let ([], None) = (fname.namespace, type_args) {
      return self.bare_call(captures, fname.name, args, false, span)
    }
    let type_args = match type_args {
      None => None,
      Some(ta) => Some(slice.map_result(ta, self.ctx.eval_type)?),
    }
    let module = if fname.namespace.is_empty() {
      self.ctx.env.*
    } else {
      self.ctx.env.get_module(span, fname)?
    }
    let global_candidates = module.signatures
      .get(fname.name)
      .ok_or_else(|| dx.MissingNameError.new(fname.name, span) as dx.ResolveError)?
    if global_candidates.is_empty() {
      return Err(dx.MissingNameError.new(fname.name, span) as dx.ResolveError)
    }
    Ok(ast.Expr.Call(
      ast.Call {
        local_candidates: [],
        global_candidates,
        type_args,
        args,
        field: None,
      },
    ))
  }

  /// handle the syntax `foo(args)`, `foo.bar(args)` and `foo.bar`
  fn bare_call(
    self: mut Resolver,
    captures: mut Ref<CaptureStack>,
    fname: string,
    args: Slice<ast.Expression>,
    is_dotname: bool,
    span: spn.Span,
  ) -> Result<ast.Expr, dx.ResolveError> {
    let mut ctx = self.ctx
    let local_candidates = self.scope.bindings.filter(|id| ctx.env.variable(id).name == fname)
    for v in local_candidates {
      // capture ALL local names that match, just in case they might be used
      // TODO: during typechecking, just add the resolved local closure variable to all the containing closure capture sets
      //       I guess that means we have to track the stack of closure capture sets during typechecking too
      let _ = self.capture(captures, v, -1)
    }
    let global_candidates = self.ctx.env.signatures
      .get(fname)
      .ok_or_else(|| dx.MissingNameError.new(fname, span) as dx.ResolveError)?
    if let (false, [], []) = (is_dotname, global_candidates, local_candidates) {
      return Err(dx.MissingNameError.new(fname, span) as dx.ResolveError)
    }
    let field = if is_dotname { Some(fname) } else { None }
    Ok(ast.Expr.Call(
      ast.Call {
        local_candidates,
        global_candidates,
        type_args: None,
        args,
        field,
      },
    ))
  }

  fn last_capset(self, captures: mut Ref<CaptureStack>) -> CaptureSet {
    let size = captures.sets.length()
    captures.sets.get(size - 1).unwrap_or(CaptureSet { index: -1, .. })
  }
}

/// index: the boundary in the stack of variables at which the closure scope opens
/// captures: the set of variables outside the scope of the closure
struct CaptureSet { index: int, captures: Slice<ty.VarId> }

struct CaptureStack { sets: mut Slice<CaptureSet> }

impl CaptureStack {
  fn new() -> mut CaptureStack {
    CaptureStack { sets: [] }
  }
}

struct ResolvedPattern {
  expr: ast.Expression,
  scope: Scope,
}

struct ResolvedPatterns {
  exprs: Slice<ast.Expression>,
  scope: Scope,
}

struct ResolvedFieldPatterns {
  fields: Slice<ast.Field>,
  scope: Scope,
}

impl CaptureSet {
  fn string(self) -> string {
    f"CaptureSet(index={self.index}, captures={self.captures})"
  }
}

/// an immutable stack of bindings
/// scope is *shallow-copied* on every function call, so the length only ever increases with Go's call stack depth
/// this naturally mirrors the scoping rules of Mismo's tree-shaped CST.
pub struct Scope { bindings: Slice<ty.VarId> }

impl Scope {
  fn from_params(env: mut Ref<mut ast.Registry>, params: Slice<ty.Parameter>) -> Scope {
    Scope { bindings: params.map(|p| env.add_variable(ty.Variable.from_param(p))) }
  }

  fn bind(self, variable: ty.VarId) -> Scope {
    Scope { bindings: self.bindings.append(variable) }
  }

  // if name in scope, return variable and whether it is captured or not
  // search start from top (most recent) of stack
  fn get(self, env: mut Ref<mut ast.Registry>, name: string) -> Option<(int, ty.VarId)> {
    let mut i = self.bindings.length()
    while i > 0 {
      i -= 1
      let id = self.bindings[i]
      if env.variable(id).name == name { return Some((i, id)) }
    }
    None
  }
}
