import "ast"
import "cst"
import dx "diagnostics"
import "operator"
import "span"
import "utils/slice"

type Expr = ast.Expr

#[display]
pub struct Resolver {
  pub ctx: TypeContext,
  pub scope: Scope,
  pub capture_set_stack: Ref<Slice<CaptureSet>>,
}

impl Resolver {
  fn new(env: Ref<ast.Registry>, func: Ref<ast.Function>) -> Resolver {
    let scope = Scope.from_params(func.parameters)
    let ctx = TypeContext.new(env, func.type_parameters)
    let capture_set_stack = &Slice.new()
    Resolver { ctx, scope, capture_set_stack }
  }

  fn new_blank() -> Resolver {
    Resolver.new(
      &ast.Registry.new(),
      &ast.FunctionDef.mock("dummy", [], [], Type.nil()),
    )
  }

  fn resolve(self, node: cst.Expression) -> Result<ast.Expression, dx.ResolveError> {
    let expr: Expr = match node.kind {
      Nil => Expr.Nil,
      BoolLiteral(b) => Expr.BoolLiteral(b),
      IntLiteral(i) => Expr.IntLiteral(i),
      FloatLiteral(f) => Expr.FloatLiteral(f),
      StringLiteral(s) => Expr.StringLiteral(s),
      ArrayLiteral(elems) => Expr.ArrayLiteral(
        slice.map_result(elems, self.resolve)?,
      ),
      TupleLiteral(elems) => Expr.TupleLiteral(
        slice.map_result(elems, self.resolve)?,
      ),
      Closure(params, body) => self.closure(
        slice.map_result(params, self.ctx.eval_param)?,
        body,
      )?,
      Identifier(path) => self.resolve_path(path, node.span)?,
      Binding(m, expr) => {
        let e = self.resolve(expr.*)?
        Expr.Binding(m, &e)
      },
      Binop(binop) => self.binop(binop.*, node.span)?,
      Call(call) => self.call(
        call.fn_name,
        slice.map_result(call.type_args.unwrap_or([]), self.ctx.eval_type)?,
        slice.map_result(call.args, self.resolve)?,
        node.span,
      )?,
      If(cond) => self.if_expr(cond, node.span)?,
      While(cond) => self.while_expr(cond, node.span)?,
      For(for_loop) => self.for_expr(for_loop.*, node.span)?,
      Block(exprs) => Expr.Block(self.block(exprs)?),
      Neg(expr) => self.call(
        cst.Path.name_("neg"),
        [],
        [self.resolve(expr.*)?],
        node.span,
      )?,
      Not(expr) => self.call(
        cst.Path.name_("not"),
        [],
        [self.resolve(expr.*)?],
        node.span,
      )?,
      Return(None) => Expr.Return(None),
      Return(Some(expr)) => {
        let e = self.resolve(expr.*)?
        Expr.Return(Some(&e))
      },
      Break(None) => Expr.Break(None),
      Break(Some(expr)) => {
        let e = self.resolve(expr.*)?
        Expr.Break(Some(&e))
      },
      Continue => Expr.Continue,
      DotName(expr, name) => self.dot_name(
        self.resolve(expr.*)?,
        name,
        node.span,
      )?,
      DotCall(expr, call) => self.call(
        call.fn_name,
        slice.map_result(call.type_args.unwrap_or([]), self.ctx.eval_type)?,
        [self.resolve(expr.*)?].append(slice.map_result(call.args, self.resolve)?...),
        node.span,
      )?,
      TypeDotCall(path, type_args, call) => self.type_dot_call(
        path,
        slice.map_result(type_args, self.ctx.eval_type)?,
        call,
        node.span,
      )?,
      Extern => Expr.Extern,
    }
    Ok(ast.Expression { span: node.span, kind: expr })
  }

  fn resolve_path(self, path: cst.Path, span: span.Span) -> Result<Expr, dx.ResolveError> {
    if path.namespace.is_empty() {
      match self.scope.get(path.name) {
        Some((idx, varid)) => {
          if self.capture(varid, idx) {
            Ok(Expr.CapturedIdent(varid))
          } else {
            Ok(Expr.Identifier(varid))
          }
        },
        None => Err(dx.MissingNameError.new(path.name, span)),
      }
    } else {
      Err(dx.MissingNameError.new(
        f"{path.namespace.join("::")}::{path.name}",
        span,
      ))
    }
  }

  /// add variable to capture set of all closures outside current scope
  /// return `true` if captured, false, otherwise
  fn capture(self, varid: Ref<ast.Variable>, index: int) -> bool {
    let mut self = self
    let mut is_capture = false
    for i in 0..self.capture_set_stack.length() {
      let capset = &self.capture_set_stack.*[i]
      if index < capset.index {
        is_capture = true
        capset.captures = capset.captures.append(varid)
      }
    }
    is_capture
  }

  fn block(self, block: cst.Block) -> Result<ast.Block, dx.ResolveError> {
    let mut self = self
    let expressions = slice.map_result(
      block.statements,
      |stmt| {
        let expr = self.resolve(stmt)?
        if let Expr.Declare(_, varid, _) = expr.kind {
          self.scope.bindings = self.scope.bindings.append(varid)
        }
        Ok(expr)
      },
    )?
    Ok(ast.Block.new(expressions))
  }

  fn append_params(self, params: Slice<ast.Parameter>) -> Slice<Ref<ast.Variable>> {
    params.fold(
      self.scope.bindings,
      |vars, param| vars.append(&ast.Variable.from_param(param)),
    )
  }

  fn push_closure_env(self) {
    self.capture_set_stack.* = self.capture_set_stack.*.append(
      CaptureSet { index: self.scope.bindings.length(), .. },
    )
  }

  fn pop_closure_env(self) -> Slice<ast.Capture> {
    let last = self.capture_set_stack.length() - 1
    let env = self.capture_set_stack.*[last].captures.map(ast.Capture.new)
    self.capture_set_stack.* = self.capture_set_stack.*[..last]
    env
  }

  fn closure(self, params: Slice<ast.Parameter>, body: cst.Block) -> Result<Expr, dx.ResolveError> {
    let mut self = self
    let ret_type = Type.Never
    self.push_closure_env()
    self.scope.bindings = self.append_params(params)
    let body = self.block(body)?
    let env = self.pop_closure_env()
    Ok(Expr.Closure(ast.Closure { env, params, ret_type, body }))
    // Ok(Expression.new(span, Expr.Closure(closure)))
  }

  fn binop(self, binop: cst.Binop, span: span.Span) -> Result<Expr, dx.ResolveError> {
    if binop.op == operator.Operator.Assign {
      let value = self.resolve(binop.right)?
      let value = &value
      self.assign(binop.left, value)
    } else {
      self.call(
        cst.Path.name_(binop.op.sigil()),
        [],
        [self.resolve(binop.left)?, self.resolve(binop.right)?],
        span,
      )
    }
  }

  fn assign(self, lhs: cst.Expression, value: Ref<ast.Expression>) -> Result<Expr, dx.ResolveError> {
    match lhs.kind {
      Binding(mode, expr) => match expr.kind {
        Identifier(path) if path.namespace.is_empty() => {
          return Ok(Expr.Declare(
            mode,
            &ast.Variable.new(mode, path.name, lhs.span.start),
            value,
          ))
        },
        _ => (),
      },
      Identifier(path) if path.namespace.is_empty() => {
        return match self.scope.get(path.name) {
          Some((i, varid)) => if i < self.last_capset().index {
            Ok(Expr.AssignCapture(varid, value))
          } else {
            Ok(Expr.Assign(varid, value))
          },
          None => Err(dx.MissingNameError.new(path.name, lhs.span)),
        }
      },
      // TODO: destructuring assignment
      // (x, y) = (a, b)
      // Foo{x} = foo
      _ => (),
    }
    Err(dx.InvalidAssignmentTargetError.new(lhs.span, lhs))
  }

  fn if_expr(self, cond: cst.Conditional, span: span.Span) -> Result<Expr, dx.ResolveError> {
    let _ = cond
    let _ = span
    panic("not implemented yet")
  }

  fn while_expr(self, cond: cst.Conditional, span: span.Span) -> Result<Expr, dx.ResolveError> {
    let _ = span
    match cond {
      Binary { .. } => panic(
        "Conditonal.Binary not implemented yet for while loops",
      ),
      Unary { expr, consequent } => {
        let cond = self.resolve(expr.*)?
        let body = self.block(consequent)?
        Ok(ast.Expr.While(&cond, body))
      },
      Multi(conds) => panic(
        "Conditonal.Multi not implemented yet for while loops",
      ),
      Else { .. } => panic(
        "Conditonal.Else not implemented yet for while loops",
      ),
    }
  }

  fn for_expr(self, for_loop: cst.ForLoop, span: span.Span) -> Result<Expr, dx.ResolveError> {
    let _ = for_loop
    let _ = span
    panic("not implemented yet")
  }

  fn dot_name(self, expr: ast.Expression, name: string, span: span.Span) -> Result<Expr, dx.ResolveError> {
    panic((name, [], [expr], span))
  }

  fn type_dot_call(
    self,
    type_path: cst.Path,
    type_args: Slice<Type>,
    call: cst.Call,
    span: span.Span,
  ) -> Result<Expr, dx.ResolveError> {
    panic((type_path, type_args, call, span))
  }

  fn call(
    self,
    fname: cst.Path,
    type_args: Slice<Type>,
    args: Slice<ast.Expression>,
    span: span.Span,
  ) -> Result<Expr, dx.ResolveError> {
    panic((fname, type_args, args, span))
  }

  // fn get_local_functions(self, fname: string) -> Slice<Ref<ast.Variable>> {
  //   panic(fname)
  // }

  fn last_capset(self) -> CaptureSet {
    let size = self.capture_set_stack.length()
    self.capture_set_stack.get(size - 1).unwrap_or(CaptureSet { index: -1, .. })
  }
}

/// index: the boundary in the stack of variables at which the closure scope opens
/// captures: the set of variables outside the scope of the closure
struct CaptureSet { index: int, captures: Slice<Ref<ast.Variable>> }

impl CaptureSet {
  fn string(self) -> string {
    f"CaptureSet(index={self.index}, captures={self.captures.map(|v| v.name)})"
  }
}

/// an immutable stack of bindings
/// scope is *shallow-copied* on every function call, so the length only ever increases with Go's call stack depth
/// this naturally mirrors the scoping rules of Mismo's tree-shaped CST.
pub struct Scope { bindings: Slice<Ref<ast.Variable>> }

impl Scope {
  fn from_params(params: Slice<ast.Parameter>) -> Scope {
    Scope { bindings: params.map(|p| &ast.Variable.from_param(p)) }
  }

  // if name in scope, return variable and whether it is captured or not
  // search start from top (most recent) of stack
  fn get(self, name: string) -> Option<(int, Ref<ast.Variable>)> {
    let mut i = self.bindings.length()
    while i > 0 {
      i -= 1
      let v = self.bindings[i]
      if v.name == name { return Some((i, v)) }
    }
    None
  }
}
