  }

  fn for_expr(self, for_loop: cst.ForLoop, span: span.Span) -> Result<Expr, dx.ResolveError> {
    let _ = for_loop
    let _ = span
    panic("not implemented yet")
  }

  fn get_type_def(self, type_path: cst.Path, span: span.Span) -> Result<Ref<ty.TypeDef>, dx.ResolveError> {
    self.ctx.env.get_module(span, type_path)?.type_defs
      .get(type_path.name)
      .ok_or_else(|| dx.MissingNameError.new(type_path.name, span) as dx.ResolveError)
  }

  fn type_dot_call(
    self,
    type_path: cst.Path,
    type_args: Slice<Type>,
    call: cst.Call,
    span: span.Span,
  ) -> Result<Expr, dx.ResolveError> {
    let module = match type_path.namespace {
      [] => self.ctx.env.*,
      path => self.ctx.env.get_module(span, type_path)?,
    }
    let global_candidates = module.type_defs
      .get(type_path.name)
      .ok_or_else(|| dx.MissingNameError.new(type_path.name, span) as dx.ResolveError)?
      .signatures
      .get(call.fn_name.name)
      .ok_or_else(|| dx.MissingNameError.new(call.fn_name.name, span) as dx.ResolveError)?
      .map(|i| module.function_defs[i])
    if global_candidates.is_empty() {
      return Err(
        dx.MissingNameError.new(call.fn_name.name, span) as dx.ResolveError,
      )
    }
    // combine the type args from the type with the type args with the type args from the call
    let type_args = match call.type_args {
      None => Some(type_args),
      Some(ta) => Some(type_args.append(slice.map_result(ta, self.ctx.eval_type)?...)),
    }
    let args = slice.map_result(call.args, self.resolve)?
    Ok(ast.Expr.Call(
      ast.Call {
        local_candidates: [],
        global_candidates,
        type_args,
        args,
        field: None,
      },
    ))
  }

  fn call(
    self,
    fname: cst.Path,
    type_args: Option<Slice<cst.Type>>,
    args: Slice<ast.Expression>,
    span: span.Span,
  ) -> Result<Expr, dx.ResolveError> {
    if let ([], None) = (fname.namespace, type_args) {
      return self.bare_call(fname.name, args, false, span)
    }
    let type_args = match type_args {
      None => None,
      Some(ta) => Some(slice.map_result(ta, self.ctx.eval_type)?),
    }
    let module = if fname.namespace.is_empty() {
      self.ctx.env.*
    } else {
      self.ctx.env.get_module(span, fname)?
    }
    let global_candidates = module.signatures
      .get(fname.name)
      .ok_or_else(|| dx.MissingNameError.new(fname.name, span) as dx.ResolveError)?
    if global_candidates.is_empty() {
      return Err(dx.MissingNameError.new(fname.name, span) as dx.ResolveError)
    }
    Ok(ast.Expr.Call(
      ast.Call {
        local_candidates: [],
        global_candidates,
        type_args,
        args,
        field: None,
      },
    ))
  }

  /// handle the syntax `foo(args)`, `foo.bar(args)` and `foo.bar`
  fn bare_call(
    self,
    fname: string,
    args: Slice<ast.Expression>,
    is_dotname: bool,
    span: span.Span,
  ) -> Result<ast.Expr, dx.ResolveError> {
    let local_candidates = self.scope.bindings.filter(|v| v.name == fname)
    for v in local_candidates {
      // capture ALL local names that match, just in case they might be used
      // TODO: during typechecking, just add the resolved local closure variable to all the containing closure capture sets
      //       I guess that means we have to track the stack of closure capture sets during typechecking too
      let _ = self.capture(v, -1)
    }
    let global_candidates = self.ctx.env.signatures
      .get(fname)
      .ok_or_else(|| dx.MissingNameError.new(fname, span) as dx.ResolveError)?
    if let (false, [], []) = (is_dotname, global_candidates, local_candidates) {
      return Err(dx.MissingNameError.new(fname, span) as dx.ResolveError)
    }
    let field = if is_dotname {Some(fname)} else {None}
    Ok(ast.Expr.Call(
      ast.Call {
        local_candidates,
        global_candidates,
        type_args: None,
        args,
        field,
      },
    ))
  }

  fn last_capset(self) -> CaptureSet {
    let size = self.capture_set_stack.length()
    self.capture_set_stack.get(size - 1).unwrap_or(CaptureSet { index: -1, .. })
  }
}

/// index: the boundary in the stack of variables at which the closure scope opens
/// captures: the set of variables outside the scope of the closure
struct CaptureSet { index: int, captures: Slice<Ref<ty.Variable>> }

impl CaptureSet {
  fn string(self) -> string {
    f"CaptureSet(index={self.index}, captures={self.captures.map(|v| v.name)})"
  }
}

/// an immutable stack of bindings
/// scope is *shallow-copied* on every function call, so the length only ever increases with Go's call stack depth
/// this naturally mirrors the scoping rules of Mismo's tree-shaped CST.
pub struct Scope { bindings: Slice<Ref<ty.Variable>> }

impl Scope {
  fn from_params(params: Slice<ty.Parameter>) -> Scope {
    Scope { bindings: params.map(|p| &ty.Variable.from_param(p)) }
  }

  // if name in scope, return variable and whether it is captured or not
  // search start from top (most recent) of stack
  fn get(self, name: string) -> Option<(int, Ref<ty.Variable>)> {
    let mut i = self.bindings.length()
    while i > 0 {
      i -= 1
      let v = self.bindings[i]
      if v.name == name { return Some((i, v)) }
    }
    None
  }
}
