import "go:fmt"

import "cst"
import dx "diagnostics"
import myt "testing"
import "operator"

#[test("parser/top-level")]
fn test_parser_top_level(t) {
  for test in [
    test_consume,
    test_parse_type_params,
    test_parse_type,
    test_parse_tuple_type,
    test_parse_fn_type,
    test_parse_field,
    test_parse_fields,
    test_parse_struct,
    test_parse_variant,
    test_parse_enum,
    test_parse_signature,
    test_parse_function,
  ] {
    t.run("Parser: Top-level", wrap_test(test))
  }
}

#[test("parser/expression-parser")]
fn test_expression_parser(t) {
  for test in [
    test_parse_simple_binary,
    test_parse_arithmetic_precedence,
    test_parse_parens,
    test_parse_basic_literals,
    test_parse_array_literals,
    test_parse_tuple_literals,
    test_parse_closure,
    test_parse_function_calls,
    test_parse_method_calls,
    test_parse_unary_neg,
    test_parse_unary_not,
    test_parse_let_var,
    test_parse_return_break_continue,
  ] {
    // test_parse_while,
    t.run("ExpressionParser", wrap_test(test))
  }
}

fn wrap_test(test_func: fn(Ref<myt.TestRunner>) -> Result<(), string>) -> fn(TestContext) -> () {
  |t| {
    if let Err(s) = test_func(&myt.TestRunner.new("")) {
      t.log(s)
      assert false
    }
  }
}

#[test("parser/conditional/parse_segment")]
fn test_parse_segment(t) {
  let assert Ok((segment, op)) = Parser.new("1 + 3 * 4\n").parse_segment()
  let assert Ok(expr) = Parser.new("1 + 3 * 4\n").parse_expression()
  assert op == None
  assert segment.equals(expr)

  let assert Ok(expr) = Parser.new("1 + 3 * 4 ==\n  5").parse_expression()
  let mut p = Parser.new("1 + 3 * 4 ==\n  5")
  let assert Ok((segment, op)) = p.parse_segment()
  assert !expr.equals(segment)
  assert op == Some(Operator.Eq)
  assert p.peek().kind.string() == "5"
  let assert cst.Expr.Binop(binop) = expr.kind
  assert binop.op == Operator.Eq
  let assert cst.Expr.Binop(binop) = segment.kind
  assert binop.op == Operator.Add

  let assert Ok(expr) = Parser.new("1 + 3 * 4 \n  ==5").parse_expression()
  let mut p = Parser.new("1 + 3 * 4 \n  ==5")
  let assert Ok((segment, op)) = p.parse_segment()
  assert !expr.equals(segment)
  assert op == None
  assert p.peek().kind.string() == "=="
  let assert cst.Expr.Binop(binop) = expr.kind
  assert binop.op == Operator.Eq
  let assert cst.Expr.Binop(binop) = segment.kind
  assert binop.op == Operator.Add

  let source_lines = [
    "if a >                                     ",
    "  0 and b >                                ",
    "    1: 'a+ b+'                             ",
  ]
  let mut p = Parser.new(source_lines.join("\n"))
  assert p.next().kind.string() == "if"
  let assert Ok((seg, op)) = p.parse_segment()
  let assert Some(Operator.Gt) = op
  let assert cst.Expr.Identifier(cst.Path { name: "a", .. }) = seg.kind

  // let's look into this
  let mut ep = ExpressionParser.new(&p, 1 as uint32 << 31)
  let assert Ok(()) = ep.do_parse()
  let assert [] = ep.terms
  let assert [] = ep.operators

  let assert Ok((seg, op)) = p.parse_segment()
  let assert Some(Operator.Gt) = op
  let assert cst.Expr.Binop(binop) = seg.kind
  assert binop.op == Operator.And
}

#[test("parser/conditional/arms/single")]
fn test_conditional_single_arm(t) -> Result<(), error> {
  let assert Ok(block) = parse(["if yes is no: what"])
  let assert [
    cst.Expr.If(
      cst.Conditional { arms: [cst.Arm.Leaf(test, what)], default: None },
    ),
  ] = block.expr_kinds()
  let assert cst.Expr.Binop(binop) = test.kind
  assert binop.op == Operator.Is
  let assert [cst.Expr.Identifier(cst.Path { name: "what", .. })] = what.expr_kinds()

  let assert Ok(block) = parse([
    "if yes is           ",
    "  no:               ",
    "    what            ",
  ])
  let assert [cst.Expr.If(cst.Conditional { arms: [arm], default: None })] = block.expr_kinds()
  let assert cst.Arm.Node(expr, [branch]) = arm
  let assert cst.Expr.Identifier(cst.Path { name: "yes", .. }) = expr.kind
  assert branch.op == Operator.Is
  let assert cst.Arm.Leaf(expr, block) = branch.arm
  let assert cst.Expr.Identifier(cst.Path { name: "no", .. }) = expr.kind
  let assert [cst.Expr.Identifier(cst.Path { name: "what", .. })] = block.expr_kinds()

  let block = parse([
    "if yes              ",
    "  is                ",
    "    no:             ",
    "      what          ",
  ])
  let assert Ok(block) = block
  let assert [cst.Expr.If(cst.Conditional { arms: [arm], default: None })] = block.expr_kinds()
  let assert cst.Arm.Node(expr, [branch]) = arm
  let assert cst.Expr.Identifier(cst.Path { name: "yes", .. }) = expr.kind
  assert branch.op == Operator.Is
  let assert cst.Arm.Leaf(expr, block) = branch.arm
  let assert cst.Expr.Identifier(cst.Path { name: "no", .. }) = expr.kind
  let assert [cst.Expr.Identifier(cst.Path { name: "what", .. })] = block.expr_kinds()
  Ok(())
}

#[test("parser/conditional/arms/multiple")]
fn test_conditional_multiple_arms(t) {
  let assert Ok(block) = parse([
    "if x ==             ",
    "  1: one            ",
    "  2: two            ",
    "  3: three          ",
  ])
  let assert [
    cst.Expr.If(
      cst.Conditional { arms: [cst.Arm.Node(subj, branches)], default: None },
    ),
  ] = block.expr_kinds()
  let assert cst.Expr.Identifier(cst.Path { name: "x", .. }) = subj.kind
  assert branches.length() == 3
  for (i, b) in branches.enumerate() {
    assert b.op == operator.Operator.Eq
    let assert cst.Arm.Leaf(obj, block) = b.arm
    let assert cst.Expr.IntLiteral(value) = obj.kind
    assert value == i + 1
    let assert [cst.Expr.Identifier(cst.Path { name, .. })] = block.expr_kinds()
    assert name == ["one", "two", "three"][i]
  }

  let assert Ok(block) = parse([
    "if x                   ",
    "  == 1: one            ",
    "  == 2: two            ",
    "  == 3: three          ",
  ])
  let assert [
    cst.Expr.If(
      cst.Conditional { arms: [cst.Arm.Node(subj, branches)], default: None },
    ),
  ] = block.expr_kinds()
  let assert cst.Expr.Identifier(cst.Path { name: "x", .. }) = subj.kind
  assert branches.length() == 3
  for (i, b) in branches.enumerate() {
    assert b.op == operator.Operator.Eq
    let assert cst.Arm.Leaf(obj, block) = b.arm
    let assert cst.Expr.IntLiteral(value) = obj.kind
    assert value == i + 1
    let assert [cst.Expr.Identifier(cst.Path { name, .. })] = block.expr_kinds()
    assert name == ["one", "two", "three"][i]
  }
}

#[test("parser/conditional/multi-switch")]
fn test_multi_conditional(t) -> Result<(), error> {
  let assert Ok(block) = parse([
    "if                  ",
    "  x == 1: one       ",
    "  x == 2: two       ",
    "  x == 3: three     ",
  ])
  let assert cst.Expr.If(cst.Conditional { arms, default: None }) = block.last().kind
  assert arms.length() == 3
  for (i, arm) in arms.enumerate() {
    let assert cst.Arm.Leaf(cond, block) = arm
    let assert cst.Expr.Binop(binop) = cond.kind
    let assert cst.Expr.Identifier(cst.Path { name: "x", .. }) = binop.left.kind
    assert binop.op == Operator.Eq
    let assert cst.Expr.IntLiteral(n) = binop.right.kind
    assert n == i + 1
    let assert [cst.Expr.Identifier(cst.Path { name, .. })] = block.expr_kinds()
    assert name == ["one", "two", "three"][i]
  }
  Ok(())
}

#[test("parser/conditional/nested")]
fn test_nested_conditionals(t) -> Result<(), error> {
  let assert Ok(block) = parse([
    "if x > y: r  ",
    "             ",
    "if x >       ",
    "  y: r1      ",
    "  z: r2      ",
    "             ",
    "if x         ",
    "  > y: r1    ",
    "  ==         ",
    "    z: r2    ",
    "    w: r3    ",
    "             ",
    "if           ",
    "  x > y: r   ",
    "  x >        ",
    "    y: r1    ",
    "    z: r2    ",
    "  x          ",
    "    > y: r1  ",
    "    ==       ",
    "      z: r2  ",
    "      w: r3  ",
  ])
  let assert [
    cst.Expr.If(cond1),
    cst.Expr.If(cond2),
    cst.Expr.If(cond3),
    cst.Expr.If(cond4),
  ] = block.expr_kinds()

  let assert None = cond1.default
  let assert [cst.Arm.Leaf(test, block)] = cond1.arms
  let assert cst.Expr.Binop(_) = test.kind
  let assert [cst.Expr.Identifier(_)] = block.expr_kinds()

  let assert None = cond2.default
  let assert [cst.Arm.Node(subj, branches)] = cond2.arms
  let assert cst.Expr.Identifier(_) = subj.kind
  let assert [
    cst.Branch { op: Operator.Gt, arm: cst.Arm.Leaf(y, b1) },
    cst.Branch { op: Operator.Gt, arm: cst.Arm.Leaf(z, b2) },
  ] = branches
  let assert cst.Expr.Identifier(cst.Path { name: "y", .. }) = y.kind
  let assert cst.Expr.Identifier(cst.Path { name: "z", .. }) = z.kind
  let assert [cst.Expr.Identifier(cst.Path { name: "r1", .. })] = b1.expr_kinds()
  let assert [cst.Expr.Identifier(cst.Path { name: "r2", .. })] = b2.expr_kinds()

  let assert None = cond3.default
  let assert [cst.Arm.Node(subj, branches)] = cond3.arms
  let assert cst.Expr.Identifier(_) = subj.kind
  let assert [
    cst.Branch { op: Operator.Gt, arm: cst.Arm.Leaf(y, b1) },
    cst.Branch { op: Operator.Eq, arm: cst.Arm.Leaf(z, b2) },
    cst.Branch { op: Operator.Eq, arm: cst.Arm.Leaf(w, b3) },
  ] = branches
  let assert cst.Expr.Identifier(cst.Path { name: "y", .. }) = y.kind
  let assert cst.Expr.Identifier(cst.Path { name: "z", .. }) = z.kind
  let assert cst.Expr.Identifier(cst.Path { name: "w", .. }) = w.kind
  let assert [cst.Expr.Identifier(cst.Path { name: "r1", .. })] = b1.expr_kinds()
  let assert [cst.Expr.Identifier(cst.Path { name: "r2", .. })] = b2.expr_kinds()
  let assert [cst.Expr.Identifier(cst.Path { name: "r3", .. })] = b3.expr_kinds()

  let assert None = cond4.default
  let assert [
    cst.Arm.Leaf(test, block),
    cst.Arm.Node(subj1, branches1),
    cst.Arm.Node(subj2, branches2),
  ] = cond4.arms

  // arm 1 == conditional 1
  let assert cst.Expr.Binop(_) = test.kind
  let assert [cst.Expr.Identifier(_)] = block.expr_kinds()

  // arm 2 == condtional 2
  let assert cst.Expr.Identifier(_) = subj1.kind
  let assert [
    cst.Branch { op: Operator.Gt, arm: cst.Arm.Leaf(y, b1) },
    cst.Branch { op: Operator.Gt, arm: cst.Arm.Leaf(z, b2) },
  ] = branches1
  let assert cst.Expr.Identifier(cst.Path { name: "y", .. }) = y.kind
  let assert cst.Expr.Identifier(cst.Path { name: "z", .. }) = z.kind
  let assert [cst.Expr.Identifier(cst.Path { name: "r1", .. })] = b1.expr_kinds()
  let assert [cst.Expr.Identifier(cst.Path { name: "r2", .. })] = b2.expr_kinds()

  // arm 3 == condtional 3
  let assert cst.Expr.Identifier(_) = subj2.kind
  let assert [
    cst.Branch { op: Operator.Gt, arm: cst.Arm.Leaf(y, b1) },
    cst.Branch { op: Operator.Eq, arm: cst.Arm.Leaf(z, b2) },
    cst.Branch { op: Operator.Eq, arm: cst.Arm.Leaf(w, b3) },
  ] = branches2
  let assert cst.Expr.Identifier(cst.Path { name: "y", .. }) = y.kind
  let assert cst.Expr.Identifier(cst.Path { name: "z", .. }) = z.kind
  let assert cst.Expr.Identifier(cst.Path { name: "w", .. }) = w.kind
  let assert [cst.Expr.Identifier(cst.Path { name: "r1", .. })] = b1.expr_kinds()
  let assert [cst.Expr.Identifier(cst.Path { name: "r2", .. })] = b2.expr_kinds()
  let assert [cst.Expr.Identifier(cst.Path { name: "r3", .. })] = b3.expr_kinds()
  Ok(())
}

#[test("parser/conditional/and-or-connectives")]
fn test_conditional_with_and_or(t) {
  let assert Ok(block) = parse([
    "if x >                                     ",
    "  y and something_else:                    ",
    "    r                                      ",
    "else:                                      ",
    "  r2                                       ",
    "                                           ",
    "if a >                                     ",
    "  0 and b >                                ",
    "    0: 'a+ b+'                             ",
    "    100: 'b is big'                        ",
    "    else: 'a+'                             ",
    "  _ and b > 0: 'b+'                        ",
    "    r                                      ",
    "else:                                      ",
    "  r2                                       ",
    "                                           ",
  ])
  let assert [] = block.expr_kinds()
}

