import "go:fmt"

import "cst"
import dx "diagnostics"
import myt "testing"
import "operator"

#[test("parser/top-level")]
fn test_parser_top_level(t) {
  for test in [
    test_consume,
    test_parse_type_params,
    test_parse_type,
    test_parse_tuple_type,
    test_parse_fn_type,
    test_parse_field,
    test_parse_fields,
    test_parse_struct,
    test_parse_variant,
    test_parse_enum,
    test_parse_signature,
    test_parse_function,
  ] {
    t.run("Parser: Top-level", wrap_test(test))
  }
}

#[test("parser/expression-parser")]
fn test_expression_parser(t) {
  for test in [
    test_parse_simple_binary,
    test_parse_arithmetic_precedence,
    test_parse_parens,
    test_parse_basic_literals,
    test_parse_array_literals,
    test_parse_tuple_literals,
    test_parse_closure,
    test_parse_function_calls,
    test_parse_method_calls,
    test_parse_unary_neg,
    test_parse_unary_not,
    test_parse_let_var,
    test_parse_return_break_continue,
  ] {
    // test_parse_while,
    t.run("ExpressionParser", wrap_test(test))
  }
}

fn wrap_test(test_func: fn(Ref<myt.TestRunner>) -> Result<(), string>) -> fn(TestContext) -> () {
  |t| {
    if let Err(s) = test_func(&myt.TestRunner.new("")) {
      t.log(s)
      assert false
    }
  }
}

#[test("parser/conditional/arms/single")]
fn test_conditional_single_arm(t) -> Result<(), error> {
  let assert Ok(block) = parse(["if yes is no: what"])
  let assert cst.Expr.If(
    cst.Conditional { 
      clauses: [cst.Clause.Comparison(subj, arms)],
      default: None,
    },
  ) = block.last().kind
  let assert cst.Expr.Identifier(cst.Path { name: "yes", .. }) = subj.kind
  let assert [cst.Arm { op, object, then }] = arms
  assert op == operator.Operator.Is
  let assert cst.Expr.Identifier(cst.Path { name: "no", .. }) = object.kind
  let assert cst.Consequent.Do(block) = then
  let assert cst.Expr.Identifier(cst.Path { name: "what", .. }) = block.last().kind

  let assert Ok(block) = parse(["if yes is no:", "  what"])
  let assert cst.Expr.If(
    cst.Conditional { 
      clauses: [cst.Clause.Comparison(subj, arms)],
      default: None,
    },
  ) = block.last().kind
  let assert cst.Expr.Identifier(cst.Path { name: "yes", .. }) = subj.kind
  let assert [cst.Arm { op, object, then }] = arms
  assert op == operator.Operator.Is
  let assert cst.Expr.Identifier(cst.Path { name: "no", .. }) = object.kind
  let assert cst.Consequent.Do(block) = then
  let assert cst.Expr.Identifier(cst.Path { name: "what", .. }) = block.last().kind

  let assert Ok(block) = parse([
    "if yes is           ",
    "  no:               ",
    "    what            ",
  ])
  let assert cst.Expr.If(
    cst.Conditional { 
      clauses: [cst.Clause.Comparison(subj, arms)],
      default: None,
    },
  ) = block.last().kind
  let assert cst.Expr.Identifier(cst.Path { name: "yes", .. }) = subj.kind
  let assert [cst.Arm { op, object, then }] = arms
  assert op == operator.Operator.Is
  let assert cst.Expr.Identifier(cst.Path { name: "no", .. }) = object.kind
  let assert cst.Consequent.Do(block) = then
  let assert cst.Expr.Identifier(cst.Path { name: "what", .. }) = block.last().kind

  let block = parse([
    "if yes              ",
    "  is                ",
    "    no:             ",
    "      what          ",
  ])
  let assert Ok(block) = block
  let assert cst.Expr.If(
    cst.Conditional { 
      clauses: [cst.Clause.Comparison(subj, arms)],
      default: None,
    },
  ) = block.last().kind
  let assert cst.Expr.Identifier(cst.Path { name: "yes", .. }) = subj.kind
  let assert [cst.Arm { op, object, then }] = arms
  assert op == operator.Operator.Is
  let assert cst.Expr.Identifier(cst.Path { name: "no", .. }) = object.kind
  let assert cst.Consequent.Do(block) = then
  let assert cst.Expr.Identifier(cst.Path { name: "what", .. }) = block.last().kind
  Ok(())
}

#[test("parser/conditional/arms/multiple")]
fn test_conditional_multiple_arms(t) -> Result<(), error> {
  let assert Ok(block) = parse([
    "if x ==             ",
    "  1: one            ",
    "  2: two            ",
    "  3: three          ",
  ])
  let assert cst.Expr.If(
    cst.Conditional { 
      clauses: [cst.Clause.Comparison(subj, arms)],
      default: None,
    },
  ) = block.last().kind
  let assert cst.Expr.Identifier(cst.Path { name: "x", .. }) = subj.kind
  let assert [one, two, three] = arms
  for arm in arms {
    assert arm.op == operator.Operator.Eq
  }
  let assert cst.Expr.IntLiteral(1) = one.object.kind
  let assert cst.Expr.IntLiteral(2) = two.object.kind
  let assert cst.Expr.IntLiteral(3) = three.object.kind
  let assert cst.Consequent.Do(block) = one.then
  let assert cst.Expr.Identifier(cst.Path { name: "one", .. }) = block.last().kind
  let assert cst.Consequent.Do(block) = two.then
  let assert cst.Expr.Identifier(cst.Path { name: "two", .. }) = block.last().kind
  let assert cst.Consequent.Do(block) = three.then
  let assert cst.Expr.Identifier(cst.Path { name: "three", .. }) = block.last().kind

  let assert Ok(block) = parse([
    "if x                   ",
    "  == 1: one            ",
    "  == 2: two            ",
    "  == 3: three          ",
  ])
  let assert cst.Expr.If(
    cst.Conditional { 
      clauses: [cst.Clause.Comparison(subj, arms)],
      default: None,
    },
  ) = block.last().kind
  let assert cst.Expr.Identifier(cst.Path { name: "x", .. }) = subj.kind
  let assert [one, two, three] = arms
  for arm in arms {
    assert arm.op == operator.Operator.Eq
  }
  let assert cst.Expr.IntLiteral(1) = one.object.kind
  let assert cst.Expr.IntLiteral(2) = two.object.kind
  let assert cst.Expr.IntLiteral(3) = three.object.kind
  let assert cst.Consequent.Do(block) = one.then
  let assert cst.Expr.Identifier(cst.Path { name: "one", .. }) = block.last().kind
  let assert cst.Consequent.Do(block) = two.then
  let assert cst.Expr.Identifier(cst.Path { name: "two", .. }) = block.last().kind
  let assert cst.Consequent.Do(block) = three.then
  let assert cst.Expr.Identifier(cst.Path { name: "three", .. }) = block.last().kind
  Ok(())
}

#[test("parser/conditional/multi-switch")]
fn test_multi_conditional(t) -> Result<(), error> {
  let assert Ok(block) = parse([
    "if                  ",
    "  x == 1: one       ",
    "  x == 2: two       ",
    "  x == 3: three     ",
  ])
  let assert cst.Expr.If(cst.Conditional { clauses, default: None }) = block.last().kind
  assert clauses.length() == 3
  for (i, c) in clauses.enumerate() {
    let assert cst.Clause.Comparison(subj, [arm]) = c
    let assert cst.Expr.Identifier(cst.Path { name: "x", .. }) = subj.kind
    let assert cst.Expr.IntLiteral(n) = arm.object.kind
    assert n == i + 1
  }
  Ok(())
}

#[test("parser/conditional/nested")]
fn test_nested_conditionals(t) -> Result<(), error> {
  let assert Ok(block) = parse([
    "if x > y: r  ",
    "             ",
    "if x >       ",
    "  y: r1      ",
    "  z: r2      ",
    "             ",
    "if x         ",
    "  > y: r1    ",
    "  ==         ",
    "    z: r2    ",
    "    w: r3    ",
    "             ",
    "if           ",
    "  x > y: r   ",
    "  x >        ",
    "    y: r1    ",
    "    z: r2    ",
    "  x          ",
    "    > y: r1  ",
    "    ==       ",
    "      z: r2  ",
    "      w: r3  ",
  ])
  let assert [
    cst.Expr.If(cond1),
    cst.Expr.If(cond2),
    cst.Expr.If(cond3),
    cst.Expr.If(cond4),
  ] = block.statements.map(|s| s.kind)
  let assert [cst.Clause.Comparison(subj, [arm])] = cond1.clauses
  let assert cst.Expr.Identifier(cst.Path { name: "x", .. }) = subj.kind
  let assert cst.Expr.Identifier(cst.Path { name: "y", .. }) = arm.object.kind

  let assert [cst.Clause.Comparison(subj, [a1, a2])] = cond2.clauses
  let assert cst.Expr.Identifier(cst.Path { name: "x", .. }) = subj.kind
  let assert cst.Expr.Identifier(cst.Path { name: "y", .. }) = a1.object.kind
  let assert cst.Expr.Identifier(cst.Path { name: "z", .. }) = a2.object.kind

  let assert [cst.Clause.Comparison(subj, [a1, a2, a3])] = cond3.clauses
  let assert cst.Expr.Identifier(cst.Path { name: "x", .. }) = subj.kind
  assert a1.op == Operator.Gt
  assert a2.op == Operator.Eq
  assert a3.op == Operator.Eq

  let assert [cond1, cond2, cond3] = cond4.clauses
  let assert cst.Clause.Comparison(subj, [arm]) = cond1
  let assert cst.Expr.Identifier(cst.Path { name: "x", .. }) = subj.kind
  let assert cst.Expr.Identifier(cst.Path { name: "y", .. }) = arm.object.kind

  let assert cst.Clause.Comparison(subj, [a1, a2]) = cond2
  let assert cst.Expr.Identifier(cst.Path { name: "x", .. }) = subj.kind
  let assert cst.Expr.Identifier(cst.Path { name: "y", .. }) = a1.object.kind
  let assert cst.Expr.Identifier(cst.Path { name: "z", .. }) = a2.object.kind

  let assert cst.Clause.Comparison(subj, [a1, a2, a3]) = cond3
  let assert cst.Expr.Identifier(cst.Path { name: "x", .. }) = subj.kind
  assert a1.op == Operator.Gt
  assert a2.op == Operator.Eq
  assert a3.op == Operator.Eq
  Ok(())
}

#[test("parser/conditional/nested-with-else")]
fn test_cond_nested_with_else(t) {
  let assert Ok(block) = parse([
    "if x > y:                                  ",
    "  r                                        ",
    "else:                                      ",
    "  r2                                       ",
    "                                           ",
    "if x > y: r                                ",
    "else: r2                                   ",
    "                                           ",
    "-- these next two should parse identically ",
    "if x >                                     ",
    "  y: r1                                    ",
    "  z: r2                                    ",
    "  else: -- this error will get caught at name resolution time",
    "    r3                                     ",
    "                                           ",
    "if x >                                     ",
    "  y: r1                                    ",
    "  z: r2                                    ",
    "else:                                      ",
    "  r3                                       ",
    "                                           ",
    "if                                         ",
    "  a >                                      ",
    "    y: r1                                  ",
    "    z: r2                                  ",
    "  b                                        ",
    "    > y: r1                                ",
    "    ==                                     ",
    "      z: r2                                ",
    "      w: r3                                ",
    "  else: \"inner else\"                     ",
    "else: \"outer else\"                       ",
    "-- this error should get caught when checking exhaustiveness/redundancy",
  ])
  let stmts = block.statements.map(|s| s.kind)
  let assert [
    cst.Expr.If(c1),
    cst.Expr.If(c2),
    cst.Expr.If(c3),
    cst.Expr.If(c4),
    cst.Expr.If(c5),
  ] = stmts
  let assert Some(block) = c1.default
  let assert [stmt] = block.statements
  let assert cst.Expr.Identifier(cst.Path { name: "r2", .. }) = stmt.kind
  let assert [cst.Clause.Comparison(subj, [arm])] = c1.clauses
  let assert cst.Expr.Identifier(cst.Path { name: "x", .. }) = subj.kind
  let assert cst.Expr.Identifier(cst.Path { name: "y", .. }) = arm.object.kind

  let assert Some(block) = c2.default
  let assert [stmt] = block.statements
  let assert cst.Expr.Identifier(cst.Path { name: "r2", .. }) = stmt.kind
  let assert [cst.Clause.Comparison(subj, [arm])] = c2.clauses
  let assert cst.Expr.Identifier(cst.Path { name: "x", .. }) = subj.kind
  let assert cst.Expr.Identifier(cst.Path { name: "y", .. }) = arm.object.kind

  let assert None = c3.default
  let assert [cst.Clause.Comparison(_subj, [a1, a2, a3])] = c3.clauses
  assert (a1.op, a2.op, a3.op) == (Operator.Gt, Operator.Gt, Operator.Gt)
  // NOTE: the below is an error that will get caught at name resolution time
  let assert cst.Expr.Identifier(cst.Path { name: "else", .. }) = a3.object.kind

  let assert Some(block) = c4.default
  assert block.statements.length() == 1
  let assert cst.Expr.Identifier(cst.Path { name: "r3", .. }) = block.statements[0].kind
  let assert [cst.Clause.Comparison(_subj, [a1, a2, a3])] = c3.clauses
  assert (a1.op, a2.op, a3.op) == (Operator.Gt, Operator.Gt, Operator.Gt)

  let assert Some(block) = c5.default
  let assert cst.Expr.StringLiteral("outer else") = block.last().kind
  let assert [_, _, cst.Clause.Else(block)] = c5.clauses
  let assert cst.Expr.StringLiteral("inner else") = block.last().kind
}

#[test("parser/conditional/and-or-connectives")]
fn test_conditional_with_and_or(t) {
  let assert Ok(block) = parse([
    "if x >                                     ",
    "  y and something_else:                    ",
    "  r                                        ",
    "else:                                      ",
    "  r2                                       ",
    "                                           ",
  ])
}

fn parse(lines: Slice<string>) -> Result<cst.Block, error> {
  let source_code = ": \n" + lines.map(|ln| f"  {ln}\n").join("")
  Parser
    .new(source_code)
    .parse_colon_and_block()
    .map_err(|e| {
      fmt.Errorf("%v", dx.render(e, source_code as Slice<rune>))
    })
}

