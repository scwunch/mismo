#[test("parser/top-level")]
fn test_parser_top_level(t) {
  for test in [
    test_consume,
    test_parse_type_params,
    test_parse_type,
    test_parse_fn_type,
    test_parse_field,

    // test_parse_fields,
    // test_parse_struct,
    // test_parse_variant,
    // test_parse_enum,

    test_parse_signature,
    test_parse_function,
  ] {
    t.run("Parser: Top-level", wrap_test(test))
  }
}

