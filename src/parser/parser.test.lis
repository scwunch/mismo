fn parse(lines: Slice<string>) -> Result<cst.Block, error> {
  let source_code = ": \n" + lines.map(|ln| f"  {ln}\n").join("")
  Parser
    .new(source_code)
    .parse_colon_and_block()
    .map_err(|e| {
      fmt.Errorf("%v", dx.render(e, source_code as Slice<rune>))
    })
}

