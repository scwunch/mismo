import "cst"
import "errors"
import "lexer"
import "mode"
import "operator"
import "span"

type Operator = operator.Operator

enum Expecting {
  Term,
  Operator,
}

struct ExpressionParser {
  parser: Ref<Parser>,
  terms: Slice<cst.Expression>,
  operators: Slice<Operator>,
  expression_indent: uint32,
  expecting: Expecting,
}

impl ExpressionParser {
  fn new(parser: Ref<Parser>, expression_indent: uint32) -> ExpressionParser {
    ExpressionParser { 
      parser,
      terms: [],
      operators: [],
      expression_indent,
      expecting: Expecting.Term,
    }
  }

  fn optional_expression(self: Ref<ExpressionParser>) -> Result<Option<Ref<cst.Expression>>, ParseError> {
    if self.expression_done() { return Ok(None) }
    let expr = self.parser.parse_expression()?
    Ok(Some(&expr))
  }

  fn parse(self: Ref<ExpressionParser>) -> Result<cst.Expression, ParseError> {
    if self.expression_done() {
      return Err(ParseError.new(self.parser.peek().span, "Empty expression"))
    }
    loop {
      match self.expecting {
        Expecting.Term => self.read_operand()?,
        Expecting.Operator => {
          if self.expression_done() { break }
          self.read_operator()?
        },
      }
    }

    if self.expecting == Expecting.Term {
      let op_str = self.operators[self.operators.length() - 1].string()
      return Err(ParseError.new(
        self.parser.peek().span,
        f"expected operand after {op_str}",
      ))
    }

    while !self.operators.is_empty() {
      self.compress()?
    }

    if !self.operators.is_empty() || self.terms.length() != 1 {
      return Err(ParseError.new(
        self.parser.peek().span,
        "operators and terms did not add up",
      ))
    }

    let result = self.pop_term()?
    self.expecting = Expecting.Term
    Ok(result)
  }

  fn expression_done(self: Ref<ExpressionParser>) -> bool {
    match self.parser.peek().kind {
      TokenKind.RightParen |
      TokenKind.RightBracket |
      TokenKind.RightBrace |
      TokenKind.Colon |
      TokenKind.Comma |
      TokenKind.EOF => true,
      TokenKind.Newline(i, _) => i <= self.expression_indent,
      _ => false,
    }
  }

  fn read_operand(self: Ref<ExpressionParser>) -> Result<(), ParseError> {
    let tok = self.parser.next()
    let term = match tok.kind {
      TokenKind.Operator(Sub) => return self.handle_prefix(Operator.Neg),
      TokenKind.Operator(Not) => return self.handle_prefix(Operator.Not),
      TokenKind.Operator(op) => {
        if self.parser.peek().kind == TokenKind.LeftParen {
          self.function_call(tok.span, cst.Path.name_(op.sigil()))?
        } else {
          return Err(ParseError.new(
            tok.span,
            f"Expected term or prefix operator. Got operator '{op}'",
          ))
        }
      },
      TokenKind.Let => return self.handle_prefix(Operator.Let),
      TokenKind.Mut => return self.handle_prefix(Operator.Mut),
      TokenKind.MutBang => return self.handle_prefix(Operator.MutBang),
      TokenKind.Var => return self.handle_prefix(Operator.Var),
      TokenKind.If => self.parser.parse_if_expression(tok.span)?,
      TokenKind.While => self.parser.parse_while_expression(tok.span)?,
      TokenKind.For => self.parser.parse_for_expression(tok.span)?,
      TokenKind.Return => cst.return_(tok.span, self.optional_expression()?),
      TokenKind.Break => cst.break_(tok.span, self.optional_expression()?),
      TokenKind.Continue => cst.continue_(tok.span),
      TokenKind.Identifier(name) => self.identifier(tok.span, name)?,
      TokenKind.LeftParen => self.parse_paren_group(tok.span)?,
      TokenKind.LeftBracket => self.parse_array_literal(tok.span)?,
      TokenKind.Dot => self.handle_dot(cst.implicit_self(tok.span))?,
      TokenKind.IntLiteral(n) => cst.int_lit(tok.span, n),
      TokenKind.FloatLiteral(n) => cst.float_lit(tok.span, n),
      TokenKind.StringLiteral(s) => cst.string_lit(tok.span, s),
      TokenKind.Nil => cst.nil_lit(tok.span),
      TokenKind.Bool(b) => cst.bool_lit(tok.span, b),
      TokenKind.Error(msg) => return Err(ParseError.new(tok.span, msg)),
      _ => return Err(ParseError.new(
        tok.span,
        f"Expected term or prefix operator. Got {tok.kind}",
      )),
    }
    self.terms = self.terms.append(term)
    self.expecting = Expecting.Operator
    Ok(())
  }

  fn handle_prefix(self: Ref<ExpressionParser>, prefix_op: Operator) -> Result<(), ParseError> {
    self.push_operator(prefix_op)?
    self.read_operand()
  }

  fn identifier(self: Ref<ExpressionParser>, span: span.Span, name: string) -> Result<cst.Expression, ParseError> {
    match name {
      "true" => Ok(cst.bool_lit(span, true)),
      "false" => Ok(cst.bool_lit(span, false)),
      "nil" => Ok(cst.nil_lit(span)),
      _ => {
        let (span, path) = self.parse_path(span, name)?
        match self.parser.peek().kind {
          LeftParen | LeftBracket => Ok(self.function_call(span, path)?),
          _ => Ok(cst.identifier(span, path)),
        }
      },
    }
  }

  fn parse_path(
    self: Ref<ExpressionParser>,
    mut span_: span.Span,
    mut name: string,
  ) -> Result<(span.Span, cst.Path), ParseError> {
    let mut path = []
    loop {
      if self.parser.consume(TokenKind.NamespaceSeparator).is_ok() {
        span_ = span_.merge(self.parser.peek().span)
        path = path.append(name)
        name = self.parser.consume_identifier()?
      } else {
        return Ok((span_, cst.Path { namespace: path, name }))
      }
    }
  }

  fn read_operator(self: Ref<ExpressionParser>) -> Result<(), ParseError> {
    let tok = self.parser.next()
    let tok_span = tok.span
    match tok.kind {
      TokenKind.Newline(_, _) => self.read_operator(),
      TokenKind.Operator(op) => {
        self.push_operator(op)?
        self.expecting = Expecting.Term
        Ok(())
      },
      TokenKind.Dot => {
        let receiver = self.pop_term()?
        self.terms = self.terms.append(self.handle_dot(receiver)?)
        Ok(())
      },
      TokenKind.LeftParen => Err(ParseError.new(
        tok_span,
        "only named functions are supported, cannot 'call' arbitrary expressions",
      )),
      LeftBracket => Err(ParseError.new(
        tok_span,
        "Use `.get(i)` to index into collections.",
      )),
      TokenKind.Error(msg) => Err(ParseError.new(tok_span, msg)),
      _ => Err(ParseError.new(
        tok_span,
        f"Expected binary operator; got {tok.kind}",
      )),
    }
  }

  fn push_operator(self: Ref<ExpressionParser>, right_op: Operator) -> Result<(), ParseError> {
    loop {
      match self.operators.get(self.operators.length() - 1) {
        None => break,
        Some(left_op) => match left_op.relative_precedence(right_op) {
          Tighter => self.compress()?,
          Looser => break,
          None => return Err(ParseError.new(
            self.parser.peek().span,
            f"Relative precedence not defined between '{left_op}' [left] and '{right_op}' [right].  Disambiguate with parentheses.",
          )),
        },
      }
    }
    self.operators = self.operators.append(right_op)
    Ok(())
  }

  fn compress(self: Ref<ExpressionParser>) -> Result<(), ParseError> {
    if self.operators.is_empty() { return Ok(()) }
    let last = self.operators.length() - 1
    let op = self.operators[last]
    self.operators = self.operators[..last]
    let term = match op {
      Neg | Not | Let | Mut | MutBang | Var => unary_op(op, self.pop_term()?),
      binop => {
        let t2 = self.pop_term()?
        let t1 = self.pop_term()?
        let span = t1.span.merge(t2.span)
        cst.binop_expr(span, t1, binop, t2)
      },
    }
    self.terms = self.terms.append(term)
    Ok(())
  }

  fn pop_term(self: Ref<ExpressionParser>) -> Result<cst.Expression, ParseError> {
    if self.terms.is_empty() {
      return Err(ParseError.new(
        self.parser.peek().span,
        "Not enough terms to complete expression",
      ))
    }
    let last = self.terms.length() - 1
    let t = self.terms[last]
    self.terms = self.terms[..last]
    Ok(t)
  }

