  fn read_operator(self: Ref<ExpressionParser>) -> Result<(), dx.ParseError> {
    // let tok = self.parser.next()
    // let tok_span = tok.span
    match self.parser.peek().kind {
      Operator(op) => {
        let _ = self.parser.next()
        self.push_operator(op)?
        self.expecting = Expecting.Term
      },
      Dot => {
        let receiver = Some(self.pop_term()?)
        let dot = self.parser.next()
        self.terms = self.terms.append(self.handle_dot(receiver, dot.span)?)
      },
      // LeftParen => Err(dx.ParseError.new(
      //   tok_span,
      //   "only named functions are supported, cannot 'call' arbitrary expressions",
      // )),
      // LeftBracket => Err(dx.ParseError.new(
      //   tok_span,
      //   "Use `.get(i)` to index into collections.",
      // )),
      Error(msg) => return Err(dx.ParseError.new(self.parser.peek().span, msg)),
      tok => match self.terms[self.terms.length() - 1].kind {
        Type(_, _) | EnumConstructor(_, _) => {
          self.push_operator(Operator.Juxtaposition)?
          self.expecting = Expecting.Term
        },
        _ => return Err(dx.ParseError.new(
          self.parser.peek().span,
          f"Expected binary operator; got `{tok}`",
        )),
      },
    }
    Ok(())
  }

  fn push_operator(self: Ref<ExpressionParser>, right_op: Operator) -> Result<(), dx.ParseError> {
    loop {
      match self.operators.get(self.operators.length() - 1) {
        None => break,
        Some(left_op) => match left_op.relative_precedence(right_op) {
          Tighter => self.compress()?,
          Looser => break,
          None => return Err(dx.ParseError.new(
            self.parser.peek().span,
            f"Relative precedence not defined between '{left_op}' [left] and '{right_op}' [right].  Disambiguate with parentheses.",
          )),
        },
      }
    }
    self.operators = self.operators.append(right_op)
    Ok(())
  }

  fn compress(self: Ref<ExpressionParser>) -> Result<(), dx.ParseError> {
    if self.operators.is_empty() { return Ok(()) }
    let last = self.operators.length() - 1
    let op = self.operators[last]
    self.operators = self.operators[..last]
    let term = match op {
      Neg | Not | Let | Mut | MutBang | Var => unary_op(op, self.pop_term()?),
      binop => {
        let t2 = self.pop_term()?
        let t1 = self.pop_term()?
        let span = t1.span.merge(t2.span)
        cst.binop_expr(span, t1, binop, t2)
      },
    }
    self.terms = self.terms.append(term)
    Ok(())
  }

  fn pop_term(self: Ref<ExpressionParser>) -> Result<cst.Expression, dx.ParseError> {
    if self.terms.is_empty() {
      return Err(dx.ParseError.new(
        self.parser.peek().span,
        "Not enough terms to complete expression",
      ))
    }
    let last = self.terms.length() - 1
    let term = self.terms[last]
    self.terms = self.terms[..last]
    Ok(term)
  }

  fn parse_paren_group(self: Ref<ExpressionParser>, _span: Span) -> Result<cst.Expression, dx.ParseError> {
    let exprs = self.parse_list(')')?
    let end = self.parser.consume(TokenKind.RightParen)?
    let s = _span.merge(end)
    match exprs {
      [e] => Ok(e),
      _ => Ok(cst.block_expr(s, exprs)),
    }
  }

  fn parse_array_literal(self: Ref<ExpressionParser>, _span: Span) -> Result<cst.Expression, dx.ParseError> {
    let items = self.parse_list(']')?
    let rbracket_span = self.parser.consume(TokenKind.RightBracket)?
    let s = _span.merge(rbracket_span)
    Ok(cst.array_lit(s, items))
  }

  fn parse_tuple_or_record_literal(self: Ref<ExpressionParser>, span: Span) -> Result<cst.Expression, dx.ParseError> {
    if let Ok(end) = self.parser.consume(TokenKind.RightBrace) {
      return Ok(cst.tuple_lit(span.merge(end), []))
    }
    let open_brace_indent = self.parser.current_line_indent
    let ident_span = self.parser.peek().span
    let Ok(name) = self.parser.consume_identifier() else {
      return self.finish_tuple_literal(span, open_brace_indent, self.parser.parse_expression()?)
    }
    let (path_span, path) = self.parser.parse_path(ident_span, name)?
    if path.namespace.is_empty() && !path.is_type_name() && self.parser.peek().kind == TokenKind.Colon {
      self.finish_record_literal(span, open_brace_indent, ident_span, path.name)
    } else {
      let first = self.identifier(path_span, name)?
      self.finish_tuple_literal(span, open_brace_indent, first)
    }
  }

  fn finish_tuple_literal(
      self: Ref<ExpressionParser>,
      open: Span,
      open_brace_indent: uint32,
      first: cst.Expression
    ) -> Result<cst.Expression, dx.ParseError> {
      let _ = self.parser.consume(TokenKind.Comma)
      self.parser.current_line_indent = open_brace_indent
      let rest = self.parser.parse_list('}', self.parser.parse_expression)?
      let close = self.parser.consume(TokenKind.RightBrace)?
      Ok(cst.tuple_lit(open.merge(close), [first].append(rest...)))
  }

  fn finish_record_literal(
    self: Ref<ExpressionParser>,
    open: Span,
    open_brace_indent: uint32,
    first_field_span: Span,
    first_field_name: string,
  ) -> Result<cst.Expression, dx.ParseError> {
    let block = self.parser.parse_colon_and_block()?
    let _ = self.parser.consume(TokenKind.Comma)
    let expr = match block.statements {
      [expr] => expr,
      exprs => cst.block_expr(block.span(), exprs),
    }
    let span = first_field_span.merge(expr.span)
    let first = cst.RecordField { span, name: first_field_name, expr}
    self.parser.current_line_indent = open_brace_indent
    let fields = self.parser.parse_list('}', self.parse_field)?
    let fields = [first].append(fields...)
    let close = self.parser.consume(TokenKind.RightBrace)?
    Ok(cst.record_lit(open.merge(close), fields))
  }

  fn parse_field(self: Ref<ExpressionParser>) -> Result<cst.RecordField, dx.ParseError> {
    let span: Span = self.parser.peek().span
    let name = self.parser.consume_identifier()?
    let block = self.parser.parse_colon_and_block()?
    let expr = match block.statements {
      [expr] => expr,
      exprs => cst.block_expr(block.span(), exprs),
    }
    let span = span.merge(expr.span)
    Ok(cst.RecordField { span, name, expr })
  }

  fn handle_dot(
    self: Ref<ExpressionParser>,
    receiver: Option<cst.Expression>,
    dot_span: spn.Span,
  ) -> Result<cst.Expression, dx.ParseError> {
    let span = receiver.map_or(dot_span, |r| r.span).merge(self.parser.peek().span)
    let (span, path) = self.parser.parse_path(
      span,
      self.parser.consume_identifier()?,
    )?


    // if path.namespace.is_empty() && path.is_type_name() {
    //   let ty = match receiver {
    //     None => None,
    //     Some(expr) => match expr.kind {
    //       Type(ty_path, args) => Some((ty_path, args)),
    //       _ => return Err(dx.ParseError.new(expr.span, "expected type")),
    //     }
    //   }
    //   Ok(cst.enum_constructor(span, ty, path.name))
    // }
    match (receiver.map(|r| r.kind), path.namespace, path.is_type_name()) {
      (Some(Type(type_path, type_args)), [], true) => {
        Ok(cst.enum_constructor(span, Some((type_path, type_args)), path.name))
      },
      // NOTE: implementation currently raises no error for `variable.Type` syntax
      (None, [], true) => {
        Ok(cst.enum_constructor(span, None, path.name))
      },
      _ => {
        let receiver = receiver.unwrap_or_else(|| cst.implicit_self(dot_span))
        let (span, type_args) = self.parser.parse_type_args(receiver.span)?
        if path.namespace.is_empty() && type_args.is_none() &&
        self.parser.peek().kind != lexer.TokenKind.LeftParen {
          Ok(cst.dot_name(span, &receiver, path.name))
        } else {
          let (span, call) = self.parse_call(span, path, type_args)?
          Ok(cst.dot_call(span, &receiver, call))
        }
      },
    }
  }

  fn function_call(
    self: Ref<ExpressionParser>,
    start: Span,
    fn_name: cst.Path,
    type_args: Option<Slice<cst.Type>>,
  ) -> Result<cst.Expression, dx.ParseError> {
    let (span, call) = self.parse_call(start, fn_name, type_args)?
    Ok(cst.call_expr(span, call))
  }

  fn parse_call(
    self: Ref<ExpressionParser>,
    start: Span,
    fn_name: cst.Path,
    type_args: Option<Slice<cst.Type>>,
  ) -> Result<(spn.Span, cst.Call), dx.ParseError> {
    // let type_args = self.parse_type_args()?
    if self.parser.consume(TokenKind.LeftParen).is_err() {
      return Ok((start, cst.Call { fn_name, type_args, args: [] }))
    }
    let args = self.parse_list(')')?
    let end = self.parser.consume(TokenKind.RightParen)?
    let s = start.merge(end)
    Ok((s, cst.Call { fn_name, type_args, args }))
  }

  fn parse_closure(self: Ref<ExpressionParser>, span: spn.Span) -> Result<cst.Expression, dx.ParseError> {
    let parameters = self.parser.parse_list('|', self.parser.parse_parameter)?
    let _ = self.parser.consume(TokenKind.Pipe)?
    let body = self.parser.parse_colon_and_block()?
    let span = span.merge(body.last().span)
    Ok(cst.closure(span, parameters, body))
  }

  fn parse_list(self: Ref<ExpressionParser>, end: rune) -> Result<Slice<cst.Expression>, dx.ParseError> {
    self.parser.parse_list(end, self.parser.parse_expression)
  }
}

impl Parser {
  pub fn parse_expression(self: Ref<Parser>) -> Result<cst.Expression, dx.ParseError> {
    let mut expr_parser = ExpressionParser.new(self, self.peek_indent())
    expr_parser.parse()
  }

  fn parse_until(self: Ref<Parser>, kind: TokenKind) -> Result<cst.Expression, dx.ParseError> {
    ExpressionParser.until(self, self.peek_indent(), kind).parse()
  }

  pub fn parse_colon_and_block(self: Ref<Parser>) -> Result<cst.Block, dx.ParseError> {
    let _ = self.consume(TokenKind.Colon)?
    let indent = self.current_line_indent
    if self.peek_indent() == indent {
      return Ok(cst.Block { statements: [self.parse_expression()?] })
    }
    let mut statements = [self.parse_expression()?]
    loop {
      match self.peek().kind {
        EOF | RightBracket | RightParen | RightBrace => break,
        _ if self.newline_follows(indent) => break,
        _ => statements = statements.append(self.parse_expression()?),
      }
    }
    Ok(cst.Block { statements })
  }

  fn parse_while_expression(self: Ref<Parser>, span: Span) -> Result<cst.Expression, dx.ParseError> {
    let conditional = self.parse_conditional(span)?
    let span = span.merge(conditional.end_span())
    Ok(cst.while_(span, conditional))
    // let condition = self.parse_expression()?
    // let body = self.parse_colon_and_block()?
    // let span = span.merge(body.last().span)
    // let else_ = if self.peek_indent() == indent &&
    // self.consume(TokenKind.Else).is_ok() {
    //   Some(self.parse_colon_and_block()?)
    // } else {
    //   None
    // }
    // let cond = cst.Conditional.predicate(
    //   condition,
    //   cst.Consequent.Do(body),
    //   else_,
    // )
    // Ok(cst.while_(span, cond))
  }

  fn parse_for_expression(self: Ref<Parser>, span: Span) -> Result<cst.Expression, dx.ParseError> {
    let header = self.parse_expression()?
    let (patt, iter) = match header.kind {
      Binop(binop) => match binop.* {
        cst.Binop { left, op: In, right } => (left, right),
        _ => return Err(dx.ParseError.new(
          span.merge(header.span),
          "Proper syntax is `for <pattern> in <iterable>: <body>` eg, `for x in xs: ...`",
        )),
      },
      _ => return Err(dx.ParseError.new(
        span.merge(header.span),
        "Proper syntax is `for <pattern> in <iterable>: <body>` eg, `for x in xs: ...`",
      )),
    }
    let body = self.parse_colon_and_block()?
    let span = span.merge(body.last().span)
    Ok(cst.for_(span, patt, iter, body))
  }

  fn parse_if_expression(self: Ref<Parser>, span: Span) -> Result<cst.Expression, dx.ParseError> {
    let cond = self.parse_conditional(span)?
    let span = span.merge(cond.end_span())
    Ok(cst.if_expr(span, cond))
  }

  fn parse_conditional(self: Ref<Parser>, span: spn.Span) -> Result<cst.If, dx.ParseError> {
    let cond_indent = self.current_line_indent
    let checks = self.parse_list('\n', self.parse_check)?
    if checks.is_empty() {
      return Err(dx.ParseError.new(span, "expected expression after `if`"))
    }
    let default = if self.peek_indent() == cond_indent &&
    self.consume(TokenKind.Else).is_ok() {
      Some(self.parse_colon_and_block()?)
    } else {
      None
    }
    Ok(cst.If { checks, default })
  }

  fn parse_check(self: Ref<Parser>) -> Result<cst.Check, dx.ParseError> {
    let is = TokenKind.Operator(Operator.Is)
    let condition = self.parse_until(is)?
    if let Ok(span) = self.consume(is) {
      // consider raising error here when `condition` is an `and` or `or` binop
      let arms = self.parse_list('\n', self.parse_arm)?
      if arms.is_empty() {
        return Err(dx.ParseError.new(span, "expected expression after `if`"))
      }
      Ok(cst.Check.Match(condition, arms))
    } else {
      let block = self.parse_colon_and_block()?
      Ok(cst.Check.Test(condition, block))
    }
  }

  fn parse_arm(self: Ref<Parser>) -> Result<cst.Arm, dx.ParseError> {
    let pattern = self.parse_until(TokenKind.If)?
    if let Ok(span) = self.consume(TokenKind.If) {
      let conditional = self.parse_conditional(span)?
      Ok(cst.Arm { pattern, then: cst.Then.If(conditional) })
    } else {
      let block = self.parse_colon_and_block()?
      Ok(cst.Arm { pattern, then: cst.Then.Block(block) })
    }
  }
}

fn unary_op(op: Operator, term: cst.Expression) -> cst.Expression {
  match op {
    Neg => {
      let span = term.span.extend_left(1)
      match term.kind {
        IntLiteral(i) => cst.int_lit(span, -i),
        FloatLiteral(f) => cst.float_lit(span, -f),
        _ => cst.neg(span, &term),
      }
    },
    Not => {
      let span = term.span.extend_left(4)
      cst.not_(span, &term)
    },
    Let => {
      let span = term.span.extend_left(4)
      cst.binding(span, md.Mode.Let, &term)
    },
    Mut => {
      let span = term.span.extend_left(4)
      cst.binding(span, md.Mode.Mut, &term)
    },
    MutBang => {
      let span = term.span.extend_left(5)
      cst.binding(span, md.Mode.MutBang, &term)
    },
    Var => {
      let span = term.span.extend_left(4)
      cst.binding(span, md.Mode.Var, &term)
    },
    _ => panic(f"{op} is not a unary operator"),
  }
}
