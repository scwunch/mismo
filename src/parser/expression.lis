import "cst"
import dx "diagnostics"
import "lexer"
import "mode"
import "operator"
import "span"
import t "testing"

type Operator = operator.Operator

#[display]
enum Expecting {
  Term,
  Operator,
}

struct ExpressionParser {
  parser: Ref<Parser>,
  terms: Slice<cst.Expression>,
  operators: Slice<Operator>,
  expression_indent: uint32,
  expecting: Expecting,
  should_stop_at_comparison_operator: bool,
}

impl ExpressionParser {
  fn new(parser: Ref<Parser>, expression_indent: uint32) -> ExpressionParser {
    ExpressionParser { 
      parser,
      terms: [],
      operators: [],
      expression_indent,
      expecting: Expecting.Term,
      should_stop_at_comparison_operator: false,
    }
  }

  fn optional_expression(self: Ref<ExpressionParser>) -> Result<Option<Ref<cst.Expression>>, ParseError> {
    if self.expression_done() { return Ok(None) }
    let expr = self.parser.parse_expression()?
    Ok(Some(&expr))
  }

  fn parse(self: Ref<ExpressionParser>) -> Result<cst.Expression, ParseError> {
    loop {
      match self.expecting {
        Expecting.Term => self.read_operand()?,
        Expecting.Operator => {
          if self.expression_done() { break }
          self.read_operator()?
        },
      }
    }

    if self.expecting == Expecting.Term {
      let op_str = self.operators[self.operators.length() - 1].string()
      return Err(ParseError.new(
        self.parser.peek().span,
        f"expected operand after {op_str}",
      ))
    }

    while self.operators.length() > 0 {
      self.compress()?
    }

    if !self.operators.is_empty() || self.terms.length() != 1 {
      return Err(ParseError.new(
        self.parser.peek().span,
        "operators and terms did not add up",
      ))
    }

    let result = self.pop_term()?
    self.expecting = Expecting.Term
    Ok(result)
  }

  fn expression_done(self: Ref<ExpressionParser>) -> bool {
    match self.parser.peek().kind {
      RightParen | RightBracket | RightBrace | Colon | Comma | Else | EOF => true,
      Operator(op) if self.should_stop_at_comparison_operator => op.is_comparer(),
      _ => self.parser.peek_newline(self.expression_indent),
    }
  }

  fn read_operand(self: Ref<ExpressionParser>) -> Result<(), ParseError> {
    let tok = self.parser.next()
    let term = match tok.kind {
      Operator(Sub) => return self.handle_prefix(Operator.Neg),
      Operator(Not) => return self.handle_prefix(Operator.Not),
      Operator(op) => {
        if self.parser.peek().kind == TokenKind.LeftParen {
          self.function_call(tok.span, cst.Path.name_(op.sigil()), None)?
        } else {
          return Err(ParseError.new(
            tok.span,
            f"Expected term or prefix operator. Got operator '{op}'",
          ))
        }
      },
      Let => return self.handle_prefix(Operator.Let),
      Mut => return self.handle_prefix(Operator.Mut),
      MutBang => return self.handle_prefix(Operator.MutBang),
      Var => return self.handle_prefix(Operator.Var),
      If => self.parser.parse_if_expression(tok.span)?,
      While => self.parser.parse_while_expression(tok.span)?,
      For => self.parser.parse_for_expression(tok.span)?,
      Return => cst.return_(tok.span, self.optional_expression()?),
      Break => cst.break_(tok.span, self.optional_expression()?),
      Continue => cst.continue_(tok.span),
      Identifier(name) => self.identifier(tok.span, name)?,
      LeftParen => self.parse_paren_group(tok.span)?,
      LeftBracket => self.parse_array_literal(tok.span)?,
      Dot => self.handle_dot(cst.implicit_self(tok.span))?,
      Pipe => self.parse_closure(tok.span)?,
      IntLiteral(n) => cst.int_lit(tok.span, n),
      FloatLiteral(n) => cst.float_lit(tok.span, n),
      StringLiteral(s) => cst.string_lit(tok.span, s),
      Nil => cst.nil_lit(tok.span),
      Bool(b) => cst.bool_lit(tok.span, b),
      Error(msg) => return Err(ParseError.new(tok.span, msg)),
      _ => return Err(ParseError.new(
        tok.span,
        f"Expected term or prefix operator. Got {tok.kind}",
      )),
    }
    self.terms = self.terms.append(term)
    self.expecting = Expecting.Operator
    Ok(())
  }

  fn handle_prefix(self: Ref<ExpressionParser>, prefix_op: Operator) -> Result<(), ParseError> {
    self.push_operator(prefix_op)?
    self.read_operand()
  }

  fn identifier(self: Ref<ExpressionParser>, span: span.Span, name: string) -> Result<cst.Expression, ParseError> {
    match name {
      "true" => Ok(cst.bool_lit(span, true)),
      "false" => Ok(cst.bool_lit(span, false)),
      "nil" => Ok(cst.nil_lit(span)),
      _ => {
        let (span, path) = self.parser.parse_path(span, name)?
        let type_args = self.parse_type_args()?
        match (type_args, self.parser.peek().kind) {
          (Some(type_args), Dot) => {
            self.parse_type_dot_call(span, path, type_args)
          },
          (_, LeftParen) => self.function_call(span, path, type_args),
          _ => Ok(cst.identifier(span, path)),
        }
      },
    }
  }

  fn parse_type_dot_call(
    self: Ref<ExpressionParser>,
    typ_span: Span,
    type_path: cst.Path,
    type_args: Slice<cst.Type>,
  ) -> Result<cst.Expression, ParseError> {
    let _ = self.parser.consume(lexer.TokenKind.Dot)?
    let name = self.parser.consume_identifier()?
    let (span_, path) = self.parser.parse_path(typ_span, name)?
    if !path.namespace.is_empty() {
      return Err(ParseError.new(
        span_,
        "static method calls cannot be namespaced",
      ))
    }
    let call_type_args = self.parse_type_args()?
    let (span_, call) = match self.parser.peek().kind {
      LeftParen => self.parse_call(span_, path, call_type_args)?,
      _ => (span_, cst.Call { fn_name: path, type_args: call_type_args, .. }),
    }
    Ok(cst.type_dot_call(span_, type_path, type_args, call))
  }

  fn read_operator(self: Ref<ExpressionParser>) -> Result<(), ParseError> {
    let tok = self.parser.next()
    let tok_span = tok.span
    match tok.kind {
      Operator(op) => {
        self.push_operator(op)?
        self.expecting = Expecting.Term
        Ok(())
      },
      Dot => {
        let receiver = self.pop_term()?
        self.terms = self.terms.append(self.handle_dot(receiver)?)
        Ok(())
      },
      LeftParen => Err(ParseError.new(
        tok_span,
        "only named functions are supported, cannot 'call' arbitrary expressions",
      )),
      LeftBracket => Err(ParseError.new(
        tok_span,
        "Use `.get(i)` to index into collections.",
      )),
      Error(msg) => Err(ParseError.new(tok_span, msg)),
      _ => Err(ParseError.new(
        tok_span,
        f"Expected binary operator; got {tok.kind}",
      )),
    }
  }

  fn push_operator(self: Ref<ExpressionParser>, right_op: Operator) -> Result<(), ParseError> {
    loop {
      match self.operators.get(self.operators.length() - 1) {
        None => break,
        Some(left_op) => match left_op.relative_precedence(right_op) {
          Tighter => self.compress()?,
          Looser => break,
          None => return Err(ParseError.new(
            self.parser.peek().span,
            f"Relative precedence not defined between '{left_op}' [left] and '{right_op}' [right].  Disambiguate with parentheses.",
          )),
        },
      }
    }
    self.operators = self.operators.append(right_op)
    Ok(())
  }

  fn compress(self: Ref<ExpressionParser>) -> Result<(), ParseError> {
    if self.operators.is_empty() { return Ok(()) }
    let last = self.operators.length() - 1
    let op = self.operators[last]
    self.operators = self.operators[..last]
    let term = match op {
      Neg | Not | Let | Mut | MutBang | Var => unary_op(op, self.pop_term()?),
      binop => {
        let t2 = self.pop_term()?
        let t1 = self.pop_term()?
        let span = t1.span.merge(t2.span)
        cst.binop_expr(span, t1, binop, t2)
      },
    }
    self.terms = self.terms.append(term)
    Ok(())
  }

  fn pop_term(self: Ref<ExpressionParser>) -> Result<cst.Expression, ParseError> {
    if self.terms.is_empty() {
      return Err(ParseError.new(
        self.parser.peek().span,
        "Not enough terms to complete expression",
      ))
    }
    let last = self.terms.length() - 1
    let t = self.terms[last]
    self.terms = self.terms[..last]
    Ok(t)
  }

  fn parse_paren_group(self: Ref<ExpressionParser>, _span: Span) -> Result<cst.Expression, ParseError> {
    let exprs = self.parse_list(')')?
    let end = self.parser.consume(TokenKind.RightParen)?
    let s = _span.merge(end)
    match exprs {
      [e] => Ok(e),
      _ => Ok(cst.tuple_lit(s, exprs)),
    }
  }

  fn parse_array_literal(self: Ref<ExpressionParser>, _span: Span) -> Result<cst.Expression, ParseError> {
    let items = self.parse_list(']')?
    let rbracket_span = self.parser.consume(TokenKind.RightBracket)?
    let s = _span.merge(rbracket_span)
    Ok(cst.array_lit(s, items))
  }

  fn handle_dot(self: Ref<ExpressionParser>, receiver: cst.Expression) -> Result<cst.Expression, ParseError> {
    let start = receiver.span.merge(self.parser.peek().span)
    let (span, path) = self.parser.parse_path(
      start,
      self.parser.consume_identifier()?,
    )?
    let type_args = self.parse_type_args()?
    if type_args.is_some() ||
    self.parser.peek().kind == lexer.TokenKind.LeftParen {
      // `foo.bar[T]` or `foo.bar(...`
      let (span, call) = self.parse_call(span, path, type_args)?
      Ok(cst.dot_call(span, &receiver, call))
    } else if path.namespace.is_empty() {
      // `foo.bar`
      Ok(cst.dot_name(span, &receiver, path.name))
    } else {
      // `foo.mod::bar`
      Ok(cst.dot_call(
        span,
        &receiver,
        cst.Call { fn_name: path, type_args, args: [] },
      ))
    }
  }

  fn function_call(
    self: Ref<ExpressionParser>,
    start: Span,
    fn_name: cst.Path,
    type_args: Option<Slice<cst.Type>>,
  ) -> Result<cst.Expression, ParseError> {
    let (span, call) = self.parse_call(start, fn_name, type_args)?
    Ok(cst.call_expr(span, call))
  }

  fn parse_call(
    self: Ref<ExpressionParser>,
    start: Span,
    fn_name: cst.Path,
    type_args: Option<Slice<cst.Type>>,
  ) -> Result<(span.Span, cst.Call), ParseError> {
    // let type_args = self.parse_type_args()?
    let _ = self.parser.consume(TokenKind.LeftParen)?
    let args = self.parse_list(')')?
    let end = self.parser.consume(TokenKind.RightParen)?
    let s = start.merge(end)
    Ok((s, cst.Call { fn_name, type_args, args }))
  }

  fn parse_type_args(self: Ref<ExpressionParser>) -> Result<Option<Slice<cst.Type>>, ParseError> {
    if self.parser.peek().kind != TokenKind.LeftBracket { return Ok(None) }
    let _ = self.parser.next()
    let types = self.parser.parse_list(']', self.parser.parse_type)?
    let _ = self.parser.consume(TokenKind.RightBracket)?
    Ok(Some(types))
  }

  fn parse_closure(self: Ref<ExpressionParser>, span: span.Span) -> Result<cst.Expression, ParseError> {
    let parameters = self.parser.parse_list('|', self.parser.parse_parameter)?
    let _ = self.parser.consume(TokenKind.Pipe)?
    let body = self.parser.parse_colon_and_block()?
    let span = span.merge(body.last().span)
    Ok(cst.closure(span, parameters, body))
  }

  fn parse_list(self: Ref<ExpressionParser>, end: rune) -> Result<Slice<cst.Expression>, ParseError> {
    self.parser.parse_list(end, self.parser.parse_expression)
  }
}

impl Parser {
  pub fn parse_expression(self: Ref<Parser>) -> Result<cst.Expression, ParseError> {
    let mut expr_parser = ExpressionParser.new(self, self.peek_indent())
    expr_parser.parse()
  }

  pub fn parse_colon_and_block(self: Ref<Parser>) -> Result<cst.Block, ParseError> {
    let colon = self.consume(TokenKind.Colon)?
    let statements = self.parse_list('\n', self.parse_expression)?
    if statements.is_empty() {
      Err(ParseError.new(colon, "Empty block"))
    } else {
      Ok(cst.Block { statements })
    }
  }

  fn parse_while_expression(self: Ref<Parser>, span: Span) -> Result<cst.Expression, ParseError> {
    let condition = self.parse_expression()?
    let body = self.parse_colon_and_block()?
    let span = span.merge(body.last().span)
    let cond = cst.Conditional.Predicate(&condition, cst.Consequent.Do(body))
    Ok(cst.while_(span, cond))
  }

  fn parse_for_expression(self: Ref<Parser>, span: Span) -> Result<cst.Expression, ParseError> {
    let header = self.parse_expression()?
    let (patt, iter) = match header.kind {
      Binop(binop) => match binop.* {
        cst.Binop { left, op: In, right } => (left, right),
        _ => return Err(ParseError.new(
          span.merge(header.span),
          "Proper syntax is `for <pattern> in <iterable>: <body>` eg, `for x in xs: ...`",
        )),
      },
      _ => return Err(ParseError.new(
        span.merge(header.span),
        "Proper syntax is `for <pattern> in <iterable>: <body>` eg, `for x in xs: ...`",
      )),
    }
    let body = self.parse_colon_and_block()?
    let span = span.merge(body.last().span)
    Ok(cst.for_(span, patt, iter, body))
  }

  fn parse_if_expression(self: Ref<Parser>, span: Span) -> Result<cst.Expression, ParseError> {
    let cond = self.parse_conditional()?
    Ok(cst.if_(span.merge(cond.span()), cond))
  }

  fn parse_conditional(self: Ref<Parser>) -> Result<cst.Conditional, ParseError> {
    if self.peek_indent() > self.current_line_indent {
      let conditionals = self.parse_list('\n', self.parse_conditional)?
      return if conditionals.is_empty() {
        Err(ParseError.new(span.new(0, 0), "expected expression after `if`"))
      } else {
        Ok(cst.Conditional.Multi(conditionals))
      }
    }

    let subject_indent = self.current_line_indent
    let subject = self.parse_subject()?
    match self.peek().kind {
      Operator(op) if op.is_comparer() => {
        self.current_line_indent = subject_indent
        let arms = self.parse_arms(op)?
        Ok(cst.Conditional.Compares(subject, arms))
      },
      _ => {
        let block = self.parse_consequent()?
        Ok(cst.Conditional.Predicate(subject, block))
      },
    }
  }

  fn parse_subject(self: Ref<Parser>) -> Result<Ref<cst.Expression>, ParseError> {
    let mut ep = ExpressionParser.new(self, self.current_line_indent)
    ep.should_stop_at_comparison_operator = true
    ep.parse().map(|expr| &expr)
  }

  fn parse_arms(self: Ref<Parser>, mut current_op: Operator) -> Result<Slice<cst.Arm>, ParseError> {
    let mut op_indent = self.current_line_indent
    self.parse_list(
      '\n',
      || {
        if let TokenKind.Operator(op) = self.peek().kind {
          if op.is_comparer() {
            let _ = self.next()
            current_op = op
            op_indent = self.current_line_indent
            if self.peek_newline(op_indent) {
              return Err(ParseError.new(
                self.peek().span,
                "expected expression after operator",
              ))
            }
          }
        } else if self.current_line_indent <= op_indent {
          panic(
            f"Oops, this arm should be indented under the last `{current_op}`; what should I do here?",
          )
        }
        let object = self.parse_expression()?
        let then = self.parse_consequent()?
        Ok(cst.Arm { op: current_op, object, then })
      },
    )
  }

  fn parse_consequent(self: Ref<Parser>) -> Result<cst.Consequent, ParseError> {
    match self.peek().kind {
      Operator(And) => panic("`and` not yet supported here"),
      Operator(Or) => panic("`or` not yet supported"),
      Colon => Ok(cst.Consequent.Do(self.parse_colon_and_block()?)),
      _ => Err(ParseError.new(
        self.peek().span,
        "expected `and`, `or`, or colon and block",
      )),
    }
  }
}

fn unary_op(op: Operator, term: cst.Expression) -> cst.Expression {
  match op {
    Neg => {
      let span = term.span.extend_left(1)
      match term.kind {
        IntLiteral(i) => cst.int_lit(span, -i),
        FloatLiteral(f) => cst.float_lit(span, -f),
        _ => cst.neg(span, &term),
      }
    },
    Not => {
      let span = term.span.extend_left(4)
      cst.not_(span, &term)
    },
    Let => {
      let span = term.span.extend_left(4)
      cst.binding(span, mode.Mode.Let, &term)
    },
    Mut => {
      let span = term.span.extend_left(4)
      cst.binding(span, mode.Mode.Mut, &term)
    },
    MutBang => {
      let span = term.span.extend_left(5)
      cst.binding(span, mode.Mode.MutBang, &term)
    },
    Var => {
      let span = term.span.extend_left(4)
      cst.binding(span, mode.Mode.Var, &term)
    },
    _ => panic(f"{op} is not a unary operator"),
  }
}
