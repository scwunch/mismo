import "cst"
import dx "diagnostics"
import "lexer"
import md "mode"
import "operator"
import spn "span"

type Operator = operator.Operator

#[display]
enum Expecting {
  Term,
  Operator,
}

struct ExpressionParser {
  parser: Ref<Parser>,
  terms: Slice<cst.Expression>,
  operators: Slice<Operator>,
  expression_indent: uint32,
  expecting: Expecting,
  stop_at: lexer.TokenKind,
}

impl ExpressionParser {
  fn new(parser: Ref<Parser>, expression_indent: uint32) -> ExpressionParser {
    ExpressionParser {
      parser,
      terms: [],
      operators: [],
      expression_indent,
      expecting: Expecting.Term,
      stop_at: TokenKind.EOF as TokenKind,
    }
  }

  fn until(parser: Ref<Parser>, expression_indent: uint32, stop_at: TokenKind) -> ExpressionParser {
    ExpressionParser {
      parser,
      terms: [],
      operators: [],
      expression_indent,
      expecting: Expecting.Term,
      stop_at,
    }
  }

  fn optional_expression(self: Ref<ExpressionParser>) -> Result<Option<Ref<cst.Expression>>, dx.ParseError> {
    if self.expression_done() { return Ok(None) }
    let expr = self.parser.parse_expression()?
    Ok(Some(&expr))
  }

  fn do_parse(self: Ref<ExpressionParser>) -> Result<(), dx.ParseError> {
    loop {
      match self.expecting {
        Expecting.Term => self.read_operand()?,
        Expecting.Operator => self.read_operator()?,
      }
      if self.expression_done() { return Ok(()) }
    }
  }

  fn parse(self: Ref<ExpressionParser>) -> Result<cst.Expression, dx.ParseError> {
    self.do_parse()?

    if self.expecting == Expecting.Term {
      let op_str = self.operators[self.operators.length() - 1].string()
      return Err(dx.ParseError.new(
        self.parser.peek().span,
        f"expected operand after {op_str}",
      ))
    }

    while self.operators.length() > 0 {
      self.compress()?
    }

    if !self.operators.is_empty() || self.terms.length() != 1 {
      return Err(dx.ParseError.new(
        self.parser.peek().span,
        "operators and terms did not add up (this is probably a compiler bug)",
      ))
    }

    let result = self.pop_term()?
    self.expecting = Expecting.Term
    Ok(result)
  }

  fn expression_done(self: Ref<ExpressionParser>) -> bool {
    match self.parser.peek().kind {
      RightParen | RightBracket | RightBrace | Colon | Comma | EOF => true,
      tok if tok == self.stop_at => true,
      _ => self.parser.newline_follows(self.expression_indent),
    }
  }

  fn read_operand(self: Ref<ExpressionParser>) -> Result<(), dx.ParseError> {
    let tok = self.parser.next()
    let term = match tok.kind {
      Operator(Sub) => return self.handle_prefix(Operator.Neg),
      Operator(Not) => return self.handle_prefix(Operator.Not),
      Operator(op) => {
        if self.parser.peek().kind == TokenKind.LeftParen {
          self.function_call(tok.span, cst.Path.name_(op.sigil()), None)?
        } else {
          return Err(dx.ParseError.new(
            tok.span,
            f"Expected term or prefix operator. Got operator '{op}'",
          ))
        }
      },
      Let => return self.handle_prefix(Operator.Let),
      Mut => return self.handle_prefix(Operator.Mut),
      MutBang => return self.handle_prefix(Operator.MutBang),
      Var => return self.handle_prefix(Operator.Var),
      If => self.parser.parse_if_expression(tok.span)?,
      While => self.parser.parse_while_expression(tok.span)?,
      For => self.parser.parse_for_expression(tok.span)?,
      Return => cst.return_(tok.span, self.optional_expression()?),
      Break => cst.break_(tok.span, self.optional_expression()?),
      Continue => cst.continue_(tok.span),
      Identifier(name) => self.identifier(tok.span, name)?,
      LeftParen => self.parse_paren_group(tok.span)?,
      LeftBracket => self.parse_array_literal(tok.span)?,
      LeftBrace => self.parse_tuple_or_record_literal(tok.span)?,
      Dot => self.handle_dot(None, tok.span)?,
      Pipe => self.parse_closure(tok.span)?,
      IntLiteral(n) => cst.int_lit(tok.span, n),
      FloatLiteral(n) => cst.float_lit(tok.span, n),
      StringLiteral(s) => cst.string_lit(tok.span, s),
      Nil => cst.nil_lit(tok.span),
      Bool(b) => cst.bool_lit(tok.span, b),
      Else => self.identifier(tok.span, "else")?,
      Error(msg) => return Err(dx.ParseError.new(tok.span, msg)),
      _ => return Err(dx.ParseError.new(
        tok.span,
        f"Expected term or prefix operator. Got `{tok.kind}`",
      )),
    }
    self.terms = self.terms.append(term)
    self.expecting = Expecting.Operator
    Ok(())
  }

  fn handle_prefix(self: Ref<ExpressionParser>, prefix_op: Operator) -> Result<(), dx.ParseError> {
    self.push_operator(prefix_op)?
    self.read_operand()
  }

  fn identifier(self: Ref<ExpressionParser>, span: spn.Span, name: string) -> Result<cst.Expression, dx.ParseError> {
    match name {
      "true" => Ok(cst.bool_lit(span, true)),
      "false" => Ok(cst.bool_lit(span, false)),
      "nil" => Ok(cst.nil_lit(span)),
      _ => {
        let (span, path) = self.parser.parse_path(span, name)?
        let (span, type_args) = self.parser.parse_type_args(span)?

        if path.is_type_name() {
          Ok(cst.type_expr(span, path, type_args))
        } else if type_args.is_some() ||
        self.parser.peek().kind == TokenKind.LeftParen {
          self.function_call(span, path, type_args)
        } else {
          Ok(cst.identifier(span, path))
        }
      },
    }
  }

