  fn parse_tuple_or_record_type(self: Ref<Parser>, span: Span) -> Result<cst.Type, dx.ParseError> {
    if let Ok(end) = self.consume(TokenKind.RightBrace) {
      return Ok(cst.Type.tuple(span.merge(end), []))
    }
    let open_brace_indent = self.current_line_indent
    let ident_span = self.peek().span
    let Ok(name) = self.consume_identifier() else {
      return self.finish_tuple_type(span, open_brace_indent, self.parse_type()?)
    }
    let (path_span, path) = self.parse_path(ident_span, name)?
    if path.namespace.is_empty() && !path.is_type_name() {
      self.finish_record_type(span, open_brace_indent, ident_span, path.name)
    } else {
      let (first_span, args) = self.parse_type_args(path_span)?
      let first = cst.Type.new(first_span, path, args.unwrap_or([]))
      let _ = self.consume(TokenKind.Comma)
      self.finish_tuple_type(span, open_brace_indent, first)
    }
  }

  fn finish_tuple_type(self: Ref<Parser>, open: Span, open_brace_indent: uint32, first: cst.Type) -> Result<cst.Type, dx.ParseError> {
    self.current_line_indent = open_brace_indent
    let rest = self.parse_list('}', self.parse_type)?
    let close = self.consume(TokenKind.RightBrace)?
    Ok(cst.Type.tuple(open.merge(close), [first].append(rest...)))
  }

  fn finish_record_type(
    self: Ref<Parser>,
    open: Span,
    open_brace_indent: uint32,
    first_field_span: Span,
    first_field_name: string,
  ) -> Result<cst.Type, dx.ParseError> {
    let _ = self.consume(TokenKind.Colon)
    let typ = self.parse_type()?
    let span = first_field_span.merge(typ.span)
    let first = cst.TypeField { span, name: first_field_name, typ}
    let _ = self.consume(TokenKind.Comma)
    self.current_line_indent = open_brace_indent
    let fields = self.parse_list('}', self.parse_field)?
    let fields = [first].append(fields...)
    let close = self.consume(TokenKind.RightBrace)?
    Ok(cst.Type.record(open.merge(close), fields))
  }

  fn parse_field(self: Ref<Parser>) -> Result<cst.TypeField, dx.ParseError> {
    let span: Span = self.peek().span
    let name = self.consume_identifier()?
    let _ = self.consume(TokenKind.Colon)?
    let typ = self.parse_type()?
    let span = span.merge(typ.span)
    Ok(cst.TypeField { span, name, typ })
  }

