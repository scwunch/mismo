  fn consume(self: Ref<Parser>, kind: TokenKind) -> Result<Span, dx.ParseError> {
    if self.peek().kind == kind {
      Ok(self.next().span)
    } else {
      Err(dx.ParseError.new(
        self.peek().span,
        f"Expected {kind}; got {self.peek().kind}",
      ))
    }
  }

  /// emit an error
  fn emit_error(self: Ref<Parser>, err: dx.ParseError) {
    self.defs.errors = self.defs.errors.append(err)
  }

  /// recover parser to the next top-level statement (ie, indent=0)
  fn recover_to_next_def(self: Ref<Parser>) {
    while !self.newline_follows(0) {
      let _ = self.next()
    }
  }
}
