import "ast"
import "errors"
import "lexer"
import "mode"
import "span"

type Lexer = lexer.Lexer

type Span = span.Span

pub type Token = lexer.Token

pub type TokenKind = lexer.TokenKind

type TypeParameters = Slice<string>

type ParseError = errors.ParseError

pub struct Parser {
  lexer: Lexer,
  peeked: Token,
  current_line_indent: uint32,
  pub defs: Ref<ast.Definitions>,
}

impl Parser {
  pub fn new(source: string, defs: Ref<ast.Definitions>) -> Parser {
    let mut lexer = Lexer.new(source)
    let peeked = lexer.next()
    Parser { lexer, peeked, current_line_indent: 0, defs }
  }

  pub fn new_with_defs(source: string) -> Parser {
    Parser.new(source, &ast.Definitions.new())
  }

  pub fn peek(self: Ref<Parser>) -> Token {
    self.peeked
  }

  pub fn next(self: Ref<Parser>) -> Token {
    let tok = self.peeked
    self.peeked = self.lexer.next()
    tok
  }

  pub fn parse(self: Ref<Parser>) {
    loop {
      let result: Result<(), ParseError> = match self.peek().kind {
        TokenKind.Identifier("import") => self.parse_import(),
        TokenKind.Identifier("struct") => self.parse_struct(),
        TokenKind.Identifier("enum") => self.parse_enum(),
        TokenKind.Identifier("fn") => self.parse_function(),
        _ => Err(self.error(
          self.peek().span,
          "Expected top-level definition (fn, import, struct, enum, interface)",
        )),
      }
      match result {
        Ok(_) => (),
        Err(_) => self.recover_to_next_def(),
      }
    }
  }

  fn parse_import(self: Ref<Parser>) -> Result<(), ParseError> {
    match self.peek().kind {
      TokenKind.StringLiteral(path) => panic("parse_import not implemented"),
      _ => panic("parse_import not implemented"),
    }
  }

  fn parse_struct(self: Ref<Parser>) -> Result<(), ParseError> {
    let mut span = self.next().span
    // consume the "struct" keyword
    let name = self.consume_identifier()?
    let mut type_params = []
    if self.consume(lexer.TokenKind.LeftBracket).is_ok() {
      type_params = self.parse_type_params()?
      let _ = self.consume(lexer.TokenKind.RightBracket)?
    }
    let fields = self.parse_fields()?
    let newline_span = self.next().span
    span = span.merge(newline_span)
    self.defs.add_struct(ast.StructDef.new(span, name, type_params, fields))
    Ok(())
  }

  fn parse_enum(self: Ref<Parser>) -> Result<(), ParseError> {
    let mut span = self.next().span
    // consume the "struct" keyword
    let name = self.consume_identifier()?
    let mut type_params = []
    if self.consume(lexer.TokenKind.LeftBracket).is_ok() {
      type_params = self.parse_type_params()?
      let _ = self.consume(lexer.TokenKind.RightBracket)?
    }
    let variants = self.parse_variants()?
    let newline_span = self.next().span
    span = span.merge(newline_span)
    self.defs.add_enum(ast.EnumDef.new(span, name, type_params, variants))
    Ok(())
  }

  fn parse_function(self: Ref<Parser>) -> Result<(), ParseError> {
    let mut span = self.next().span
    let sig = self.parse_signature()?
    let body = self.parse_function_body()?
    span = span.merge(body.span)
    self.defs.add_function(ast.FunctionDef.new(span, sig, body))
    Ok(())
  }

  fn parse_signature(self: Ref<Parser>) -> Result<ast.Signature, ParseError> {
    let mut span = self.peek().span
    let name = self.consume_identifier()?
    let mut type_params = []
    if self.consume(lexer.TokenKind.LeftBracket).is_ok() {
      type_params = self.parse_type_params()?
      let _ = self.consume(lexer.TokenKind.RightBracket)?
    }
    let _ = self.consume(lexer.TokenKind.LeftParen)?
    let params = self.parse_function_params()?
    let rparen = self.consume(lexer.TokenKind.RightParen)?
    span = span.merge(rparen)
    let _ = self.consume(lexer.TokenKind.Arrow)
    let ret_type = self.parse_type()?
    span = span.merge(ret_type.span)
    Ok(ast.Signature.new(span, name, type_params, params, ret_type))
  }

  fn parse_function_params(self: Ref<Parser>) -> Result<Slice<ast.Parameter>, ParseError> {
    self.parse_list(lexer.TokenKind.RightParen, self.parse_parameter)
  }

  fn parse_parameter(self: Ref<Parser>) -> Result<ast.Parameter, ParseError> {
    let mut span = self.peek().span
    let mode = self.consume_mode()
    let name = self.consume_identifier()?
    let _ = self.consume(lexer.TokenKind.Colon)
    let typ = self.parse_type()?
    span = span.merge(typ.span)
    Ok(ast.Parameter.new(span, mode, name, typ))
  }

  fn parse_function_body(self: Ref<Parser>) -> Result<ast.Expression, ParseError> {
    let span = self.peek().span
    Ok(ast.nil_lit(span))
  }

  // consume and return the string representation of an identifier, keyword, or operator
  // e.g. "let", "if", "+", "*"
  //
  // returns an error if the peeked token is not an identifier, keyword, or operator
  fn consume_identifier(self: Ref<Parser>) -> Result<string, ParseError> {
    let ident = match self.peek().kind {
      TokenKind.Identifier(name) => name,
      TokenKind.Let => "let",
      TokenKind.Mut => "mut",
      TokenKind.MutBang => "mut!",
      TokenKind.Var => "var",
      TokenKind.Break => "break",
      TokenKind.Continue => "continue",
      TokenKind.Return => "return",
      TokenKind.If => "if",
      TokenKind.For => "for",
      TokenKind.While => "while",
      TokenKind.Operator(op) => op.sigil(),
      tok => return Err(self.error(
        self.peek().span,
        f"Expected identifier.  Got {tok}",
      )),
    }
    let _ = self.next()
    Ok(ident)
  }

  fn consume_mode(self: Ref<Parser>) -> Option<mode.Mode> {
    let mod = match self.peek().kind {
      TokenKind.Let => mode.Mode.Let,
      TokenKind.Mut => mode.Mode.Mut,
      TokenKind.MutBang => mode.Mode.MutBang,
      TokenKind.Var => mode.Mode.Var,
      tok => return None,
    }
    let _ = self.next()
    Some(mod)
  }

  fn parse_type_params(self: Ref<Parser>) -> Result<TypeParameters, ParseError> {
    self.parse_list(lexer.TokenKind.RightBracket, self.consume_identifier)
  }

  /// parse a list of items using a given parse function.  Items are separated by
  /// (COMMA | COMMA + NEWLINE | NEWLINE) where the NEWLINE must be indented
  /// beyond the given indent.
  ///
  /// Returns either a ParseError, or a tuple containing the parsed items along
  /// with the index of the ending token
  ///
  /// Will consume initial newline, and any trailing comma and newline.
  /// Beginning and ending brackets are not consumed.
  fn parse_list<Item>(
    self: Ref<Parser>,
    end: TokenKind,
    fun: fn() -> Result<Item, ParseError>,
  ) -> Result<Slice<Item>, ParseError> {
    let mut items = []
    let indent = self.current_line_indent
    while self.peek().kind != end && self.peek().kind != lexer.TokenKind.EOF {
      if let TokenKind.Newline(i) = self.peek().kind {
        if i > indent {
          // ignore newline, since next item is indented
          let _ = self.next()
          continue
        } else {
          // syntax error, unless the closing token follows this newline
          self.try_or_backtrack(|| {
            let _ = self.consume(lexer.TokenKind.Newline(indent))?
            if self.peek().kind == end {
              Ok(())
            } else {
              Err(self.error(
                self.peek().span,
                "list items must be indented deeper than line of list start",
              ))
            }
          })?
          break
        }
      }

      items = items.append(fun()?)

      // optional comma
      let _ = self.consume(lexer.TokenKind.Comma)
    }
    Ok(items)
  }

  fn try_or_backtrack<R, E>(self: Ref<Parser>, fun: fn() -> Result<R, E>) -> Result<R, E> {
    let state = self.*
    // let index = self.lexer.index
    // let peeked = self.peeked
    let res = fun()
    if res.is_err() {
      // self.lexer.index = index
      // self.peeked = peeked
      self.* = state
    }
    res
  }

  fn parse_variants(self: Ref<Parser>) -> Result<Slice<ast.Variant>, ParseError> {
    self.parse_list(lexer.TokenKind.Newline(0), self.parse_variant)
  }

  fn parse_variant(self: Ref<Parser>) -> Result<ast.Variant, ParseError> {
    let mut span = self.peek().span
    let name = self.consume_identifier()?
    let mut payload = []
    if self.consume(lexer.TokenKind.LeftParen).is_ok() {
      payload = self.parse_list(lexer.TokenKind.RightParen, self.parse_type)?
      let lparen = self.consume(lexer.TokenKind.RightParen)?
      span = span.merge(lparen)
    }
    Ok(ast.Variant.new(span, name, payload))
  }

  fn parse_fields(self: Ref<Parser>) -> Result<Slice<ast.Field>, ParseError> {
    // let _ = self.consume_newline(0)
    self.parse_list(lexer.TokenKind.Newline(0), self.parse_field)
    // let mut fields = []
    // loop {
    //   match self.consume_newline() {
    //     Ok(indent) => {
    //       if indent > 0 {
    //         fields = fields.append(self.parse_field())
    //       } else {
    //         break
    //       }
    //     },
    //     Err(tok) => return Err(self.error(tok.span, f"Expected struct fields; got {tok.kind}"))
    //   }

    //   let indent = self.consume_newline().map_err(
    //     |tok| self.error(tok.span, f"Expected struct fields; got {tok.kind}")
    //   )?
    //   if indent > 0 {
    //     fields = fields.append(self.parse_field())
    //   } else {
    //     break
    //   }
    // }
    // Ok(fields)
  }

  fn parse_field(self: Ref<Parser>) -> Result<ast.Field, ParseError> {
    let mut span = self.peek().span
    let name = self.consume_identifier()?
    let _ = self.consume(lexer.TokenKind.Colon)
    // optional colon
    span = span.merge(self.peek().span)
    let typ = self.parse_type()?
    Ok(ast.Field { span, name, typ })
  }

  fn parse_type(self: Ref<Parser>) -> Result<ast.Type, ParseError> {
    let mut span = self.peek().span
    let Ok(name) = self.consume_identifier() else {
      return self.parse_tuple_or_fn_type()
    }
    let mut type_args = []
    if self.consume(lexer.TokenKind.LeftBracket).is_ok() {
      type_args = self.parse_type_args()?
      span = span.merge(self.consume(lexer.TokenKind.RightBracket)?)
    }
    Ok(ast.Type.new(span, name, type_args))
  }

  fn parse_type_args(self: Ref<Parser>) -> Result<Slice<ast.Type>, ParseError> {
    self.parse_list(lexer.TokenKind.RightBracket, self.parse_type)
  }

  fn parse_param_type(self: Ref<Parser>) -> Result<ast.ParamType, ParseError> {
    let mode = self.consume_mode()
    let typ = self.parse_type()?
    Ok(ast.ParamType { mode, typ })
  }

  fn parse_tuple_or_fn_type(self: Ref<Parser>) -> Result<ast.Type, ParseError> {
    let mut span = self.peek().span
    let _ = self
      .consume(lexer.TokenKind.LeftParen)
      .map_err(|_| {
        self.error(
          span,
          f"Expected type (eg `Option[Int]` or `(T)->R`); got {self.peek().kind}",
        )
      })?
    let params = self.parse_list(
      lexer.TokenKind.RightParen,
      self.parse_param_type,
    )?
    span = span.merge(self.consume(lexer.TokenKind.RightParen)?)
    if self.consume(lexer.TokenKind.Arrow).is_ok() {
      let ret_type = self.parse_type()?
      span = span.merge(ret_type.span)
      Ok(ast.Type.fn_(span, params, &ret_type))
    } else {
      let type_pargs = params.map(|p| p.typ)
      Ok(ast.Type.tuple(span, type_pargs))
    }
  }

  fn consume(self: Ref<Parser>, kind: TokenKind) -> Result<Span, ParseError> {
    if self.peek().kind == kind {
      Ok(self.next().span)
    } else {
      Err(self.error(
        self.peek().span,
        f"Expected {kind}; got {self.peek().kind}",
      ))
    }
  }

  /// emit an error
  fn error(self: Ref<Parser>, span: Span, msg: string) -> ParseError {
    let err = ParseError { span, msg }
    self.defs.errors = self.defs.errors.append(err)
    err
  }

  /// recover parser to the next top-level statement (ie, indent=0)
  fn recover_to_next_def(self: Ref<Parser>) {
    if self.peek().kind == lexer.TokenKind.Newline(0) { return }
    loop {
      match self.next().kind {
        TokenKind.Newline(0) | TokenKind.EOF => {
          return
        },
        _ => (),
      }
    }
  }
}
