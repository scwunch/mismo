import "cst"
import dx "diagnostics"
import lex "lexer"
import md "mode"
import spn "span"

type Span = spn.Span

pub type TokenKind = lex.TokenKind

pub struct Parser {
  lexer: lex.Lexer,
  peeked: lex.Token,
  current_line_indent: uint32,
  pub defs: cst.Declarations,
}

impl Parser {
  pub fn new(source: string) -> Parser {
    let mut lexer = lex.Lexer.new(source)
    let peeked = lexer.next()
    Parser {
      lexer,
      peeked,
      current_line_indent: 0,
      defs: cst.Declarations.new(),
    }
  }

  pub fn peek(self) -> lex.Token {
    self.peeked
  }

  /// return `true` if the next token is on a new line
  /// unless it's indented greater than the reference
  pub fn newline_follows(self, reference_indent: uint32) -> bool {
    self.lexer.on_line_start && self.peek_indent() <= reference_indent
  }

  pub fn next(self: Ref<Parser>) -> lex.Token {
    let tok = self.peeked
    self.current_line_indent = self.lexer.indent
    self.peeked = self.lexer.next()
    tok
  }

  pub fn peek_indent(self) -> uint32 {
    self.lexer.indent
  }

  fn parse_path(self: Ref<Parser>, mut span: Span, mut name: string) -> Result<(spn.Span, cst.Path), dx.ParseError> {
    let mut path = []
    loop {
      if self.consume(TokenKind.NamespaceSeparator).is_ok() {
        span = span.merge(self.peek().span)
        path = path.append(name)
        name = self.consume_identifier()?
      } else {
        return Ok((span, cst.Path { namespace: path, name }))
      }
    }
  }

  // consume and return the string representation of an identifier, keyword, or operator
  // e.g. "let", "if", "+", "*"
  //
  // returns an error if the peeked token is not an identifier, keyword, or operator
  fn consume_identifier(self: Ref<Parser>) -> Result<string, dx.ParseError> {
    let ident = match self.peek().kind {
      Identifier(name) => name,
      Let => "let",
      Mut => "mut",
      MutBang => "mut!",
      Var => "var",
      Break => "break",
      Continue => "continue",
      Return => "return",
      If => "if",
      For => "for",
      While => "while",
      Operator(op) => op.sigil(),
      tok => return Err(dx.ParseError.new(
        self.peek().span,
        f"Expected identifier.  Got {tok}",
      )),
    }
    let _ = self.next()
    Ok(ident)
  }

  fn consume_mode(self: Ref<Parser>) -> Option<md.Mode> {
    let mod = match self.peek().kind {
      Let => md.Mode.Let,
      Mut => md.Mode.Mut,
      MutBang => md.Mode.MutBang,
      Var => md.Mode.Var,
      tok => return None,
    }
    let _ = self.next()
    Some(mod)
  }

  /// parse a list of items using a given parse function.  Items are separated by
  /// (COMMA | (COMMA + NEWLINE) | NEWLINE) where the NEWLINE must be indented
  /// beyond the initial indent.
  ///
  /// Returns a slice of parsed items, or the the first dx.ParseError raised.
  ///
  /// Will consume initial newline, and any trailing comma.
  /// Beginning and ending brackets are not consumed.  Parser will end where `peek` is the ending token.
  fn parse_list<Item>(
    self: Ref<Parser>,
    end: rune,
    fun: fn() -> Result<Item, dx.ParseError>,
  ) -> Result<Slice<Item>, dx.ParseError> {
    let mut items = []
    let indent = self.current_line_indent
    loop {
      match (self.peek().kind, end) {
        (EOF, _) |
        (RightBracket, ']') |
        (RightParen, ')') |
        (RightBrace, '}') |
        (Pipe, '|') => break,
        (RightBracket, '\n') |
        (RightParen, '\n') |
        (RightBrace, '\n') => break,
        _ if self.newline_follows(indent) => {
          if end == '\n' { break }
          return Err(dx.ParseError.new(
            self.peek().span,
            "list items must be indented deeper than line of list start",
          ))
        },
        _ => {
          items = items.append(fun()?)
          // optional comma
          let _ = self.consume(TokenKind.Comma)
        },
      }
    }
    Ok(items)
  }

  fn parse_type(self: Ref<Parser>) -> Result<cst.Type, dx.ParseError> {
    match self.peek().kind {
      Dot => self.parse_enum_type(self.next().span),
      LeftBrace => self.parse_tuple_or_record_type(self.next().span),
      LeftParen => self.parse_fn_type(self.next().span),
      Identifier(_) => self.parse_nominal_type(self.peek().span),
      k => Err(dx.ParseError.new(self.peek().span, f"expected type; got {k}")),
    }
  }

  fn parse_nominal_type(self: Ref<Parser>, span: Span) -> Result<cst.Type, dx.ParseError> {
    let name = self.consume_identifier()?
    let (span, path) = self.parse_path(span, name)?
    let (span, type_args) = self.parse_type_args(span)?
    Ok(cst.Type.new(span, path, type_args.unwrap_or([])))
  }

  fn parse_type_args(self: Ref<Parser>, span: Span) -> Result<(Span, Option<Slice<cst.Type>>), dx.ParseError> {
    if self.peek().kind != TokenKind.LeftBracket { return Ok((span, None)) }
    let _ = self.next()
    let types = self.parse_list(']', self.parse_type)?
    let end = self.consume(TokenKind.RightBracket)?
    Ok((span.merge(end), Some(types)))
  }

  fn parse_param_type(self: Ref<Parser>) -> Result<cst.ParamType, dx.ParseError> {
    let mode = self.consume_mode()
    let typ = self.parse_type()?
    Ok(cst.ParamType { mode, typ })
  }

  fn parse_enum_type(self: Ref<Parser>, span: Span) -> Result<cst.Type, dx.ParseError> {
    let _ = self.consume(TokenKind.LeftBrace)?
    let variants = self.parse_list('}', self.parse_variant)?
    let _ = self.consume(TokenKind.RightBrace)?
    Ok(cst.Type { span, kind: cst.TypeKind.Enum(variants) })
  }

  fn parse_variant(self: Ref<Parser>) -> Result<cst.Variant, dx.ParseError> {
    let mut span: Span = self.peek().span
    let name = self.consume_identifier()?
    let payload = if self.peek().kind == TokenKind.Comma || self.newline_follows(self.current_line_indent) {
      None
    } else {
      let typ = self.parse_type()?
      span = span.merge(typ.span)
      Some(typ)
    }
    Ok(cst.Variant { span, name, payload })
  }

  fn parse_fn_type(self: Ref<Parser>, mut span: Span) -> Result<cst.Type, dx.ParseError> {
    let params = self.parse_list(')', self.parse_param_type)?
    span = span.merge(self.consume(TokenKind.RightParen)?)
    if self.consume(TokenKind.Arrow).is_ok() {
      let ret_type = self.parse_type()?
      span = span.merge(ret_type.span)
      Ok(cst.Type.fn_(span, params, &ret_type))
    } else {
      let ret_type = cst.Type { span: spn.new(span.end, span.end), kind: cst.TypeKind.Tuple([]) }
      Ok(cst.Type.fn_(span, params, &ret_type))
    }
  }

