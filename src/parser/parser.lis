import "span"
import "lexer"
import "ast"
import "errors"
type Lexer = lexer.Lexer
pub type Token = lexer.Token
pub type TokenKind = lexer.TokenKind
type TypeParameters = Slice<string>
type ParseError = errors.ParseError

pub struct Parser {
  lexer: Lexer,
  peeked: Token,
  line_indent: uint32,
  pub defs: Ref<ast.Definitions>,
}
impl Parser {
  pub fn new(source: string, defs: Ref<ast.Definitions>) -> Parser {
    let mut lexer = Lexer.new(source)
    let peeked = lexer.next()
    Parser { lexer, peeked, line_indent: 0, defs }
  }

  pub fn new_with_defs(source: string) -> Parser {
    Parser.new(source, &ast.Definitions.new())
  }

  pub fn peek(self: Ref<Parser>) -> Token {
    self.peeked
  }

  pub fn next(self: Ref<Parser>) -> Token {
    let tok = self.peeked
    if let TokenKind.Newline(indent) = tok.kind {
      self.line_indent = indent
    }
    self.peeked = self.lexer.next()
    tok
  }

  pub fn parse(self: Ref<Parser>) {
    loop {
      let tok = self.next()
      let result: Result<(), ParseError> = match tok.kind {
        TokenKind.Identifier("import") => self.parse_import(),
        TokenKind.Identifier("struct") => self.parse_struct(),
        TokenKind.Identifier("enum") => self.parse_enum(),
        TokenKind.Identifier("interface") => self.parse_interface(),
        TokenKind.Identifier("fn") => self.parse_function(),
        _ => Err(self.error(tok.span, "Expected top-level definition (fn, import, struct, enum, interface)"))
      }
      match result {
        Ok(_) => (),
        Err(_) => self.recover_to_next_def()
      }
    }
  }

  fn parse_import(self: Ref<Parser>) -> Result<(), ParseError> {
    match self.peek().kind {
      TokenKind.StringLiteral(path) => panic("parse_import not implemented"),
      _ => panic("parse_import not implemented")
    }
  }

  fn parse_struct(self: Ref<Parser>) -> Result<(), ParseError> {
    let mut span = self.peek().span
    let name = self.consume_identifier()?
    let type_params = self.parse_type_params()?
    let fields = self.parse_fields()?
    span.end = self.lexer.index
    self.defs.add_struct(ast.StructDef.new(span, name, type_params, fields))
    Ok(())
  }

  fn parse_enum(self: Ref<Parser>) -> Result<(), ParseError> {
    Ok(())
  }

  fn parse_interface(self: Ref<Parser>) -> Result<(), ParseError> {
    Ok(())
  }

  fn parse_function(self: Ref<Parser>) -> Result<(), ParseError> {
    Ok(())
  }

  fn consume_identifier(self: Ref<Parser>) -> Result<string, ParseError> {
    match self.peek().kind {
      TokenKind.Identifier(name) => {
        let _ = self.next()
        Ok(name)
      },
      tok => Err(self.error(self.peek().span, f"Expected identifier.  Got {tok}"))
    }
  }

  fn consume_newline(self: Ref<Parser>, current_indent: uint32) -> Result<uint32, Token> {
    match self.peek().kind {
      TokenKind.Newline(indent) if indent > current_indent => {
        let _ = self.next()
        Ok(indent)
      },
      _ => Err(self.peek())
    }
  }

  fn parse_type_params(self: Ref<Parser>) -> Result<TypeParameters, ParseError> {
    if self.consume(lexer.TokenKind.LeftBracket).is_err() || 
       self.consume(lexer.TokenKind.RightBracket).is_ok() {
      return Ok([])
    }
    self.parse_items(
      0, 
      lexer.TokenKind.RightBracket,
      self.consume_identifier
    )
  }

  /// parse a list of items using a given parse function.  Items are separated by
  /// (COMMA | COMMA + NEWLINE | NEWLINE) where the NEWLINE must be indented 
  /// beyond the given indent.
  /// 
  /// Will consume initial newline, but no opening bracket or parenthesis.
  /// Trailing comma will be consumed; trailing newline is only consumed if 
  /// indentation is greater than `indent`.
  fn parse_items<Item>(
    self: Ref<Parser>, 
    indent: uint32,
    end: TokenKind,
    fun: fn()->Result<Item, ParseError>,
  ) -> Result<Slice<Item>, ParseError> {
    let mut items = []
    loop {
      if let TokenKind.Newline(i) = self.peek().kind {
        if i <= indent {
          if i == indent && self.try_or_backtrack(|| {
            let _ = self.next()
            self.consume(end)
          }).is_ok() {
            // 
            break
          }
          return Err(self.error(
            self.peek().span, 
            "list items must be indented deeper than line of list start"
          ))
        } else {
          let _ = self.next()
        }
      }

      if self.consume(end).is_ok() {
        break
      }

      items = items.append(fun()?)

      // optional comma
      let _ = self.consume(lexer.TokenKind.Comma)
    }
    Ok(items)
  }

  fn try_or_backtrack<R, E>(self: Ref<Parser>, fun: fn()->Result<R, E>) -> Result<R, E> {
    let state = self.*
    // let index = self.lexer.index
    // let peeked = self.peeked
    let res = fun()
    if res.is_err() {
      // self.lexer.index = index
      // self.peeked = peeked
      self.* = state
    }
    res
  }

  fn parse_fields(self: Ref<Parser>) -> Result<Slice<ast.Field>, ParseError> {
    let _ = self.consume_newline(0)
    self.parse_items(
      0,
      lexer.TokenKind.Newline(0),
      self.parse_field
    )
    // let mut fields = []
    // loop {
    //   match self.consume_newline() {
    //     Ok(indent) => {
    //       if indent > 0 {
    //         fields = fields.append(self.parse_field())
    //       } else {
    //         break
    //       }
    //     },
    //     Err(tok) => return Err(self.error(tok.span, f"Expected struct fields; got {tok.kind}"))
    //   }

    //   let indent = self.consume_newline().map_err(
    //     |tok| self.error(tok.span, f"Expected struct fields; got {tok.kind}")
    //   )?
    //   if indent > 0 {
    //     fields = fields.append(self.parse_field())
    //   } else {
    //     break
    //   }
    // }
    // Ok(fields)
  }

  fn parse_field(self: Ref<Parser>) -> Result<ast.Field, ParseError> {
    let mut span = self.peek().span
    let name = self.consume_identifier()?
    let _ = self.consume(lexer.TokenKind.Colon)  // optional colon
    span = span.merge(self.peek().span)
    let typ = self.parse_type()?
    Ok(ast.Field { span, name, typ })
  }

  fn parse_type(self: Ref<Parser>) -> Result<ast.Type, ParseError> {
    let start = self.peek().span.start
    let name = self.consume_identifier()?
    let type_args = self.parse_type_args()?
    let span = span.Span{start, end: self.peek().span.start}
    Ok(ast.Type.new(span, name, type_args))
  }

  fn parse_type_args(self: Ref<Parser>) -> Result<Slice<ast.Type>, ParseError> {
    self.parse_items(
      self.line_indent, 
      lexer.TokenKind.RightBracket,
      self.parse_type,
    )
  }

  fn consume(self: Ref<Parser>, kind: TokenKind) -> Result<span.Span, Token> {
    if self.peek().kind == kind {
      Ok(self.next().span)
    } else { 
      Err(self.peek())
    }
  }

  /// emit an error
  fn error(self: Ref<Parser>, span: span.Span, msg: string) -> ParseError {
    let err = ParseError { span, msg }
    self.defs.errors = self.defs.errors.append(err)
    err
  }

  /// recover parser to the next top-level statement (ie, indent=0)
  fn recover_to_next_def(self: Ref<Parser>) {
    if self.peek().kind == lexer.TokenKind.Newline(0) {
      return
    }
    loop {
      match self.next().kind {
        TokenKind.Newline(0) | TokenKind.EOF => {
          return
        },
        _ => ()
      }
    }
  }
}