import "cst"
import dx "diagnostics"
import "lexer"

impl Parser {
  pub fn parse(self: Ref<Parser>) -> cst.Declarations {
    loop {
      let result: Result<(), ParseError> = match self.peek().kind {
        Identifier("import") => self.parse_import(),
        Identifier("struct") => self.parse_struct(),
        Identifier("enum") => self.parse_enum(),
        Identifier("fn") => self.parse_function(),
        Identifier("extern") => self.parse_extern(),
        EOF => return self.defs,
        _ => Err(ParseError.new(
          self.peek().span,
          "Expected top-level definition (fn, import, struct, enum)",
        )),
      }
      if let Err(e) = result {
        self.emit_error(e)
        self.recover_to_next_def()
      }
    }
  }

  fn parse_import(self: Ref<Parser>) -> Result<(), ParseError> {
    match self.peek().kind {
      TokenKind.StringLiteral(path) => panic("parse_import not implemented"),
      _ => panic("parse_import not implemented"),
    }
  }

  fn parse_struct(self: Ref<Parser>) -> Result<(), ParseError> {
    let mut span = self.next().span
    // consume the "struct" keyword
    let name = self.consume_identifier()?
    let mut type_params = []
    if self.consume(TokenKind.LeftBracket).is_ok() {
      type_params = self.parse_type_params()?
      let _ = self.consume(TokenKind.RightBracket)?
    }
    let fields = self.parse_fields()?
    span.end = self.peek().span.start
    self.defs.add_type(cst.TypeDecl.new_struct(span, name, type_params, fields))
    Ok(())
  }

  fn parse_enum(self: Ref<Parser>) -> Result<(), ParseError> {
    let mut span = self.next().span
    // consume the "enum" keyword
    let name = self.consume_identifier()?
    let mut type_params = []
    if self.consume(TokenKind.LeftBracket).is_ok() {
      type_params = self.parse_type_params()?
      let _ = self.consume(TokenKind.RightBracket)?
    }
    let variants = self.parse_variants()?
    span.end = self.peek().span.start
    self.defs.add_type(cst.TypeDecl.new_enum(span, name, type_params, variants))
    Ok(())
  }

  fn parse_extern(self: Ref<Parser>) -> Result<(), ParseError> {
    let mut span = self.next().span
    let _ = self.consume(TokenKind.Identifier("fn"))?
    let sig = self.parse_signature()?
    span = span.merge(sig.span)
    self.defs.add_function(cst.FunctionDecl.new(
      span,
      sig,
      cst.Block { statements: [cst.extern(span)] },
    ))
    Ok(())
  }

  fn parse_function(self: Ref<Parser>) -> Result<(), ParseError> {
    let mut span = self.next().span
    let sig = self.parse_signature()?
    let body = self.parse_colon_and_block()?
    span = span.merge(body.last().span)
    self.defs.add_function(cst.FunctionDecl.new(span, sig, body))
    Ok(())
  }

  fn parse_signature(self: Ref<Parser>) -> Result<cst.Signature, ParseError> {
    let mut span = self.peek().span
    let name = self.consume_identifier()?
    let mut type_params = []
    if self.consume(TokenKind.LeftBracket).is_ok() {
      type_params = self.parse_type_params()?
      let _ = self.consume(TokenKind.RightBracket)?
    }
    let _ = self.consume(TokenKind.LeftParen)?
    let params = self.parse_function_params()?
    let rparen = self.consume(TokenKind.RightParen)?
    span = span.merge(rparen)
    let ret_type = if self.consume(TokenKind.Arrow).is_ok() {
      self.parse_type()?
    } else {
      match self.peek().kind {
        Colon => cst.Type.new(self.peek().span, cst.Path.name_("Nil"), []),
        _ if self.newline_follows(0) => cst.Type.new(
          self.peek().span,
          cst.Path.name_("Nil"),
          [],
        ),
        _ => self.parse_type()?,
      }
    }
    span = span.merge(ret_type.span)
    Ok(cst.Signature.new(span, name, type_params, params, ret_type))
  }

  fn parse_function_params(self: Ref<Parser>) -> Result<Slice<cst.Parameter>, ParseError> {
    self.parse_list(')', self.parse_parameter)
  }

  fn parse_parameter(self: Ref<Parser>) -> Result<cst.Parameter, ParseError> {
    let mut span = self.peek().span
    let mode = self.consume_mode()
    let name = self.consume_identifier()?
    let _ = self.consume(TokenKind.Colon)
    let typ = self.parse_type()?
    span = span.merge(typ.span)
    Ok(cst.Parameter.new(span, mode, name, typ))
  }

  fn parse_type_param(self: Ref<Parser>) -> Result<cst.TypeParameter, ParseError> {
    let span = self.peek().span
    let name = self.consume_identifier()?
    Ok(cst.TypeParameter { span, name })
  }

  fn parse_type_params(self: Ref<Parser>) -> Result<Slice<cst.TypeParameter>, ParseError> {
    self.parse_list(']', self.parse_type_param)
  }

  fn parse_variants(self: Ref<Parser>) -> Result<Slice<cst.Variant>, ParseError> {
    self.parse_list('\n', self.parse_variant)
  }

  fn parse_variant(self: Ref<Parser>) -> Result<cst.Variant, ParseError> {
    let mut span = self.peek().span
    let name = self.consume_identifier()?
    let mut payload = []
    if self.consume(TokenKind.LeftParen).is_ok() {
      payload = self.parse_list(')', self.parse_type)?
      let lparen = self.consume(TokenKind.RightParen)?
      span = span.merge(lparen)
    }
    Ok(cst.Variant.new(span, name, payload))
  }

  fn parse_fields(self: Ref<Parser>) -> Result<Slice<cst.Field>, ParseError> {
    self.parse_list('\n', self.parse_field)
  }

  fn parse_field(self: Ref<Parser>) -> Result<cst.Field, ParseError> {
    let mut span = self.peek().span
    let name = self.consume_identifier()?
    let _ = self.consume(TokenKind.Colon)
    // optional colon
    span = span.merge(self.peek().span)
    let typ = self.parse_type()?
    Ok(cst.Field { span, name, typ })
  }
}
