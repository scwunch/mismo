import "ast"
import "lexer"
import "mode"
import "span"
import "testing"

pub fn test() {
  let _ = testing.test_suite(
    "Parser",
    [
      test_consume,
      test_parse_type_params,
      test_parse_type,
      test_parse_tuple_type,
      test_parse_fn_type,
      test_parse_field,
      test_parse_fields,
      test_parse_struct,
      test_parse_variant,
      test_parse_enum,
      test_parse_signature,
      test_parse_simple_binary,
      test_parse_arithmetic_precedence,
      test_parse_parens,
      test_parse_basic_literals,
      test_parse_array_literals,
      test_parse_tuple_literals,
      test_parse_function_calls,
      test_parse_method_calls,
      test_parse_unary_neg,
      test_parse_unary_not,
      test_parse_let_var,
      test_parse_return_break_continue,
    ],
  )
}

fn test_consume(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Parser Consume"
  let mut parser = Parser.new_with_defs("[[[[[")
  match parser.consume(lexer.TokenKind.LeftBracket) {
    Ok(s) => t.should_eq(s, span.Span.new(0, 1))?,
    Err(e) => t.fail(f"{e}")?,
  }
  match parser.consume(lexer.TokenKind.RightBracket) {
    Ok(s) => t.fail("Did not expect `]`")?,
    Err(e) => t.should_eq(parser.peek(), lexer.Token.left_bracket(1))?,
  }
  parser = Parser.new_with_defs("foobar")
  match parser.consume_identifier() {
    Ok(str) => t.should_eq_repr(str, "foobar")?,
    Err(e) => t.fail(f"{e}")?,
  }
  Ok(())
}

fn test_parse_type_params(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Parse Type Params"
  // NOTE: parse_type_params is called *after* consuming the opening bracket,
  // so we just leave it off here
  let mut parser = Parser.new_with_defs(" T, U]")
  match parser.parse_type_params() {
    Ok(type_params) => t.should_eq_repr(type_params, ["T", "U"])?,
    Err(err) => t.fail(err.message())?,
  }

  // trailing comma
  parser = Parser.new_with_defs(" T, U,]")
  match parser.parse_type_params() {
    Ok(type_params) => t.should_eq_repr(type_params, ["T", "U"])?,
    Err(err) => t.fail(err.message())?,
  }

  // space-separated
  parser = Parser.new_with_defs(" T U]")
  match parser.parse_type_params() {
    Ok(type_params) => t.should_eq_repr(type_params, ["T", "U"])?,
    Err(err) => t.fail(err.message())?,
  }

  // newline-separated, newline at beginning and end
  parser = Parser.new_with_defs(" \n T\n U\n]")
  match parser.parse_type_params() {
    Ok(type_params) => t.should_eq_repr(type_params, ["T", "U"])?,
    Err(err) => t.fail(err.message())?,
  }

  // comma-newline-separated, newline at end
  parser = Parser.new_with_defs(" T,\n U,\n]")
  match parser.parse_type_params() {
    Ok(type_params) => t.should_eq_repr(type_params, ["T", "U"])?,
    Err(err) => t.fail(err.message())?,
  }

  // empty list
  parser = Parser.new_with_defs(" ]")
  match parser.parse_type_params() {
    Ok(type_params) => t.should_eq_repr(type_params, [])?,
    Err(err) => t.fail(err.message())?,
  }

  // empty list with newline (indent>0)
  parser = Parser.new_with_defs(" \n  ]")
  match parser.parse_type_params() {
    Ok(type_params) => t.should_eq_repr(type_params, [])?,
    Err(err) => t.fail(err.message())?,
  }

  // empty list with newline (indent=0)
  parser = Parser.new_with_defs("  \n]")
  match parser.parse_type_params() {
    Ok(type_params) => t.should_eq_repr(type_params, [])?,
    Err(err) => t.fail(err.message())?,
  }

  // failure to indent item
  parser = Parser.new_with_defs("\nT\nU\n]")
  match parser.parse_type_params() {
    Ok(type_params) => t.fail("expected error")?,
    Err(err) => t.should_eq_repr(
      err.message(),
      "list items must be indented deeper than line of list start",
    )?,
  }
  Ok(())
}

fn test_parse_type(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Parsing Type"
  let mut parser = Parser.new_with_defs("Type")
  match parser.parse_type() {
    Ok(typ) => t.should_eq(typ, ast.Type.new(span.Span.new(0, 4), "Type", []))?,
    Err(e) => t.fail(e.message())?,
  }

  parser = Parser.new_with_defs("Option[T]")
  match parser.parse_type() {
    Ok(typ) => t.should_eq(
      typ,
      ast.typ(0, 9, "Option", [ast.typ(7, 8, "T", [])]),
    ),
    Err(e) => t.fail(e.message()),
  }?

  parser = Parser.new_with_defs("Result[Option[T], String]")
  let mut res = ast.typ(
    0,
    25,
    "Result",
    [
      ast.typ(7, 16, "Option", [ast.typ(14, 15, "T", [])]),
      ast.typ(18, 24, "String", []),
    ],
  )
  match parser.parse_type() {
    Ok(typ) => t.should_eq(typ, res),
    Err(e) => t.fail(e.message()),
  }?

  parser = Parser.new_with_defs("Result[\n  Option[T]  \n  String\n]")
  res = ast.typ(
    0,
    32,
    "Result",
    [
      ast.typ(10, 19, "Option", [ast.typ(17, 18, "T", [])]),
      ast.typ(24, 30, "String", []),
    ],
  )
  match parser.parse_type() {
    Ok(typ) => t.should_eq(typ, res),
    Err(e) => t.fail(e.message()),
  }?

  Ok(())
}

fn test_parse_tuple_type(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Parsing Tuple Type"
  let mut parser = Parser.new_with_defs("(Type, Type)")
  let res = ast.Type.tuple(
    span.Span.new(0, 12),
    [ast.typ(1, 5, "Type", []), ast.typ(7, 11, "Type", [])],
  )
  match parser.parse_type() {
    Ok(typ) => t.should_eq(typ, res),
    Err(e) => t.fail(e.message()),
  }?
  Ok(())
}

fn test_parse_fn_type(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Parsing Function Type"
  let mut parser = Parser.new_with_defs("(Type, Type) -> Type")
  let res = ast.Type.fn_(
    span.Span.new(0, 20),
    [
      ast.ParamType.none(ast.typ(1, 5, "Type", [])),
      ast.ParamType.none(ast.typ(7, 11, "Type", [])),
    ],
    &ast.typ(16, 20, "Type", []),
  )
  match parser.parse_type() {
    Ok(typ) => t.should_eq(typ, res),
    Err(e) => t.fail(e.message()),
  }?

  parser = Parser.new_with_defs("(let Option[T], mut! T)->R")
  let res = ast.Type.fn_(
    span.Span.new(0, 26),
    [
      ast.ParamType.let_(ast.typ(5, 14, "Option", [ast.typ(12, 13, "T", [])])),
      ast.ParamType.mut_bang(ast.typ(21, 22, "T", [])),
    ],
    &ast.typ(25, 26, "R", []),
  )
  match parser.parse_type() {
    Ok(typ) => t.should_eq(typ, res),
    Err(e) => t.fail(e.message()),
  }?
  Ok(())
}

fn test_parse_field(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Parsing Field of Struct"
  let mut parser = Parser.new_with_defs("field: Type")
  match parser.parse_field() {
    Ok(field) => t.should_eq(
      field,
      ast.Field.new(0, 11, "field", ast.typ(7, 11, "Type", [])),
    ),
    Err(e) => t.fail(e.message()),
  }?
  Ok(())
}

fn test_parse_fields(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Parsing Struct Fields"
  let mut parser = Parser.new_with_defs("\n  field: Type\n  field: Type\n")
  match parser.parse_fields() {
    Ok(fields) => t.should_eq_repr(
      fields,
      [
        ast.Field.new(3, 14, "field", ast.typ(10, 14, "Type", [])),
        ast.Field.new(17, 28, "field", ast.typ(24, 28, "Type", [])),
      ],
    ),
    Err(e) => t.fail(e.message()),
  }?
  Ok(())
}

fn test_parse_struct(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Parsing Struct"
  let mut parser = Parser.new_with_defs("struct Point \n  x: Int\n  y: Int\n")

  match parser.parse_struct() {
    Ok(_) => (),
    Err(e) => t.fail(e.message())?,
  }
  let s = parser.defs.types.get(0).ok_or("no struct found")?
  t.should_eq_repr(s.name, "Point")?
  t.should_be_true(
    s.type_parameters.length() == 0,
    "type parameters should be empty",
  )?
  let ast.TypeBody.Struct(fields) = s.body else {
    return Err("expected struct, got enum")
  }
  t.should_eq_repr(fields.length(), 2)?
  let expected_field1 = ast.Field.new(16, 22, "x", ast.typ(19, 22, "Int", []))
  let expected_field2 = ast.Field.new(25, 31, "y", ast.typ(28, 31, "Int", []))
  t.should_eq(fields[0], expected_field1)?
  t.should_eq(fields[1], expected_field2)?
  t.should_eq(
    s,
    ast.TypeDecl.new_struct(
      Span.new(0, 32),
      "Point",
      [],
      [expected_field1, expected_field2],
    ),
  )?

  // struct with type parameters
  let mut parser = Parser.new_with_defs("struct Point[T]\n  x: T\n  y: T\n")
  match parser.parse_struct() {
    Ok(_) => (),
    Err(e) => t.fail(e.message())?,
  }
  let s = parser.defs.types.get(0).ok_or("no struct found")?
  t.should_eq_repr(s.name, "Point")?
  t.should_be_true(
    s.type_parameters.length() == 1,
    "type parameters should have length 1",
  )?
  t.should_eq_repr(s.type_parameters[0], "T")?
  let ast.TypeBody.Struct(fields) = s.body else {
    return Err("expected struct, got enum")
  }
  t.should_eq_repr(fields.length(), 2)?
  let expected_field1 = ast.Field.new(18, 22, "x", ast.typ(21, 22, "T", []))
  let expected_field2 = ast.Field.new(25, 29, "y", ast.typ(28, 29, "T", []))
  t.should_eq(fields[0], expected_field1)?
  t.should_eq(fields[1], expected_field2)?
  t.should_eq(
    s,
    ast.TypeDecl.new_struct(
      Span.new(0, 30),
      "Point",
      ["T"],
      [expected_field1, expected_field2],
    ),
  )?
  Ok(())
}

fn test_parse_variant(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Parsing Variant"
  let mut parser = Parser.new_with_defs("Some(T)")
  match parser.parse_variant() {
    Ok(variant) => t.should_eq(
      variant,
      ast.Variant.new(Span.new(0, 7), "Some", [ast.typ(5, 6, "T", [])]),
    )?,
    Err(e) => t.fail(e.message())?,
  }
  parser = Parser.new_with_defs("None")
  match parser.parse_variant() {
    Ok(variant) => t.should_eq(
      variant,
      ast.Variant.new(Span.new(0, 4), "None", []),
    )?,
    Err(e) => t.fail(e.message())?,
  }
  Ok(())
}

fn test_parse_enum(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Parsing Enum"
  let mut parser = Parser.new_with_defs("enum Color\n  Red\n  Green\n  Blue\n")
  parser.parse_enum().map_err(|e| e.message())?
  let e = parser.defs.types.get(0).ok_or("no enum found")?
  t.should_eq_repr(e.name, "Color")?
  let ast.TypeBody.Enum(variants) = e.body else {
    return Err("expected enum, got struct")
  }
  t.should_eq_repr(variants.length(), 3)?
  let expected_variant1 = ast.Variant.new(Span.new(13, 16), "Red", [])
  let expected_variant2 = ast.Variant.new(Span.new(19, 24), "Green", [])
  let expected_variant3 = ast.Variant.new(Span.new(27, 31), "Blue", [])
  t.should_eq(variants[0], expected_variant1)?
  t.should_eq(variants[1], expected_variant2)?
  t.should_eq(variants[2], expected_variant3)?
  t.should_eq(
    e,
    ast.TypeDecl.new_enum(
      Span.new(0, 32),
      "Color",
      [],
      [expected_variant1, expected_variant2, expected_variant3],
    ),
  )?

  parser = Parser.new_with_defs("enum Option[T]\n  Some(T)\n  None")
  parser.parse_enum().map_err(|e| e.message())?
  let e = parser.defs.types.get(0).ok_or("no enum found")?
  t.should_eq_repr(e.name, "Option")?
  let ast.TypeBody.Enum(variants) = e.body else {
    return Err("expected enum, got struct")
  }
  t.should_eq_repr(variants.length(), 2)?
  let expected_variant1 = ast.Variant.new(
    Span.new(17, 24),
    "Some",
    [ast.typ(22, 23, "T", [])],
  )
  let expected_variant2 = ast.Variant.new(Span.new(27, 31), "None", [])
  t.should_eq(variants[0], expected_variant1)?
  t.should_eq(variants[1], expected_variant2)?
  t.should_eq(
    e,
    ast.TypeDecl.new_enum(
      Span.new(0, 31),
      "Option",
      ["T"],
      [expected_variant1, expected_variant2],
    ),
  )?
  Ok(())
}

fn test_parse_signature(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Parse Function Signature"
  let mut parser = Parser.new_with_defs("fn foo(a: Int, b: Int) Int")
  match parser.consume_identifier() {
    Ok(name) => t.should_eq_repr(name, "fn")?,
    Err(e) => return t.fail(e.message()),
  }
  let sig = match parser.parse_signature() {
    Ok(sig) => sig,
    Err(e) => return t.fail(e.message()),
  }
  t.should_eq_repr(sig.name, "foo")?
  t.should_eq_repr(sig.type_parameters.length(), 0)?
  t.should_eq_repr(sig.parameters.length(), 2)?
  t.should_eq(
    sig.parameters[0],
    ast.param(7, 13, None, "a", ast.typ(10, 13, "Int", [])),
  )?
  t.should_eq(
    sig.parameters[1],
    ast.param(15, 21, None, "b", ast.typ(18, 21, "Int", [])),
  )?
  t.should_eq(sig.return_type, ast.typ(23, 26, "Int", []))?

  parser = Parser.new_with_defs("fn bar(let a String, mut! b Int) -> Nil")
  match parser.consume_identifier() {
    Ok(name) => t.should_eq_repr(name, "fn")?,
    Err(e) => return t.fail(e.message()),
  }
  let sig = match parser.parse_signature() {
    Ok(sig) => sig,
    Err(e) => return t.fail(e.message()),
  }
  t.should_eq_repr(sig.name, "bar")?
  t.should_eq_repr(sig.type_parameters.length(), 0)?
  t.should_eq_repr(sig.parameters.length(), 2)?
  t.should_eq(
    sig.parameters[0],
    ast.param(7, 19, Some(mode.Mode.Let), "a", ast.typ(13, 19, "String", [])),
  )?
  t.should_eq(
    sig.parameters[1],
    ast.param(21, 31, Some(mode.Mode.MutBang), "b", ast.typ(28, 31, "Int", [])),
  )?
  t.should_eq(sig.return_type, ast.typ(36, 39, "Nil", []))?

  Ok(())
}

fn test_parse_simple_binary(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "ExpressionParser: simple binary"
  let mut parser = Parser.new_with_defs("1 + 2")
  let mut ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  match expr.kind {
    ast.Expr.Binop(b) => {
      t.should_eq(expr.span, span.Span.new(0, 5))?
      t.should_eq(b.op, Operator.Add)?
      t.should_eq(b.left.kind, ast.Expr.IntLiteral(1))?
      t.should_eq(b.right.kind, ast.Expr.IntLiteral(2))?
    },
    _ => return t.fail(f"Expected Binop; got {expr.kind}"),
  }
  Ok(())
}

fn test_parse_arithmetic_precedence(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "ExpressionParser: arithmetic precedence"
  let mut parser = Parser.new_with_defs("1 + 2 * 3")
  let mut ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  match expr.kind {
    ast.Expr.Binop(b) => {
      t.should_eq(b.op, Operator.Add)?
      t.should_eq(b.left.kind, ast.Expr.IntLiteral(1))?
      match b.right.kind {
        ast.Expr.Binop(br) => {
          t.should_eq(br.op, Operator.Mul)?
          t.should_eq(br.left.kind, ast.Expr.IntLiteral(2))?
          t.should_eq(br.right.kind, ast.Expr.IntLiteral(3))?
        },
        _ => return t.fail(f"Expected Binop; got {b.right.kind}"),
      }
    },
    _ => return t.fail(f"Expected Binop; got {expr.kind}"),
  }

  parser = Parser.new_with_defs("1 - 2 * 3 + 4")
  ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  match expr.kind {
    ast.Expr.Binop(b) => {
      t.should_eq(b.op, Operator.Add)?
      match b.left.kind {
        ast.Expr.Binop(bl) => {
          t.should_eq(bl.op, Operator.Sub)?
          t.should_eq(bl.left.kind, ast.Expr.IntLiteral(1))?
          match bl.right.kind {
            ast.Expr.Binop(blr) => {
              t.should_eq(blr.op, Operator.Mul)?
              t.should_eq(blr.left.kind, ast.Expr.IntLiteral(2))?
              t.should_eq(blr.right.kind, ast.Expr.IntLiteral(3))?
            },
            _ => return t.fail("Expected Binop"),
          }
        },
        _ => return t.fail("Expected Binop"),
      }
      t.should_eq(b.right.kind, ast.Expr.IntLiteral(4))?
    },
    _ => return t.fail(f"Expected Binop; got {expr.kind}"),
  }
  Ok(())
}

fn test_parse_parens(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "ExpressionParser: parentheses"
  let mut parser = Parser.new_with_defs("(1 + 2) * 3")
  let mut ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  match expr.kind {
    ast.Expr.Binop(b) => {
      t.should_eq(b.op, Operator.Mul)?
      match b.left.kind {
        ast.Expr.Binop(bl) => {
          t.should_eq(bl.op, Operator.Add)?
          t.should_eq(bl.left.kind, ast.Expr.IntLiteral(1))?
          t.should_eq(bl.right.kind, ast.Expr.IntLiteral(2))?
        },
        _ => return t.fail("Expected Binop for paren group"),
      }
      t.should_eq(b.right.kind, ast.Expr.IntLiteral(3))?
    },
    _ => return t.fail(f"Expected Binop; got {expr.kind}"),
  }
  Ok(())
}

fn test_parse_basic_literals(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "ExpressionParser: basic literals"

  let mut parser = Parser.new_with_defs("1")
  let mut ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  t.should_eq(expr.kind, ast.Expr.IntLiteral(1))?

  parser = Parser.new_with_defs("1.0")
  ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  t.should_eq(expr.kind, ast.Expr.FloatLiteral(1.0))?

  parser = Parser.new_with_defs("\"hello\"")
  ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  t.should_eq(expr.kind, ast.Expr.StringLiteral("hello"))?

  parser = Parser.new_with_defs("true")
  ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  t.should_eq(expr.kind, ast.Expr.BoolLiteral(true))?

  parser = Parser.new_with_defs("false")
  ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  t.should_eq(expr.kind, ast.Expr.BoolLiteral(false))?

  parser = Parser.new_with_defs("nil")
  ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  t.should_eq(expr.kind, ast.Expr.Nil)?
  Ok(())
}

fn test_parse_array_literals(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "ExpressionParser: array literals"
  let mut parser = Parser.new_with_defs("[1, 2, 3]")
  let mut ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  match expr.kind {
    ast.Expr.ArrayLiteral(elems) => {
      t.should_be_true(elems.length() == 3, f"Expected 3; got {elems.length()}")?
      t.should_eq(expr.span, span.Span.new(0, 9))?
      t.should_eq(elems[0].kind, ast.Expr.IntLiteral(1))?
      t.should_eq(elems[1].kind, ast.Expr.IntLiteral(2))?
      t.should_eq(elems[2].kind, ast.Expr.IntLiteral(3))?
    },
    _ => return t.fail(f"Expected ArrayLiteral; got {expr.kind}"),
  }

  parser = Parser.new_with_defs("[]")
  ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  match expr.kind {
    ast.Expr.ArrayLiteral(elems) => {
      t.should_be_true(elems.length() == 0, "Expected empty array")?
    },
    _ => return t.fail(f"Expected ArrayLiteral; got {expr.kind}"),
  }
  Ok(())
}

fn test_parse_tuple_literals(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "ExpressionParser: tuple literals"
  let mut parser = Parser.new_with_defs("1, 2, 3, 4")
  let mut ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  match expr.kind {
    ast.Expr.TupleLiteral(elems) => {
      t.should_be_true(elems.length() == 4, f"Expected 4; got {elems.length()}")?
      t.should_eq(expr.span, span.Span.new(0, 10))?
      t.should_eq(elems[0].kind, ast.Expr.IntLiteral(1))?
      t.should_eq(elems[1].kind, ast.Expr.IntLiteral(2))?
      t.should_eq(elems[2].kind, ast.Expr.IntLiteral(3))?
      t.should_eq(elems[3].kind, ast.Expr.IntLiteral(4))?
    },
    _ => return t.fail(f"Expected TupleLiteral; got {expr.kind}"),
  }
  Ok(())
}

fn test_parse_function_calls(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "ExpressionParser: function calls"
  let mut parser = Parser.new_with_defs("awesome(1, 2, 3)")
  let mut ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  match expr.kind {
    ast.Expr.Call(c) => {
      t.should_eq_repr(c.fn_name, "awesome")?
      t.should_be_true(c.type_args.is_none(), "Expected no type args")?
      t.should_be_true(
        c.args.length() == 3,
        f"Expected 3 args; got {c.args.length()}",
      )?
      t.should_eq(c.args[0].kind, ast.Expr.IntLiteral(1))?
      t.should_eq(c.args[1].kind, ast.Expr.IntLiteral(2))?
      t.should_eq(c.args[2].kind, ast.Expr.IntLiteral(3))?
    },
    _ => return t.fail(f"Expected Call; got {expr.kind}"),
  }

  parser = Parser.new_with_defs("awesome[Int](1)")
  ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  match expr.kind {
    ast.Expr.Call(c) => {
      t.should_eq_repr(c.fn_name, "awesome")?
      match c.type_args {
        Some(type_args) => {
          t.should_be_true(
            type_args.length() == 1,
            f"Expected 1 type arg; got {type_args.length()}",
          )?
          t.should_eq(type_args[0], ast.typ(8, 11, "Int", []))?
        },
        _ => return t.fail("Expected type args"),
      }
      t.should_be_true(
        c.args.length() == 1,
        f"Expected 1 arg; got {c.args.length()}",
      )?
    },
    _ => return t.fail(f"Expected Call; got {expr.kind}"),
  }
  Ok(())
}

fn test_parse_method_calls(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "ExpressionParser: method calls"

  let mut parser = Parser.new_with_defs(".awesome(1, 2, 3)")
  let mut ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  match expr.kind {
    ast.Expr.DotCall(receiver, call) => {
      t.should_eq(expr.span, span.Span.new(0, 17))?
      t.should_eq(receiver.kind, ast.Expr.Identifier("self"))?
      t.should_eq_repr(call.fn_name, "awesome")?
      t.should_be_true(call.type_args.is_none(), "Expected no type args")?
      t.should_be_true(
        call.args.length() == 3,
        f"Expected 3 args; got {call.args.length()}",
      )?
      t.should_eq(call.args[0].kind, ast.Expr.IntLiteral(1))?
      t.should_eq(call.args[1].kind, ast.Expr.IntLiteral(2))?
      t.should_eq(call.args[2].kind, ast.Expr.IntLiteral(3))?
    },
    _ => return t.fail(f"Expected DotCall; got {expr.kind}"),
  }

  parser = Parser.new_with_defs(".awesome[Int](1)")
  ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  match expr.kind {
    ast.Expr.DotCall(receiver, call) => {
      t.should_eq(expr.span, span.Span.new(0, 16))?
      t.should_eq(receiver.kind, ast.Expr.Identifier("self"))?
      t.should_eq_repr(call.fn_name, "awesome")?
      match call.type_args {
        Some(type_args) => {
          t.should_be_true(
            type_args.length() == 1,
            f"Expected 1 type arg; got {type_args.length()}",
          )?
          t.should_eq(type_args[0], ast.typ(9, 12, "Int", []))?
        },
        _ => return t.fail("Expected type args"),
      }
      t.should_be_true(
        call.args.length() == 1,
        f"Expected 1 arg; got {call.args.length()}",
      )?
    },
    _ => return t.fail(f"Expected DotCall; got {expr.kind}"),
  }

  parser = Parser.new_with_defs(".awesome")
  ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  match expr.kind {
    ast.Expr.DotName(receiver, field) => {
      t.should_eq(expr.span, span.Span.new(0, 8))?
      t.should_eq(receiver.kind, ast.Expr.Identifier("self"))?
      t.should_eq_repr(field, "awesome")?
    },
    _ => return t.fail(f"Expected DotName; got {expr.kind}"),
  }
  Ok(())
}

fn test_parse_unary_neg(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "ExpressionParser: unary negation"
  let mut parser = Parser.new_with_defs("-5")
  let mut ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  t.should_eq(expr.kind, ast.Expr.IntLiteral(-5))?
  t.should_eq(expr.span, span.Span.new(0, 2))?

  parser = Parser.new_with_defs("-x")
  ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  t.should_eq(
    expr.kind,
    ast.Expr.Neg(&ast.identifier(span.Span.new(1, 2), "x")),
  )?
  t.should_eq(expr.span, span.Span.new(0, 2))?
  Ok(())
}

fn test_parse_unary_not(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "ExpressionParser: unary not"
  let mut parser = Parser.new_with_defs("not x")
  let mut ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  t.should_eq(
    expr.kind,
    ast.Expr.Not(&ast.identifier(span.Span.new(4, 5), "x")),
  )?
  t.should_eq(expr.span, span.Span.new(0, 3))?
  Ok(())
}

fn test_parse_let_var(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "ExpressionParser: let/var declarations"

  let mut parser = Parser.new_with_defs("let x = 5")
  let mut ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  match expr.kind {
    ast.Expr.Binop(b) => {
      t.should_eq(b.op, Operator.Assign)?
      match b.left.kind {
        ast.Expr.Binding(mode.Mode.Let, id_ref) => {
          t.should_eq(id_ref.kind, ast.Expr.Identifier("x"))?
          t.should_eq_repr(id_ref.span, span.Span.new(4, 5))?
        },
        _ => return t.fail("Expected Binding(Let)"),
      }
      t.should_eq(b.right.kind, ast.Expr.IntLiteral(5))?
    },
    _ => return t.fail(f"Expected Binop; got {expr.kind}"),
  }

  parser = Parser.new_with_defs("var y = 10")
  ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  match expr.kind {
    ast.Expr.Binop(b) => {
      t.should_eq(b.op, Operator.Assign)?
      match b.left.kind {
        ast.Expr.Binding(mode.Mode.Var, id_ref) => {
          t.should_eq(id_ref.kind, ast.Expr.Identifier("y"))?
          t.should_eq_repr(id_ref.span, span.Span.new(4, 5))?
        },
        _ => return t.fail("Expected Binding(Var)"),
      }
      t.should_eq(b.right.kind, ast.Expr.IntLiteral(10))?
    },
    _ => return t.fail(f"Expected Binop; got {expr.kind}"),
  }
  Ok(())
}

fn test_parse_return_break_continue(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "ExpressionParser: return/break/continue"

  let mut parser = Parser.new_with_defs("return 42")
  let mut ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  match expr.kind {
    ast.Expr.Return(Some(e)) => t.should_eq(e.kind, ast.Expr.IntLiteral(42))?,
    _ => return t.fail(f"Expected Return; got {expr.kind}"),
  }

  parser = Parser.new_with_defs("break")
  ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  t.should_eq(expr.kind, ast.Expr.Break)?

  parser = Parser.new_with_defs("continue")
  ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.message())?
  t.should_eq(expr.kind, ast.Expr.Continue)?
  Ok(())
}
