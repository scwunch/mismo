      t.should_be_true(elems.length() == 4, f"Expected 4; got {elems.length()}")?
      match elems[0].kind {
        ast.Expr.IntLiteral(1) => (),
        _ => return t.fail("Expected 1"),
      }
      match elems[1].kind {
        ast.Expr.IntLiteral(2) => (),
        _ => return t.fail("Expected 2"),
      }
      match elems[2].kind {
        ast.Expr.IntLiteral(3) => (),
        _ => return t.fail("Expected 3"),
      }
      match elems[3].kind {
        ast.Expr.IntLiteral(4) => (),
        _ => return t.fail("Expected 4"),
      }
    },
    _ => return t.fail(f"Expected TupleLiteral; got {expr.kind}"),
  }
  Ok(())
}

fn test_parse_function_calls(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "ExpressionParser: function calls"
  let mut parser = Parser.new_with_defs("awesome(1, 2, 3)")
  let mut ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.Error())?
  match expr.kind {
    ast.Expr.Call { fn_name, type_args, args } => {
      t.should_eq_repr(fn_name, "awesome")?
      t.should_be_true(type_args.length() == 0, "Expected no type args")?
      t.should_be_true(
        args.length() == 3,
        f"Expected 3 args; got {args.length()}",
      )?
      match args[0].kind {
        ast.Expr.IntLiteral(1) => (),
        _ => return t.fail("Expected 1"),
      }
      match args[1].kind {
        ast.Expr.IntLiteral(2) => (),
        _ => return t.fail("Expected 2"),
      }
      match args[2].kind {
        ast.Expr.IntLiteral(3) => (),
        _ => return t.fail("Expected 3"),
      }
    },
    _ => return t.fail(f"Expected Call; got {expr.kind}"),
  }

  parser = Parser.new_with_defs("awesome[Int](1)")
  ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.Error())?
  match expr.kind {
    ast.Expr.Call { fn_name, type_args, args } => {
      t.should_eq_repr(fn_name, "awesome")?
      t.should_be_true(type_args.length() == 1, "Expected 1 type arg")?
      t.should_be_true(
        args.length() == 1,
        f"Expected 1 arg; got {args.length()}",
      )?
    },
    _ => return t.fail(f"Expected Call; got {expr.kind}"),
  }
  Ok(())
}

fn test_parse_method_calls(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "ExpressionParser: method calls"

  let mut parser = Parser.new_with_defs(".awesome(1, 2, 3)")
  let mut ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.Error())?
  match expr.kind {
    ast.Expr.Call { fn_name, type_args, args } => {
      t.should_eq_repr(fn_name, "awesome")?
      t.should_be_true(
        args.length() == 4,
        f"Expected 4 args (self + 3); got {args.length()}",
      )?
      match args[0].kind {
        ast.Expr.Identifier(name) => t.should_eq_repr(name, "self")?,
        _ => return t.fail("Expected self identifier"),
      }
      match args[1].kind {
        ast.Expr.IntLiteral(1) => (),
        _ => return t.fail("Expected 1"),
      }
      match args[2].kind {
        ast.Expr.IntLiteral(2) => (),
        _ => return t.fail("Expected 2"),
      }
      match args[3].kind {
        ast.Expr.IntLiteral(3) => (),
        _ => return t.fail("Expected 3"),
      }
    },
    _ => return t.fail(f"Expected Call; got {expr.kind}"),
  }

  parser = Parser.new_with_defs(".awesome[Int](1)")
  ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.Error())?
  match expr.kind {
    ast.Expr.Call { fn_name, type_args, args } => {
      t.should_eq_repr(fn_name, "awesome")?
      t.should_be_true(
        args.length() == 2,
        f"Expected 2 args (self + 1); got {args.length()}",
      )?
    },
    _ => return t.fail(f"Expected Call; got {expr.kind}"),
  }

  parser = Parser.new_with_defs(".awesome")
  ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.Error())?
  match expr.kind {
    ast.Expr.Call { fn_name, type_args, args } => {
      t.should_eq_repr(fn_name, "awesome")?
      t.should_be_true(
        args.length() == 1,
        f"Expected 1 arg (self); got {args.length()}",
      )?
    },
    _ => return t.fail(f"Expected Call; got {expr.kind}"),
  }
  Ok(())
}

fn test_parse_unary_neg(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "ExpressionParser: unary negation"
  let mut parser = Parser.new_with_defs("-5")
  let mut ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.Error())?
  match expr.kind {
    ast.Expr.IntLiteral(n) => t.should_eq_repr(n, -5)?,
    _ => return t.fail(f"Expected IntLiteral(-5); got {expr.kind}"),
  }

  parser = Parser.new_with_defs("-x")
  ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.Error())?
  match expr.kind {
    ast.Expr.Neg(e) => match e.kind {
      ast.Expr.Identifier(name) => t.should_eq_repr(name, "x")?,
      _ => return t.fail("Expected Identifier"),
    },
    _ => return t.fail(f"Expected Neg; got {expr.kind}"),
  }
  Ok(())
}

fn test_parse_unary_not(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "ExpressionParser: unary not"
  let mut parser = Parser.new_with_defs("not x")
  let mut ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.Error())?
  match expr.kind {
    ast.Expr.Not(e) => match e.kind {
      ast.Expr.Identifier(name) => t.should_eq_repr(name, "x")?,
      _ => return t.fail("Expected Identifier"),
    },
    _ => return t.fail(f"Expected Not; got {expr.kind}"),
  }
  Ok(())
}

fn test_parse_let_var(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "ExpressionParser: let/var declarations"

  let mut parser = Parser.new_with_defs("let x = 5")
  let mut ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.Error())?
  match expr.kind {
    ast.Expr.Let { name, init } => {
      t.should_eq_repr(name, "x")?
      match init.kind {
        ast.Expr.IntLiteral(5) => (),
        _ => return t.fail("Expected 5"),
      }
    },
    _ => return t.fail(f"Expected Let; got {expr.kind}"),
  }

  parser = Parser.new_with_defs("var y = 10")
  ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.Error())?
  match expr.kind {
    ast.Expr.Var { name, init } => {
      t.should_eq_repr(name, "y")?
      match init.kind {
        ast.Expr.IntLiteral(10) => (),
        _ => return t.fail("Expected 10"),
      }
    },
    _ => return t.fail(f"Expected Var; got {expr.kind}"),
  }
  Ok(())
}

fn test_parse_return_break_continue(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "ExpressionParser: return/break/continue"

  let mut parser = Parser.new_with_defs("return 42")
  let mut ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.Error())?
  match expr.kind {
    ast.Expr.Return(Some(e)) => match e.kind {
      ast.Expr.IntLiteral(42) => (),
      _ => return t.fail("Expected 42"),
    },
    _ => return t.fail(f"Expected Return; got {expr.kind}"),
  }

  parser = Parser.new_with_defs("break")
  ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.Error())?
  match expr.kind {
    ast.Expr.Break => (),
    _ => return t.fail(f"Expected Break; got {expr.kind}"),
  }

  parser = Parser.new_with_defs("continue")
  ep = ExpressionParser.new(&parser, 0, StopAt.Normal)
  let expr = ep.parse().map_err(|e| e.Error())?
  match expr.kind {
    ast.Expr.Continue => (),
    _ => return t.fail(f"Expected Continue; got {expr.kind}"),
  }
  Ok(())
}
