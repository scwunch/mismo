fn test_parse_struct(t: Ref<testing.TestRunner>) -> Result<(), string> {
  let mut parser = Parser.new_with_defs(
    "struct Name \n  field: Type\n  field: Type\n",
  )
  match parser.parse_struct() {
    Ok(_) => (),
    Err(e) => t.fail(e.Error())?,
  }
  t.should_eq(
    parser.defs.structs[0],
    ast.StructDef.new(
      Span.new(0, 30),
      "Name",
      [],
      [
        ast.Field.new(6, 17, "field", ast.typ(13, 17, "Type", [])),
        ast.Field.new(20, 31, "field", ast.typ(27, 31, "Type", [])),
      ],
    ),
  )?
  Ok(())
}
