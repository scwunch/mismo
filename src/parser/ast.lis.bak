import "lexer"
import "operator"
type Span = lexer.Span
type Operator = operator.Operator



struct Import {
  path: string,
  alias: Option<string>,
}

struct StructDef {
  span: Span,
  name: string,
  type_parameters: Slice<string>,
  fields: Slice<Field>,
}

struct Field {
  span: Span,
  name: string,
  typ: Type,
}

struct EnumDef {
  span: Span,
  name: string,
  type_parameters: Slice<string>,
  variants: Slice<Variant>,
}

struct Variant {
  span: Span,
  name: string,
  payload: Slice<Type>
}

struct InterfaceDef {
  span: Span,
  name: string,
  type_parameters: Slice<string>,
  parents: Slice<Type>,
  methods: Slice<MethodDef>,
}

struct FunctionDef {
  sig: Signature,
  body: Expression,
}

struct MethodDef {
  sig: Signature,
  body: Option<Expression>,
}

struct Signature {
  span: Span,
  name: string,
  type_parameters: Slice<string>,
  parameters: Slice<Parameter>,
}

struct Parameter {
  span: Span,
  mode: Mode,
  name: string,
  typ:  Type,
}

struct Type {
  span: Span,
  name: string,
  type_args: Slice<Type>,
}

enum Expression {
  Nil(Span),
  Bool(Span, bool),
  IntLiteral(Span, int),
  FloatLiteral(Span, float64),
  StringLiteral(Span, string),
  ArrayLiteral(Span, Slice<Expression>),
  TupleLiteral(Span, Slice<Expression>),
  Identifier(Span, string),
  Binding(Mode, Ref<Expression>),
  Binop{left: Ref<Expression>, op: Operator, right: Ref<Expression>},
  Assign{pattern: Ref<Expression>, value: Option<Ref<Expression>>},
  Call{span: Span, fn_name: string, type_args: Slice<Type>, args: Slice<Expression>},
  If(Span, Conditional),
  While(Span, Conditional),
  For{span: Span, binding: Ref<Expression>, iter: Ref<Expression>, body: Ref<Expression>},
  Block(Slice<Expression>),
}

enum Conditional {
  Binary{subject: Ref<Expression>, ops: Slice<Comparison>},
  Unary{expr: Ref<Expression>, consequent: Ref<Expression>},
  Multi(Slice<Conditional>),
  Else{consequent: Ref<Expression>}
}

struct Comparison {
  op: Operator,
  objects: Slice<Branch>,
}

struct Branch {
  object: Ref<Expression>,
  then: Consequent,
}

enum Consequent {
  And(Conditional),
  Or(Conditional),
  Do(Ref<Expression>),
}


