import "mode"
import "operator"
import "span"
import "utils/slice"

// type Span = span.Span
pub type Operator = operator.Operator

pub struct Expression {
  pub span: span.Span,
  pub kind: Expr,
}

#[display]
pub enum Expr {
  Nil,
  BoolLiteral(bool),
  IntLiteral(int),
  FloatLiteral(float64),
  StringLiteral(string),
  ArrayLiteral(Slice<Expression>),
  TupleLiteral(Slice<Expression>),
  Identifier(string),
  Binding(mode.Mode, Ref<Expression>),
  Binop(Ref<Binop>),
  Call(Call),
  If(Conditional),
  While(Conditional),
  For(Ref<ForLoop>),
  Block(Slice<Expression>),
  Neg(Ref<Expression>),
  Not(Ref<Expression>),
  Return(Option<Ref<Expression>>),
  Break(Option<Ref<Expression>>),
  Continue,
  Type(string, Option<Slice<Type>>),
  DotName(Ref<Expression>, string),
  DotCall(Ref<Expression>, Call),
}

pub struct Binop {
  pub left: Expression,
  pub op: Operator,
  pub right: Expression,
}

impl Binop {
  pub fn eq(self, other: Binop) -> bool {
    self.left.eq(other.left) && self.op == other.op &&
    self.right.eq(other.right)
  }
}

pub struct Call {
  pub fn_name: string,
  pub type_args: Option<Slice<Type>>,
  pub args: Slice<Expression>,
}

impl Call {
  pub fn eq(self, other: Call) -> bool {
    let type_args_eq = match (self.type_args, other.type_args) {
      (None, None) => true,
      (Some(a1), Some(a2)) => slice.compare(a1, a2, Type.eq),
      _ => false,
    }
    self.fn_name == other.fn_name && type_args_eq &&
    slice.compare(self.args, other.args, Expression.eq)
  }
}

pub struct ForLoop {
  pub binding: Expression,
  pub iter: Expression,
  pub body: Expression,
}

impl ForLoop {
  pub fn eq(self, other: ForLoop) -> bool {
    self.binding.eq(other.binding) && self.iter.eq(other.iter) &&
    self.body.eq(other.body)
  }
}

pub enum Conditional {
  Binary { subject: Ref<Expression>, ops: Slice<Comparison> },
  Unary { expr: Ref<Expression>, consequent: Ref<Expression> },
  Multi(Slice<Conditional>),
  Else { consequent: Ref<Expression> },
}

pub struct Comparison {
  pub op: Operator,
  pub objects: Slice<Branch>,
}

pub struct Branch {
  pub object: Ref<Expression>,
  pub then: Consequent,
}

pub enum Consequent {
  And(Conditional),
  Or(Conditional),
  Do(Ref<Expression>),
}

pub fn nil_lit(span: span.Span) -> Expression {
  Expression { span, kind: Expr.Nil }
}

pub fn bool_lit(span: span.Span, value: bool) -> Expression {
  Expression { span, kind: Expr.BoolLiteral(value) }
}

pub fn int_lit(span: span.Span, value: int) -> Expression {
  Expression { span, kind: Expr.IntLiteral(value) }
}

pub fn float_lit(span: span.Span, value: float64) -> Expression {
  Expression { span, kind: Expr.FloatLiteral(value) }
}

pub fn string_lit(span: span.Span, value: string) -> Expression {
  Expression { span, kind: Expr.StringLiteral(value) }
}

pub fn array_lit(span: span.Span, values: Slice<Expression>) -> Expression {
  Expression { span, kind: Expr.ArrayLiteral(values) }
}

pub fn tuple_lit(span: span.Span, values: Slice<Expression>) -> Expression {
  Expression { span, kind: Expr.TupleLiteral(values) }
}

pub fn identifier(span: span.Span, name: string) -> Expression {
  Expression { span, kind: Expr.Identifier(name) }
}

pub fn binding(span: span.Span, mode: mode.Mode, expr: Ref<Expression>) -> Expression {
  Expression { span, kind: Expr.Binding(mode, expr) }
}

pub fn binop_expr(
  span: span.Span,
  left: Expression,
  op: Operator,
  right: Expression,
) -> Expression {
  Expression { span, kind: Expr.Binop(&Binop { left, op, right }) }
}

pub fn call_expr(span: span.Span, call: Call) -> Expression {
  Expression { span, kind: Expr.Call(call) }
}

pub fn if_(span: span.Span, cond: Conditional) -> Expression {
  Expression { span, kind: Expr.If(cond) }
}

pub fn while_(span: span.Span, cond: Conditional) -> Expression {
  Expression { span, kind: Expr.While(cond) }
}

pub fn for_(
  span: span.Span,
  binding: Expression,
  iter: Expression,
  body: Expression,
) -> Expression {
  Expression { span, kind: Expr.For(&ForLoop { binding, iter, body }) }
}

pub fn block(span: span.Span, exprs: Slice<Expression>) -> Expression {
  Expression { span, kind: Expr.Block(exprs) }
}

pub fn neg(span: span.Span, expr: Ref<Expression>) -> Expression {
  Expression { span, kind: Expr.Neg(expr) }
}

pub fn not_(span: span.Span, expr: Ref<Expression>) -> Expression {
  Expression { span, kind: Expr.Not(expr) }
}

pub fn type_expr(span: span.Span, name: string, type_args: Option<Slice<Type>>) -> Expression {
  Expression { span, kind: Expr.Type(name, type_args) }
}

pub fn dot_name(span: span.Span, receiver: Ref<Expression>, field: string) -> Expression {
  Expression { span, kind: Expr.DotName(receiver, field) }
}

pub fn dot_call(span: span.Span, receiver: Ref<Expression>, call: Call) -> Expression {
  Expression { span, kind: Expr.DotCall(receiver, call) }
}

pub fn return_(span: span.Span, expr: Option<Ref<Expression>>) -> Expression {
  // let span = expr.map(|e| span.merge(e.span)).unwrap_or(span)
  if let Some(e) = expr { span = span.merge(e.span) }
  Expression { span, kind: Expr.Return(expr) }
}

pub fn break_(span: span.Span, expr: Option<Ref<Expression>>) -> Expression {
  if let Some(e) = expr { span = span.merge(e.span) }
  Expression { span, kind: Expr.Break(expr) }
}

pub fn continue_(span: span.Span) -> Expression {
  Expression { span, kind: Expr.Continue }
}

impl Expression {
  pub fn string(self) -> string {
    f"{self.span}: {self.kind.string()}"
  }
}

impl Expr {
  pub fn string(self) -> string {
    match self {
      Expr.Nil => "nil",
      Expr.BoolLiteral(b) => f"{b}",
      Expr.IntLiteral(i) => f"{i}",
      Expr.FloatLiteral(f) => f"{f}",
      Expr.StringLiteral(s) => f"\"{s}\"",
      Expr.ArrayLiteral(elems) => f"[{elems.length()} elems]",
      Expr.TupleLiteral(elems) => f"({elems.length()} elems)",
      Expr.Identifier(name) => name,
      Expr.Binding(mode, _) => f"Binding({mode})",
      Expr.Binop(b) => f"Binop({b.left.kind.string()} {b.op} {b.right.kind.string()})",
      Expr.Call(c) => f"Call({c.fn_name}[{c.args.length()}])",
      Expr.If(_) => "If(...)",
      Expr.While(_) => "While(...)",
      Expr.For(f) => f"For({f.binding.kind.string()} in {f.iter.kind.string()})",
      Expr.Block(stmts) => f"Block({stmts.length()})",
      Expr.Neg(e) => f"Neg({e.kind.string()})",
      Expr.Not(e) => f"Not({e.kind.string()})",
      Expr.Return(Some(e)) => f"Return({e.kind.string()})",
      Expr.Return(None) => "Return",
      Expr.Break(None) => "Break",
      Expr.Break(Some(e)) => f"Break({e.kind.string()})",
      Expr.Continue => "Continue",
      Expr.Type(name, _) => f"Type({name})",
      Expr.DotName(r, field) => f"DotName({r.kind.string()}.{field})",
      Expr.DotCall(r, c) => f"DotCall({r.kind.string()}.{c.fn_name})",
    }
  }
}

