import "mode"
import "operator"
import "span"

// type Span = span.Span
pub type Operator = operator.Operator

#[display]
#[json]
pub struct Expression {
  pub span: span.Span,
  pub kind: Expr,
}

#[display]
#[json]
pub enum Expr {
  Nil,
  BoolLiteral(bool),
  IntLiteral(int),
  FloatLiteral(float64),
  StringLiteral(string),
  ArrayLiteral(Slice<Expression>),
  TupleLiteral(Slice<Expression>),
  Closure(Slice<Parameter>, Block),
  Identifier(Path),
  Binding(mode.Mode, Ref<Expression>),
  Binop(Ref<Binop>),
  Call(Call),
  If(Conditional),
  While(Conditional),
  For(Ref<ForLoop>),
  Block(Block),
  Neg(Ref<Expression>),
  Not(Ref<Expression>),
  Return(Option<Ref<Expression>>),
  Break(Option<Ref<Expression>>),
  Continue,
  // Type(string, Option<Slice<Type>>),
  DotName(Ref<Expression>, string),
  DotCall(Ref<Expression>, Call),
  TypeDotCall(Path, Slice<Type>, Call),
  Extern,
}

#[json]
#[display]
pub struct Path {
  pub namespace: Slice<string>,
  pub name: string,
}

impl Path {
  pub fn name_(name: string) -> Path {
    Path { name, .. }
  }

  pub fn string(self) -> string {
    if self.namespace.is_empty() {
      self.name
    } else {
      self.namespace.join("::") + "::" + self.name
    }
  }
}

#[json]
pub struct Binop {
  pub left: Expression,
  pub op: Operator,
  pub right: Expression,
}

impl Binop {
  pub fn equals(self, other: Binop) -> bool {
    self.left.equals(other.left) && self.op == other.op &&
    self.right.equals(other.right)
  }
}

#[json]
pub struct Call {
  pub fn_name: Path,
  pub type_args: Option<Slice<Type>>,
  pub args: Slice<Expression>,
}

#[json]
pub struct ForLoop {
  pub binding: Expression,
  pub iter: Expression,
  pub body: Block,
}

impl ForLoop {
  pub fn equals(self, other: ForLoop) -> bool {
    self.binding.equals(other.binding) && self.iter.equals(other.iter) &&
    self.body.equals(other.body)
  }
}

#[json]
#[display]
pub enum Conditional {
  Compares(Ref<Expression>, Slice<Arm>),
  Predicate(Ref<Expression>, Consequent),
  Multi(Slice<Conditional>),
  Else(Consequent),
}

#[json]
pub struct Arm {
  pub op: Operator,
  pub object: Expression,
  pub then: Consequent,
}

#[json]
pub enum Consequent {
  And(Ref<Conditional>),
  Or(Ref<Conditional>),
  Do(Block),
}

impl Conditional {
  pub fn span(self) -> span.Span {
    match self {
      Compares(subject, arms) => subject.span.merge(arms
        .get(arms.length() - 1)
        .map_or(subject.span, |arm| arm.then.span())),
      Predicate(pred, consequent) => pred.span.merge(consequent.span()),
      Multi(conds) => conds[conds.length() - 1].span(),
      Else(consequent) => consequent.span(),
    }
  }
}

impl Consequent {
  pub fn span(self) -> span.Span {
    match self {
      And(cond) => cond.span(),
      Or(cond) => cond.span(),
      Do(block) => block.span(),
    }
  }
}

impl Arm {
  pub fn new(op: Operator, object: Expression, then: Consequent) -> Arm {
    Arm { op, object, then }
  }
}

#[equality]
pub struct Block {
  pub statements: Slice<Expression>,
}

impl Block {
  pub fn span(self) -> span.Span {
    span.new(self.statements[0].span.start, self.last().span.end)
  }

  pub fn last(self) -> Expression {
    self.statements[self.statements.length() - 1]
  }
}

pub fn nil_lit(span: span.Span) -> Expression {
  Expression { span, kind: Expr.Nil }
}

pub fn bool_lit(span: span.Span, value: bool) -> Expression {
  Expression { span, kind: Expr.BoolLiteral(value) }
}

pub fn int_lit(span: span.Span, value: int) -> Expression {
  Expression { span, kind: Expr.IntLiteral(value) }
}

pub fn float_lit(span: span.Span, value: float64) -> Expression {
  Expression { span, kind: Expr.FloatLiteral(value) }
}

pub fn string_lit(span: span.Span, value: string) -> Expression {
  Expression { span, kind: Expr.StringLiteral(value) }
}

pub fn array_lit(span: span.Span, values: Slice<Expression>) -> Expression {
  Expression { span, kind: Expr.ArrayLiteral(values) }
}

pub fn tuple_lit(span: span.Span, values: Slice<Expression>) -> Expression {
  Expression { span, kind: Expr.TupleLiteral(values) }
}

pub fn closure(span: span.Span, params: Slice<Parameter>, body: Block) -> Expression {
  Expression { span, kind: Expr.Closure(params, body) }
}

pub fn identifier(span: span.Span, path: Path) -> Expression {
  Expression { span, kind: Expr.Identifier(path) }
}

pub fn implicit_self(span: span.Span) -> Expression {
  Expression { span, kind: Expr.Identifier(Path { name: "self", .. }) }
}

pub fn binding(span: span.Span, mode: mode.Mode, expr: Ref<Expression>) -> Expression {
  Expression { span, kind: Expr.Binding(mode, expr) }
}

pub fn binop_expr(
  span: span.Span,
  left: Expression,
  op: Operator,
  right: Expression,
) -> Expression {
  Expression { span, kind: Expr.Binop(&Binop { left, op, right }) }
}

pub fn call_expr(span: span.Span, call: Call) -> Expression {
  Expression { span, kind: Expr.Call(call) }
}

pub fn if_(span: span.Span, cond: Conditional) -> Expression {
  Expression { span, kind: Expr.If(cond) }
}

pub fn while_(span: span.Span, cond: Conditional) -> Expression {
  Expression { span, kind: Expr.While(cond) }
}

pub fn for_(span: span.Span, binding: Expression, iter: Expression, body: Block) -> Expression {
  Expression { span, kind: Expr.For(&ForLoop { binding, iter, body }) }
}

pub fn block_expr(span: span.Span, exprs: Block) -> Expression {
  Expression { span, kind: Expr.Block(exprs) }
}

pub fn neg(span: span.Span, expr: Ref<Expression>) -> Expression {
  Expression { span, kind: Expr.Neg(expr) }
}

pub fn not_(span: span.Span, expr: Ref<Expression>) -> Expression {
  Expression { span, kind: Expr.Not(expr) }
}

pub fn dot_name(span: span.Span, receiver: Ref<Expression>, field: string) -> Expression {
  Expression { span, kind: Expr.DotName(receiver, field) }
}

pub fn dot_call(span: span.Span, receiver: Ref<Expression>, call: Call) -> Expression {
  Expression { span, kind: Expr.DotCall(receiver, call) }
}

pub fn type_dot_call(
  span: span.Span,
  path: Path,
  type_args: Slice<Type>,
  call: Call,
) -> Expression {
  Expression { span, kind: Expr.TypeDotCall(path, type_args, call) }
}

pub fn return_(span: span.Span, expr: Option<Ref<Expression>>) -> Expression {
  // let span = expr.map(|e| span.merge(e.span)).unwrap_or(span)
  if let Some(e) = expr { span = span.merge(e.span) }
  Expression { span, kind: Expr.Return(expr) }
}

pub fn break_(span: span.Span, expr: Option<Ref<Expression>>) -> Expression {
  if let Some(e) = expr { span = span.merge(e.span) }
  Expression { span, kind: Expr.Break(expr) }
}

pub fn continue_(span: span.Span) -> Expression {
  Expression { span, kind: Expr.Continue }
}

pub fn extern(span: span.Span) -> Expression {
  Expression { span, kind: Expr.Extern }
}

impl Expression {
  pub fn string(self) -> string {
    f"{self.span}: {self.kind}"
  }
}

