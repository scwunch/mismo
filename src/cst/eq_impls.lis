import "mode"
import "span"

impl Type {
  pub fn equals(self, other: Type) -> bool {
    self.span == other.span && self.kind.equals(other.kind)
  }
}

impl TypeKind {
  pub fn equals(self, other: TypeKind) -> bool {
    match (self, other) {
      (TypeKind.Nominal(name1, args1), TypeKind.Nominal(name2, args2)) => {
        name1.equals(name2) && args1.equals(args2)
      },
      (TypeKind.Tuple(args1), TypeKind.Tuple(args2)) => {
        args1.equals(args2)
      },
      (TypeKind.Fn(params1, ret1), TypeKind.Fn(params2, ret2)) => {
        params1.equals(params2) && ret1.equals(ret2.*)
      },
      _ => false,
    }
  }
}

impl ParamType {
  pub fn equals(self, other: ParamType) -> bool {
    self.mode == other.mode && self.typ.equals(other.typ)
  }
}

impl Field {
  pub fn equals(self, other: Field) -> bool {
    self.span == other.span && self.name == other.name &&
    self.typ.equals(other.typ)
  }
}

impl TypeParameter {
  pub fn equals(self, other: TypeParameter) -> bool {
    self.span == other.span && self.name == other.name
  }
}

impl TypeDecl {
  pub fn equals(self, other: TypeDecl) -> bool {
    self.span == other.span && self.name == other.name &&
    self.type_parameters.equals(other.type_parameters) &&
    self.body.equals(other.body)
  }
}

impl TypeBody {
  pub fn equals(self, other: TypeBody) -> bool {
    match (self, other) {
      (TypeBody.Struct(s1), TypeBody.Struct(s2)) => s1.equals(s2),
      (TypeBody.Enum(e1), TypeBody.Enum(e2)) => e1.equals(e2),
      _ => false,
    }
  }
}

impl Variant {
  pub fn equals(self, other: Variant) -> bool {
    self.span == other.span && self.name == other.name &&
    self.payload.equals(other.payload)
  }
}

impl Expression {
  pub fn equals(self, other: Expression) -> bool {
    self.span == other.span && self.kind.equals(other.kind)
  }
}

impl Expr {
  #[allow(float_cmp, match_same_arms)]
  pub fn equals(self, other: Expr) -> bool {
    match (self, other) {
      (Nil, Nil) => true,
      (BoolLiteral(b1), BoolLiteral(b2)) => b1 == b2,
      (IntLiteral(i1), IntLiteral(i2)) => i1 == i2,
      (FloatLiteral(f1), FloatLiteral(f2)) => f1 == f2,
      (StringLiteral(s1), StringLiteral(s2)) => s1 == s2,
      (ArrayLiteral(a1), ArrayLiteral(a2)) => {
        a1.equals(a2)
      },
      (TupleLiteral(t1), TupleLiteral(t2)) => {
        t1.equals(t2)
      },
      (Identifier(i1), Identifier(i2)) => i1.equals(i2),
      (Binding(m1, e1), Binding(m2, e2)) => m1 == m2 && e1.equals(e2.*),
      (Binop(b1), Binop(b2)) => b1.equals(b2.*),
      (If(cond1), If(cond2)) => cond1.equals(cond2),
      (While(cond1), While(cond2)) => cond1.equals(cond2),
      (For(f1), For(f2)) => f1.equals(f2.*),
      (Block(exprs1), Block(exprs2)) => {
        exprs1.equals(exprs2)
      },
      (Neg(e1), Neg(e2)) => e1.equals(e2.*),
      (Not(e1), Not(e2)) => e1.equals(e2.*),
      (Return(Some(e1)), Return(Some(e2))) => e1.equals(e2.*),
      (Return(None), Return(None)) => true,
      (Break(None), Break(None)) => true,
      (Break(Some(e1)), Break(Some(e2))) => e1.equals(e2.*),
      (Continue, Continue) => true,
      (DotName(r1, f1), DotName(r2, f2)) => r1.equals(r2.*) && f1 == f2,
      (DotCall(r1, c1), DotCall(r2, c2)) => r1.equals(r2.*) && c1.equals(c2),
      (Call(c1), Call(c2)) => c1.equals(c2),
      _ => false,
    }
  }
}

impl Path {
  pub fn equals(self, other: Path) -> bool {
    self.name == other.name && self.namespace.equals(other.namespace)
  }
}

impl Call {
  pub fn equals(self, other: Call) -> bool {
    let type_args_eq = match (self.type_args, other.type_args) {
      (None, None) => true,
      (Some(a1), Some(a2)) => a1.equals(a2),
      _ => false,
    }
    self.fn_name.equals(other.fn_name) && type_args_eq &&
    self.args.equals(other.args)
  }
}

impl Conditional {
  pub fn equals(self, other: Conditional) -> bool {
    match (self.default, other.default) {
      (None, None) => self.clauses.equals(other.clauses),
      (Some(d1), Some(d2)) => self.clauses.equals(other.clauses) &&
      d1.equals(d2),
      _ => false,
    }
  }
}

impl Clause {
  pub fn equals(self, other: Clause) -> bool {
    match (self, other) {
      (Comparison(e1, a1), Comparison(e2, a2)) => e1.equals(e2) && a1.equals(a2),
      (Predicate(p1, c1), Predicate(p2, c2)) => p1.equals(p2) && c1.equals(c2),
      (Else(b1), Else(b2)) => b1.equals(b2),
      _ => false,
    }
  }
}

impl Arm {
  pub fn equals(self, other: Arm) -> bool {
    self.op == other.op && self.object.equals(other.object) &&
    self.then.equals(other.then)
  }
}

impl Consequent {
  pub fn equals(self, other: Consequent) -> bool {
    match (self, other) {
      (And(c1), And(c2)) => c1.equals(c2.*),
      (Or(e1, b1), Or(e2, b2)) => e1.equals(e2) && b1.equals(b2),
      (Do(e1), Do(e2)) => e1.equals(e2),
      _ => false,
    }
  }
}

impl Parameter {
  pub fn equals(self, other: Parameter) -> bool {
    self.span == other.span && self.mode == other.mode &&
    self.name == other.name &&
    self.typ.equals(other.typ)
  }
}

impl Block {
  pub fn equals(self, other: Block) -> bool {
    self.statements.equals(other.statements)
  }
}
