import "mode"
import "span"
import "utils/slice"

impl Type {
  pub fn eq(self, other: Type) -> bool {
    self.span == other.span && self.kind.eq(other.kind)
  }
}

impl TypeKind {
  pub fn eq(self, other: TypeKind) -> bool {
    match (self, other) {
      (TypeKind.Nominal(name1, args1), TypeKind.Nominal(name2, args2)) => {
        name1 == name2 && slice.compare(args1, args2, Type.eq)
      },
      (TypeKind.Tuple(args1), TypeKind.Tuple(args2)) => {
        slice.compare(args1, args2, Type.eq)
      },
      (TypeKind.Fn(params1, ret1), TypeKind.Fn(params2, ret2)) => {
        slice.compare(params1, params2, ParamType.eq) && ret1.eq(ret2.*)
      },
      _ => false,
    }
  }
}

impl ParamType {
  pub fn eq(self, other: ParamType) -> bool {
    self.mode == other.mode && self.typ.eq(other.typ)
  }
}

impl Field {
  pub fn eq(self, other: Field) -> bool {
    self.span == other.span && self.name == other.name && self.typ.eq(other.typ)
  }
}

impl TypeParameter {
  pub fn eq(self, other: TypeParameter) -> bool {
    self.span == other.span && self.name == other.name
  }
}

impl TypeDecl {
  pub fn eq(self, other: TypeDecl) -> bool {
    self.span == other.span && self.name == other.name &&
    slice.compare(self.type_parameters, other.type_parameters, TypeParameter.eq) &&
    self.body.eq(other.body)
  }
}

impl TypeBody {
  pub fn eq(self, other: TypeBody) -> bool {
    match (self, other) {
      (TypeBody.Struct(s1), TypeBody.Struct(s2)) => slice.compare(
        s1,
        s2,
        Field.eq,
      ),
      (TypeBody.Enum(e1), TypeBody.Enum(e2)) => slice.compare(
        e1,
        e2,
        Variant.eq,
      ),
      _ => false,
    }
  }
}

impl Variant {
  pub fn eq(self, other: Variant) -> bool {
    self.span == other.span && self.name == other.name &&
    slice.compare(self.payload, other.payload, Type.eq)
  }
}

impl Expression {
  pub fn eq(self, other: Expression) -> bool {
    self.span == other.span && self.kind.eq(other.kind)
  }
}

impl Expr {
  pub fn eq(self, other: Expr) -> bool {
    match (self, other) {
      (Nil, Nil) => true,
      (BoolLiteral(b1), BoolLiteral(b2)) => b1 == b2,
      (IntLiteral(i1), IntLiteral(i2)) => i1 == i2,
      (FloatLiteral(f1), FloatLiteral(f2)) => f1 == f2,
      (StringLiteral(s1), StringLiteral(s2)) => s1 == s2,
      (ArrayLiteral(a1), ArrayLiteral(a2)) => {
        slice.compare(a1, a2, Expression.eq)
      },
      (TupleLiteral(t1), TupleLiteral(t2)) => {
        slice.compare(t1, t2, Expression.eq)
      },
      (Identifier(i1), Identifier(i2)) => i1 == i2,
      (Binding(m1, e1), Binding(m2, e2)) => m1 == m2 && e1.eq(e2.*),
      (Binop(b1), Binop(b2)) => b1.eq(b2.*),
      (If(cond1), If(cond2)) => cond1.eq(cond2),
      (While(cond1), While(cond2)) => cond1.eq(cond2),
      (For(f1), For(f2)) => f1.eq(f2.*),
      (Block(exprs1), Block(exprs2)) => {
        slice.compare(exprs1, exprs2, Expression.eq)
      },
      (Neg(e1), Neg(e2)) => e1.eq(e2.*),
      (Not(e1), Not(e2)) => e1.eq(e2.*),
      (Return(Some(e1)), Return(Some(e2))) => e1.eq(e2.*),
      (Return(None), Return(None)) => true,
      (Break(None), Break(None)) => true,
      (Break(Some(e1)), Break(Some(e2))) => e1.eq(e2.*),
      (Continue, Continue) => true,
      (Type(n1, a1), Type(n2, a2)) => {
        let type_args_eq = match (a1, a2) {
          (None, None) => true,
          (Some(t1), Some(t2)) => slice.compare(t1, t2, Type.eq),
          _ => false,
        }
        n1 == n2 && type_args_eq
      },
      (DotName(r1, f1), DotName(r2, f2)) => r1.eq(r2.*) && f1 == f2,
      (DotCall(r1, c1), DotCall(r2, c2)) => r1.eq(r2.*) && c1.eq(c2),
      (Call(c1), Call(c2)) => c1.eq(c2),
      _ => false,
    }
  }
}

impl Conditional {
  pub fn eq(self, other: Conditional) -> bool {
    match (self, other) {
      (
        Conditional.Binary { subject: s1, ops: o1 },
        Conditional.Binary { subject: s2, ops: o2 },
      ) => s1 == s2 && slice.compare(o1, o2, Comparison.eq),
      (
        Conditional.Unary { expr: e1, consequent: c1 },
        Conditional.Unary { expr: e2, consequent: c2 },
      ) => e1 == e2 && c1 == c2,
      (Conditional.Multi(c1), Conditional.Multi(c2)) => slice.compare(
        c1,
        c2,
        Conditional.eq,
      ),
      (Conditional.Else { consequent: c1 }, Conditional.Else { consequent: c2 }) => c1 ==
      c2,
      _ => false,
    }
  }
}

impl Comparison {
  pub fn eq(self, other: Comparison) -> bool {
    self.op == other.op && slice.compare(self.objects, other.objects, Branch.eq)
  }
}

impl Branch {
  pub fn eq(self, other: Branch) -> bool {
    self.object.eq(other.object.*) && self.then.eq(other.then)
  }
}

impl Consequent {
  pub fn eq(self, other: Consequent) -> bool {
    match (self, other) {
      (Consequent.And(c1), Consequent.And(c2)) => c1.eq(c2),
      (Consequent.Or(c1), Consequent.Or(c2)) => c1.eq(c2),
      (Consequent.Do(e1), Consequent.Do(e2)) => e1.eq(e2.*),
      _ => false,
    }
  }
}

impl Parameter {
  pub fn eq(self, other: Parameter) -> bool {
    self.span == other.span && self.mode == other.mode &&
    self.name == other.name &&
    self.typ.eq(other.typ)
  }
}

pub fn param(
  start: uint32,
  end: uint32,
  mode: Option<mode.Mode>,
  name: string,
  typ: Type,
) -> Parameter {
  Parameter.new(span.new(start, end), mode, name, typ)
}
