import md "mode"
import spn "span"

#[json]
#[equality]
pub struct Type {
  pub span: spn.Span,
  pub kind: TypeKind,
}

#[json]
pub enum TypeKind {
  Nominal(Path, Slice<Type>),
  Tuple(Slice<Type>),
  Record(Slice<TypeField>),
  Enum(Slice<Variant>),
  Fn(Slice<ParamType>, Ref<Type>),
}

#[json]
#[equality]
pub struct TypeField {
  pub span: spn.Span,
  pub name: string,
  pub typ: Type,
}

pub struct Variant {
  pub span: spn.Span,
  pub name: string,
  pub payload: Option<Type>,
}
impl Variant {
  pub fn equals(self, other: Variant) -> bool {
    match (self.payload, other.payload) {
      (Some(a), Some(b)) => self.span == other.span && self.name == other.name && a.equals(b),
      (None, None) => self.span == other.span && self.name == other.name,
      _ => false,
    }
  }
}

