#[json]
#[equality]
pub struct ParamType {
  pub mode: Option<md.Mode>,
  pub typ: Type,
}

impl ParamType {
  pub fn new(mode: Option<md.Mode>, typ: Type) -> ParamType {
    ParamType { mode, typ }
  }

  pub fn none(typ: Type) -> ParamType {
    ParamType { mode: None, typ }
  }

  pub fn let_(typ: Type) -> ParamType {
    ParamType { mode: Some(md.Mode.Let), typ }
  }

  pub fn mut_(typ: Type) -> ParamType {
    ParamType { mode: Some(md.Mode.Mut), typ }
  }

  pub fn mut_bang(typ: Type) -> ParamType {
    ParamType { mode: Some(md.Mode.MutBang), typ }
  }

  pub fn var_(typ: Type) -> ParamType {
    ParamType { mode: Some(md.Mode.Var), typ }
  }
}

impl Type {
  pub fn new(span: spn.Span, name: Path, type_args: Slice<Type>) -> Type {
    Type { span, kind: TypeKind.Nominal(name, type_args) }
  }

  pub fn tuple(span: spn.Span, type_args: Slice<Type>) -> Type {
    Type { span, kind: TypeKind.Tuple(type_args) }
  }

  pub fn record(span: spn.Span, fields: Slice<TypeField>) -> Type {
    Type { span, kind: TypeKind.Record(fields) }
  }

  pub fn enum_(span: spn.Span, variants: Slice<Variant>) -> Type {
    Type { span, kind: TypeKind.Enum(variants)}
  }

  pub fn fn_(span: spn.Span, params: Slice<ParamType>, ret: Ref<Type>) -> Type {
    Type { span, kind: TypeKind.Fn(params, ret) }
  }
}

pub fn typ(start: uint32, end: uint32, name: string, type_args: Slice<Type>) -> Type {
  Type {
    span: spn.Span { start, end },
    kind: TypeKind.Nominal(Path.name_(name), type_args),
  }
}
