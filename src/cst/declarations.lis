import dx "diagnostics"
import md "mode"
import spn "span"

/// a container for declarations collected from a module
#[json]
pub struct Declarations {
  pub imports: Slice<Import>,
  pub types: Slice<TypeDecl>,
  pub functions: Slice<FunctionDecl>,
  pub errors: Slice<dx.SyntaxError>,
}

#[json]
pub struct Import {
  pub path: string,
  pub alias: Option<string>,
}

impl Import {
  pub fn new(path: string, alias: Option<string>) -> Import {
    Import { path, alias }
  }
}

#[json]
pub struct TypeParameter {
  pub span: spn.Span,
  pub name: string,
}

impl TypeParameter {
  pub fn new(span: spn.Span, name: string) -> TypeParameter {
    TypeParameter { span, name }
  }
}

#[json]
pub struct TypeDecl {
  pub span: spn.Span,
  pub name: string,
  pub type_parameters: Slice<TypeParameter>,
  pub body: Type,
}

impl TypeDecl {
  pub fn new_struct(
    span: spn.Span,
    name: string,
    type_parameters: Slice<TypeParameter>,
    fields: Slice<(int, int, string, Type)>,
  ) -> TypeDecl {
    let fields = fields.map(|(start, end, name, typ)|
      TypeField { span: spn.new(start as uint32, end as uint32), name, typ }
    )
    let body = Type.record(span, fields)
    TypeDecl { span, name, type_parameters, body }
  }

  pub fn new_enum(
    span: spn.Span,
    name: string,
    type_parameters: Slice<TypeParameter>,
    variants: Slice<(int, int, string, Option<Type>)>,
  ) -> TypeDecl {
    let variants = variants.map(|(start, end, name, payload)|
      Variant { span: spn.new(start as uint32, end as uint32), name, payload }
    )
    let body = Type.enum_(span, variants)
    TypeDecl { span, name, type_parameters, body }
  }
}

#[json]
#[equality]
pub struct FunctionDecl {
  pub span: spn.Span,
  pub signature: Signature,
  pub body: Block,
}

impl FunctionDecl {
  pub fn new(span: spn.Span, signature: Signature, body: Block) -> FunctionDecl {
    FunctionDecl { span, signature, body }
  }

  pub fn extern(self) -> bool {
    match self.body.statements {
      [Expression { kind: Extern, .. }] => true,
      _ => false,
    }
  }
}

#[json]
#[equality]
pub struct Signature {
  pub span: spn.Span,
  pub name: string,
  pub type_parameters: Slice<TypeParameter>,
  pub parameters: Slice<Parameter>,
  pub return_type: Type,
}

impl Signature {
  pub fn new(
    span: spn.Span,
    name: string,
    type_parameters: Slice<TypeParameter>,
    parameters: Slice<Parameter>,
    return_type: Type,
  ) -> Signature {
    Signature { span, name, type_parameters, parameters, return_type }
  }
}

#[json]
#[equality]
pub struct Parameter {
  pub span: spn.Span,
  pub mode: Option<md.Mode>,
  pub name: string,
  pub typ: Type,
}

impl Parameter {
  pub fn new(span: spn.Span, mode: Option<md.Mode>, name: string, typ: Type) -> Parameter {
    Parameter { span, mode, name, typ }
  }
}

pub fn param(
  start: uint32,
  end: uint32,
  mode: Option<md.Mode>,
  name: string,
  typ: Type,
) -> Parameter {
  Parameter.new(spn.new(start, end), mode, name, typ)
}

impl Declarations {
  pub fn new() -> Declarations {
    Declarations { imports: [], types: [], functions: [], errors: [] }
  }

  pub fn add_import(self: Ref<Declarations>, i: Import) {
    self.imports = self.imports.append(i)
  }

  pub fn add_type(self: Ref<Declarations>, t: TypeDecl) {
    self.types = self.types.append(t)
  }

  pub fn add_function(self: Ref<Declarations>, f: FunctionDecl) {
    self.functions = self.functions.append(f)
  }

  pub fn add_error(self: Ref<Declarations>, s: dx.SyntaxError) {
    self.errors = self.errors.append(s)
  }
}
