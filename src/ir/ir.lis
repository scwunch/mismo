impl Expression {
  pub fn new(span: spn.Span, kind: Expr) -> Expression {
    Expression { span, kind }
  }

  pub fn blank() -> Expression {
    Expression.new(spn.new(0, 0), Expr.Nil)
  }

  pub fn typ(self, registry: mut Ref<mut Registry>) -> ty.Type {
    self.kind.typ(registry)
  }

  pub fn mode(self, registry: mut Ref<mut Registry>) -> md.Mode {
    self.kind.mode(registry)
  }
}

impl Expr {
  pub fn is_extern(self) -> bool {
    if let Expr.Extern = self { true } else { false }
  }
}

impl Expr {
  pub fn typ(self, registry: mut Ref<mut Registry>) -> ty.Type {
    match self {
      Nil => ty.nil(),
      BoolLiteral(bool) => ty.Type.Bool,
      IntLiteral(int) => ty.Type.Int,
      FloatLiteral(float64) => ty.Type.Float,
      StringLiteral(string) => ty.Type.String,
      ArrayLiteral(_, typ) => typ,
      TupleLiteral(exprs) => ty.Type.Tuple(exprs.map(|e| e.typ(registry))),
      RecordLiteral(exprs) => ty.Type.Record(exprs.map(|f|
        ty.Field {name: f.name, typ: f.expr.typ(registry)}
      )),
      Closure(closure) => closure.typ(),
      Identifier(id) | CapturedIdent(id) | Assign(id, _) | AssignCapture(id, _) => registry.variable(id).typ,
      Declare(_, _, _) => ty.nil(),
      Binding(_, expr) => expr.typ(registry),
      Call(call) => call.fun.return_type,
      If(_, t) => t,
      While(_, blk) | Block(blk) => blk.typ,
      FieldAccess(obj, i) => obj.typ(registry).field(i),
      ConcreteCall(_, _) => panic(
        "compiler bug 75: concrete call should never have 'type' method called on it",
      ),
      StructConstructor(typ, _) => typ,
      EnumConstructor(typ, _, _) => typ,
      Return(_) | Break(_) | Continue | Extern => ty.Type.Never,
    }
  }

  pub fn mode(self, registry: mut Ref<mut Registry>) -> md.Mode {
    match self {
      Nil |
      BoolLiteral(_) |
      IntLiteral(_) |
      FloatLiteral(_) |
      StringLiteral(_) |
      ArrayLiteral(_, _) |
      TupleLiteral(_) |
      RecordLiteral(_) => md.Mode.Var,
      Closure(closure) => if closure.is_movable() {
        md.Mode.Var
      } else {
        md.Mode.MutBang
      },
      Identifier(varid) | CapturedIdent(varid) => registry.variable(varid).mode,
      Declare(_, _, _) | Assign(_, _) | AssignCapture(_, _) => md.Mode.Var,
      Binding(m, _) => m,
      FieldAccess(obj, _) => obj.mode(registry),
      If(cond, _) => md.Mode.Var,
      While(cond, _) => md.Mode.Var,
      Block(_) => md.Mode.Var,
      // TODO: incorrect for If, While, and Block; we actually need to search for all break statements, or store the mode explicitly
      Call(_) | Return(_) | Break(_) | Continue => md.Mode.Var,
      ConcreteCall(_, _) => md.Mode.Var,
      EnumConstructor(_, _, _) | StructConstructor(_, _) => md.Mode.Var,
      Extern => md.Mode.Var,
    }
  }
}
