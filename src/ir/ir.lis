import "ast"
import md "mode"
import spn "span"
import "ty"

#[display]
#[json]
#[equality]
pub struct Expression {
  pub span: spn.Span,
  pub kind: mut Expr,
}

#[display]
#[json]
#[equality]
pub enum Expr {
  Nil,
  BoolLiteral(bool),
  IntLiteral(int),
  FloatLiteral(float64),
  StringLiteral(string),
  ArrayLiteral(Slice<Expression>, ty.Type),
  TupleLiteral(Slice<Expression>),
  RecordLiteral(Slice<Field>),
  Closure(Closure),
  Declare(md.Mode, ty.VarId, Ref<Expression>),
  Identifier(ty.VarId),
  CapturedIdent(ty.VarId),
  Assign(ty.VarId, Ref<Expression>),
  AssignCapture(ty.VarId, Ref<Expression>),
  Binding(md.Mode, Ref<Expression>),
  Call(Call),
  ConcreteCall(int, Slice<Expression>),
  If(If, ty.Type),
  While(Ref<Expression>, Block),
  Block(Block),
  Return(Option<Ref<Expression>>),
  Break(Option<Ref<Expression>>),
  Continue,
  FieldAccess(Ref<Expression>, int),
  StructConstructor(ty.Type, Ref<Expression>),
  EnumConstructor(ty.Type, ty.Constructor, Ref<Expression>),
  Extern,
}

#[equality]
pub struct Field {
  pub name: string,
  pub expr: Expression,
}

#[equality]
pub struct Block {
  pub statements: Slice<Expression>,
  pub typ: ty.Type,
}

impl Block {
  pub fn new(statements: Slice<Expression>, typ: ty.Type) -> Block {
    if statements.is_empty() { panic("Block must have at least one statement") }
    Block { statements, typ }
  }

  pub fn kinds(self) -> Slice<Expr> {
    self.statements.map(|s| s.kind)
  }

  pub fn span(self) -> spn.Span {
    self.statements[0].span.merge(self.last().span)
  }

  pub fn last(self) -> Expression {
    self.statements[self.statements.length() - 1]
  }

  pub fn is_extern(self) -> bool {
    match self.statements {
      [Expression { kind: Extern, .. }] => true,
      _ => false,
    }
  }
}

/// all the info required to resolve function overload in type checking phase
#[display]
#[json]
#[equality]
pub struct Call {
  pub fun: mut Ref<FunctionDef>,
  pub type_args: Slice<ty.Type>,
  pub args: Slice<Expression>,
}

impl Call {
  pub fn new(
    fun: mut Ref<FunctionDef>,
    type_args: Slice<ty.Type>,
    args: Slice<Expression>,
  ) -> Call {
    Call { fun, type_args, args }
  }
}

#[json]
#[equality]
pub struct Closure {
  pub env: Slice<ast.Capture>,
  pub params: Slice<ty.Parameter>,
  pub ret_type: ty.Type,
  pub body: Block,
}

impl Closure {
  pub fn typ(self) -> ty.Type {
    // let params = self.params.map(|p| Paramty.Type{mode: p.mode, typ: p.typ})
    ty.Type.Fn(self.params.map(ty.Parameter.param_type), &self.ret_type)
  }

  pub fn call_mode(self) -> md.Mode {
    self.env.fold(md.Mode.Let, |acc, cap| acc.union(cap.mode))
  }

  pub fn is_movable(self) -> bool {
    self.env.all(|c| c.mode == md.Mode.Var)
  }
}

#[equality]
pub enum Decision {
  Leaf(Block),
  Fail,
  Guard { cond: Expression, then: mut Ref<Decision>, else_: mut Ref<Decision> },
  Assign { expr: Expression, place: Place, next: mut Ref<Decision> },
  Switch { scrutinee: Place, cases: Slice<Case>, default: mut Ref<Decision> },
  Bind { name: string, place: Place, next: mut Ref<Decision> },
}

#[equality]
pub struct Case {
  pub tag: string,
  pub then: mut Ref<Decision>,
}

#[equality]
pub struct Place {
  pub varid: ty.VarId,
  pub path: Slice<int>,
}

impl Place {
  pub fn extend(self, i: int) -> Place {
    Place { path: self.path.append(i), varid: self.varid }
  }
}

pub struct If {
  pub checks: Slice<Check>,
  pub default: Option<Block>,
  pub decision: mut Ref<Decision>,
  pub typ: ty.Type,
}

pub struct Checks {
  pub checks: Slice<Check>,
  pub default: Option<Block>,
}

#[json]
#[display]
#[equality]
pub enum Check {
  Test(Expression, Block),
  Match(Expression, Slice<Arm>),
}

#[json]
#[equality]
pub struct Arm {
  pub span: spn.Span,
  pub pattern: Pattern,
  pub then: Then,
}

#[json]
#[equality]
pub enum Pattern {
  Wildcard,
  Binding(ty.VarId),
  Tuple(Slice<Pattern>),
  Constructor(string, Ref<Pattern>),
}

impl Pattern {
  pub fn irrefutable(self) -> bool {
    match self {
      Wildcard | Binding(_) => true,
      Tuple(patts) => patts.all(Pattern.irrefutable),
      Constructor(_, _) => false,
    }
  }
}

#[json]
#[equality]
pub enum Then {
  Block(Block),
  If(If),
}

impl If {
  pub fn new(checks: Slice<Check>, default: Option<Block>, typ: ty.Type) -> mut If {
    let mut fail = Decision.Fail
    If { checks, default, decision: &fail, typ }
  }

  pub fn span(self) -> spn.Span {
    self.checks[0].span().merge(self.end_span())
  }

  #[allow(manual_map_or)]
  pub fn end_span(self) -> spn.Span {
    match self.default {
      Some(block) => block.last().span,
      None => self.checks[self.checks.length() - 1].end_span(),
    }
  }

  pub fn equals(self, other: If) -> bool {
    self.checks.equals(other.checks) &&
    self.default.map_or_else(
      || other.default.is_none(),
      |b1| other.default.map_or(false, |b2| b1.equals(b2)),
    )
  }

  pub fn fold<A>(self, accumulator: A, f: fn(A, Expression) -> A) -> A {
    let mut acc = accumulator
    for check in self.checks {
      match check {
        Test(_, blk) => acc = f(acc, blk.last()),
        Match(_, arms) => {
          for arm in arms {
            match arm.then {
              Block(blk) => acc = f(acc, blk.last()),
              If(cond) => acc = cond.fold(acc, f),
            }
          }
        },
      }
    }
    self.default.map_or(acc, |blk| f(acc, blk.last()))
  }
}

impl Check {
  pub fn span(self) -> spn.Span {
    match self {
      Test(expr, block) => expr.span.merge(block.last().span),
      Match(expr, arms) => expr.span.merge(arms[arms.length() - 1].end_span()),
    }
  }

  #[allow(manual_map_or)]
  pub fn end_span(self) -> spn.Span {
    match self {
      Test(_, block) => block.last().span,
      Match(_, arms) => arms[arms.length() - 1].end_span(),
    }
  }
}

impl Arm {
  pub fn end_span(self) -> spn.Span {
    match self.then {
      Block(block) => block.last().span,
      If(cond) => cond.end_span(),
    }
  }
}

