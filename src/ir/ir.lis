import "mode"
import "ty"
import "span"
import "ast"

#[display]
#[json]
#[equality]
pub struct Expression {
  pub span: span.Span,
  pub kind: Expr,
}

#[display]
#[json]
#[equality]
pub enum Expr {
  Nil,
  BoolLiteral(bool),
  IntLiteral(int),
  FloatLiteral(float64),
  StringLiteral(string),
  ArrayLiteral(Slice<Expression>, ty.Type),
  TupleLiteral(Slice<Expression>),
  Closure(Closure),
  Declare(mode.Mode, Ref<ty.Variable>, Ref<Expression>),
  Identifier(Ref<ty.Variable>),
  CapturedIdent(Ref<ty.Variable>),
  Assign(Ref<ty.Variable>, Ref<Expression>),
  AssignCapture(Ref<ty.Variable>, Ref<Expression>),
  Binding(mode.Mode, Ref<Expression>),
  Call(Call),
  ConcreteCall(int, Slice<Expression>),
  If(If, ty.Type),
  While(Ref<Expression>, Block),
  Block(Block),
  Return(Option<Ref<Expression>>),
  Break(Option<Ref<Expression>>),
  Continue,
  FieldAccess(Ref<Expression>, int),
  StructConstructor(ty.Type, Slice<Expression>),
  EnumConstructor(ty.Variant, Slice<Expression>),
  Extern,
}

#[equality]
pub struct Block {
  pub statements: Slice<Expression>,
  pub typ: ty.Type,
}

impl Block {
  pub fn new(statements: Slice<Expression>, typ: ty.Type) -> Block {
    if statements.is_empty() { panic("Block must have at least one statement") }
    Block { statements, typ }
  }

  pub fn kinds(self) -> Slice<Expr> {
    self.statements.map(|s| s.kind)
  }

  pub fn span(self) -> span.Span {
    self.statements[0].span.merge(self.last().span)
  }

  pub fn last(self) -> Expression {
    self.statements[self.statements.length() - 1]
  }

  pub fn is_extern(self) -> bool {
    match self.statements {
      [Expression { kind: Extern, .. }] => true,
      _ => false,
    }
  }
}

/// all the info required to resolve function overload in type checking phase
#[display]
#[json]
#[equality]
pub struct Call {
  pub fun: Ref<ast.FunctionDef>,
  pub type_args: Slice<ty.Type>,
  pub args: Slice<Expression>,
}

impl Call {
  pub fn new(
    fun: Ref<ast.FunctionDef>,
    type_args: Slice<ty.Type>,
    args: Slice<Expression>,
  ) -> Call {
    Call { fun, type_args, args }
  }
}

#[json]
#[equality]
pub struct Closure {
  pub env: Slice<ast.Capture>,
  pub params: Slice<ty.Parameter>,
  pub ret_type: ty.Type,
  pub body: Block,
}

impl Closure {
  pub fn typ(self) -> ty.Type {
    // let params = self.params.map(|p| Paramty.Type{mode: p.mode, typ: p.typ})
    ty.Type.Fn(self.params.map(ty.Parameter.param_type), &self.ret_type)
  }

  pub fn call_mode(self) -> mode.Mode {
    self.env.fold(mode.Mode.Let, |acc, cap| acc.union(cap.mode))
  }

  pub fn is_movable(self) -> bool {
    self.env.all(|c| c.mode == mode.Mode.Var)
  }
}

#[equality]
pub enum Decision {
  Leaf(Block),
  Fail,
  Guard{cond: Expression, then: Ref<Decision>, else_: Ref<Decision>},
  Assign{expr: Expression, place: Place, next: Ref<Decision>},
  Switch{scrutinee: Place, cases: Slice<Case>, default: Ref<Decision>},
  Bind{name: string, place: Place, next: Ref<Decision>},
}

#[equality]
pub struct Case {
  pub tag: string,
  pub then: Ref<Decision>,
}

#[equality]
pub struct Place {
  pub varid: Ref<ty.Variable>,
  pub path: Slice<int>,
}

impl Place {
  pub fn extend(self, i: int) -> Place {
    Place { path: self.path.append(i), varid: self.varid }
  }
}

pub struct If {
  pub checks: Slice<Check>,
  pub default: Option<Block>,
  pub decision: Ref<Decision>,
  pub typ: ty.Type,
}

pub struct Checks {
  pub checks: Slice<Check>,
  pub default: Option<Block>,
}

#[json]
#[display]
#[equality]
pub enum Check {
  Test(Expression, Block),
  Match(Expression, Slice<Row>),
}

#[json]
#[equality]
pub struct Row {
  pub span: span.Span,
  pub patterns: Slice<Pattern>,
  pub then: Then,
}

#[json]
#[equality]
pub enum Pattern {
  Wildcard,
  Binding(Ref<ty.Variable>),
  Constructor(string, Slice<Pattern>),
}
impl Pattern {
  pub fn irrefutable(self) -> bool {
    match self {
      Wildcard | Binding(_) => true,
      Constructor(_, _) => false,
    }
  }
}

#[json]
#[equality]
pub enum Then {
  Block(Block),
  If(If),
}

impl If {
  pub fn new(checks: Slice<Check>, default: Option<Block>, typ: ty.Type) -> If {
    If{checks, default, decision: &Decision.Fail, typ}
  }

  pub fn span(self) -> span.Span {
    self.checks[0].span().merge(self.end_span())
  }

  #[allow(manual_map_or)]
  pub fn end_span(self) -> span.Span {
    match self.default {
      Some(block) => block.last().span,
      None => self.checks[self.checks.length() - 1].end_span(),
    }
  }

  pub fn equals(self, other: If) -> bool {
    self.checks.equals(other.checks) &&
    self.default.map_or_else(
      || other.default.is_none(),
      |b1| other.default.map_or(false, |b2| b1.equals(b2)),
    )
  }

  pub fn fold<A>(self, accumulator: A, f: fn(A, Expression) -> A) -> A {
    let mut acc = accumulator
    for check in self.checks {
      match check {
        Test(_, blk) => acc = f(acc, blk.last()),
        Match(_, arms) => {
          for arm in arms {
            match arm.then {
              Block(blk) => acc = f(acc, blk.last()),
              If(cond) => acc = cond.fold(acc, f),
            }
          }
        }
      }
    }
    self.default.map_or(acc, |blk| f(acc, blk.last()))
  }
}

impl Check {
  pub fn span(self) -> span.Span {
    match self {
      Test(expr, block) => expr.span.merge(block.last().span),
      Match(expr, arms) => expr.span.merge(arms[arms.length() - 1].end_span()),
    }
  }


  #[allow(manual_map_or)]
  pub fn end_span(self) -> span.Span {
    match self {
      Test(_, block) => block.last().span,
      Match(_, arms) => arms[arms.length() - 1].end_span(),
    }
  }
}

impl Row {
  pub fn end_span(self) -> span.Span {
    match self.then {
      Block(block) => block.last().span,
      If(cond) => cond.end_span(),
    }
  }

  pub fn replace(self, col: int, patt: Slice<Pattern>) -> Row {
    let len = self.patterns.length() + patt.length() - 1
    let mut patterns = [].reserve(len)
    patterns = patterns.append(self.patterns[..col]...)
    patterns = patterns.append(patt...)
    patterns = patterns.append(self.patterns[col+1..]...)
    Row{patterns, ..self}
  }

  pub fn irrefutable(self) -> bool {
    self.patterns.all(|patt| patt.irrefutable())
  }
}

