impl Expression {
  pub fn new(span: span.Span, kind: Expr) -> Expression {
    Expression { span, kind }
  }

  pub fn blank() -> Expression {
    Expression.new(span.new(0, 0), Expr.Nil)
  }

  pub fn typ(self) -> ty.Type {
    self.kind.typ()
  }
}

impl Expr {
  pub fn is_extern(self) -> bool {
    if let Expr.Extern = self {
      true
    } else { false }
  }
}

impl Expr {
  pub fn typ(self) -> ty.Type {
    match self {
      Nil => ty.nil(),
      BoolLiteral(bool) => ty.Type.Bool,
      IntLiteral(int) => ty.Type.Int,
      FloatLiteral(float64) => ty.Type.Float,
      StringLiteral(string) => ty.Type.String,
      ArrayLiteral(_, typ) => typ,
      TupleLiteral(exprs) => ty.Type.Tuple(exprs.map(|e| e.typ())),
      Closure(closure) => closure.typ(),
      Identifier(id) | CapturedIdent(id) |
      Assign(id, _) | AssignCapture(id, _) => id.typ,
      Declare(_, _, _) => ty.nil(),
      Binding(_, expr) => expr.typ(),
      Call(call) => call.fun.return_type,
      If(_, t) => t,
      While(_, blk) | Block(blk) => blk.typ,
      FieldAccess(obj, i) => match obj.typ() {
        ty.Type.Adt(def, args) => match def.kind {
          Struct(fields) => fields[i].typ.substitute(args),
          Enum(_) => panic("compiler bug 71: FieldAccess on enum"),
        },
        _ => panic("compiler bug 73: FieldAccess on non-ADT"),
      },
      ConcreteCall(_, _) => panic(
        "compiler bug 75: concrete call should never have 'type' method called on it",
      ),
      StructConstructor(typ, _) => typ,
      EnumConstructor(_, _) => panic("TODO: rework this"),
      Return(_) |
      Break(_) |
      Continue |
      Extern => ty.Type.Never,
    }
  }
}
