import "cst"
import dx "diagnostics"
import "mode"
import "span"
import "utils/slice"

/// Generic context that bundles a TypeEnv with type parameters
/// for evaluating types
struct TypeContext { env: Ref<TypeEnv>, type_params: Slice<TypeParameter> }

impl TypeEnv {
  fn type_context(self: Ref<TypeEnv>, type_params: Slice<TypeParameter>) -> TypeContext {
    TypeContext { env: self, type_params }
  }
}

impl TypeContext {
  fn eval_type(self, typ: cst.Type) -> Result<Type, dx.TypeError> {
    match typ.kind {
      cst.TypeKind.Tuple(types) => {
        Ok(Type.Tuple(slice.map_result(types, self.eval_type)?))
      },
      cst.TypeKind.Fn(params, ret) => {
        let params = slice.map_result(params, self.eval_param_type)?
        let ret = self.eval_type(ret.*)?
        Ok(Type.Fn(params, &ret))
      },
      cst.TypeKind.Nominal(name, type_args) => {
        self.eval_nominal_type(
          typ.span,
          name,
          slice.map_result(type_args, self.eval_type)?,
        )
      },
    }
  }

  fn eval_nominal_type(
    self,
    span: span.Span,
    path: cst.Path,
    type_args: Slice<Type>,
  ) -> Result<Type, dx.TypeError> {
    if path.namespace.is_empty() {
      // try to match type param
      if let Some(res_t) = self.type_of_type_param(span, path.name, type_args) {
        return res_t
      }
      // try to match built in type
      if let Some(res_t) = self.primitive_type(span, path.name, type_args) {
        return res_t
      }
      self.env.eval_type(span, path.name, type_args)
    } else {
      let module = self.env.get_module(span, path)?
      module.eval_type(span, path.name, type_args)
    }
  }

  fn type_of_type_param(
    self,
    span: span.Span,
    name: string,
    type_args: Slice<Type>,
  ) -> Option<Result<Type, dx.TypeError>> {
    for (i, tp) in self.type_params.enumerate() {
      if name == tp.name {
        return if type_args.is_empty() {
          Some(Ok(Type.Var(i)))
        } else {
          let e = dx.TypeParameterArityError.new(
            span,
            f"type parameter {tp.name}",
            0,
            type_args.length(),
          )
          Some(Err(e))
        }
      }
    }
    None
  }

  fn primitive_type(self, span: span.Span, name: string, type_args: Slice<Type>) -> Option<Result<Type, dx.TypeError>> {
    let primitive = match name {
      "Any" => Type.Any,
      "Never" => Type.Never,
      "Nil" => Type.Tuple([]),
      "Bool" => Type.Bool,
      "Nat" => Type.Nat,
      "Int" => Type.Int,
      "Float" => Type.Float,
      "String" => Type.String,
      "Array" => {
        return Some(check_arity(span, name, type_args.length(), 1).map(|_| Type.Array(
          &type_args[0],
        )))
      },
      "Slice" => {
        return Some(check_arity(span, name, type_args.length(), 1).map(|_| Type.Slice(
          &type_args[0],
        )))
      },
      "Pointer" => {
        return Some(check_arity(span, name, type_args.length(), 1).map(|_| Type.Pointer(
          &type_args[0],
        )))
      },
      _ => return None,
    }
    Some(check_arity(span, name, type_args.length(), 0).map(|_| primitive))
  }

  fn eval_param(self, param: cst.Parameter) -> Result<Parameter, dx.TypeError> {
    let typ = self.eval_type(param.typ)?
    Ok(
      Parameter { 
        span: param.span,
        mode: param.mode.unwrap_or(mode.Mode.Let),
        name: param.name,
        typ,
      },
    )
  }

  fn eval_param_type(self, param: cst.ParamType) -> Result<ParamType, dx.TypeError> {
    let typ = self.eval_type(param.typ)?
    Ok(ParamType { mode: param.mode.unwrap_or(mode.Mode.Let), typ })
  }
}

fn check_arity(span: span.Span, name: string, type_args: int, type_params: int) -> Result<(), dx.TypeError> {
  if type_args == type_params {
    Ok(())
  } else {
    Err(dx.TypeParameterArityError.new(span, name, type_args, type_params))
  }
}
