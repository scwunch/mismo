import "cst"
import "errors"
import "mode"
import "span"

pub struct TypeEnv {
  pub type_defs: Map<string, Ref<TypeDef>>,
  pub function_defs: Slice<FunctionDef>,
  pub signatures: Map<string, Slice<Ref<FunctionDef>>>,
  pub errors: Slice<errors.TypeError>,
}

impl TypeEnv {
  pub fn new() -> TypeEnv {
    TypeEnv { 
      type_defs: Map.new(),
      function_defs: Slice.new(),
      signatures: Map.new(),
      errors: Slice.new(),
    }
  }

  fn register_types(self: Ref<TypeEnv>, type_defs: Slice<cst.TypeDecl>) {
    for t in type_defs {
      match self.type_defs.get(t.name) {
        Some(def) => self.error(errors.DuplicateNameError.new(
          t.name,
          t.span,
          def.span,
        )),
        None => {
          let kind = match t.body {
            cst.TypeBody.Struct(_) => TypeKind.Struct([]),
            cst.TypeBody.Enum(_) => TypeKind.Enum([]),
          }
          let type_params = t.type_parameters.map(|param| {
            TypeParameter { span: param.span, name: param.name }
          })
          self.type_defs[t.name] = &TypeDef.new(
            t.span,
            t.name,
            type_params,
            kind,
          )
        },
      }
    }
  }

  fn fill_out_type_info(self: Ref<TypeEnv>, types: Slice<cst.TypeDecl>) {
    for decl in types {
      let def = self.type_defs[decl.name]
      match decl.body {
        cst.TypeBody.Struct(fields) => {
          def.kind = TypeKind.Struct(fields.map(|field| {
            Field { 
              span: field.span,
              name: field.name,
              typ: self
                .eval_type(field.typ)
                .unwrap_or_else(|e| {
                  self.error(e)
                  Type.Never
                }),
            }
          }))
        },
        cst.TypeBody.Enum(variants) => {
          def.kind = TypeKind.Enum(variants.map(|variant| {
            Variant { 
              span: variant.span,
              name: variant.name,
              fields: variant.payload.map(|typ| {
                self
                  .eval_type(typ)
                  .unwrap_or_else(|e| {
                    self.error(e)
                    Type.Never
                  })
              }),
            }
          }))
        },
      }
    }
  }

  fn eval_type(self, typ: cst.Type) -> Result<Type, errors.TypeError> {
    match typ.kind {
      cst.TypeKind.Tuple(types) => {
        // Ok(Type.Tuple(slice.map_result(types, self.eval_type)))
        let mut ts = []
        for t in types {
          ts = ts.append(self.eval_type(t)?)
        }
        Ok(Type.Tuple(ts))
      },
      cst.TypeKind.Fn(params, ret) => {
        // let params = slice.map_result(params, self.eval_param_type)?
        let mut param_types = []
        for p in params {
          param_types = param_types.append(self.eval_param_type(p)?)
        }
        let ret = self.eval_type(ret.*)?
        Ok(Type.Fn(param_types, &ret))
      },
      cst.TypeKind.Nominal(name, type_args) => {
        let primitive = match name {
          "Never" => Some(Type.Never),
          "Nil" => Some(Type.Tuple([])),
          "Bool" => Some(Type.Bool),
          "Nat" => Some(Type.Nat),
          "Int" => Some(Type.Int),
          "Float" => Some(Type.Float),
          "String" => Some(Type.String),
          _ => None,
        }
        if let Some(primitive) = primitive {
          self.check_arity(typ.span, name, type_args.length(), 0)?
          return Ok(primitive)
        }

        match self.type_defs.get(name) {
          None => {
            Err(errors.MissingNameError.new(name, typ.span))
          },
          Some(def) => {
            // let type_args = slice.map_result(type_args, self.eval_type)?
            let mut ts = []
            for t in type_args {
              ts = ts.append(self.eval_type(t)?)
            }
            self.check_arity(
              typ.span,
              name,
              type_args.length(),
              def.type_parameters.length(),
            )?
            Ok(Type.Adt(def, ts))
          },
        }
      },
    }
  }

  fn check_arity(
    self,
    span: span.Span,
    name: string,
    type_args: int,
    type_params: int,
  ) -> Result<(), errors.TypeError> {
    if type_args == type_params {
      Ok(())
    } else {
      Err(errors.TypeParameterArityError.new(span, name, type_args, type_params))
    }
  }

  pub fn eval_param(self, param: cst.Parameter) -> Result<Parameter, errors.TypeError> {
    let typ = self.eval_type(param.typ)?
    Ok(
      Parameter { 
        span: param.span,
        mode: param.mode.unwrap_or(mode.Mode.Let),
        name: param.name,
        typ,
      },
    )
  }

  fn eval_param_type(self, param: cst.ParamType) -> Result<ParamType, errors.TypeError> {
    let typ = self.eval_type(param.typ)?
    Ok(ParamType { mode: param.mode.unwrap_or(mode.Mode.Let), typ })
  }

  fn register_functions(self: Ref<TypeEnv>, functions: Slice<cst.FunctionDecl>) {
    self.function_defs = functions.map(self.eval_function)
    for i in 0..self.function_defs.length() {
      let def = &self.function_defs[i]
      match self.signatures.get(def.name) {
        Some(existing) => {
          self.signatures[def.name] = existing.append(def)
        },
        None => self.signatures[def.name] = [def],
      }
    }
  }

  fn eval_function(self: Ref<TypeEnv>, func: cst.FunctionDecl) -> FunctionDef {
    self
      .try_eval_function(func)
      .unwrap_or_else(|e| {
        self.error(e)
        FunctionDef.new(
          func.span,
          -1,
          func.signature.name,
          [],
          [],
          Type.nil(),
          Expression.blank(),
        )
      })
  }

  fn try_eval_function(self, func: cst.FunctionDecl) -> Result<FunctionDef, errors.TypeError> {
    let span = func.span
    let name = func.signature.name
    let type_params = func.signature.type_parameters.map(|param| {
      TypeParameter { span: param.span, name: param.name }
    })
    let mut params = []
    for param in func.signature.parameters {
      params = params.append(self.eval_param(param)?)
    }
    let return_type = self.eval_type(func.signature.return_type)?
    let body = Expression.blank()
    Ok(FunctionDef.new(span, -1, name, type_params, params, return_type, body))
  }

  fn error(self: Ref<TypeEnv>, err: errors.TypeError) {
    self.errors = self.errors.append(err)
  }
}
