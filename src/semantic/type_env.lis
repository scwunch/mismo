import "cst"
import "errors"
import "mode"
import "span"
import "utils/slice"

pub struct TypeEnv {
  pub imports: Map<string, TypeEnv>,
  pub type_defs: Map<string, Ref<TypeDef>>,
  pub function_defs: Slice<FunctionDef>,
  pub signatures: Map<string, Slice<Ref<FunctionDef>>>,
  pub errors: Slice<errors.TypeError>,
}

impl TypeEnv {
  pub fn new() -> TypeEnv {
    TypeEnv { .. }
  }

  pub fn register_types(self: Ref<TypeEnv>, type_defs: Slice<cst.TypeDecl>) {
    for t in type_defs {
      match self.type_defs.get(t.name) {
        Some(def) => self.error(errors.DuplicateNameError.new(
          t.name,
          t.span,
          def.span,
        )),
        None => {
          let kind = match t.body {
            cst.TypeBody.Struct(_) => TypeKind.Struct([]),
            cst.TypeBody.Enum(_) => TypeKind.Enum([]),
          }
          let type_params = t.type_parameters.map(|param| {
            TypeParameter { span: param.span, name: param.name }
          })
          self.type_defs[t.name] = &TypeDef.new(
            t.span,
            t.name,
            type_params,
            kind,
          )
        },
      }
    }
  }

  pub fn fill_out_type_info(self: Ref<TypeEnv>, types: Slice<cst.TypeDecl>) {
    for decl in types {
      let def = self.type_defs[decl.name]
      let ctx = self.type_context(def.type_parameters)
      match decl.body {
        cst.TypeBody.Struct(fields) => {
          def.kind = TypeKind.Struct(fields.map(|field| {
            Field { 
              span: field.span,
              name: field.name,
              typ: ctx
                .eval_type(field.typ)
                .unwrap_or_else(|e| {
                  self.error(e)
                  Type.Never
                }),
            }
          }))
        },
        cst.TypeBody.Enum(variants) => {
          def.kind = TypeKind.Enum(variants.map(|variant| {
            Variant { 
              span: variant.span,
              name: variant.name,
              fields: variant.payload.map(|typ| {
                ctx
                  .eval_type(typ)
                  .unwrap_or_else(|e| {
                    self.error(e)
                    Type.Never
                  })
              }),
            }
          }))
        },
      }
    }
  }

  pub fn register_functions(
    self: Ref<TypeEnv>,
    functions: Slice<cst.FunctionDecl>,
  ) {
    self.function_defs = functions.map(self.eval_function)
    for i in 0..self.function_defs.length() {
      let def = &self.function_defs[i]
      match self.signatures.get(def.name) {
        Some(existing) => {
          self.signatures[def.name] = existing.append(def)
        },
        None => self.signatures[def.name] = [def],
      }
    }
  }

  pub fn eval_function(self: Ref<TypeEnv>, func: cst.FunctionDecl) -> FunctionDef {
    self
      .try_eval_function(func)
      .unwrap_or_else(|e| {
        self.error(e)
        FunctionDef.new(
          func.span,
          -1,
          func.signature.name,
          [],
          [],
          Type.nil(),
          Expression.blank(),
        )
      })
  }

  pub fn add_function(self: Ref<TypeEnv>, func: FunctionDef) {
    let i = self.function_defs.length()
    self.function_defs = self.function_defs.append(func)
    let def = &self.function_defs[i]
    match self.signatures.get(def.name) {
      Some(existing) => {
        self.signatures[def.name] = existing.append(def)
      },
      None => self.signatures[def.name] = [def],
    }
  }

  pub fn try_eval_function(self: Ref<TypeEnv>, func: cst.FunctionDecl) -> Result<FunctionDef, errors.TypeError> {
    let span = func.span
    let name = func.signature.name
    let type_params = func.signature.type_parameters.map(|param| {
      TypeParameter { span: param.span, name: param.name }
    })
    let ctx = self.type_context(type_params)
    let mut params = []
    for param in func.signature.parameters {
      params = params.append(ctx.eval_param(param)?)
    }
    let return_type = ctx.eval_type(func.signature.return_type)?
    let body = Expression.blank()
    Ok(FunctionDef.new(span, -1, name, type_params, params, return_type, body))
  }

  pub fn error(self: Ref<TypeEnv>, err: errors.TypeError) {
    self.errors = self.errors.append(err)
  }

  pub fn get_module(self, span: span.Span, path: cst.Path) -> Result<TypeEnv, errors.TypeError> {
    self.imports
      .get(path.namespace.join("::"))
      .ok_or_else(|| errors.MissingNameError.new(
        path.namespace.join("::"),
        span,
      ))
  }

  pub fn eval_type(self, span: span.Span, name: string, type_args: Slice<Type>) -> Result<Type, errors.TypeError> {
    match self.type_defs.get(name) {
      None => {
        Err(errors.MissingNameError.new(name, span))
      },
      Some(def) => {
        let n = def.type_parameters.length()
        check_arity(span, name, type_args.length(), n)?
        Ok(Type.Adt(def, type_args))
      },
    }
  }
}
