import "ast"
import dx "diagnostics"

pub fn analyze(env: Ref<ast.Registry>) {
  for i in 0..env.functions.length() {
    let func = env.function_defs[i]
    match TypeCheck.new(&env, func.*).check(func.body, func.return_type) {
      Ok(expr) => {
        func.body = expr
        if let Err(e) = ModeCheck.new().consume(expr) { env.error(e) }
      },
      Err(e) => env.error(e),
    }
  }
}

pub fn analyze_type_check(items: cst.Declarations) -> TypeEnv {
  for i in 0..env.functions.length() {
    let func = env.function_defs[i]
    match TypeCheck.new(&env, func.*).check(func.body, func.return_type) {
      Ok(expr) => {
        func.body = expr
      },
      Err(e) => env.error(e),
    }
  }
}
