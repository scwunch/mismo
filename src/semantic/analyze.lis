import "ty"
import "ast"
import "ir"
import dx "diagnostics"

pub fn analyze(env: Ref<ast.Registry>) -> ir.Registry {
  let mut reg = ir.Registry.new()
  reg.type_defs = env.type_defs
  reg.function_defs = env.function_defs.map(|fun| {
    let (new_fun, err) = lower(fun)
    if let Some(e) = err {
      env.error(e)
    }
    new_fun
  })
  reg
}

fn lower(fun: Ref<ast.FunctionDef>) -> (Ref<ir.FunctionDef>, Option<dx.TypeError>) {
  let new_fun = &ir.FunctionDef.new(
    fun.span,
    fun.id,
    fun.name,
    fun.type_parameters,
    fun.parameters,
    fun.return_type,
    ir.Block.new([], ty.Type.Never),
  )
  match TypeCheck.new(fun).check_block(fun.body, fun.return_type, fun.span) {
    Ok(blk) => {
      new_fun.body = blk
      (new_fun, None)
    },
    Err(e) => (new_fun, Some(e)),
  }
}

