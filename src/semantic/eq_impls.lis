import "utils/slice"

impl Expression {
  pub fn equals(self, other: Expression) -> bool {
    self.span == other.span && self.kind.equals(other.kind)
  }
}

impl Expr {
  #[allow(float_cmp)]
  pub fn equals(self, other: Expr) -> bool {
    match (self, other) {
      (Expr.Nil, Expr.Nil) => true,
      (Expr.BoolLiteral(a), Expr.BoolLiteral(b)) => a == b,
      (Expr.IntLiteral(a), Expr.IntLiteral(b)) => a == b,
      (Expr.FloatLiteral(a), Expr.FloatLiteral(b)) => a == b,
      (Expr.StringLiteral(a), Expr.StringLiteral(b)) => a == b,
      (Expr.ArrayLiteral(a1, t1), Expr.ArrayLiteral(a2, t2)) => a1.equals(a2) &&
      t1.equals(t2),
      (Expr.TupleLiteral(a), Expr.TupleLiteral(b)) => a.equals(b),
      (Expr.Identifier(a), Expr.Identifier(b)) => a == b,
      (Expr.Assign(a1, a2), Expr.Assign(b1, b2)) => a1 == b1 && a2.equals(b2.*),
      (Expr.Binding(m1, a), Expr.Binding(m2, b)) => m1 == m2 && a.equals(b.*),
      (Expr.Call(a), Expr.Call(b)) => a.equals(b),
      (Expr.SwitchIf(a), Expr.SwitchIf(b)) => a.equals(b),
      (Expr.Match(a), Expr.Match(b)) => a.equals(b),
      (Expr.Loop(a1, t1), Expr.Loop(a2, t2)) => a1.equals(a2) && t1.equals(t2),
      (Expr.Block(a1, t1), Expr.Block(a2, t2)) => a1.equals(a2) && t1.equals(t2),
      (Expr.Return(None), Expr.Return(None)) => true,
      (Expr.Return(Some(a)), Expr.Return(Some(b))) => a.equals(b.*),
      (Expr.Break(None), Expr.Break(None)) => true,
      (Expr.Break(Some(a)), Expr.Break(Some(b))) => a.equals(b.*),
      (Expr.Continue, Expr.Continue) => true,
      (Expr.FieldAccess(a1, i1), Expr.FieldAccess(a2, i2)) => a1 == a2 &&
      i1 == i2,
      _ => false,
    }
  }
}

impl FnCall {
  pub fn equals(self, other: FnCall) -> bool {
    self.fun == other.fun && self.args.equals(other.args)
  }
}

impl SwitchIf {
  pub fn equals(self, other: SwitchIf) -> bool {
    if self.cases.length() != other.cases.length() { return false }
    for i in 0..self.cases.length() {
      let (a1, a2) = self.cases[i]
      let (b1, b2) = other.cases[i]
      if !a1.equals(b1) || !a2.equals(b2) { return false }
    }
    true
  }
}

impl Match {
  pub fn equals(self, other: Match) -> bool {
    self.subject.equals(other.subject.*) && self.cases.equals(other.cases)
  }
}

impl MatchArm {
  pub fn equals(self, other: MatchArm) -> bool {
    self.pattern.equals(other.pattern) && self.expr.equals(other.expr)
  }
}
