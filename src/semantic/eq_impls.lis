import "utils/slice"

impl TypeDef {
  pub fn equals(self, other: TypeDef) -> bool {
    self.span == other.span && self.name == other.name &&
    self.type_parameters.equals(other.type_parameters) &&
    self.kind.equals(other.kind)
  }
}

impl TypeParameter {
  pub fn equals(self, other: TypeParameter) -> bool {
    self.span == other.span && self.name == other.name
  }
}

impl TypeKind {
  pub fn equals(self, other: TypeKind) -> bool {
    match (self, other) {
      (TypeKind.Struct(a), TypeKind.Struct(b)) => a.equals(b),
      (TypeKind.Enum(a), TypeKind.Enum(b)) => a.equals(b),
      _ => false,
    }
  }
}

impl Field {
  pub fn equals(self, other: Field) -> bool {
    self.span == other.span && self.name == other.name &&
    self.typ.equals(other.typ)
  }
}

impl Variant {
  pub fn equals(self, other: Variant) -> bool {
    self.span == other.span && self.name == other.name &&
    self.fields.equals(other.fields)
  }
}

impl Type {
  pub fn equals(self, other: Type) -> bool {
    match (self, other) {
      (Any, Any) => true,
      (Never, Never) => true,
      (Bool, Bool) => true,
      (Nat, Nat) => true,
      (Int, Int) => true,
      (Float, Float) => true,
      (String, String) => true,
      (Array(a), Array(b)) | (Pointer(a), Pointer(b)) => a.equals(b.*),
      (Slice(a), Slice(b)) => a.equals(b.*),
      (Tuple(a), Tuple(b)) => a.equals(b),
      (Fn(a, b), Fn(c, d)) => a.equals(c) && b.equals(d.*),
      (Adt(a, b), Adt(c, d)) => a == c && b.equals(d),
      (Var(a), Var(b)) => a == b,
      (Any, _) |
      (Never, _) |
      (Bool, _) |
      (Nat, _) |
      (Int, _) |
      (Float, _) |
      (String, _) |
      (Array(_), _) |
      (Slice(_), _) |
      (Pointer(_), _) |
      (Tuple(_), _) |
      (Fn(_, _), _) |
      (Adt(_, _), _) |
      (Var(_), _) => false,
    }
  }
}

impl ParamType {
  pub fn equals(self, other: ParamType) -> bool {
    self.mode == other.mode && self.typ.equals(other.typ)
  }
}

impl Parameter {
  pub fn equals(self, other: Parameter) -> bool {
    self.span == other.span && self.mode == other.mode &&
    self.name == other.name &&
    self.typ.equals(other.typ)
  }
}

impl FunctionDef {
  pub fn equals(self, other: FunctionDef) -> bool {
    self.span == other.span && self.name == other.name &&
    self.type_parameters.equals(other.type_parameters) &&
    self.parameters.equals(other.parameters) &&
    self.return_type.equals(other.return_type) &&
    self.body.equals(other.body)
  }
}

impl Expression {
  pub fn equals(self, other: Expression) -> bool {
    self.span == other.span && self.kind.equals(other.kind)
  }
}

impl Expr {
  #[allow(float_cmp)]
  pub fn equals(self, other: Expr) -> bool {
    match (self, other) {
      (Expr.Nil, Expr.Nil) => true,
      (Expr.BoolLiteral(a), Expr.BoolLiteral(b)) => a == b,
      (Expr.IntLiteral(a), Expr.IntLiteral(b)) => a == b,
      (Expr.FloatLiteral(a), Expr.FloatLiteral(b)) => a == b,
      (Expr.StringLiteral(a), Expr.StringLiteral(b)) => a == b,
      (Expr.ArrayLiteral(a1, t1), Expr.ArrayLiteral(a2, t2)) => a1.equals(a2) &&
      t1.equals(t2),
      (Expr.TupleLiteral(a), Expr.TupleLiteral(b)) => a.equals(b),
      (Expr.Identifier(a), Expr.Identifier(b)) => a == b,
      (Expr.Assign(a1, a2), Expr.Assign(b1, b2)) => a1 == b1 && a2.equals(b2.*),
      (Expr.Binding(m1, a), Expr.Binding(m2, b)) => m1 == m2 && a.equals(b.*),
      (Expr.Call(a), Expr.Call(b)) => a.equals(b),
      (Expr.SwitchIf(a), Expr.SwitchIf(b)) => a.equals(b),
      (Expr.Match(a), Expr.Match(b)) => a.equals(b),
      (Expr.Loop(a1, t1), Expr.Loop(a2, t2)) => a1.equals(a2) && t1.equals(t2),
      (Expr.Block(a1, t1), Expr.Block(a2, t2)) => a1.equals(a2) && t1.equals(t2),
      (Expr.Return(None), Expr.Return(None)) => true,
      (Expr.Return(Some(a)), Expr.Return(Some(b))) => a.equals(b.*),
      (Expr.Break(None), Expr.Break(None)) => true,
      (Expr.Break(Some(a)), Expr.Break(Some(b))) => a.equals(b.*),
      (Expr.Continue, Expr.Continue) => true,
      (Expr.FieldAccess(a1, i1), Expr.FieldAccess(a2, i2)) => a1 == a2 &&
      i1 == i2,
      _ => false,
    }
  }
}

impl FnCall {
  pub fn equals(self, other: FnCall) -> bool {
    self.fun == other.fun && self.args.equals(other.args)
  }
}

impl SwitchIf {
  pub fn equals(self, other: SwitchIf) -> bool {
    if self.cases.length() != other.cases.length() { return false }
    for i in 0..self.cases.length() {
      let (a1, a2) = self.cases[i]
      let (b1, b2) = other.cases[i]
      if !a1.equals(b1) || !a2.equals(b2) { return false }
    }
    true
  }
}

impl Match {
  pub fn equals(self, other: Match) -> bool {
    self.subject.equals(other.subject.*) && self.cases.equals(other.cases)
  }
}

impl MatchCase {
  pub fn equals(self, other: MatchCase) -> bool {
    self.pattern.equals(other.pattern) && self.expr.equals(other.expr)
  }
}
