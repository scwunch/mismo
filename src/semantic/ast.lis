import "mode"
import "span"

#[display]
#[json]
pub struct Expression {
  pub span: span.Span,
  pub kind: Expr,
}

#[display]
#[json]
pub enum Expr {
  Nil,
  BoolLiteral(bool),
  IntLiteral(int),
  FloatLiteral(float64),
  StringLiteral(string),
  ArrayLiteral(Slice<Expression>, Type),
  TupleLiteral(Slice<Expression>),
  Closure(Closure),
  Identifier(Ref<Variable>),
  Declare(mode.Mode, Ref<Variable>, Ref<Expression>),
  Assign(Ref<Variable>, Ref<Expression>),
  Binding(mode.Mode, Ref<Expression>),
  Call(FnCall),
  ConcreteCall(int, Slice<Expression>),
  SwitchIf(SwitchIf),
  Match(Match),
  Loop(Slice<Expression>, Type),
  Block(Slice<Expression>, Type),
  Return(Option<Ref<Expression>>),
  Break(Option<Ref<Expression>>),
  Continue,
  FieldAccess(Ref<Expression>, int),
  Constructor(Type, Slice<string>),
  Extern,
}

#[display]
#[json]
pub struct FnCall {
  pub fun: Ref<FunctionDef>,
  pub type_args: Slice<Type>,
  pub args: Slice<Expression>,
}

impl FnCall {
  pub fn new(
    fun: Ref<FunctionDef>,
    type_args: Slice<Type>,
    args: Slice<Expression>,
  ) -> FnCall {
    FnCall { fun, type_args, args }
  }
}

#[json]
pub struct Closure {
  pub env: Slice<Capture>,
  pub params: Slice<Parameter>,
  pub ret_type: Type,
  pub body: Ref<Expression>,
}

#[json]
pub struct Capture {
  pub mode: mode.Mode,
  pub variable: Ref<Variable>,
}

impl Closure {
  pub fn typ(self) -> Type {
    // let params = self.params.map(|p| ParamType{mode: p.mode, typ: p.typ})
    Type.Fn(self.params.map(Parameter.param_type), &self.ret_type)
  }

  pub fn call_mode(self) -> mode.Mode {
    self.env.fold(mode.Mode.Let, |acc, cap| acc.union(cap.mode))
  }

  pub fn is_movable(self) -> bool {
    self.env.all(|c| c.mode == mode.Mode.Var)
  }
}

#[json]
pub struct SwitchIf {
  pub cases: Slice<(Expression, Expression)>,
}

impl SwitchIf {
  pub fn new(cases: Slice<(Expression, Expression)>) -> SwitchIf {
    SwitchIf { cases }
  }
}

#[json]
pub struct Match {
  pub subject: Ref<Expression>,
  pub cases: Slice<MatchArm>,
}

impl Match {
  pub fn new(subject: Ref<Expression>, cases: Slice<MatchArm>) -> Match {
    Match { subject, cases }
  }
}

#[json]
pub struct MatchArm {
  pub pattern: Expression,
  pub expr: Expression,
}

impl MatchArm {
  pub fn new(pattern: Expression, expr: Expression) -> MatchArm {
    MatchArm { pattern, expr }
  }
}

impl Expression {
  pub fn new(span: span.Span, kind: Expr) -> Expression {
    Expression { span, kind }
  }

  pub fn blank() -> Expression {
    Expression.new(span.new(0, 0), Expr.Nil)
  }

  pub fn typ(self) -> Type {
    self.kind.typ()
  }
}

impl Expr {
  pub fn typ(self) -> Type {
    match self {
      Expr.Nil => Type.nil(),
      Expr.BoolLiteral(bool) => Type.Bool,
      Expr.IntLiteral(int) => Type.Int,
      Expr.FloatLiteral(float64) => Type.Float,
      Expr.StringLiteral(string) => Type.String,
      Expr.ArrayLiteral(_, typ) => typ,
      Expr.TupleLiteral(exprs) => Type.Tuple(exprs.map(|e| e.typ())),
      Expr.Closure(closure) => closure.typ(),
      Expr.Identifier(id) => id.typ,
      Expr.Declare(_, _, _) => Type.nil(),
      Expr.Assign(id, _) => id.typ,
      Expr.Binding(_, expr) => expr.typ(),
      Expr.Call(call) => call.fun.return_type,
      Expr.SwitchIf(cases) => cases.cases[0].1.typ(),
      Expr.Match(cases) => cases.cases[0].expr.typ(),
      Expr.Loop(_, typ) => typ,
      Expr.Block(_, typ) => typ,
      Expr.Return(_) => Type.Never,
      Expr.Break(_) => Type.Never,
      Expr.Continue => Type.Never,
      Expr.FieldAccess(obj, i) => match obj.typ() {
        Type.Adt(def, args) => match def.kind {
          TypeKind.Struct(fields) => fields[i].typ.substitute(args),
          TypeKind.Enum(_) => panic("compiler bug 71: FieldAccess on enum"),
        },
        _ => panic("compiler bug 73: FieldAccess on non-ADT"),
      },
      Expr.ConcreteCall(_, _) => panic(
        "compiler bug 75: concrete call should never have 'type' method called on it",
      ),
      Expr.Constructor(typ, _) => typ,
      Expr.Extern => Type.Never,
    }
  }
}
