import "cst"
import "errors"
import "mode"
import "span"
import "testing"

pub fn test_typecheck() {
  let _ = testing.test_suite("Type Check", [test_dummy])
}

fn test_dummy(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "dummy"
  t.should_eq(Type.Nil, Type.Nil)?
  t.should_eq_repr("value", "value")?
  t.should_be_true(true, "expected true")?
  Ok(())
}
