  fn check_array(self, array_span: span.Span, elems: Slice<ast.Expression>, expected: ty.Type, type_span: span.Span) -> Result<ir.Expr, dx.TypeError> {
    let ty.Type.Array(expected) = expected else {
      return Err(dx.TypeMismatchError.new(type_span, f"{expected}", "Array", array_span))
    }
    let elem_type = expected.*
    let elems = slice.map_result(elems, |expr| self.check(expr, elem_type, type_span))?

    Ok(ir.Expr.ArrayLiteral(elems, elem_type))
  }

  fn infer_closure(self, closure: ast.Closure) -> Result<ir.Expr, dx.TypeError> {
    let body = self.infer_block(closure.body, &LUB.new())?
    Ok(ir.Expr.Closure(ir.Closure { env: closure.env, params: closure.params, ret_type: body.typ, body }))
    // Ok(Expression.new(span, Expr.Closure(closure)))
  }

  fn assign(self, target: Ref<ty.Variable>, value: Ref<ast.Expression>) -> Result<ir.Expr, dx.TypeError> {
    let value = self.check(value.*, target.typ, span.new(target.init, target.init))?
    Ok(ir.Expr.Assign(target, &value))
  }

  fn assign_cap(self, target: Ref<ty.Variable>, value: Ref<ast.Expression>) -> Result<ir.Expr, dx.TypeError> {
    let value = self.check(value.*, target.typ, span.new(target.init, target.init))?
    Ok(ir.Expr.AssignCapture(target, &value))
  }

  fn check_if(self, cond: ast.If, expected: ty.Type, type_span: span.Span) -> Result<ir.If, dx.TypeError> {
    let checks = slice.map_result(cond.checks, |chk| self.check_check(chk, expected, type_span))?
    let default = match cond.default {
      None if !expected.equals(ty.nil()) => {
        panic("raise a 'MissingElseBlock' error")
      },
      None => None,
      Some(block) => Some(self.check_block(block, expected, type_span)?),
    }
    Ok(ir.If.new(checks, default, expected))
  }

  fn check_check(self, check: ast.Check, expected: ty.Type, type_span: span.Span) -> Result<ir.Check, dx.TypeError> {
    match check {
      Test(expr, blk) => {
        let test = self.infer(expr)?
        if !test.typ().equals(ty.Type.Bool) {
          panic("TypeError: condition should be boolean")
        }
        let blk = self.check_block(blk, expected, type_span)?
        Ok(ir.Check.Test(test, blk))
      },
      Match(subj, arms) => {
        let subj = self.infer(subj)?
        let arms = slice.map_result(arms, |arm| self.check_arm(arm, expected, type_span))?
        Ok(ir.Check.Match(subj, arms))
      }
    }
  }

  fn check_arm(self, arm: ast.Arm, expected: ty.Type, type_span: span.Span) -> Result<ir.Arm, dx.TypeError> {
    // TODO: this should be upgraded to `self.pattern(arm.pattern, pattern_type)`
    let pattern = self.infer(arm.pattern)?
    let then = match arm.then {
      Block(blk) => ir.Then.Block(self.check_block(blk, expected, type_span)?),
      If(cond) => ir.Then.If(self.check_if(cond, expected, type_span)?),
    }
    Ok(ir.Arm{pattern, then})
  }

  fn infer_if_node(self, cond: ast.If) -> Result<ir.Expr, dx.TypeError> {
    let lub = &LUB.new()
    let cond = self.infer_if(cond, lub)?
    Ok(ir.Expr.If(cond, lub.ty))
  }

  fn infer_if(self, cond: ast.If, lub: Ref<LUB>) -> Result<ir.If, dx.TypeError> {
    let checks = slice.map_result(cond.checks, |chk| self.infer_check(chk, lub))?
    match cond.default {
      None => match lub.ty {
        Tuple([]) |
        Never => Ok(ir.If.new(checks, None, ty.nil())),
        _ => panic("raise 'missing `else` block' error"),
      },
      Some(blk) => {
        let blk = self.infer_block(blk, lub)?
        Ok(ir.If.new(checks, Some(blk), lub.ty))
      }
    }
  }

  fn infer_check(self, check: ast.Check, lub: Ref<LUB>) -> Result<ir.Check, dx.TypeError> {
    match check {
      Test(expr, blk) => {
        let test = self.infer(expr)?
        if !test.typ().equals(ty.Type.Bool) {
          panic("TypeError: condition should be boolean")
        }
        let blk = self.infer_block(blk, lub)?
        Ok(ir.Check.Test(test, blk))
      },
      Match(subj, arms) => {
        let subj = self.infer(subj)?
        let arms = slice.map_result(arms, |arm| self.infer_arm(arm, lub))?
        Ok(ir.Check.Match(subj, arms))
      }
    }
  }

  fn infer_arm(self, arm: ast.Arm, lub: Ref<LUB>) -> Result<ir.Arm, dx.TypeError> {
    // TODO: this should be upgraded to `self.pattern(arm.pattern, pattern_type)`
    let pattern = self.infer(arm.pattern)?
    let then = match arm.then {
      Block(blk) => ir.Then.Block(self.infer_block(blk, lub)?),
      If(cond) => ir.Then.If(self.infer_if(cond, lub)?),
    }
    Ok(ir.Arm{pattern, then})
  }

