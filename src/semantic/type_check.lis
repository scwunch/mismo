import "cst"
import dx "diagnostics"
import "mode"
import "operator"
import "span"
import "utils/slice"

pub struct TypeCheck {
  env: TypeContext,
  next_var: Ref<int>,
  return_type: Type,
  bindings: Ref<List<Ref<Variable>>>,
}

impl TypeCheck {
  fn new(env: Ref<TypeEnv>, func: FunctionDef) -> TypeCheck {
    let zero = 0
    let mut scope = &List.Nil
    for param in func.parameters {
      let v = &Variable.from_param(param)
      scope = &List.Cons(v, scope)
    }
    TypeCheck { 
      env: env.type_context(func.type_parameters),
      next_var: &zero,
      return_type: func.return_type,
      bindings: scope,
    }
  }

  fn new_blank() -> TypeCheck {
    let env = &TypeEnv.new()
    let dummy = FunctionDef.mock("dummy", [], [], Type.Tuple([]))
    TypeCheck.new(env, dummy)
  }
}

pub enum List<T> {
  Nil,
  Cons(T, Ref<List<T>>),
}

impl List<Ref<Variable>> {
  fn get(self, name: string) -> Option<Ref<Variable>> {
    let mut current = self
    while let List.Cons(binding, next) = current {
      if binding.name == name { return Some(binding) }
      current = next.*
    }
    None
  }
}

impl TypeCheck {
  fn get(self, name: string) -> Option<Ref<Variable>> {
    let mut current = self.bindings.*
    while let List.Cons(binding, next) = current {
      if binding.name == name { return Some(binding) }
      current = next.*
    }
    None
  }
}

impl TypeCheck {
  fn check(self, expr: cst.Expression, expected: Type) -> Result<Expression, dx.TypeError> {
    let actual = self.infer(expr)?
    if !actual.typ().assignable_to(expected) {
      return Err(dx.TypeMismatchError.new(
        actual.span,
        expected.string(),
        actual.typ().string(),
      ))
    }
    Ok(actual)
  }

  fn infer(self, node: cst.Expression) -> Result<Expression, dx.TypeError> {
    let expr: Expr = match node.kind {
      Nil => Expr.Nil,
      BoolLiteral(b) => Expr.BoolLiteral(b),
      IntLiteral(i) => Expr.IntLiteral(i),
      FloatLiteral(f) => Expr.FloatLiteral(f),
      StringLiteral(s) => Expr.StringLiteral(s),
      ArrayLiteral(elems) => self.array(elems, node.span)?,
      TupleLiteral(elems) => Expr.TupleLiteral(
        slice.map_result(elems, self.infer)?,
      ),
      Identifier(path) => if path.namespace.is_empty() {
        match self.get(path.name) {
          Some(varid) => Expr.Identifier(varid),
          None => return Err(dx.MissingNameError.new(path.name, node.span)),
        }
      } else {
        panic("TODO: implement TypeCheck.resolve_path(Path)")
      },
      Binding(m, expr) => {
        let e = self.infer(expr.*)?
        Expr.Binding(m, &e)
      },
      Binop(binop) => self.binop(binop.*, node.span)?,
      Call(call) => self.call(
        call.fn_name,
        slice.map_result(call.type_args.unwrap_or([]), self.env.eval_type)?,
        slice.map_result(call.args, self.infer)?,
        node.span,
      )?,
      If(cond) => self.if_expr(cond, node.span)?,
      While(cond) => self.while_expr(cond, node.span)?,
      For(for_loop) => self.for_expr(for_loop.*, node.span)?,
      Block(exprs) => self.block(exprs, node.span)?,
      Neg(expr) => self.call(
        cst.Path.name_("neg"),
        [],
        [self.infer(expr.*)?],
        node.span,
      )?,
      Not(expr) => self.call(
        cst.Path.name_("not"),
        [],
        [self.infer(expr.*)?],
        node.span,
      )?,
      Return(None) => Expr.Return(None),
      Return(Some(expr)) => {
        let e = self.infer(expr.*)?
        Expr.Return(Some(&e))
      },
      Break(None) => Expr.Break(None),
      Break(Some(expr)) => {
        let e = self.infer(expr.*)?
        Expr.Break(Some(&e))
      },
      Continue => Expr.Continue,
      DotName(expr, name) => self.dot_name(self.infer(expr.*)?, name, node.span)?,
      DotCall(expr, call) => self.call(
        call.fn_name,
        slice.map_result(call.type_args.unwrap_or([]), self.env.eval_type)?,
        [self.infer(expr.*)?].append(slice.map_result(call.args, self.infer)?...),
        node.span,
      )?,
      TypeDotCall(path, type_args, call) => self.type_dot_call(
        path,
        slice.map_result(type_args, self.env.eval_type)?,
        call,
        node.span,
      )?,
      Extern => Expr.Extern,
    }
    Ok(Expression { span: node.span, kind: expr })
  }

  fn block(self, exprs: Slice<cst.Expression>, span: span.Span) -> Result<Expr, dx.TypeError> {
    let mut self = self
    if exprs.is_empty() { return Ok(Expr.Nil) }
    let mut expressions = []
    let mut types = []
    for node in exprs {
      let expr = self.infer(node)?
      expressions = expressions.append(expr)
      match expr.kind {
        Expr.Assign(varid, _) => self.bindings = &List.Cons(
          varid,
          self.bindings,
        ),
        Expr.Return(opt_expr) => {
          let actual = opt_expr.map(|e| e.typ()).unwrap_or(Type.Tuple([]))
          if !self.return_type.equals(actual) {
            return Err(dx.TypeMismatchError.new(
              span,
              f"{self.return_type}",
              f"{actual}",
            ))
          }
        },
        Expr.Break(opt_expr) => {
          let ty = opt_expr.map(|e| e.typ()).unwrap_or(Type.Tuple([]))
          types = types.append(ty)
        },
        _ => (),
      }
    }
    types = types.append(expressions[expressions.length() - 1].typ())
    let expr = Expr.Block(expressions, types[0])
    Ok(expr)
  }

  fn array(self, elems: Slice<cst.Expression>, span: span.Span) -> Result<Expr, dx.TypeError> {
    if elems.is_empty() { return Err(dx.EmptyArrayLiteralError.new(span)) }
    let inferred = slice.map_result(elems, self.infer)?

    let mut elem_type = inferred[0].typ()
    for elem in inferred {
      match elem.typ().least_upper_bound(elem_type) {
        Some(t) => elem_type = t,
        None => {
          let types = inferred.map(|e| f"{e.typ()}").join(", ")
          return Err(dx.HeterogeneousArrayLiteralError.new(span, types))
        },
      }
    }

    Ok(Expr.ArrayLiteral(inferred, elem_type))
  }

  fn binop(self, binop: cst.Binop, span: span.Span) -> Result<Expr, dx.TypeError> {
    if binop.op == operator.Operator.Assign {
      let value = self.infer(binop.right)?
      let value = &value
      self.assign(binop.left, value)
    } else {
      self.call(
        cst.Path.name_(binop.op.sigil()),
        [],
        [self.infer(binop.left)?, self.infer(binop.right)?],
        span,
      )
    }
  }

  fn assign(self, lhs: cst.Expression, value: Ref<Expression>) -> Result<Expr, dx.TypeError> {
    match lhs.kind {
      Binding(mode, expr) => match expr.kind {
        Identifier(path) if path.namespace.is_empty() => {
          return Ok(Expr.Declare(
            mode,
            &Variable.new(mode, path.name, value.typ(), lhs.span.start),
            value,
          ))
        },
        _ => (),
      },
      Identifier(path) if path.namespace.is_empty() => {
        return match self.get(path.name) {
          Some(varid) => Ok(Expr.Assign(varid, value)),
          None => Err(dx.MissingNameError.new(path.name, lhs.span)),
        }
      },
      // TODO: destructuring assignment
      // (x, y) = (a, b)
      // Foo{x} = foo
      _ => (),
    }
    Err(dx.InvalidAssignmentTargetError.new(lhs.span, lhs))
  }

  fn if_expr(self, cond: cst.Conditional, span: span.Span) -> Result<Expr, dx.TypeError> {
    let _ = cond
    let _ = span
    panic("not implemented yet")
  }

  fn while_expr(self, cond: cst.Conditional, span: span.Span) -> Result<Expr, dx.TypeError> {
    let _ = cond
    let _ = span
    panic("not implemented yet")
  }

  fn for_expr(self, for_loop: cst.ForLoop, span: span.Span) -> Result<Expr, dx.TypeError> {
    let _ = for_loop
    let _ = span
    panic("not implemented yet")
  }

  fn dot_name(self, expr: Expression, name: string, span: span.Span) -> Result<Expr, dx.TypeError> {
    let typ = expr.typ()
    if let Type.Adt(def, args) = typ {
      if let TypeKind.Struct(fields) = def.kind {
        for (i, field) in fields.enumerate() {
          if field.name == name { return Ok(Expr.FieldAccess(&expr, i)) }
        }
      }
    }
    self.call(cst.Path.name_(name), [], [expr], span)
  }

  fn type_dot_call(
    self,
    type_path: cst.Path,
    type_args: Slice<Type>,
    call: cst.Call,
    span: span.Span,
  ) -> Result<Expr, dx.TypeError> {
    let type_args = match call.type_args {
      Some(extra_type_args) => {
        let extra = slice.map_result(extra_type_args, self.env.eval_type)?
        type_args.append(extra...)
      },
      None => type_args,
    }
    let args = slice.map_result(call.args, self.infer)?
    // TODO: add module resolution here too
    let Some(type_def) = self.env.env.type_defs.get(type_path.name) else {
      return Err(dx.MissingNameError.new(type_path.name, span))
    }
    resolve_overload(
      type_def.signatures,
      call.fn_name.name,
      type_args,
      args,
      span,
    )
  }

  fn call(
    self,
    fname: cst.Path,
    type_args: Slice<Type>,
    args: Slice<Expression>,
    span: span.Span,
  ) -> Result<Expr, dx.TypeError> {
    if type_args.is_empty() && fname.namespace.is_empty() {
      let local_funs = self.get_local_functions(fname.name)
      for fun in local_funs {
        if let Type.Fn(params, _) = fun.typ {
          if args.length() != params.length() { break }
          if slice
            .zip(args, params)
            .all(|arg_param| {
              !arg_param.0.typ().assignable_to(arg_param.1.typ)
            }) {
            break
          }
          panic(
            f"Found local function match, but I don't know what to do with it: {fun}",
          )
        }
      }
    }
    if !type_args.is_empty() { panic("TODO: handle explicit type args yet") }
    let mut module = self.env.env.*
    if !fname.namespace.is_empty() { module = module.get_module(span, fname)? }
    resolve_overload(module.signatures, fname.name, type_args, args, span)
  }

  fn get_local_functions(self, fname: string) -> Slice<Ref<Variable>> {
    let mut funs = []
    let mut scope = self.bindings.*
    while let List.Cons(varid, rest) = scope {
      if varid.name == fname {
        if let Type.Fn(_, _) = varid.typ { funs = funs.append(varid) }
      }
      scope = rest.*
    }
    funs
  }
}

pub struct Variable {
  pub mode: mode.Mode,
  pub name: string,
  typ: Type,
  init: uint32,
  consumed: Option<uint32>,
}

impl Variable {
  fn from_param(param: Parameter) -> Variable {
    Variable { 
      mode: param.mode,
      name: param.name,
      typ: param.typ,
      init: param.span.start,
      consumed: None,
    }
  }

  fn new(mode: mode.Mode, name: string, typ: Type, init: uint32) -> Variable {
    Variable { mode, name, typ, init, consumed: None }
  }
}

enum OverloadCandidate {
  Ok(FnCall),
  Err(Ref<FunctionDef>, dx.TypeError),
}

fn try_match_candidate(
  fun: Ref<FunctionDef>,
  args: Slice<Expression>,
  span: span.Span,
) -> OverloadCandidate {
  if fun.parameters.length() != args.length() {
    return OverloadCandidate.Err(
      fun,
      dx.ArgArityError.new(
        span,
        fun.name,
        fun.parameters.length(),
        args.length(),
      ),
    )
  }
  let mut bindings = fun.type_parameters.map(|_| Type.Var(-1))
  for (param, arg) in slice.zip(fun.parameters, args) {
    if let Err(e) = match_types(param.typ, arg.typ(), bindings, span) {
      return OverloadCandidate.Err(fun, e)
    }
  }
  for (i, t) in bindings.enumerate() {
    if let Type.Var(-1) = t {
      return OverloadCandidate.Err(
        fun,
        dx.UnboundTypeParamError.new(span, fun.type_parameters[i].name),
      )
    }
  }
  OverloadCandidate.Ok(FnCall { fun, type_args: bindings, args })
}

// Updates bindings and returns Ok if the arg type matches the param type, Err if no match
fn match_types(
  param: Type,
  arg: Type,
  mut bindings: Slice<Type>,
  span: span.Span,
) -> Result<(), dx.TypeError> {
  if let Type.Var(idx) = param {
    match bindings[idx] {
      Type.Var(-1) => {
        bindings[idx] = arg
        Ok(())
      },
      existing => if existing.equals(arg) {
        Ok(())
      } else {
        Err(dx.DoubleTypeArgBoundError.new(span, idx, f"{existing}", f"{arg}"))
      },
    }
  } else {
    if param.constructor_and_arity_eq(arg) {
      for (p, a) in slice.zip(param.type_args(), arg.type_args()) {
        match_types(p, a, bindings, span)?
      }
      Ok(())
    } else {
      Err(dx.TypeMismatchError.new(span, f"{param}", f"{arg}"))
    }
  }
}

fn resolve_overload(
  signatures: Map<string, Slice<Ref<FunctionDef>>>,
  fname: string,
  type_args: Slice<Type>,
  args: Slice<Expression>,
  span: span.Span,
) -> Result<Expr, dx.TypeError> {
  let _ = type_args
  // TODO: if type_args present, use them!
  let candidates = match signatures.get(fname) {
    None => return Err(dx.MissingNameError.new(fname, span)),
    Some(funs) => funs.map(|fun| try_match_candidate(fun, args, span)),
  }
  let mut matches = []
  for cand in candidates {
    if let OverloadCandidate.Ok(call) = cand { matches = matches.append(call) }
  }
  let maximal = matches.filter(|call| {
    !matches.any(|other| other.fun.better_than(call.fun.*))
  })
  match maximal {
    [call] => Ok(Expr.Call(call)),
    _ => if matches.is_empty() {
      Err(dx.NoMatchError.new(
        span,
        candidates.map(|fun| match fun {
          Err(def, e) => (def.signature(), e),
          Ok(_) => panic("unreachable"),
        }),
      ))
    } else {
      Err(dx.AmbiguousFunctionCallError.new(span, maximal.map(|m| f"{m}")))
    },
  }
}

pub fn ref<T>(self: T) -> Ref<T> {
  &self
}

pub fn ngeh<T>(self: T) -> T {
  self
}
