import "ast"
import "ir"
import dx "diagnostics"
import "ty"
import "span"
import "utils/slice"

pub struct TypeCheck {
  function: Ref<ast.FunctionDef>,
}

impl TypeCheck {
  fn new(function: Ref<ast.FunctionDef>) -> TypeCheck {
    TypeCheck { function }
  }

  pub fn new_blank() -> TypeCheck {
    let dummy = &ast.FunctionDef.mock("dummy", [], [], ty.nil())
    TypeCheck.new(dummy)
  }
}

impl TypeCheck {
  fn check(self, node: ast.Expression, expected: ty.Type, src_span: span.Span) -> Result<ir.Expression, dx.TypeError> {
    let expr: ir.Expr = match node.kind {
      ArrayLiteral(elems) => self.check_array(node.span, elems, expected, src_span)?,
      TupleLiteral(elems) => self.check_tuple(node.span, elems, expected, src_span)?,
      If(cond) => ir.Expr.If(self.check_if(cond, expected, src_span)?, expected),
      _ => {
        let actual = self.infer(node)?
        if !actual.typ().assignable_to(expected) {
          return Err(dx.TypeMismatchError.new(
            src_span,
            expected.string(),
            actual.typ().string(),
            actual.span,
          ))
        }
        return Ok(actual)
      },
    }
    Ok(ir.Expression{span: node.span, kind: expr})
  }

  fn check_tuple(self, tuple_span: span.Span, elems: Slice<ast.Expression>, expected: ty.Type, type_span: span.Span) -> Result<ir.Expr, dx.TypeError> {
    let ty.Type.Tuple(expected_types) = expected else {
      return Err(dx.TypeMismatchError.new(type_span, f"{expected}", "Tuple", tuple_span))
    }
    if elems.length() != expected_types.length() {
      return Err(dx.TypeMismatchError.new(type_span, f"{expected}", f"{elems.length()}-tuple", tuple_span))
    }
    let elems = slice.map_result(
      slice.zip(elems, expected_types),
      |(expr, typ)| self.check(expr, typ, type_span)
    )?
    Ok(ir.Expr.TupleLiteral(elems))
  }

  fn infer(self, node: ast.Expression) -> Result<ir.Expression, dx.TypeError> {
    let expr: ir.Expr = match node.kind {
      Nil => ir.Expr.Nil,
      BoolLiteral(b) => ir.Expr.BoolLiteral(b),
      IntLiteral(i) => ir.Expr.IntLiteral(i),
      FloatLiteral(f) => ir.Expr.FloatLiteral(f),
      StringLiteral(s) => ir.Expr.StringLiteral(s),
      ArrayLiteral(elems) => self.infer_array(elems, node.span)?,
      TupleLiteral(elems) => ir.Expr.TupleLiteral(
        slice.map_result(elems, self.infer)?,
      ),
      Closure(closure) => self.infer_closure(closure)?,
      Declare(m, varid, expr) => {
        let expr = self.infer(expr.*)?
        varid.typ = expr.typ()
        ir.Expr.Declare(m, varid, &expr)
      },
      Assign(varid, expr) => self.assign(varid, expr)?,
      AssignCapture(varid, expr) => self.assign_cap(varid, expr)?,
      Identifier(varid) => ir.Expr.Identifier(varid),
      CapturedIdent(varid) => ir.Expr.CapturedIdent(varid),
      Binding(m, expr) => {
        let e = self.infer(expr.*)?
        ir.Expr.Binding(m, &e)
      },
      Call(call) => self.infer_call(call, node.span)?,
      If(cond) => self.infer_if_node(cond)?,
      While(cond) => self.while_expr(cond, node.span)?,
      For(for_loop) => self.for_expr(for_loop, node.span)?,
      Block(block) => self.infer_block_node(block)?,
      Return(opt_expr) => self.infer_return(opt_expr, node.span)?,
      Break(None) => ir.Expr.Break(None),
      Break(Some(expr)) => {
        let e = self.infer(expr.*)?
        ir.Expr.Break(Some(&e))
      },
      Continue => ir.Expr.Continue,
      BareConstructor(str, args) => panic("TODO"),
      StructConstructor(typ, args) => panic("TODO"),
      EnumConstructor(variant, args) => panic("TODO"),
      Extern => ir.Expr.Extern,
    }
    Ok(ir.Expression { span: node.span, kind: expr })
  }

  fn infer_return(self, expr: Option<Ref<ast.Expression>>, span: span.Span) -> Result<ir.Expr, dx.TypeError> {
    match (expr, self.function.return_type) {
      (None, Tuple([])) => Ok(ir.Expr.Return(None)),
      (None, _) => Err(dx.TypeMismatchError.new(self.function.span, f"{self.function.return_type}", "Nil", span)),
      (Some(expr), _) => {
        let expr = self.check(expr.*, self.function.return_type, self.function.span)?
        Ok(ir.Expr.Return(Some(&expr)))
      },
    }
  }

  fn infer_block_node(self, block: ast.Block) -> Result<ir.Expr, dx.TypeError> {
    let lub = &LUB.new()
    let blk = self.infer_block(block, lub)?
    Ok(ir.Expr.Block(blk))
  }

  fn infer_block(self, block: ast.Block, lub: Ref<LUB>) -> Result<ir.Block, dx.TypeError> {
    let statements = slice.map_result(block.statements, |node| self.infer(node))?
    lub.unify(statements[statements.length() - 1])?
    Ok(ir.Block.new(statements, lub.ty))
    // let mut types = []
    // let mut statements = []
    // for node in block.statements {
    //   let expr = self.infer(node)?
    //   statements = statements.append(expr)
    //   if let ir.Expr.Break(opt_expr) = expr.kind {
    //     let ty = opt_expr.map(|e| e.typ()).unwrap_or(ty.nil())
    //     types = types.append(ty)
    //   }
    // }
    // types = types.append(statements[statements.length() - 1].typ())
    // let ty = types.fold(Ok(types[0]), |t1, t2| {
    //   match t1 {
    //     Ok(t) if !t.equals(t2) => Err(dx.TypeMismatchError.new(
    //       block.span(),
    //       f"{t1}",
    //       f"{t2}",
    //       block.span()
    //     )),
    //     _ => t1,
    //   }
    // })
  }

  fn check_block(self, block: ast.Block, expected: ty.Type, src_span: span.Span) -> Result<ir.Block, dx.TypeError> {
    let len = block.statements.length()
    let mut statements = slice.map_result(block.statements[..len-2], |stmt| {
      let expr = self.infer(stmt)?
      if expr.typ().equals(ty.nil()) {
        Ok(expr)
      } else {
        Err(dx.UnusedValueError.new(expr.span))
      }
    })?
    // let mut statements = slice.map_result(block.statements[..len-1], |stmt| {
    //   match stmt.kind {
    //     Break(Some(expr)) => {
    //       let expr = self.check(expr.*, expected)?
    //       Ok(ir.Expression{span: stmt.span, kind: ir.Expr.Break(Some(&expr))})
    //     },
    //     _ =>         self.check(stmt, ty.nil())
    //   }
    // })?
    statements = statements.append(self.check(block.statements[len-1], expected, src_span)?)
    Ok(ir.Block.new(statements, expected))
  }

  fn infer_array(self, elems: Slice<ast.Expression>, span: span.Span) -> Result<ir.Expr, dx.TypeError> {
    if elems.is_empty() { return Err(dx.EmptyArrayLiteralError.new(span)) }
    let inferred = slice.map_result(elems, self.infer)?
    let mut lub = LUB.new()
    for expr in inferred {
      lub.unify(expr)?
      // if let Err(e) = lub.unify(expr) {
      //   return Err(dx.HeterogeneousArrayLiteralError.new(span, types.map(|e| f"{e}").join(", ")))
      // }
    }
    Ok(ir.Expr.ArrayLiteral(inferred, lub.ty))
  }

