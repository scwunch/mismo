fn resolve_overload(
  local_candidates: Slice<Ref<ty.Variable>>,
  global_candidates: Slice<Ref<ast.FunctionDef>>,
  args: Slice<ir.Expression>,
  span: span.Span,
) -> Result<ir.Call, dx.TypeError> {
  if !local_candidates.is_empty() {
    panic("local_candidates not handled yet in overload resolution")
  }
  // TODO: if type_args present, use them!
  let candidates = global_candidates.map(|fun| try_match_candidate(fun, args, span))
  let mut matches = []
  for cand in candidates {
    if let OverloadCandidate.Ok(call) = cand { matches = matches.append(call) }
  }
  let maximal = matches.filter(|call| {
    !matches.any(|other| other.fun.better_than(call.fun.*))
  })
  match maximal {
    [call] => Ok(call),
    _ => if matches.is_empty() {
      Err(dx.NoMatchError.new(
        span,
        candidates.map(|fun| match fun {
          Err(def, e) => (def.signature(), e),
          Ok(_) => panic("unreachable"),
        }),
      ))
    } else {
      Err(dx.AmbiguousFunctionCallError.new(span, maximal.map(|m| f"{m}")))
    },
  }
}

enum OverloadCandidate {
  Ok(ir.Call),
  Err(Ref<ast.FunctionDef>, dx.TypeError),
}

fn try_match_candidate(
  fun: Ref<ast.FunctionDef>,
  args: Slice<ir.Expression>,
  span: span.Span,
) -> OverloadCandidate {
  if fun.parameters.length() != args.length() {
    return OverloadCandidate.Err(
      fun,
      dx.ArgArityError.new(
        span,
        fun.name,
        fun.parameters.length(),
        args.length(),
      ),
    )
  }
  let mut bindings = fun.type_parameters.map(|_| ty.Type.Var(-1))
  for (param, arg) in slice.zip(fun.parameters, args) {
    if let Err(e) = match_types(param.typ, arg.typ(), bindings, span) {
      return OverloadCandidate.Err(fun, e)
    }
  }
  for (i, t) in bindings.enumerate() {
    if let ty.Type.Var(-1) = t {
      return OverloadCandidate.Err(
        fun,
        dx.UnboundTypeParamError.new(span, fun.type_parameters[i].name),
      )
    }
  }
  OverloadCandidate.Ok(ir.Call { fun, type_args: bindings, args })
}

/// Updates bindings and returns Ok if the arg type matches the param type, Err if no match
fn match_types(
  param: ty.Type,
  arg: ty.Type,
  mut bindings: Slice<ty.Type>,
  span: span.Span,
) -> Result<(), dx.TypeError> {
  if let ty.Type.Var(idx) = param {
    match bindings[idx] {
      ty.Type.Var(-1) => {
        bindings[idx] = arg
        Ok(())
      },
      existing => if existing.equals(arg) {
        Ok(())
      } else {
        Err(dx.DoubleTypeArgBoundError.new(span, idx, f"{existing}", f"{arg}"))
      },
    }
  } else {
    if param.constructor_and_arity_eq(arg) {
      for (p, a) in slice.zip(param.type_args(), arg.type_args()) {
        match_types(p, a, bindings, span)?
      }
      Ok(())
    } else {
      // TODO: the second span should be the span of the parameter
      Err(dx.TypeMismatchError.new(span, f"{param}", f"{arg}", span))
    }
  }
}

// interface Folder<A,T> {
//   fn fold(self, accumulator: A, f: fn(A, T)->A) -> A
// }

/// Least Upper Bound
struct LUB {
  span: span.Span,
  ty: ty.Type,
}
impl LUB {
  fn new() -> LUB {
    LUB{ty: ty.Type.Never, ..}
  }

  fn unify(self: Ref<LUB>, expr: ir.Expression) -> Result<(), dx.TypeError> {
    match (expr.typ(), self.ty) {
      (Never, _) => (),
      (ty, Never) => {
        self.ty = ty
        self.span = expr.span
      },
      (ty, _) => match self.ty.least_upper_bound(ty) {
        Some(t) => self.ty = t,
        None => return Err(dx.TypeMismatchError.new(
          self.span,
          f"{self.ty}",
          f"{expr.typ()}",
          expr.span
        )),
      }
    }
    Ok(())
  }
}
