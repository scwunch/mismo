import "ast"
import "ir"
import dx "diagnostics"
import "mode"
import "ty"
import "operator"
import "span"
import "utils/slice"

pub struct TypeCheck {
  env: Ref<ast.Registry>,
  function: Ref<ast.FunctionDef>,
}

impl TypeCheck {
  fn new(env: Ref<ast.Registry>, function: Ref<ast.FunctionDef>) -> TypeCheck {
    TypeCheck {
      env,
      function,
    }
  }

  pub fn new_blank() -> TypeCheck {
    let env = &ast.Registry.new()
    let dummy = &ast.FunctionDef.mock("dummy", [], [], ty.nil())
    TypeCheck.new(env, dummy)
  }
}

impl TypeCheck {
  fn check(self, expr: ast.Expression, expected: ty.Type, src_span: span.Span) -> Result<ir.Expression, dx.TypeError> {
    let actual = self.infer(expr)?
    if !actual.typ().assignable_to(expected) {
      return Err(dx.TypeMismatchError.new(
        src_span,
        expected.string(),
        actual.typ().string(),
        actual.span,
      ))
    }
    Ok(actual)
  }

  fn infer(self, node: ast.Expression) -> Result<ir.Expression, dx.TypeError> {
    let _ = node
    panic("")
  }

