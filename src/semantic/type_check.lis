  fn infer_call(self, call: ast.Call, span: span.Span) -> Result<ir.Expr, dx.TypeError> {
    if let Some(field) = call.field {
      match (call.args, call.type_args) {
        ([obj], None) => if let Some(expr) = self.field_access(self.infer(obj)?, field) {
          return Ok(expr)
        },
        _ => panic("invalid `dotname` Call"),
      }
    }
    let args = slice.map_result(call.args, self.infer)?
    let call = match call.type_args {
      Some(type_args) => panic("explicit type args not handled yet"),
      None => resolve_overload(call.local_candidates, call.global_candidates, args, span)?,
    }
    Ok(ir.Expr.Call(call))
  }

  fn field_access(self, obj: ir.Expression, field_name: string) -> Option<ir.Expr> {
    let ty.Type.Adt(type_def, _) = obj.typ() else {
      return None
    }
    let ty.TypeKind.Struct(fields) = type_def.kind else {
      return None
    }
    for (i, field) in fields.enumerate() {
      if field.name == field_name {
        return Some(ir.Expr.FieldAccess(&obj, i))
      }
    }
    None
  }

