import "cst"
import "mode"
import "span"
import "utils/slice"

pub struct TypeDef {
  pub span: span.Span,
  pub name: string,
  pub type_parameters: Slice<TypeParameter>,
  pub kind: TypeKind,
}

pub enum TypeKind {
  Struct(Slice<Field>),
  Enum(Slice<Variant>),
}

pub struct TypeParameter {
  pub span: span.Span,
  pub name: string,
}

pub struct Field {
  pub span: span.Span,
  pub name: string,
  pub typ: Type,
}

pub struct Variant {
  pub span: span.Span,
  pub name: string,
  pub fields: Slice<Type>,
}

pub struct FunctionDef {
  pub span: span.Span,
  pub name: string,
  pub type_parameters: Slice<TypeParameter>,
  pub parameters: Slice<Parameter>,
  pub return_type: Type,
  pub body: cst.Expression,
}

pub struct Parameter {
  pub span: span.Span,
  pub mode: mode.Mode,
  pub name: string,
  pub typ: Type,
}

impl TypeDef {
  pub fn new(
    span: span.Span,
    name: string,
    type_parameters: Slice<TypeParameter>,
    kind: TypeKind,
  ) -> TypeDef {
    TypeDef { span, name, type_parameters, kind }
  }
}

impl FunctionDef {
  pub fn new(
    span: span.Span,
    name: string,
    type_parameters: Slice<TypeParameter>,
    parameters: Slice<Parameter>,
    return_type: Type,
    body: cst.Expression,
  ) -> FunctionDef {
    FunctionDef { span, name, type_parameters, parameters, return_type, body }
  }

  fn better_than(self: FunctionDef, other: FunctionDef) -> bool {
    let pairs = slice.zip(self.parameters, other.parameters)
    pairs.all(|p| p.0.typ.specificity_ge(p.1.typ)) &&
    pairs.any(|p| p.0.typ.specificity_gt(p.1.typ))
  }
}
