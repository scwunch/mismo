import "mode"
import "span"

fn nil_expr() -> Expression {
  Expression { span: span.new(0, 0), kind: Expr.Nil }
}

fn bool_expr(val: bool) -> Expression {
  Expression { span: span.new(0, 0), kind: Expr.BoolLiteral(val) }
}

fn int_expr(val: int) -> Expression {
  Expression { span: span.new(0, 0), kind: Expr.IntLiteral(val) }
}

fn float_expr(val: float64) -> Expression {
  Expression { span: span.new(0, 0), kind: Expr.FloatLiteral(val) }
}

fn string_expr(val: string) -> Expression {
  Expression { span: span.new(0, 0), kind: Expr.StringLiteral(val) }
}

fn array_expr(elems: Slice<Expression>, typ: Type) -> Expression {
  Expression { span: span.new(0, 0), kind: Expr.ArrayLiteral(elems, typ) }
}

fn tuple_expr(elems: Slice<Expression>) -> Expression {
  Expression { span: span.new(0, 0), kind: Expr.TupleLiteral(elems) }
}

fn ident_expr(var_: Ref<Variable>) -> Expression {
  Expression { span: span.new(0, 0), kind: Expr.Identifier(var_) }
}

fn assign_expr(var_: Ref<Variable>, expr: Ref<Expression>) -> Expression {
  Expression { span: span.new(0, 0), kind: Expr.Assign(var_, expr) }
}

fn binding_expr(mode: mode.Mode, expr: Ref<Expression>) -> Expression {
  Expression { span: span.new(0, 0), kind: Expr.Binding(mode, expr) }
}

fn call_expr(
  fun: Ref<FunctionDef>,
  type_args: Slice<Type>,
  args: Slice<Expression>,
) -> Expression {
  Expression { 
    span: span.new(0, 0),
    kind: Expr.Call(FnCall.new(fun, type_args, args)),
  }
}

fn concrete_call_expr(id: int, args: Slice<Expression>) -> Expression {
  Expression { span: span.new(0, 0), kind: Expr.ConcreteCall(id, args) }
}

fn switch_if_expr(cases: Slice<(Expression, Expression)>) -> Expression {
  Expression { span: span.new(0, 0), kind: Expr.SwitchIf(SwitchIf.new(cases)) }
}

fn match_expr(subject: Ref<Expression>, cases: Slice<MatchCase>) -> Expression {
  Expression { 
    span: span.new(0, 0),
    kind: Expr.Match(Match.new(subject, cases)),
  }
}

fn loop_expr(body: Slice<Expression>, typ: Type) -> Expression {
  Expression { span: span.new(0, 0), kind: Expr.Loop(body, typ) }
}

fn block_expr(body: Slice<Expression>, typ: Type) -> Expression {
  Expression { span: span.new(0, 0), kind: Expr.Block(body, typ) }
}

fn return_expr(val: Option<Ref<Expression>>) -> Expression {
  Expression { span: span.new(0, 0), kind: Expr.Return(val) }
}

fn break_expr(val: Option<Ref<Expression>>) -> Expression {
  Expression { span: span.new(0, 0), kind: Expr.Break(val) }
}

fn continue_expr() -> Expression {
  Expression { span: span.new(0, 0), kind: Expr.Continue }
}

fn field_access_expr(obj: Ref<Expression>, idx: int) -> Expression {
  Expression { span: span.new(0, 0), kind: Expr.FieldAccess(obj, idx) }
}

fn constructor_expr(typ: Type, fields: Slice<string>) -> Expression {
  Expression { span: span.new(0, 0), kind: Expr.Constructor(typ, fields) }
}

fn extern_expr() -> Expression {
  Expression { span: span.new(0, 0), kind: Expr.Extern }
}

fn match_case(pattern: Expression, expr: Expression) -> MatchCase {
  MatchCase.new(pattern, expr)
}

fn var_(mode: mode.Mode, name: string, typ: Type) -> Ref<Variable> {
  &Variable.new(mode, name, typ, 0)
}
