import "ir"
import "ty"
import "mode"
import "utils/slice"

pub fn compile_match(cond: Ref<ir.If>) {
  let default = cond.default.map_or(&ir.Decision.Fail, |blk| &ir.Decision.Leaf(blk))  // TODO: this isn't quite right; a missing else block shouldn't always be a fail
  cond.decision = compile_checks(cond.checks, default)
}

pub fn compile_checks(checks: Slice<ir.Check>, default: Ref<ir.Decision>) -> Ref<ir.Decision> {
  match checks {
    [] => default,
    [Test(expr, blk), ..rest] => &ir.Decision.Guard{
      cond: expr,
      then: &ir.Decision.Leaf(blk),
      else_: compile_checks(rest, default)
    },
    [Match(expr, arms), ..rest] => {
        let matrix = PatternMatrix.new(expr, arms, rest, default)
        matrix.decide()
    },
  }
}

struct PatternMatrix {
  scrutinee: Slice<ir.Place>,
  rows: Slice<ir.Row>,
  checks: Slice<ir.Check>, // represents remaining checks yet to be compiled to matrices
  default: Ref<ir.Decision>,
}

