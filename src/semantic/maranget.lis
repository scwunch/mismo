//     If(cond) => compile_checks(cond.checks, cond.default),
//   }
//   let mut i = self.patterns.length()
//   loop {
//     if i == 0 { break dec }
//     i -= 1
//     match self.patterns[i] {
//       Binding(varid) => dec = &ir.Decision.Bind{name: varid.name, place: place.extend(i), next: dec},
//       Wildcard => (),
//       Constructor(_, _) => panic("constructor pattern not irrefutable"),
//     }
//   }
// }

impl PatternMatrix {
  fn new(scrutinee: ir.Expression, rows: Slice<ir.Row>, checks: Slice<ir.Check>, default: Ref<ir.Decision>) -> PatternMatrix {
    let varid = match scrutinee.kind {
      Identifier(varid) => varid,
      _ => {
        let varid = &ty.Variable.new(mode.Mode.MutBang, "$scrutinee", scrutinee.span.end)
        varid.typ = scrutinee.typ()
        varid
      }
    }
    let scrutinee = match scrutinee.typ() {
      Tuple(elements) => {
        elements.enumerate().map(|(i, _)| ir.Place{varid, path: [i]})
      },
      _ => [ir.Place{varid, path: []}]
    }

    PatternMatrix {scrutinee, rows, checks, default }
  }

  #[allow(manual_map_or)]
  fn decide(self) -> Ref<ir.Decision> {
    match self.rows {
      [] => compile_checks(self.checks, self.default),
      [first, ..rest] if first.irrefutable() => {
        match slice.index_of(first.patterns, is_binding) {
          Some(i) => self.default_decision(i),
          None => self.action(first.then, rest)
        }
      },
      rows => {
        let (i, constructors) = self.select_column()
        let scrutinee = self.scrutinee[i]
        let cases = constructors.map(|c| {
          ir.Case{tag: c, then: self.specialize(c, i).decide()}
        })
        let default = self.default_decision(i)
        &ir.Decision.Switch{scrutinee, cases, default}
      },
    }
  }

  #[allow(manual_map_or)]
  fn action(self, action: ir.Then, rest: Slice<ir.Row>) -> Ref<ir.Decision> {
    match action {
      Block(blk) if rest.is_empty() => &ir.Decision.Leaf(blk),
      Block(_) => panic("issue redundancy warning: {rest} is subsumed"),
      If(cond) => {
        match cond.default {
          None => compile_checks(cond.checks, PatternMatrix{rows: rest, ..self}.decide()),
          Some(blk) => {
            if rest.length() > 0 {
              panic("unreachable rows due to default on intermediate cond: {rest}")
            }
            if self.checks.length() > 0 {
              panic("unreachable additional checks")
            }
            if let ir.Decision.Fail = self.default.* {
              compile_checks(cond.checks, &ir.Decision.Leaf(blk))
            } else {
              panic("multiple defaults found")
            }
          },
        }
      },
    }
  }

  fn select_column(self) -> (int, Slice<string>) {
    let i = 0
    let mut tags = []
    for row in self.rows {
      match row.patterns.get(i) {
        Some(Constructor(tag, _)) => if !tags.contains(tag) {tags = tags.append(tag)},
        Some(_) => break,
        _ => (),
      }
    }
    (i, tags)
  }

  fn specialize(self, constructor: string, i: int) -> PatternMatrix {
    let mut len = 1
    let mut rows = []
    for row in self.rows {
      match row.patterns[i] {
        Constructor(c, patts) if c == constructor => {
          len = patts.length()  // this only needs to be set once, but it's fine to set it multiple times
          rows = rows.append(row.replace(i, patts))
        },
        _ => (),
      }
    }
    let mut scrutinee = [].reserve(len)
    for j in 0..len {
      scrutinee = scrutinee.append(self.scrutinee[i].extend(j))
    }
    PatternMatrix {scrutinee, rows, ..self}
  }

  fn default_decision(self, i: int) -> Ref<ir.Decision> {
    for row in self.rows {
      match row.patterns[i] {
        Wildcard => return self.default_matrix(i).decide(),
        Binding(varid) => return &ir.Decision.Bind{
          name: varid.name,
          place: self.scrutinee[i],
          next: self.default_matrix(i).decide()
        },
        Constructor(_, _) => (),
      }
    }
    compile_checks(self.checks, self.default)
  }

  fn default_matrix(self, i: int) -> PatternMatrix {
    let rows = self.rows.filter(|row| row.patterns[i].irrefutable())
    let rows = rows.map(|row| row.replace(i, []))
    let mut scrutinee = [].reserve(self.scrutinee.length() - 1)
    scrutinee = scrutinee.append(self.scrutinee[..i]...)
    scrutinee = scrutinee.append(self.scrutinee[i + 1..]...)
    PatternMatrix {scrutinee, rows, ..self}
  }
}

fn is_binding(p: ir.Pattern) -> bool {
  match p {
    Binding(_) => true,
    _ => false,
  }
}
