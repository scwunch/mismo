import "mode"
import "utils/slice"

pub enum Type {
  Any,
  Never,
  Bool,
  Nat,
  Int,
  Float,
  String,
  Array(Ref<Type>),
  Tuple(Slice<Type>),
  Fn(Slice<ParamType>, Ref<Type>),
  Adt(Ref<TypeDef>, Slice<Type>),
  Var(int),
}

pub struct ParamType {
  pub mode: mode.Mode,
  pub typ: Type,
}

impl ParamType {
  pub fn substitute(self, args: Slice<Type>) -> ParamType {
    ParamType { mode: self.mode, typ: self.typ.substitute(args) }
  }

  pub fn assignable_to(self, other: ParamType) -> bool {
    self.mode.assignable_to(other.mode) && self.typ.assignable_to(other.typ)
  }

  pub fn string(self) -> string {
    f"{self.mode} {self.typ}"
  }
}

impl Type {
  pub fn nil() -> Type {
    Type.Tuple([])
  }

  pub fn string(self) -> string {
    match self {
      Any => "Any",
      Never => "Never",
      Bool => "Bool",
      Nat => "Nat",
      Int => "Int",
      Float => "Float",
      String => "String",
      Array(t) => f"Array[{t}]",
      Tuple(fields) => f"({fields.map(Type.string).join(", ")})",
      Fn(params, ret) => f"({params.map(ParamType.string).join(", ")})->{ret}",
      Adt(def, args) => def.name + f"{args}",
      Var(int) => if int >= 0 { f"T{int}" } else { "T_" },
    }
  }

  pub fn type_args(self) -> Slice<Type> {
    match self {
      Any | Never | Bool | Nat | Int | Float | String | Var(_) => [],
      Array(typ) => [typ.*],
      Tuple(fields) => fields,
      Fn(params, ret) => params.map(|p| p.typ).append(ret.*),
      Adt(_, args) => args,
    }
  }

  pub fn constructor_and_arity_eq(self, other: Type) -> bool {
    match (self, other) {
      (Any, Any) |
      (Never, Never) |
      (Bool, Bool) |
      (Nat, Nat) |
      (Int, Int) |
      (Float, Float) |
      (String, String) |
      (Array(_), Array(_)) => true,
      (Tuple(a), Tuple(b)) => a.length() == b.length(),
      (Fn(a, _), Fn(b, _)) => a.length() == b.length(),
      (Adt(def1, _), Adt(def2, _)) => def1 == def2,
      (Var(a), Var(b)) => a == b,
      (Any, _) |
      (Never, _) |
      (Bool, _) |
      (Nat, _) |
      (Int, _) |
      (Float, _) |
      (String, _) |
      (Array(_), _) |
      (Tuple(_), _) |
      (Fn(_, _), _) |
      (Adt(_, _), _) |
      (Var(_), _) => false,
    }
  }

  pub fn substitute(self, args: Slice<Type>) -> Type {
    match self {
      Any => Type.Any,
      Never => Type.Never,
      Bool => Type.Bool,
      Nat => Type.Nat,
      Int => Type.Int,
      Float => Type.Float,
      String => Type.String,
      Array(typ) => Type.Array(&typ.substitute(args)),
      Tuple(fields) => Type.Tuple(fields.map(|f| f.substitute(args))),
      Fn(params, ret) => Type.Fn(params.map(|p| p.substitute(args)), ret),
      Adt(def, args) => Type.Adt(def, args.map(|a| a.substitute(args))),
      Var(i) => args[i],
    }
  }

  pub fn assignable_to(self, other: Type) -> bool {
    match (self, other) {
      (Never, _) => true,
      (_, Any) => true,
      (_, Tuple([])) => true, // this rule means a callback slot typed Fn() -> Nil could silently accept a Fn() -> Int and throw away its result.
      (Fn(params, ret), Fn(params2, ret2)) => {
        // parameters are contravariant, return type is covariant
        params.length() == params2.length() &&
        slice.zip(params, params2).all(|p| p.1.assignable_to(p.0)) &&
        ret.assignable_to(ret2.*)
      },
      _ => self.eq(other),
    }
  }

  pub fn least_upper_bound(self, other: Type) -> Option<Type> {
    if self.assignable_to(other) {
      Some(other)
    } else if other.assignable_to(self) { Some(self) } else { None }
  }

  pub fn specificity_ge(self, other: Type) -> bool {
    match (self, other) {
      (_, Var(_)) => true, // anything >= type var
      (Var(_), _) => false, // type var < concrete
      _ => // both concrete — if both matched the same arg, constructors must agree
      slice
        .zip(self.type_args(), other.type_args())
        .all(|pair| pair.0.specificity_ge(pair.1)),
    }
  }

  pub fn specificity_gt(self, other: Type) -> bool {
    match (self, other) {
      (Var(_), _) => false,
      (_, Var(_)) => true,
      _ => {
        let a_args = self.type_args()
        let b_args = other.type_args()
        slice.zip(a_args, b_args).all(|pair| pair.0.specificity_ge(pair.1)) &&
        slice.zip(a_args, b_args).any(|pair| pair.0.specificity_gt(pair.1))
      },
    }
  }
}
