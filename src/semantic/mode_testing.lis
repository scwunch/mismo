import "errors"
import "mode"
import "span"
import "testing"

pub fn test_modecheck() {
  let _ = testing.test_suite(
    "Mode Check",
    [
      test_mode_infer_literals,
      test_identifier_mode,
      test_use_after_consume,
      test_consume_borrow,
      test_binding_downgrade,
      test_binding_mode_mismatch,
      test_call_downgrade,
      test_call_var_param,
      test_call_mode_mismatch,
      test_block_infer,
      test_return_consumes,
    ],
  )
}

fn test_mode_infer_literals(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "infer literals return Var"
  let mc = ModeCheck.new()

  match mc.infer(nil_expr()) {
    Ok(m) => t.should_be_true(m == mode.Mode.Var, f"expected Var, got {m}")?,
    Err(e) => t.fail(e.message())?,
  }
  match mc.infer(bool_expr(true)) {
    Ok(m) => t.should_be_true(m == mode.Mode.Var, f"expected Var, got {m}")?,
    Err(e) => t.fail(e.message())?,
  }
  match mc.infer(int_expr(42)) {
    Ok(m) => t.should_be_true(m == mode.Mode.Var, f"expected Var, got {m}")?,
    Err(e) => t.fail(e.message())?,
  }
  match mc.infer(float_expr(1.5)) {
    Ok(m) => t.should_be_true(m == mode.Mode.Var, f"expected Var, got {m}")?,
    Err(e) => t.fail(e.message())?,
  }
  match mc.infer(string_expr("hello")) {
    Ok(m) => t.should_be_true(m == mode.Mode.Var, f"expected Var, got {m}")?,
    Err(e) => t.fail(e.message())?,
  }
  match mc.infer(array_expr([int_expr(1)], Type.Int)) {
    Ok(m) => t.should_be_true(m == mode.Mode.Var, f"expected Var, got {m}")?,
    Err(e) => t.fail(e.message())?,
  }
  match mc.infer(tuple_expr([int_expr(1), bool_expr(true)])) {
    Ok(m) => t.should_be_true(m == mode.Mode.Var, f"expected Var, got {m}")?,
    Err(e) => t.fail(e.message())?,
  }

  Ok(())
}

fn test_identifier_mode(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "identifier returns declared mode"
  let mc = ModeCheck.new()

  let v_var = var_(mode.Mode.Var, "x", Type.Int)
  match mc.infer(ident_expr(v_var)) {
    Ok(m) => t.should_be_true(m == mode.Mode.Var, f"expected Var, got {m}")?,
    Err(e) => t.fail(e.message())?,
  }

  let v_let = var_(mode.Mode.Let, "y", Type.String)
  match mc.infer(ident_expr(v_let)) {
    Ok(m) => t.should_be_true(m == mode.Mode.Let, f"expected Let, got {m}")?,
    Err(e) => t.fail(e.message())?,
  }

  let v_mut = var_(mode.Mode.Mut, "z", Type.Float)
  match mc.infer(ident_expr(v_mut)) {
    Ok(m) => t.should_be_true(m == mode.Mode.Mut, f"expected Mut, got {m}")?,
    Err(e) => t.fail(e.message())?,
  }

  Ok(())
}

fn test_use_after_consume(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "use after consume"
  let v = var_(mode.Mode.Var, "x", Type.Int)
  let mc = ModeCheck.new()

  // Consume x via a Var binding
  let src = ident_expr(v)
  if let Err(e) = mc.infer(binding_expr(mode.Mode.Var, &src)) {
    t.fail(e.message())?
  }

  // Using x again fails with UseAfterConsumeError (3012)
  match mc.infer(ident_expr(v)) {
    Ok(_) => t.fail("expected UseAfterConsumeError")?,
    Err(e) => t.should_be_true(
      e.code() == 3012,
      f"expected code 3012, got {e.code()}",
    )?,
  }

  Ok(())
}

fn test_consume_borrow(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "consume borrow"
  let mc = ModeCheck.new()

  // Cannot consume a Let variable via Var binding
  let v_let = var_(mode.Mode.Let, "x", Type.Int)
  let src = ident_expr(v_let)
  match mc.infer(binding_expr(mode.Mode.Var, &src)) {
    Ok(_) => t.fail("expected ConsumeBorrowError")?,
    Err(e) => t.should_be_true(
      e.code() == 3011,
      f"expected code 3011, got {e.code()}",
    )?,
  }

  // Cannot consume a Mut variable via Var binding
  let v_mut = var_(mode.Mode.Mut, "y", Type.Int)
  let src2 = ident_expr(v_mut)
  match mc.infer(binding_expr(mode.Mode.Var, &src2)) {
    Ok(_) => t.fail("expected ConsumeBorrowError")?,
    Err(e) => t.should_be_true(
      e.code() == 3011,
      f"expected code 3011, got {e.code()}",
    )?,
  }

  // Cannot consume a MutBang variable via Var binding
  let v_mutbang = var_(mode.Mode.MutBang, "z", Type.Int)
  let src3 = ident_expr(v_mutbang)
  match mc.infer(binding_expr(mode.Mode.Var, &src3)) {
    Ok(_) => t.fail("expected ConsumeBorrowError")?,
    Err(e) => t.should_be_true(
      e.code() == 3011,
      f"expected code 3011, got {e.code()}",
    )?,
  }

  Ok(())
}

fn test_binding_downgrade(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "binding mode downgrade"
  let mc = ModeCheck.new()

  // A Var source can be bound to a Let dest (downgrade)
  let v = var_(mode.Mode.Var, "x", Type.Int)
  let src = ident_expr(v)
  match mc.infer(binding_expr(mode.Mode.Let, &src)) {
    Ok(m) => t.should_be_true(m == mode.Mode.Let, f"expected Let, got {m}")?,
    Err(e) => t.fail(e.message())?,
  }

  Ok(())
}

fn test_binding_mode_mismatch(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "binding mode mismatch"
  let mc = ModeCheck.new()

  // A Let source cannot be assigned to a Mut dest
  let v = var_(mode.Mode.Let, "x", Type.Int)
  let src = ident_expr(v)
  match mc.infer(binding_expr(mode.Mode.Mut, &src)) {
    Ok(_) => t.fail("expected ModeMismatchError")?,
    Err(e) => t.should_be_true(
      e.code() == 3013,
      f"expected code 3013, got {e.code()}",
    )?,
  }

  // A Let source cannot be assigned to a Var dest (this goes through
  // consume_ident instead, producing ConsumeBorrowError)
  let v2 = var_(mode.Mode.Let, "y", Type.Int)
  let src2 = ident_expr(v2)
  match mc.infer(binding_expr(mode.Mode.Var, &src2)) {
    Ok(_) => t.fail("expected error")?,
    Err(e) => t.should_be_true(
      e.code() == 3011 || e.code() == 3013,
      f"expected 3011 or 3013, got {e.code()}",
    )?,
  }

  Ok(())
}

fn test_call_downgrade(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "call param mode downgrade"
  let mc = ModeCheck.new()

  // A Var arg can be passed to a Let param (downgrade), and is not consumed
  let v = var_(mode.Mode.Var, "x", Type.Int)
  let fn_def = FunctionDef.mock(
    "f",
    [],
    [Parameter.let_("a", Type.Int)],
    Type.Tuple([]),
  )
  match mc.infer(call_expr(&fn_def, [], [ident_expr(v)])) {
    Ok(m) => t.should_be_true(m == mode.Mode.Var, f"expected Var, got {m}")?,
    Err(e) => t.fail(e.message())?,
  }

  // Variable was not consumed — can still use it
  if let Err(e) = mc.infer(ident_expr(v)) { t.fail(e.message())? }

  Ok(())
}

fn test_call_var_param(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "call consumes var arg"
  let mc = ModeCheck.new()

  // A Var arg passed to a Var param is consumed
  let v = var_(mode.Mode.Var, "x", Type.Int)
  let fn_def = FunctionDef.mock(
    "f",
    [],
    [Parameter.var_("a", Type.Int)],
    Type.Tuple([]),
  )
  match mc.infer(call_expr(&fn_def, [], [ident_expr(v)])) {
    Ok(m) => t.should_be_true(m == mode.Mode.Var, f"expected Var, got {m}")?,
    Err(e) => t.fail(e.message())?,
  }

  // After consuming, using x again fails
  match mc.infer(ident_expr(v)) {
    Ok(_) => t.fail("expected UseAfterConsumeError")?,
    Err(e) => t.should_be_true(
      e.code() == 3012,
      f"expected code 3012, got {e.code()}",
    )?,
  }

  Ok(())
}

fn test_call_mode_mismatch(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "call param mode mismatch"
  let mc = ModeCheck.new()

  // A Let arg cannot be passed to a Mut param
  let v = var_(mode.Mode.Let, "x", Type.Int)
  let fn_def = FunctionDef.mock(
    "f",
    [],
    [Parameter.mut_("a", Type.Int)],
    Type.Tuple([]),
  )
  match mc.infer(call_expr(&fn_def, [], [ident_expr(v)])) {
    Ok(_) => t.fail("expected ModeMismatchError")?,
    Err(e) => t.should_be_true(
      e.code() == 3013,
      f"expected code 3013, got {e.code()}",
    )?,
  }

  Ok(())
}

fn test_block_infer(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "block infers last expression mode"
  let mc = ModeCheck.new()

  // Block with a single Var expression returns Var
  match mc.infer(block_expr([int_expr(42)], Type.Int)) {
    Ok(m) => t.should_be_true(m == mode.Mode.Var, f"expected Var, got {m}")?,
    Err(e) => t.fail(e.message())?,
  }

  // Block with Var expressions still returns Var
  match mc.infer(block_expr([int_expr(1), int_expr(2)], Type.Int)) {
    Ok(m) => t.should_be_true(m == mode.Mode.Var, f"expected Var, got {m}")?,
    Err(e) => t.fail(e.message())?,
  }

  Ok(())
}

fn test_return_consumes(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "return consumes expression"
  let mc = ModeCheck.new()

  // Return(None) returns Var
  match mc.infer(return_expr(None)) {
    Ok(m) => t.should_be_true(m == mode.Mode.Var, f"expected Var, got {m}")?,
    Err(e) => t.fail(e.message())?,
  }

  // Return(Some(ident)) consumes the variable
  let v = var_(mode.Mode.Var, "x", Type.Int)
  let ret = return_expr(Some(&ident_expr(v)))
  match mc.infer(ret) {
    Ok(m) => t.should_be_true(m == mode.Mode.Var, f"expected Var, got {m}")?,
    Err(e) => t.fail(e.message())?,
  }

  // After returning, using x again fails
  match mc.infer(ident_expr(v)) {
    Ok(_) => t.fail("expected UseAfterConsumeError")?,
    Err(e) => t.should_be_true(
      e.code() == 3012,
      f"expected code 3012, got {e.code()}",
    )?,
  }

  Ok(())
}
