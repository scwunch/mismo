pub struct Variable {
  mode: mode.Mode,
  name: string,
  typ: Type,
  init: uint32,
  consumed: Option<uint32>,
}

impl Variable {
  fn from_param(param: Parameter) -> Variable {
    Variable { 
      mode: param.mode,
      name: param.name,
      typ: param.typ,
      init: param.span.start,
      consumed: None,
    }
  }

  fn new(mode: mode.Mode, name: string, typ: Type, init: uint32) -> Variable {
    Variable { mode, name, typ, init, consumed: None }
  }

  // fn hole() -> Variable {
  //   Variable.new(mode.Mode.Var, "", Type.Never, 0)
  // }
}
