import "cst"
import "errors"
import "mode"
import "operator"
import "span"
import "utils/slice"

impl TypeEnv {
  fn type_check_function(self: Ref<TypeEnv>, func: FunctionDef) {
    let res = TypeCheck.new(self, func).check(func.body, func.return_type)
    if let Err(err) = res { self.error(err) }
  }
}

pub struct TypeCheck {
  env: Ref<TypeEnv>,
  next_var: Ref<int>,
  return_type: Type,
  bindings: Ref<List<Ref<Variable>>>,
}

impl TypeCheck {
  fn new(env: Ref<TypeEnv>, func: FunctionDef) -> TypeCheck {
    let zero = 0
    let mut scope = &List.Nil
    for param in func.parameters {
      let v = &Variable.from_param(param)
      scope = &List.Cons(v, scope)
    }
    TypeCheck { 
      env,
      next_var: &zero,
      return_type: func.return_type,
      bindings: scope,
    }
  }
}

pub enum List<T> {
  Nil,
  Cons(T, Ref<List<T>>),
}

impl List<Ref<Variable>> {
  fn get(self, name: string) -> Option<Ref<Variable>> {
    let mut current = self
    while let List.Cons(binding, next) = current {
      if binding.name == name { return Some(binding) }
      current = next.*
    }
    None
  }
}

impl TypeCheck {
  fn get(self, name: string) -> Option<Ref<Variable>> {
    let mut current = self.bindings.*
    while let List.Cons(binding, next) = current {
      if binding.name == name { return Some(binding) }
      current = next.*
    }
    None
  }
}

impl TypeCheck {
  fn check(self, expr: cst.Expression, expected: Type) -> Result<Expression, errors.TypeError> {
    let actual = self.infer(expr)?
    if !actual.typ().eq(expected) { panic("register type mismatch error here") }
    Ok(actual)
  }

  fn infer(self, node: cst.Expression) -> Result<Expression, errors.TypeError> {
    let expr = match node.kind {
      cst.Expr.Nil => Expr.Nil,
      cst.Expr.BoolLiteral(b) => Expr.BoolLiteral(b),
      cst.Expr.IntLiteral(i) => Expr.IntLiteral(i),
      cst.Expr.FloatLiteral(f) => Expr.FloatLiteral(f),
      cst.Expr.StringLiteral(s) => Expr.StringLiteral(s),
      cst.Expr.ArrayLiteral(elems) => self.array(elems, node.span)?,
      cst.Expr.TupleLiteral(elems) => Expr.TupleLiteral(
        slice.map_result(elems, self.infer)?,
      ),
      cst.Expr.Identifier(name) => match self.get(name) {
        Some(varid) => Expr.Identifier(varid),
        None => return Err(errors.MissingNameError.new(name, node.span)),
      },
      cst.Expr.Binding(m, expr) => {
        let e = self.infer(expr.*)?
        Expr.Binding(m, &e)
      },
      cst.Expr.Binop(binop) => self.binop(binop.*, node.span)?,
      cst.Expr.Call(call) => self.call(
        call.fn_name,
        slice.map_result(call.type_args.unwrap_or([]), self.env.eval_type)?,
        slice.map_result(call.args, self.infer)?,
        node.span,
      )?,
      cst.Expr.If(cond) => self.if_expr(cond, node.span)?,
      cst.Expr.While(cond) => self.while_expr(cond, node.span)?,
      cst.Expr.For(for_loop) => self.for_expr(for_loop.*, node.span)?,
      cst.Expr.Block(exprs) => self.block(exprs, node.span)?,
      cst.Expr.Neg(expr) => self.call(
        "neg",
        [],
        [self.infer(expr.*)?],
        node.span,
      )?,
      cst.Expr.Not(expr) => self.call(
        "not",
        [],
        [self.infer(expr.*)?],
        node.span,
      )?,
      cst.Expr.Return(None) => Expr.Return(None),
      cst.Expr.Return(Some(expr)) => {
        let e = self.infer(expr.*)?
        Expr.Return(Some(&e))
      },
      cst.Expr.Break(None) => Expr.Break(None),
      cst.Expr.Break(Some(expr)) => {
        let e = self.infer(expr.*)?
        Expr.Break(Some(&e))
      },
      cst.Expr.Continue => Expr.Continue,
      cst.Expr.Type(name, type_args) => {
        self.env.error(errors.ParseError.new(
          node.span,
          "unexpected type expression",
        ))
        Expr.Nil
      },
      cst.Expr.DotName(expr, string) => self.dot_name(
        self.infer(expr.*)?,
        string,
        node.span,
      )?,
      cst.Expr.DotCall(expr, call) => self.call(
        call.fn_name,
        slice.map_result(call.type_args.unwrap_or([]), self.env.eval_type)?,
        [self.infer(expr.*)?].append(slice.map_result(call.args, self.infer)?...),
        node.span,
      )?,
    }
    Ok(Expression { span: node.span, kind: expr })
  }

  fn block(self, exprs: Slice<cst.Expression>, span: span.Span) -> Result<Expr, errors.TypeError> {
    let mut self = self
    if exprs.length() == 0 { return Ok(Expr.Nil) }
    let mut expressions = []
    let mut types = []
    for node in exprs {
      let expr = self.infer(node)?
      expressions = expressions.append(expr)
      match expr.kind {
        Expr.Assign(varid, _) => self.bindings = &List.Cons(
          varid,
          self.bindings,
        ),
        Expr.Return(opt_expr) => {
          let actual = opt_expr.map(|e| e.typ()).unwrap_or(Type.Tuple([]))
          if !self.return_type.eq(actual) {
            return Err(errors.TypeMismatchError.new(
              span,
              f"{self.return_type}",
              f"{actual}",
            ))
          }
        },
        Expr.Break(opt_expr) => {
          let ty = opt_expr.map(|e| e.typ()).unwrap_or(Type.Tuple([]))
          types = types.append(ty)
        },
        _ => (),
      }
    }
    types = types.append(expressions[expressions.length() - 1].typ())
    Ok(Expr.Block(expressions, types[0]))
  }

  fn type_of_elements(elems: Slice<Expression>, span: span.Span) -> Result<Type, Slice<Type>> {
    if elems.length() == 0 { return Err([]) }
    let typ = elems[0].typ()
    for elem in elems {
      if !elem.typ().eq(typ) { return Err(elems.map(|e| e.typ())) }
    }
    Ok(typ)
  }

  fn array(self, elems: Slice<cst.Expression>, span: span.Span) -> Result<Expr, errors.TypeError> {
    if elems.length() == 0 {
      return Err(errors.EmptyArrayLiteralError.new(span))
    }
    let inferred = slice.map_result(elems, self.infer)?

    let mut elem_type = inferred[0].typ()
    for elem in inferred {
      match elem.typ().least_upper_bound(elem_type) {
        Some(t) => elem_type = t,
        None => {
          let types = inferred.map(|e| f"{e.typ()}").join(", ")
          return Err(errors.HeterogeneousArrayLiteralError.new(span, types))
        },
      }
    }

    Ok(Expr.ArrayLiteral(inferred, elem_type))
  }

  fn binop(self, binop: cst.Binop, span: span.Span) -> Result<Expr, errors.TypeError> {
    if binop.op == operator.Operator.Assign {
      match binop.left.kind {
        cst.Expr.Identifier(name) => match self.get(name) {
          Some(varid) => {
            let value = self.infer(binop.right)?
            Ok(Expr.Assign(varid, &value))
          },
          None => {
            self.env.error(errors.MissingNameError.new(name, binop.left.span))
            let _ = self.infer(binop.right)?
            Ok(Expr.Nil)
          },
        },
        _ => {
          self.env.error(errors.InvalidAssignmentTargetError.new(
            binop.left.span,
            binop.left,
          ))
          Ok(Expr.Nil)
        },
      }
    } else {
      self.call(
        binop.op.string(),
        [],
        [self.infer(binop.left)?, self.infer(binop.right)?],
        span,
      )
    }
  }

  fn if_expr(self, cond: cst.Conditional, span: span.Span) -> Result<Expr, errors.TypeError> {
    let _ = cond
    let _ = span
    panic("not implemented yet")
  }

  fn while_expr(self, cond: cst.Conditional, span: span.Span) -> Result<Expr, errors.TypeError> {
    let _ = cond
    let _ = span
    panic("not implemented yet")
  }

  fn for_expr(self, for_loop: cst.ForLoop, span: span.Span) -> Result<Expr, errors.TypeError> {
    let _ = for_loop
    let _ = span
    panic("not implemented yet")
  }

  fn dot_name(self, expr: Expression, name: string, span: span.Span) -> Result<Expr, errors.TypeError> {
    let typ = expr.typ()
    if let Type.Adt(def, args) = typ {
      if let TypeKind.Struct(fields) = def.kind {
        for (i, field) in fields.enumerate() {
          if field.name == name { return Ok(Expr.FieldAccess(&expr, i)) }
        }
      }
    }
    self.call(name, [], [expr], span)
  }

  fn call(
    self,
    fname: string,
    type_args: Slice<Type>,
    args: Slice<Expression>,
    span: span.Span,
  ) -> Result<Expr, errors.TypeError> {
    let _ = fname
    let _ = type_args
    let _ = args
    let _ = span
    panic("Oh my, overload resolution time!")
  }
}

pub struct Variable {
  mode: mode.Mode,
  name: string,
  typ: Type,
  init: uint32,
  consumed: Option<uint32>,
}

impl Variable {
  fn from_param(param: Parameter) -> Variable {
    Variable { 
      mode: param.mode,
      name: param.name,
      typ: param.typ,
      init: param.span.start,
      consumed: None,
    }
  }

  fn new(mode: mode.Mode, name: string, typ: Type, init: uint32) -> Variable {
    Variable { mode, name, typ, init, consumed: None }
  }
}
