import "cst"
import "errors"
import "mode"
import "operator"
import "span"
import "utils/slice"

impl TypeEnv {
  fn type_check_function(self: Ref<TypeEnv>, func: FunctionDef) {
    // let scope = Scope.from_params(&TypeCheck.new(self), func.parameters)
    // let res = scope.check(func.body, func.return_type)
    let res = TypeCheck.new(self, func).check(func.body, func.return_type)
    if let Err(err) = res { self.error(err) }
  }
}

pub struct TypeCheck {
  env: Ref<TypeEnv>,
  next_var: Ref<int>,
  return_type: Type,
  bindings: List<Ref<Variable>>,
}

impl TypeCheck {
  fn new(env: Ref<TypeEnv>, func: FunctionDef) -> TypeCheck {
    let zero = 0
    let mut scope = List.Nil
    for param in func.parameters {
      let prev = &scope
      scope = List.Cons(&Variable.from_param(param), prev)
    }
    TypeCheck { 
      env,
      next_var: &zero,
      return_type: func.return_type,
      bindings: scope,
    }
  }
}

// pub struct Scope { typecheck: Ref<TypeCheck>, bindings: List<Ref<Variable>> }

pub enum List<T> {
  Nil,
  Cons(T, Ref<List<T>>),
}

impl<T> List<T> {
  fn cons(self, item: T) -> List<T> {
    List.Cons(item, &self)
  }
}

