pub struct UseAfterConsumeError {
  pub name: string,
  pub use: span.Span,
  pub consumed: span.Span,
}

impl UseAfterConsumeError {
  pub fn new(name: string, use: span.Span, consumed: span.Span) -> UseAfterConsumeError {
    UseAfterConsumeError { name, use, consumed }
  }

  pub fn code(self) -> int {
    2012
  }

  pub fn message(self) -> string {
    f"Cannot use variable '{self.name}'; it has already been consumed at {self.consumed}."
  }

  pub fn span(self) -> span.Span {
    self.use
  }
}

