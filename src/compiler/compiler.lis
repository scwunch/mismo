import "cst"
import "parser"
import "semantic"

pub struct Compiler { cst_defs: cst.Declarations }

impl Compiler {
  pub fn parse(source: string) -> Ref<cst.Declarations> {
    let mut parser = parser.Parser.new(source, &cst.Declarations.new())
    parser.parse()
    parser.defs
  }

  pub fn type_check(defs: cst.Declarations) -> Result<(), ()> {
    let mut env = semantic.TypeEnv.new()
    env.type_check_program(defs)
    if env.errors.length() > 0 { Err(()) } else { Ok(()) }
  }

  pub fn monomorphize() {}
}
