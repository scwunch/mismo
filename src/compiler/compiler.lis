import "ast"
import "parser"
import "typecheck"

pub struct Compiler { ast_defs: ast.Definitions }

impl Compiler {
  pub fn parse(source: string) -> Ref<ast.Definitions> {
    let mut parser = parser.Parser.new(source, &ast.Definitions.new())
    parser.parse()
    parser.defs
  }

  pub fn type_check(defs: ast.Definitions) -> Result<(), ()> {
    let mut env = typecheck.TypeEnv.new()
    env.type_check_program(defs)
    if env.errors.length() > 0 { Err(()) } else { Ok(()) }
  }
}
