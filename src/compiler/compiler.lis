pub fn compile_to_tokens(source: string) -> Slice<lexer.Token> {
  let mut toks = []
  let mut lex = lexer.Lexer.new(source)
  loop {
    let tok = lex.next()
    toks = toks.append(tok)
    if tok.kind == lexer.TokenKind.EOF { break toks }
  }
}

pub fn compile_to_ast(source: string) -> Result<cst.Declarations, Slice<dx.Diagnostic>> {
  let mut parser = pars.Parser.new(source)
  let decs = parser.parse()
  if decs.errors.is_empty() {
    Ok(decs)
  } else {
    Err(decs.errors.map(|e| e as dx.Diagnostic))
  }
}

