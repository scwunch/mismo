import "go:fmt"
import "go:io"
import "go:os"

import "codegen"
import "cst"
import "errors"
import "lexer"
import "parser"
import "semantic"
import "specialization"

pub fn compile_to_tokens(source: string) -> Slice<lexer.Token> {
  let mut toks = []
  let mut lex = lexer.Lexer.new(source)
  loop {
    let tok = lex.next()
    toks = toks.append(tok)
    if tok.kind == lexer.TokenKind.EOF { break toks }
  }
}

pub fn compile_to_ast(source: string) -> Result<cst.Declarations, Slice<errors.Diagnostic>> {
  let mut parser = parser.Parser.new(source)
  let decs = parser.parse()
  if decs.errors.is_empty() {
    Ok(decs)
  } else {
    Err(decs.errors.map(|e| e as errors.Diagnostic))
  }
}

pub fn type_check(source: string) -> Result<semantic.TypeEnv, Slice<errors.Diagnostic>> {
  let decs = compile_to_ast(source)?
  let env = semantic.analyze_type_check(decs)
  if env.errors.is_empty() {
    Ok(env)
  } else {
    Err(env.errors.map(|e| e as errors.Diagnostic))
  }
}

pub fn mode_check(source: string) -> Result<semantic.TypeEnv, Slice<errors.Diagnostic>> {
  let decs = compile_to_ast(source)?
  let env = semantic.analyze(decs)
  if env.errors.is_empty() {
    Ok(env)
  } else {
    Err(env.errors.map(|e| e as errors.Diagnostic))
  }
}

pub enum MonomorphizationOut {
  Ok(specialization.ConcreteRegistry),
  SpecError(errors.SpecializationError),
  TypeErrors(Slice<errors.TypeError>),
}

pub fn specialize(source: string) -> Result<specialization.ConcreteRegistry, Slice<errors.Diagnostic>> {
  let reg = mode_check(source)?
  if reg.errors.is_empty() {
    match specialization.specialize(reg) {
      Ok(reg) => Ok(reg),
      Err(e) => Err([e as errors.Diagnostic]),
    }
  } else {
    Err(reg.errors.map(|e| e as errors.Diagnostic))
  }
}

pub fn transpile(source: string) -> Result<string, Slice<errors.Diagnostic>> {
  specialize(source).map(codegen.generate)
}

pub fn build(source: string, opts: Options) -> BuildResult {
  match transpile(source) {
    Ok(zig_code) => {
      match build_zig(zig_code, opts) {
        Ok(res) => BuildResult.Bin(res),
        Err(e) => BuildResult.OsErr(e),
      }
    },
    Err(errs) => BuildResult.MismoErrs(errs),
  }
}

pub enum BuildResult {
  Bin(Path),
  MismoErrs(Slice<errors.Diagnostic>),
  OsErr(error),
}

pub fn run(source: string) {
  let mut opts = Options.new()
  opts.work_dir_parent = "/home/ryan/Obsidian/Vault/Projects/mismo/zig-out"
  opts.zig_prelude_path = "/home/ryan/Obsidian/Vault/Projects/mismo/zig-out/prelude.zig"
  match build(source, opts) {
    Bin(Path(res)) => {
      match run_binary(res, [], opts.io) {
        Ok(_) => (),
        Err(e) => fmt.Fprintln(os.Stderr, e.Error()),
      }
    },
    OsErr(e) => fmt.Fprintln(os.Stderr, e.Error()),
    MismoErrs(errs) => {
      let source = source as Slice<rune>
      for e in errs {
        fmt.Println(errors.render(e, source))
      }
    },
  }
}
