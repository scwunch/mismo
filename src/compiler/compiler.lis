pub enum BuildResult {
  Bin(Path),
  MismoErrs(Slice<dx.Diagnostic>),
  OsErr(error),
}

pub fn run(source: string, opts: Options) {
  match build(source, opts) {
    Bin(Path(res)) => {
      if let Err(e) = run_binary(res, [], opts.io) {
        fmt.Fprintln(opts.io.stderr, e.Error())
      }
    },
    OsErr(e) => fmt.Fprintln(opts.io.stderr, e.Error()),
    MismoErrs(errors) => {
      let source = source as Slice<rune>
      for e in errors {
        fmt.Println(dx.render(e, source))
      }
    },
  }
}
