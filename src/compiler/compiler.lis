import "cst"
import "parser"
import "semantic"
import "specialization"

pub struct Compiler { cst_defs: cst.Declarations }

impl Compiler {
  pub fn parse(source: string) -> Ref<cst.Declarations> {
    let mut parser = parser.Parser.new(source, &cst.Declarations.new())
    parser.parse()
    parser.defs
  }

  pub fn type_check(defs: cst.Declarations) -> Result<Slice<(semantic.FunctionDef, semantic.Expression)>, ()> {
    let mut env = semantic.TypeEnv.new()
    let funcs = env.type_check_program(defs)
    if env.errors.is_empty() { Ok(funcs) } else { Err(()) }
  }

  pub fn monomorphize(funcs: Slice<(semantic.FunctionDef, semantic.Expression)>) {
    specialization.Specializer
  }
}
