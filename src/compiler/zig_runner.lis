import "go:fmt"
import "go:io"
import "go:os"
import "go:os/exec"
import "go:path/filepath"

pub struct Options {
  pub zig_bin: string,
  pub zig_prelude_path: string,
  pub out_bin: string,
  pub io: IoStreams,
  pub keep_work_dir: bool,
  pub work_dir_parent: string,
  pub work_dir: string,
}

pub struct IoStreams {
  pub stdin: io.Reader,
  pub stdout: io.Writer,
  pub stderr: io.Writer,
}

impl IoStreams {
  pub fn os() -> IoStreams {
    IoStreams { stdin: os.Stdin, stdout: os.Stdout, stderr: os.Stderr }
  }
}

impl Options {
  pub fn new() -> Options {
    Options { 
      zig_bin: "zig",
      zig_prelude_path: "",
      out_bin: "out",
      io: IoStreams.os(),
      keep_work_dir: true,
      work_dir_parent: os.TempDir(),
      work_dir: "",
    }
  }
}

pub struct Path(string)

/// Write zig_source to a temp file and run Zig compiler on it.
/// Check ZigResult.exit_code for compiler failure.
pub fn build_zig(zig_source: string, opts: Options) -> Result<Path, error> {
  let parent = opts.work_dir_parent
  let work_dir = if opts.work_dir.is_empty() {
    os.MkdirTemp(parent, "zigrunner-*")?
  } else {
    filepath.Join(parent, opts.work_dir)
  }
  if !opts.keep_work_dir {
    // only cleans the .zig source and cache
    // — the binary is copied out before this runs if needed.
    defer os.RemoveAll(work_dir)
  }

  // --- write source file ---
  let src_path = filepath.Join(work_dir, "main.zig")
  let src = os.OpenFile(
    src_path,
    os.O_WRONLY | os.O_APPEND | os.O_CREATE,
    0o644,
  )?
  src.Truncate(0)?
  match src.WriteString(zig_source) {
    Err(e) | Both(_, e) => return Err(e),
    _ => (),
  }
  if !opts.zig_prelude_path.is_empty() {
    let prelude = os.ReadFile(opts.zig_prelude_path)?
    match src.Write(prelude) {
      Err(e) | Both(_, e) => return Err(e),
      _ => (),
    }
  }
  src.Close()?

  // --- build the zig command ---
  // "zig build-exe" compiles a single file to a standalone binary.
  // We pass -femit-bin to tell zig exactly where to put the output.
  let binary_path = filepath.Join(work_dir, opts.out_bin)
  let args = ["build-exe", src_path, f"-femit-bin={binary_path}"]
  let cmd = exec.Command(opts.zig_bin, args...)
  cmd.Dir = work_dir

  cmd.Stdout = Some(opts.io.stdout)
  cmd.Stderr = Some(opts.io.stderr)

  cmd.Run().map(|_| Path(binary_path))
}

pub fn run_binary(bin_path: string, args: Slice<string>, io_streams: IoStreams) -> Result<(), error> {
  let mut cmd = exec.Command(bin_path, args...)
  cmd.Stdin = Some(io_streams.stdin)
  cmd.Stdout = Some(io_streams.stdout)
  cmd.Stderr = Some(io_streams.stderr)

  cmd.Run()
}
