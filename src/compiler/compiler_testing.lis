// struct Source { src: Slice<string> }
struct Source(string)

impl Source {
  fn equals(self, other: Source) -> bool {
    let mut i = 0
    let mut j = 0
    let self = self.0 as Slice<rune>
    let other = other.0 as Slice<rune>
    loop {
      match (self.get(i), other.get(j)) {
        (Some(a), Some(b)) if a == b => {
          i += 1
          j += 1
        },
        (Some(' '), _) | (Some('\n'), _) => i += 1,
        (_, Some(' ')) | (_, Some('\n')) => j += 1,
        (None, None) => return true,
        _ => return false,
      }
    }
  }
}
