//     FunctionDef { span, id, name, type_parameters, parameters, return_type, body }
// }

impl<Expr> FunctionDef<Expr> {
  pub fn signature(self) -> string {
    let type_params = type_params_to_string(self.type_parameters)
    let params = self.parameters
      .map(|p| f"{p.mode} {p.name} {p.typ}")
      .join(", ")
    f"fn {self.name}{type_params}({params}) {self.return_type}"
  }

  pub fn better_than(self, other: FunctionDef<Expr>) -> bool {
    let pairs = slice.zip(self.parameters, other.parameters)
    pairs.all(|p| p.0.typ.specificity_ge(p.1.typ)) &&
    pairs.any(|p| p.0.typ.specificity_gt(p.1.typ))
  }
}

impl FunctionDef<()> {
  pub fn is_extern(self) -> bool {
    true
  }
}

fn type_params_to_string(type_params: Slice<TypeParameter>) -> string {
  if type_params.is_empty() { "" } else { f"{type_params.map(|tp| tp.name)}" }
}
