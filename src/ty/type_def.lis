import md "mode"
import spn "span"

#[json]
#[equality]
pub struct TypeDef {
  pub span: spn.Span,
  pub ctor: Constructor,
  pub type_parameters: Slice<TypeParameter>,
  pub signatures: Map<string, Slice<int>>,
}

#[json]
#[equality]
#[display]
pub struct Constructor {
  pub name: string,
  pub typ: Type,
}

impl Constructor {
  pub fn substitute(self, args: Slice<Type>) -> Constructor {
    Constructor { name: self.name, typ: self.typ.substitute(args) }
  }
}

#[json]
#[equality]
pub struct TypeParameter {
  pub span: spn.Span,
  pub name: string,
}

impl TypeDef {
  pub fn new(
    span: spn.Span,
    name: string,
    type_parameters: Slice<TypeParameter>,
    typ: Type,
  ) -> TypeDef {
    TypeDef { span, ctor: Constructor { name, typ }, type_parameters, signatures: Map.new() }
  }

  pub fn new_enum(
    span: spn.Span,
    name: string,
    type_parameters: Slice<TypeParameter>,
    variants: Slice<(string, Type)>
  ) -> TypeDef {
    TypeDef {
      span,
      ctor: Constructor {
        name,
        typ: Type.Enum(variants.map(|(name, typ)| Constructor { name, typ }))
      },
      type_parameters,
      signatures: Map.new()
    }
  }

  pub fn new_struct(
    span: spn.Span,
    name: string,
    type_parameters: Slice<TypeParameter>,
    fields: Slice<(string, Type)>,
  ) -> TypeDef {
    TypeDef {
      span,
      ctor: Constructor {
        name,
        typ: Type.Record(fields.map(|(name, typ)| Field { name, typ }))
      },
      type_parameters,
      signatures: Map.new()
    }
  }
}

impl TypeParameter {
  pub fn new(span: spn.Span, name: string) -> TypeParameter {
    TypeParameter { span, name }
  }

  pub fn mock(name: string) -> TypeParameter {
    TypeParameter { name, .. }
  }
}
