import "mode"
import "span"

#[json]
#[equality]
pub struct TypeDef {
  pub span: span.Span,
  pub name: string,
  pub type_parameters: Slice<TypeParameter>,
  pub kind: TypeKind,
  pub signatures: Map<string, Slice<int>>,
}

#[json]
#[equality]
pub enum TypeKind {
  Struct(Slice<Field>),
  Enum(Slice<Variant>),
}

#[json]
#[equality]
pub struct TypeParameter {
  pub span: span.Span,
  pub name: string,
}

impl TypeDef {
  pub fn new(
    span: span.Span,
    name: string,
    type_parameters: Slice<TypeParameter>,
    kind: TypeKind,
  ) -> TypeDef {
    TypeDef { span, name, type_parameters, kind, signatures: Map.new() }
  }
}

impl TypeParameter {
  pub fn new(span: span.Span, name: string) -> TypeParameter {
    TypeParameter { span, name }
  }

  pub fn mock(name: string) -> TypeParameter {
    TypeParameter { name, .. }
  }
}

#[json]
#[equality]
pub struct Field {
  pub span: span.Span,
  pub name: string,
  pub typ: Type,
}

#[json]
#[equality]
pub struct Variant {
  pub span: span.Span,
  pub name: string,
  pub fields: Slice<Type>,
}

impl Field {
  pub fn to_param(self) -> Parameter {
    Parameter.new(self.span, mode.Mode.Var, self.name, self.typ)
  }
}
