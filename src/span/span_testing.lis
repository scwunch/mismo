import "testing"

pub fn test() {
  let _ = testing.test_suite(
    "Lexer",
    [test_span_merge, test_location_generation],
  )
}

impl Location {
  pub fn eq(self, other: Location) -> bool {
    self == other
  }
}

impl Span {
  fn index(start: uint32) -> Span {
    Span { start, end: start }
  }
}

fn test_location_generation(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Get Location of Span in source"
  let source = "123456789\n123456789\n123456789" as Slice<rune>
  t.should_eq(Span.index(0).location(source), Location { line: 1, col: 1 })?
  t.should_eq(Span.index(1).location(source), Location { line: 1, col: 2 })?
  t.should_eq(Span.index(2).location(source), Location { line: 1, col: 3 })?
  t.should_eq(Span.index(3).location(source), Location { line: 1, col: 4 })?
  t.should_eq(Span.index(9).location(source), Location { line: 1, col: 10 })?
  t.should_eq(Span.index(10).location(source), Location { line: 2, col: 1 })?
  Ok(())
}

fn test_span_merge(t: Ref<testing.TestRunner>) -> Result<(), string> {
  t.test_name = "Span Merging"
  let s1 = Span { start: 0, end: 5 }
  let s2 = Span { start: 3, end: 10 }
  let merged = s1.merge(s2)
  let expected = Span { start: 0, end: 10 }
  t.should_eq(merged, expected)?

  let s3 = Span { start: 10, end: 20 }
  let s4 = Span { start: 5, end: 15 }
  let merged2 = s3.merge(s4)
  let expected2 = Span { start: 5, end: 20 }
  t.should_eq(merged2, expected2)?
  Ok(())
}
