#[test("get location of span in source")]
fn test_span_location_generation() {
  let source = "123456789\n123456789\n123456789" as Slice<rune>

  assert Span.index(0).location(source) == Location { line: 1, col: 1 }
  assert Span.index(1).location(source) == Location { line: 1, col: 2 }
  assert Span.index(2).location(source) == Location { line: 1, col: 3 }
  assert Span.index(3).location(source) == Location { line: 1, col: 4 }
  assert Span.index(9).location(source) == Location { line: 1, col: 10 }
  assert Span.index(10).location(source) == Location { line: 2, col: 1 }
}

#[test("Span Merging")]
fn test_span_merge() {
  let s1 = Span { start: 0, end: 5 }
  let s2 = Span { start: 3, end: 10 }
  let merged = s1.merge(s2)
  let expected = Span { start: 0, end: 10 }
  assert merged == expected

  let s3 = Span { start: 10, end: 20 }
  let s4 = Span { start: 5, end: 15 }
  let merged2 = s3.merge(s4)
  let expected2 = Span { start: 5, end: 20 }
  assert merged2 == expected2
}
