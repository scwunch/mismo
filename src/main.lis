import "go:fmt"
import "go:os"
import "go:path/filepath"

import "compiler"
import "lexer"
import "parser"
import "semantic"
import "span"
import "specialization"

fn main() {
  match os.Args {
    [_] => {
      fmt.Println("Usage: mismo <input_file>")
    },
    [_, "--test", ..rest] => {
      fmt.Println("Running tests...")
      run_tests(rest)
    },
    [_, path] => {
      if let Err(e) = run_path(path) { fmt.Fprintln(os.Stderr, e.Error()) }
    },
    _ => fmt.Println("Error: no input file provided"),
  }
}

fn run_path(path: string) -> Result<(), error> {
  let source_str = os.ReadFile(path)? as string
  let work_dir = os.Getwd()?
  let mut opts = compiler.Options.new()
  opts.work_dir_parent = filepath.Join(work_dir, "zig-out")
  opts.work_dir = "testing"
  opts.zig_prelude_path = filepath.Join(work_dir, "zig-out/prelude.zig")
  Ok(compiler.run(source_str, opts))
}

fn run_tests(tests: Slice<string>) {
  let test_dict = Map.from([
    ("span", span.test),
    ("lexer", lexer.test),
    ("parser", parser.test),
    ("type_env", semantic.test_type_env),
    ("typecheck", semantic.test_typecheck),
    ("modecheck", semantic.test_modecheck),
    ("specialization", specialization.test_specialization),
    // ("codegen", codegen.test_codegen),
    ("compiler", compiler.test_compiler),
  ])

  if tests.is_empty() {
    // run all tests by default if none specified
    for (_, test_fn) in test_dict {
      test_fn()
    }
  } else {
    for test in tests {
      match test_dict.get(test) {
        Some(test_fn) => test_fn(),
        None => fmt.Println(f"Test '{test}' not found"),
      }
    }
  }
}
