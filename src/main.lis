import "go:encoding/json"
import "go:fmt"
import "go:os"
import "go:path/filepath"

import "compiler"
import dx "diagnostics"
import "lexer"
import "parser"
import "semantic"
import "span"
import "specialization"

fn main() {
  match os.Args {
    [_] => {
      fmt.Println("Usage: mismo run <input_file>")
    },
    [_, "--test", ..rest] => {
      fmt.Println("Running tests...")
      run_tests(rest)
    },
    [_, "run", path, ..args] => if let Err(e) = run_path(path) {
      fmt.Fprintln(os.Stderr, e.Error())
    },
    [_, cmd, path, ..args] => {
      let source_str = match os.ReadFile(path) {
        Ok(s) => s as string,
        Err(e) => {
          fmt.Fprintln(os.Stderr, e.Error())
          return
        },
      }

      if let Err(errors) = sub_cmd(cmd, source_str, args) {
        let runes = source_str as Slice<rune>
        for e in errors {
          fmt.Fprintln(os.Stderr, dx.render(e, runes))
        }
      }
    },
    _ => fmt.Println("Usage: mismo run <file.mismo>"),
  }
}

fn run_path(path: string) -> Result<(), error> {
  let source_str = os.ReadFile(path)? as string
  let work_dir = os.Getwd()?
  let mut opts = compiler.Options.new()
  opts.work_dir_parent = filepath.Join(work_dir, "zig-out")
  opts.work_dir = "testing"
  opts.zig_prelude_path = filepath.Join(work_dir, "zig-out/prelude.zig")
  Ok(compiler.run(source_str, opts))
}

fn sub_cmd(cmd: string, source: string, _args: Slice<string>) -> Result<(), Slice<dx.Diagnostic>> {
  let res = match cmd {
    "lex" => json.MarshalIndent(compiler.compile_to_tokens(source), "", "  "),
    "parse" => json.MarshalIndent(compiler.compile_to_ast(source)?, "", "  "),
    "typecheck" => json.MarshalIndent(compiler.type_check(source)?, "", "  "),
    "check" => json.MarshalIndent(compiler.mode_check(source)?, "", "  "),
    "specialize" => json.MarshalIndent(compiler.specialize(source)?, "", "  "),
    "transpile" => {
      fmt.Println(compiler.transpile(source)?)
      return Ok(())
    },
    "build" => {
      let mut opts = compiler.Options.new()
      let Ok(work_dir) = os.Getwd() else {
        fmt.Fprintln(os.Stderr, "couldn't get current work directory")
        return Err([])
      }
      opts.work_dir_parent = filepath.Join(work_dir, "zig-out")
      opts.work_dir = "testing"
      opts.zig_prelude_path = filepath.Join(work_dir, "zig-out/prelude.zig")
      match compiler.build(source, opts) {
        Bin(bin) => fmt.Println(bin),
        MismoErrs(errs) => return Err(errs),
        OsErr(e) => {
          fmt.Fprintln(os.Stderr, e.Error())
          return Err([])
        },
      }
      return Ok(())
    },
    _ => {
      fmt.Println(f"Error: unrecognized sub command \"{cmd}\"")
      return Err([])
    },
  }
  match res {
    Ok(bytes) => fmt.Println(bytes as string),
    Err(e) => fmt.Fprintln(os.Stderr, e.Error()),
  }
  Ok(())
}

fn run_tests(tests: Slice<string>) {
  let test_dict = Map.from([
    ("span", span.test),
    ("lexer", lexer.test),
    ("parser", parser.test),
    ("type_env", semantic.test_type_env),
    ("typecheck", semantic.test_typecheck),
    ("modecheck", semantic.test_modecheck),
    ("specialization", specialization.test_specialization),
    // ("codegen", codegen.test_codegen),
    ("compiler", compiler.test_compiler),
  ])

  if tests.is_empty() {
    // run all tests by default if none specified
    for (_, test_fn) in test_dict {
      test_fn()
    }
  } else {
    for test in tests {
      match test_dict.get(test) {
        Some(test_fn) => test_fn(),
        None => fmt.Println(f"Test '{test}' not found"),
      }
    }
  }
}
