pub enum Mode {
  Let,
  Mut,
  MutBang,
  Var,
}

impl Mode {
  pub fn string(self) -> string {
    match self {
      Mode.Let => "let",
      Mode.Mut => "mut",
      Mode.MutBang => "mut!",
      Mode.Var => "var",
    }
  }

  pub fn ordinal(self) -> int {
    match self {
      Mode.Let => 0,
      Mode.Mut => 1,
      Mode.MutBang => 2,
      Mode.Var => 3,
    }
  }

  pub fn assignable_to(self, other: Mode) -> bool {
    self.ordinal() >= other.ordinal()
  }

  pub fn union(self, other: Mode) -> Mode {
    if self.assignable_to(other) { other } else { self }
  }
}

pub fn parse(str: string) -> Option<Mode> {
  match str {
    "let" => Some(Mode.Let),
    "mut" => Some(Mode.Mut),
    "mut!" => Some(Mode.MutBang),
    "var" => Some(Mode.Var),
    _ => None,
  }
}
