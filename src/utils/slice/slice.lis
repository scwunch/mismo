pub fn compare<T>(s1: Slice<T>, s2: Slice<T>, pred: fn(T, T) -> bool) -> bool {
  s1.length() == s2.length() && zip(s1, s2).all(|(v1, v2)| pred(v1, v2))
}

pub fn zip<T, U>(s1: Slice<T>, s2: Slice<U>) -> Slice<(T, U)> {
  if s1.length() <= s2.length() {
    s1
      .enumerate()
      .map(|(i, v)| {
        (v, s2[i])
      })
  } else {
    s2
      .enumerate()
      .map(|(i, v)| {
        (s1[i], v)
      })
  }
}

pub fn map_result<T, R, E>(s: Slice<T>, f: fn(T) -> Result<R, E>) -> Result<Slice<R>, E> {
  let mut result = []
  for v in s {
    result = result.append(f(v)?)
  }
  Ok(result)
}

pub fn push<T>(s: Ref<Slice<T>>, item: T) {
  s.* = s.*.append(item)
}

pub fn pop_front<T>(s: Ref<Slice<T>>) -> Option<T> {
  match s.get(0) {
    Some(item) => {
      s.* = s.*[1..]
      Some(item)
    },
    None => None,
  }
}

pub fn index_of<T>(s: Slice<T>, predicate: fn(T) -> bool) -> Option<int> {
  for (i, v) in s.enumerate() {
    if predicate(v) {
      return Some(i)
    }
  }
  None
}
