import "go:fmt"
import "go:os"

import "lexer"
import "parser"

fn main() {
  match os.Args {
    [_] => {
      fmt.Println("Usage: mismo <input_file>")
      return
    },
    [_, path] => {
      let data = os.ReadFile(path)
      match data {
        Ok(file_data) => {
          let source_str = file_data as string
          let tokens = lexer.lex(source_str)
          fmt.Println(f"Lexed {tokens.length()} tokens")
        },
        Err(_) => fmt.Println(f"Error: could not read file {path}"),
      }
    },
    _ => fmt.Println("Error: no input file provided"),
  }
  
  // if os.Args.length() < 2 {
