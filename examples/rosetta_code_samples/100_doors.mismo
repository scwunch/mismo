"""
There are 100 doors in a row that are all initially closed.

You make 100 passes by the doors.

The first time through, visit every door and toggle the door (if the door is closed, open it; if it is open, close it).

The second time, only visit every 2nd door (door #2, #4, #6, ...), and toggle it.

The third time, visit every 3rd door (door #3, #6, #9, ...), etc, until you only
visit the 100th door. 
"""

fn main:
   var doors = Array[Bool].new(100, false)
   for i in range(1, 100):
      for j in range(i, 100, i):
         doors.set(j, ~doors.get(j))

   for i, door in doors.enumerate:
      if door:
         print(i)


fn main:
   var doors = 
      Array[Bool].new(100, false)
      .iter_mut
      .enumerate
      .map(|mut door|:
         {var i, mut door} = door
         range(1, 100)
            .iter
            .filter(|pass|: (i + 1) % pass == 0)
            .map(|pass|: 
               door = ~door
               door
            )
            .last
            .unwrap
      )
      .array
   print(doors)