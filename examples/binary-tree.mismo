-- binary tree
struct Node[T]
    left: Option[Box[Node[T]]]
    right: Option[Box[Node[T]]]
    value: T

fn Node.new[T](value: T) -> Node[T]:
    Node[T](left: None, right: None, value: value)

fn in_order[T](mut! node: Node[T]) -> Coro[T]:
    if node.left is Some(left):
        yield from in_order(left.*)
    yield node.value
    if node.right is Some(right):
        yield from in_order(right.*)

fn main():
    var tree = Node.new(2)
    tree.left = Some(Box.new(Node.new(1)))
    tree.right = Some(Box.new(Node.new(3)))

    var coro = in_order(tree)  -- tree is borrowed as `mut!`
    let result = coro.next     -- result is borrowed from `coro`
    -- problem: what is the type of `result`?

co in_order[T, R](mut! node: Node[T], ?some(mut! T)->R, ?none()->R) -> R:
    if node.left is Some(left):
        yield from in_order(left.*)
    yield some(node.value)
    if node.right is Some(right):
        yield from in_order(right.*)

co iter[T, R](mut! self: Array[T], do: fn(mut! T)->R) -> R:
   var i = 0
   while i < self.size:
      yield do(self.buffer.deref_mut(i))

co iter[T](mut! self: Array[T]):
   var i = 0
   while i < self.size:
      yield self.buffer.deref_mut(i)

